#include "ui/menudef.h"

{


menuDef {
	name "clipboard"
	visible 0
	fullscreen 0
	rect 172 18 320 440
	focusColor 1 .75 0 1
	style 1
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
	border 1
	onOpen { play "sound/clipboard/pickup.wav"; hide "clip_*"; clipboard }


// to use this script with a clipboard entity, use the key/value "popup/clip_alertstatus" in the ent



/////////////////    default clip that lets you know you need to make a sript for a clipboard entity	//////////////////


itemDef {
	group clip_test
	name test1_clipboard
	rect -80 -20 480 480
	style 3
	background "document1"
	visible 0
	decoration
	}



itemDef {
	name test1_clipboard
	rect 18 108 280 322
	group clip_test
	text "no 'popup' or bad 'popup' specified in the entity"
	textscale .18
	forecolor .1 .1 .1 .9
	visible 0
	decoration
	}

itemDef {
	group clip_test
	name test1_clipboard
	rect 20 95 245 360
	text "there is no script set for this clipboard"
	textscale .18
	forecolor .1 .1 .1 .9
	visible 0
	decoration
	}








////////////////////////////////    cl_1_watch    /////////////////////////////////// 


itemDef {
	group clip_watch
	name clip_watch
	
	cvarTest "cg_hudStyle"
	showCvar { "1" }
	
	rect -80 -20 480 480
	style 3
	background "gfx/clipboard/wolf09/document1.tga"
	visible 0
	decoration
	}
	
itemDef {
	group clip_watch
	name clip_watch
	
	cvarTest "cg_hudStyle"
	hideCvar { "1" }
	
	rect 0 0 320 440
	style 3
	background "gfx/clipboard/document1.tga"
	visible 0
	decoration
	}

itemDef {
	name clip_watch
	rect 18 108 280 322
	group clip_watch
	textfile "text/EnglishUSA/cl_1_watch.txt"
	textscale .18
	forecolor .1 .1 .1 .9
	visible 0
	decoration
	autowrapped
}

itemDef {
	name clip_watch
	rect 18 108 280 322
	group clip_watch
	textfile "text/EnglishUSA/cl_1_watch.txt"
	textscale .18
	forecolor .1 .1 .1 .6
	visible 0
	decoration
	autowrapped
}

