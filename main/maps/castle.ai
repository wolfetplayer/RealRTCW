//Chad's first scripting attempt.  :)
//six treasure items
//
// DO NOT EDIT WITHOUT SPEAKING TO CHAD.  I DON'T CARE WHO YOU ARE.
//
//Last edited by: WolfETPLayer & William Faure

player
{

	spawn
	{
		cvar g_episode 6
		objectivesneeded 1
		
		mu_fade 0 1000
		mu_queue sound\music\c_chant
	}

	trigger give_loadout_1
	{
		accum 1 abort_if_not_equal 1
		#if g_fullarsenal == 0
		applyloadout dam_vanilla_1
		#endif
		#if g_fullarsenal == 1
		applyloadout dam_realrtcw_1
		#endif
		#if g_fullarsenal == 2
		applyloadout dam_vanilla_shotgun_1
		#endif
	}

	trigger give_loadout_2
	{
		accum 1 abort_if_not_equal 2
		#if g_fullarsenal == 0
		applyloadout dam_vanilla_2
		#endif
		#if g_fullarsenal == 1
		applyloadout dam_realrtcw_2
		#endif
		#if g_fullarsenal == 2
		applyloadout dam_vanilla_shotgun_2
		#endif
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		globalaccum 0 set 0
		accum 1 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif
		cvar g_level_was_selected 0
	}

	trigger action1
	{
		wait 500
		alertentity zombie2
		wait 500
		trigger zombie2 getup
		wait 500
		alertentity zombie1
		wait 500
		trigger zombie1 getup
		wait 500
		alertentity zombie3
		wait 500
		trigger zombie3 getup
		wait 7000
		alertentity zombie5
		wait 1000
		alertentity coffindoor
		wait 2000
		trigger zombie5 go
		
	}

	trigger action2
	{
	wait 1000 
 savecheckpoint
	}

	trigger action3
	{
		trigger zombie4 getup
		mu_play sound\music\s_bighits
	}

	trigger action4
	{
		alertentity zombie6
		alertentity zombie7
		#if g_spawnpriests > 0 alertentity priest1 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_1 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_2 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_3 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_5 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action5
	{
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_6 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_7 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_8 #endif
		alertentity zombie8
		alertentity zombie9
		wait 2000
		alertentity zombie18
		
		wait 1000 
 savecheckpoint
	}

	trigger action6	// (head roll)
	{
		trigger head roll1
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_9 #endif
	}

	trigger action7
	{
		alertentity nazi1
		alertentity zombie10
		alertentity zombie11
		alertentity naziscream
	}

	trigger action8
	{
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_10 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_11 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_12 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_16 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_17 #endif
		alertentity door1
		alertentity warrior4
		alertentity nazi2
		alertentity nazi3
		wait 3000
		alertentity nazi6
		wait 3000
		
		wait 1000 
 savecheckpoint
	}

	trigger action9
	{
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_13 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_14 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_15 #endif
		wait 3000
		alertentity zombie12
		alertentity zombie13
		alertentity zombie14
		alertentity bust3
		mu_play sound\music\s_barrelfall
		alertentity killtriggerz
	}

	trigger action10
	{
	wait 1000 
 savecheckpoint
	}

	trigger action11
	{
		alertentity elite1
		alertentity nazi17
		alertentity nazi18
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_13 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_14 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_15 #endif
	}

	trigger action12
	{
		mu_fade 0 1000
		mu_queue sound\music\c_military
		alertentity door2
		alertentity nazi4
		alertentity nazi5
		alertentity elite2
	//alertentity zombie15
		alertentity zombie16
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_18 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_19 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_20 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_21 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_22 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action13
	{
		alertentity elite3
		alertentity elite4
	}

	trigger action14
	{
		trigger elite3 attack
		trigger elite4 attack
	}

	trigger action15
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_23 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_24 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_25 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_26 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_27 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action16
	{
		alertentity elite5
		alertentity nazi11
		alertentity nazi12
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_28 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_29 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_30 #endif
	}

	trigger action17
	{
		alertentity elite6
		alertentity nazi13
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_31 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_32 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_33 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_34 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action18
	{
		alertentity nazi14
		alertentity nazi15
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_35 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_36 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_37 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_38 #endif
	}
		
	trigger action19
	{
		alertentity nazi16
		wait 2000
		alertentity zombie17
	}

	trigger action20
	{
		trigger zombie8 getup
		wait 1000
		trigger zombie9 getup
	}

	trigger secret1
	{
		foundsecret
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_4 #endif
	}

	trigger secret2
	{
		foundsecret
	}

	trigger getobjective1
	{
		objectivemet 1
	}
	
	trigger endmap
	{
		changelevel end persistent 
	}

	trigger endmap_bonus
	{
		
		#if g_fullarsenal == 0	// Vanilla Bonus
		printbonus castle
		giveinventory holdable_lp_syringe
		#endif
		
		#if g_fullarsenal == 1	// RealRTCW Bonus
		printbonus castle_alt
		giveinventory holdable_lp_syringe
		#endif
		
		#if g_fullarsenal == 2	// Vanilla Bonus
		printbonus castle
		giveinventory holdable_lp_syringe
		#endif
	}
}

/// ZOMBIES
zombie1	// (first spawned zombie)
{
	attributes
	{
		starting_health 200
		aim_accuracy 1.0
	}

	inspectsoundstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	spawn
	{
		accum 0 bitset 0
		knockback off
		takeweapon monsterattack2
		noavoid
		godmode on
		nosight 9999
		playanim off_hole_still both forever
	}

	trigger getup
	{
		wait 3000
		alertentity dust2
		wait 1000
		playanim off_hole both
		godmode off
		giveweapon monsterattack2
		knockback on
		sight
		gotocast player
		noavoid off
		resetscript	
	}

	fakedeath
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		trigger counter1 room1
	}

	death
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		trigger counter1 room1
	}
}

