// --- END CINEMATIC1 ---

nazi1
{
	attributes
	{
		fov 90
		aggression 1.0
		alertness 500
		hearing_scale 0.5
		attack_crouch 0.0
	}

	spawn
	{
		accum 0 bitreset 0	// Used for music
		accum 0 bitreset 1	// Used for music
		accum 0 bitreset 2
		giveweaponfull weapon_mauserrifle
		wait forever 0 target1
	}

	trigger talk1
	{
		wait 5
		playsound churchn1_1	// Poor Josef, look at him, torn to shreds.
	}

	trigger talk2
	{
		wait 5
		playsound churchn1_2	// He must be dead by now, I'm convinced it.
		wait 3000
		trigger elite1 talk1
	}

	trigger talk3
	{
		wait 7000
		playsound churchn1_3
		wait 1000
		trigger elite1 goback
		trigger nazi2 yesmam
		trigger nazi3 yesmam
		trigger nazi1 yesmam
	}

	trigger attention
	{
		wait 1000 elite1
	}

	trigger yesmam
	{
		wait 200
		trigger nazi1 go
	}

	trigger reset
	{
		runtomarker n1spot1
		trigger nazi1 go
	}

	trigger go
	{
		wait 1750
		walktomarker n1spot1 nostop
		walktomarker n1spot2 nostop
		walktomarker n3spot3 nostop
		walktomarker n1spot4 nostop
		walktomarker n1spot5 nostop
		wait 2000
		trigger nazi1 patrol
	}

	trigger patrol
	{
		walktomarker n1spot4 nostop
		walktomarker n1spot3
		wait 3000
		walktomarker n1spot4 nostop
		walktomarker n1spot5
		wait 3000
		trigger nazi1 patrol
	}

	pain 33
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2
		playsound blank
		trigger counter1 reset_d1
		resetscript
	}

	pain 20
	{
		attrib aim_accuracy 0.5
		attrib aim_skill 0.8
		attrib attack_skill 0.8
		attrib reaction_time 0.2
		attrib running_speed 100
		attrib tactical 1.0
	}

	avoiddanger grenade
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2
		playsound blank
		trigger counter1 reset_d1		
	}

	inspectfriendlycombatstart
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2
		playsound blank
		trigger counter1 reset_d1
	}

	bulletimpact
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2
		playsound blank
		trigger counter1 reset_d1
	}

	inspectsoundstart
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2
		playsound blank
		trigger counter1 reset_d1
	}

	inspectbodystart
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2
		playsound blank
		trigger counter1 reset_d1
	}

	death
	{
		playsound blank
		trigger elite1 accum1inc1
	}

	enemysight
	{
		accum 0 bitset 0
		accum 0 bitset 1
		trigger counter1 music_inc
		accum 0 bitset 2
		playsound blank
		resetscript
		attrib fov 240
		attrib alertness 1024
	}
}

