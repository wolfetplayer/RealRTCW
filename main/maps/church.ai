//
//AI Scripting
//Map: Church
//Last edited by: WolfETPLayer & William Faure
//

player
{

	spawn
	{
		cvar g_episode 1
		objectivesneeded 3

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		globalaccum 0 set 0
		applyloadout village1
		#endif
		cvar g_level_was_selected 0

		mu_fade 0 1000
		mu_queue sound/music/c_chant
		trigger counter1 cinematic1
		trigger player cam1
	}

	// --- Start Cinematic 1 Cameras ---

	trigger cam1
	{
		startcamblack cs04_01
	}

	trigger cam1b
	{
		startcam cs04_01b
	}

	trigger cam2
	{
		startcam cs04_02
	}

	trigger cam3
	{
		startcam cs04_03
	}

	trigger cam3d
	{
		startcam cs04_03d
	}

	trigger cam4
	{
		startcam cs04_04
	}

	trigger cam5
	{
		startcam cs04_05
	}

	trigger cam6
	{
		startcam cs04_06
	}

	trigger cam7
	{
		startcam cs04_07
	}

	trigger cam8
	{
		startcam cs04_08
	}

	trigger cam9
	{
		startcam cam9
	}

	trigger cam10
	{
		startcam cs04_10
	}

	// --- End Cinematic 1 Cameras ---

	trigger camerainterrupt
	{
		stopcam
		trigger counter1 cleanup
	}

	trigger music1_restart
	{
		mu_fade 0 1000
		mu_queue sound/music/c_military		
	}

	trigger music2_restart
	{
		mu_fade 0 1000
		mu_queue sound/music/c_atmos		
	}

	trigger action1
	{
		trigger counter1 dialog1	// Triggers nazi1 to start talking about their dead commrade.
	}

	trigger action1a
	{
		alertentity nazi4
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_3 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action1b
	{
		trigger counter1 scare_zombie
	}

	trigger opencoffin1
	{
		trigger coffincover1a slowopen
		trigger coffincover1b slowopen
		alertentity elite1a
		alertentity elite1b
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_4 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_5 #endif
	}

	trigger action2
	{
		trigger elite1b talk1
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_6 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_7 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_8 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_9 #endif
	}

	trigger action3
	{
		alertentity dispatch
		trigger portcullis1 action3
		trigger counter1 action3
		#if g_spawnpriests > 0 alertentity priest1 #endif
		#if g_spawnpriests > 0 alertentity priest2 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_10 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_11 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_14 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_15 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action4
	{
		alertentity elite9
		alertentity elite11
		trigger elite10 go2
		
		wait 1000 
 savecheckpoint
	}

	trigger e11_sten
	{
		trigger elite11 get_sten
	}

	trigger e11_toss
	{
		trigger elite11 toss_grenade
	}

	trigger action5
	{
		alertentity elite11a
		alertentity elite12
		alertentity elite13
		alertentity elite14
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_16 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_17 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_18 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_19 #endif
	}

	trigger action5a
	{
		trigger elite12 reset
		trigger elite13 reset
	}

	trigger action6
	{
		trigger counter1 action6
		trigger portcullis1 toggle
	}

	trigger port2_toggle
	{
		trigger portcullis2 toggle
	}

	trigger port3_toggle
	{
		trigger portcullis3 toggle
	}

	trigger action7
	{
		alertentity elite15
		alertentity elite16
		
	}

	trigger action7a
	{
		trigger lightning1 stinger
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_22 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_23 #endif
	}

	trigger action8
	{
		alertentity elite17
		trigger elite16 go
	}

	trigger action8a
	{
		trigger portcullis3 down	// This is to hide porcullis3 going through the roof, which can be visible from the last room.
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_24 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_25 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_26 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_eliteguard_27 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_eliteguard_28 #endif
		
		wait 1000 
 savecheckpoint
	}
	
	

	trigger pass_mission1
	{
		objectivemet 1
	}

	trigger pass_mission
	{
		objectivemet 2
	}

	trigger got_objective3
	{
		objectivemet 3
	}
	
	trigger secret1
	{
		foundsecret
		achievement_crystal
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_20 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_21 #endif
	}

	trigger endmap
	{
	changelevel boss1 persistent
	}

	trigger endmap_bonus										
	{															
	#if g_fullarsenal == 0  			// Vanilla Bonus
		printbonus church	
		giveammo ammo_dynamite
		giveinventory holdable_cross
	#endif
		
	#if g_fullarsenal == 1				// RealRTCW Bonus
		printbonus church_alt
		giveammo ammo_dynamite
		giveinventory holdable_cross
	#endif		

	#if g_fullarsenal == 2  			// Vanilla Bonus
		printbonus church	
		giveammo ammo_dynamite
		giveinventory holdable_cross
	#endif	
	}	
}

// --- START CINEMATIC1 ---

helga1
{
	attributes
	{
	}

	spawn
	{
		explicit_routing on
		takeweapon all
		headlook off
		wait forever 0 c_target1
	}

	trigger anim
	{
		playanim cs_4 both	
	}

	trigger go1
	{
		walktomarker h1spot1
		wait forever 0 c_target1
	}

	trigger go2
	{
		walktomarker h1spot2
		wait forever 0 c_target1
	}

	trigger talk1
	{
		playanim cs_4 torso	// print Well, what's happening?
		playsound church_helga1_1
	}

	trigger talk2
	{
		playsound church_helga1_2	// print Is it working?
	}

	trigger talk3
	{
		playsound church_helga1_3	// print Enough of your stallin. Tell me, yes or no, will it work?
	}

	trigger talk4
	{
		playsound church_helga1_4	// print Don't take that patroning tone with me....
	}

	trigger talk5
	{
		playsound church_helga1_5	// print What What!?
	}

	trigger talk6
	{
		playsound church_helga1_6	// print Excellent
	}
}

zemph1
{
	attributes
	{
	}

	spawn
	{
		explicit_routing on
		takeweapon all
		headlook off
		wait forever 0 c_target1
	}

	trigger anim1
	{
		playanim cs_4-01 torso
	}

	trigger anim2
	{
		playanim cs_4-02 torso
	}

	trigger anim3
	{
		playanim cs_4-03 torso
	}

	trigger talk1
	{
		playsound church_zemph1_1	// print A moment mein Director
	}

	trigger talk2
	{
		playsound church_zemph1_2	// print Please, be patient! We are operating under very difficult conditions here...
	}

	trigger talk3
	{
		playsound church_zemph1_3	// print Frau Von Bulow, how many times...
		playanim cs_4-02 torso
	}

	trigger talk4
	{
		playsound church_zemph1_4	// print Just a moment, Just a moment..
	}

	trigger talk5
	{
		playsound church_zemph1_5	// print Ya, ya... The Extraction process is beginning.
	}
}

