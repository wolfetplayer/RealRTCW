//
//AI Scripting
//Map: Crypt2 
//Last edited by: WolfETPLayer & William Faure
//

player
{
	spawn
	{
		accum 0 set 0
		accum 1 set 0
		
		cvar g_episode 1
		objectivesneeded 1

		abort_if_loadgame
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		globalaccum 0 set 0
		applyloadout village1
		#endif
		cvar g_level_was_selected 0

		mu_fade 0 1000
		mu_queue sound/music/c_military
#if g_reinforce >= 2 alertentity reinforce_ai_zombie_4 #endif
	}
	

	trigger music2_start
	{
		mu_play sound/music/s_longout
		mu_queue sound/music/c_chant 2000
	}

	trigger music3_start
	{
		mu_start sound/music/c_atmos 2000
	}

	trigger music_stop_3000
	{
		mu_stop 3000
	}

	trigger music_stop_1000
	{
		mu_stop 1000
	}

	trigger cam1
	{
	}

	trigger nazi2help
	{
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_1 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_2 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_3 #endif
	}

	trigger action0a
	{
		trigger s_coffin1 loop
		
		wait 1000 
 savecheckpoint
	}

	trigger action0
	{
		alertentity nazi3
		alertentity nazi4
		alertentity s_coffin1blow
		alertentity zombie2a
	}

	trigger action0b
	{
		trigger counter1 action0b
	}

	trigger action1
	{
		trigger nazi4 reset
		trigger nazi3 reset
		trigger nazi5 reset
		alertentity bnazi1
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_7 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_8 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_9 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_10 #endif
	}

	trigger action2
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		trigger counter1 action2
		wait 2000
		
		wait 1000 
 savecheckpoint
	}

	trigger z9wake
	{
		trigger zombie9 reset
	}

	trigger crossfall
	{
		trigger cross fall
	}

	trigger action3
	{
		alertentity door_close
		trigger counter1 action3
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_11 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_12 #endif
		
		wait 1000
		wait 1000 
 savecheckpoint
	}

	trigger action4
	{
		#if g_spawnpriests > 0 
		alertentity priest1
		alertentity priest2
		#endif
		alertentity zombie15
		alertentity zombie16
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_24 #endif
		
	    wait 1000 
 savecheckpoint
	}

	trigger z16reset
	{
		trigger zombie16 reset
	}

	trigger z15reset
	{
		trigger zombie15 reset
	}

	trigger bladeswing
	{
		trigger swingblade swing1
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_27 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_28 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger swingbladestop
	{
		trigger swingblade stop
		alertentity warboss1 
		alertentity warboss2
	}

    trigger action5
    {
        trigger counter1 go
        trigger spikes go
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_26 #endif
		wait 500
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_29 #endif
		wait 500
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_30 #endif
		wait 500
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_31 #endif
		wait 500
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_32 #endif
		wait 500
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_33 #endif
		trigger player swingbladestop // cs: no idea why this isn't triggered from map now ...
		
		wait 2000
	    wait 1000 
 savecheckpoint
    }

	trigger razorsgo
	{
		trigger hsaw1 go
	}

	trigger trapwalls
	{
		trigger trapdoor1 close
	}

	trigger trapreset
	{
		trigger trapwall1 open
		trigger trapwall2 open
	}

	trigger secretfirst
	{
		trigger 1st_btn go
		trigger secretdummy first
	}

	trigger secretsecond
	{
		trigger 2nd_btn go
		trigger secretdummy second
		trigger big_wall1 go
		trigger big_wall2 go
	}

	trigger secretthird
	{
		trigger 3rd_btn go
		trigger secretdummy third	
	}

	trigger trap3
	{
		alertentity warzombie17
		alertentity warzombie18
	}

	trigger blockready
	{
		trigger bigblock ready
	}

	trigger supersecret1
	{
		achievement_goldchest
		foundsecret
	}

	trigger secret1
	{	
		foundsecret
		#if g_reinforce >= 2 alertentity reinforce_ai_zombie_5 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_zombie_6 #endif
	}

	trigger pass_mission
	{
		objectivemet 1	
	}

	trigger exitdoor
	{
		alertentity unlockexit
		alertentity openexit
	}
	

	trigger endmap
	{
	changelevel church persistent
	}

	trigger endmap_bonus										
	{															
		
	#if g_fullarsenal == 0  			// Vanilla Bonus	// REALRTCW ENDMAP BONUS
		printbonus crypt2	
		givehealth item_health
		giveinventory holdable_cross
	#endif
		
	#if g_fullarsenal == 1				// RealRTCW Bonus	// REALRTCW ENDMAP BONUS
		printbonus crypt2_alt
		givehealth item_health
		giveinventory holdable_cross
	#endif							

	#if g_fullarsenal == 2  			// Vanilla Bonus	// REALRTCW ENDMAP BONUS
		printbonus crypt2	
		givehealth item_health
		giveinventory holdable_cross
	#endif	

	}	

}

bnazi1
{
	attributes
	{
		starting_health	10000
		pain_threshhold_scale 100		
		hearing_scale 0.0
	}

	spawn
	{
		statetype alert
		noaidamage on
		nosight 999999
		wait 5 0
		catchfire
		alertentity warzombie4
		alertentity warzombie5
		alertentity flamer0
		playanim pain_fire torso 100
		gotomarker bn1spot1 nostop
		sethealth 50
		playanim pain_fire torso 100
		gotomarker bn1spot2 nostop
	}

	bulletimpactsound
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	death
	{
		playanim death_flame_1 both
	}
}

