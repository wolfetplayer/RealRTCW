		deny
	}

	inspectbodystart
	{
		clearanim
		accum 1 inc 1
		trigger radio_nazi2 get_weapons
		accum 1 abort_if_less_than 2
		deny
	}

	trigger get_weapons
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		statetype alert
		giveweaponfull weapon_luger
		resetscript
	}

