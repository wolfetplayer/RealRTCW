radio_nazi1	// 
{
	attributes
	{
		tactical 1.0
		aggression 1.0
		inner_detection_radius 200
		alertness 800
	}

	spawn
	{
		accum 0 bitreset 20
		takeweapon all
		accum 0 bitset 0
		accum 0 bitreset 1
		accum 1 set 0
		accum 2 set 1		// Nazi is alaive
		accum 3 set 0		// Used so that the "inspects" are only used once. Then it will DENY.
		trigger checker1 alive_check_in
		wait 5
		trigger checker1 if_alarm_on
		wait 5
		trigger checker1 if_alarm_off
	}
	
	trigger go1	// relaxed response
	{
		wait 1000
		walktomarker rn1spot1
		facetargetangles rn1spot1
		trigger radio_nazi1 anim_loop
	}

	trigger anim_loop
	{
		playanim device both
		wait 3000
		trigger radio_nazi1 anim_loop
	}

	trigger talk1
	{
		wait 2000
		trigger radio_nazi1 anim_loop
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	trigger alarm_on_response
	{
		resetscript
		clearanim
		statetype alert
		runtomarker rn1spot1a
		giveweaponfull weapon_luger
	}

	enemysight
	{
		accum 0 bitset 20
		trigger checker2 sight_check_in
		clearanim
		trigger radio_nazi1 get_weapons
		resetscript
	}

	trigger afraid
	{
	}

	trigger anim_loop2
	{
	//  test	playanim alert_idle_no both 100 player
	}

	trigger choose_tactic
	{
		trigger radio_nazi1 tacitc2
	}

	trigger tactic1	// Passive
	{
	}

	trigger scared_loop
	{
	}

	trigger tactic2	// Agreesive
	{
		accum 1 abort_if_not_equal 1
		resetscript
		giveweaponfull weapon_luger
		accum 1 set 0
	}

	trigger you_blew_up_my_radio
	{
		accum 2 abort_if_not_equal 1
		resetscript
		wait 500 player
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		clearanim
		accum 0 inc 1
		trigger radio_nazi1 get_weapons
		accum 0 abort_if_less_than 2
		deny
	}

	inspectbodystart
	{
		clearanim
		accum 0 inc 1
		trigger radio_nazi1 get_weapons
		accum 0 abort_if_less_than 2
		deny
	}

	trigger get_weapons
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1
		statetype alert
		giveweaponfull weapon_luger
		resetscript
	}

	death
	{
		accum 2 set 0 		// Nazi is now dead
		trigger checker1 death_check_out
		accum 0 abort_if_not_bitset 20
		trigger checker2 sight_check_out
	}
}

