		walktomarker m1spot1
		facetargetangles m1spot1
		movetype crouch
		wait 4000
	}

	trigger anim_loop	// called 
	{
		accum 2 abort_if_equal 1
		accum 0 abort_if_bitset 30
		playanim clipboard both
	}

	trigger anim_loop2	// called 
	{
		accum 2 abort_if_equal 1
		accum 0 abort_if_bitset 30
		playanim clipboard both
	}

	trigger anim_loop3
	{
		accum 2 abort_if_equal 1
		accum 0 abort_if_bitset 30
		wait 1000 mechanic2
		playanim talking both
	}

	enemysight
	{
		clearanim
		playsound blank
		giveweaponfull weapon_luger
		resetscript
		clearanim
	}

	trigger choose_tactic
	{
		accum 2 random 3
		wait 5
		trigger mechanic1 tactic1
		wait 5
		trigger mechanic1 tactic2
		wait 5
		trigger mechanic1 tactic3
	}

	trigger tactic1	// total camper
	{
		accum 2 abort_if_not_equal 0
		resetscript
		attrib camper 1.0
		attrib aggression 0.1
		attrib aim_accuracy 0.5
		attrib reaction_time 0.9
		wait 3000 player
	}

	trigger tactic2	// Super aggressive
	{
		accum 2 abort_if_not_equal 1
		resetscript
		attrib camper 0.1
		attrib aggression 1.0
		attrib aim_accuracy 0.3
	}

	trigger tactic3	// medium
	{
		accum 2 abort_if_not_equal 2
		resetscript
		attrib reaction_time 0.9
		attrib camper 0.6
		attrib aggression 0.7
		attrib aim_accuracy 0.1
		wait 4000 player
	}

	trigger alarm_on_response		// Only is triggered if alarm is on...
	{
		trigger sliding_door2 lock_door
		playsound blank
		alertentity backup1_zone1
		runtomarker m1alert1 nostop
		runtomarker m1alert2 nostop
		runtomarker m1alert3 nostop
		runtomarker m1alert4 
		facetargetangles m1alert4
		movetype crouch
		wait forever 0 
	}

	trigger blown_response
	{
		statetype alert 
	}

//--------Conversation----------
	trigger talk1
	{
		accum 0 abort_if_bitset 30
		playsound m1_verdammt_leak	// Ahc this dran leak
		accum 0 abort_if_bitset 30
		wait 6000
		accum 0 abort_if_bitset 30
		trigger mechanic2 anim_loop2
		accum 0 abort_if_bitset 30
		wait 5
		trigger mechanic2 talk1
		accum 0 abort_if_bitset 30
	}

	trigger talk2
	{
		accum 0 abort_if_bitset 30
		playsound m1_thats_right		// see how it works
		accum 0 abort_if_bitset 30
		wait 7600
		accum 0 abort_if_bitset 30
		trigger mechanic2 anim_loop5
		accum 0 abort_if_bitset 30
		wait 5
		trigger mechanic2 talk2
		accum 0 abort_if_bitset 30
	}

	trigger talk3
	{
		accum 0 abort_if_bitset 30
		playsound m1_yes_it_was_obvious
		accum 0 abort_if_bitset 30
		wait 10000
		accum 0 abort_if_bitset 30
		trigger mechanic2 anim_loop4
		accum 0 abort_if_bitset 30
		wait 5
		trigger mechanic2 talk3
		accum 0 abort_if_bitset 30
	}
		
	trigger talk4
	{
		accum 0 abort_if_bitset 30
		playsound m1_makes_perfect_sense
		accum 0 abort_if_bitset 30
		wait 5300
		accum 0 abort_if_bitset 30
		trigger mechanic2 anim_loop
		wait 5
		trigger mechanic1 anim_loop2
		accum 0 abort_if_bitset 30
	}

//----------END----------------
	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
		accum 0 abort_if_bitset 30
		accum 0 bitset 30
		trigger valve valve_stop
		deny
		clearanim
		playsound blank
		giveweaponfull weapon_luger
		statetype alert
		resetscript
		wait 500 0 player
	}

	inspectsoundstart
	{
		deny
		accum 0 abort_if_bitset 30
		accum 0 bitset 30
		trigger valve valve_stop
		deny
		clearanim
		playsound blank
		giveweaponfull weapon_luger
		statetype alert
		resetscript
		wait 500 0 player
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_bitset 30
		accum 0 bitset 30
		trigger valve valve_stop
		clearanim
		playsound blank
		giveweaponfull weapon_luger
		statetype alert
		resetscript
		wait 500 0 player
	}

	death
	{
		trigger valve valve_stop
		accum 2 set 1
		trigger checker1 death_check_out
		trigger mechanic2 mechanic1_dead_checkin	
	}
}

