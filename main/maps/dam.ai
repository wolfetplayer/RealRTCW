	}
}

nazi1	// THIS IS NAZI WHO GETS OUT OF TRUCK...				
{
	attributes
	{
		tactical 1.0
		aggression 1.0
		inner_detection_radius 200
		alertness 1800		
	}

	spawn
	{
		takeweapon all
		accum 0 bitset 0 
		accum 0 bitreset 20 
		accum 1 set 0
		accum 2 set 0
		accum 4 set 0
		trigger officer1 nazi1_alive_checkin
		trigger checker1 alive_check_in	
		trigger nazi1 go1
	}

	trigger officer1_alive_checkin
	{
		accum 0 bitreset 30
	}

	trigger officer1_dead_checkin
	{
		accum 0 bitset 30
	}

	trigger alarm_on_response
	{
		accum 4 set 1
		statetype alert
		giveweaponfull weapon_luger

	}

	trigger go1
	{
		wait forever 0	
	}
	
	trigger go1a	// This has nazi1 will walk up to gate...	
	{
		takeweapon all
		alertentity closing_door
		trigger officer1 run_to_door	//  this tell officer to open the door...
		walktomarker n1spot1 nostop
		facetargetangles n1spot2
		walktomarker n1spot2
		wait 500
		wait 300 //officer1 
		trigger nazi1 talk1
		wait 5
	}

//--------CONVERSATION-------------
//  THIS NAZI WILL TALK TO THE GAURD WHO COMES OUT OF FIRST TOWER 

	trigger talk1
	{
		trigger player cam6
		accum 0 abort_if_bitset 30
		playsound driver_open_gate	// HEY, can you openthe gate please...
		wait 3800 officer1
		trigger officer1 talk1
		
	}

	trigger talk2
	{
		trigger player cam4
		accum 0 abort_if_bitset 30
		playsound driver_what_do_you_mean_closed	// What do you mean closed..
		wait 2700
		trigger player cam5
		wait 2300
		trigger officer1 anim_loop2
		wait 5
		trigger officer1 talk2
		clearanim
		wait 800
		trigger player cam2
	}

	trigger talk3
	{
		trigger officer1 anim_loop2
		wait 5
		playsound driver_delivery_for_gen	// iknow but this delivery is for gen Von...
		wait 9700
		trigger officer1 talk3
		wait 2500
		trigger player cam5
		accum 0 abort_if_bitset 30
	}

	trigger talk4
	{
		trigger player cam7
		accum 0 abort_if_bitset 30
		playsound driver_what	// What !!
		wait 600
		clearanim
		trigger officer1 anim_loop2
		wait 5
		trigger officer1 talk4
	}

	trigger talk5
	{
		accum 0 abort_if_bitset 30
		playsound driver_ja_ja
		wait 3000
		trigger player cam5
		wait 6700
		trigger player cam3
		wait 100
		trigger officer1 anim_loop2
		wait 5
		trigger officer1 talk5

	}

	trigger talk6
	{
		accum 0 abort_if_bitset 30
		playsound driver_what_am_I_supposed_to_do
		wait 2800
		trigger officer1 anim_loop4
		wait 5
		trigger officer1 talk6
		wait 1300
		trigger player cam3
	}

///--------END--------------------
	trigger cine1_stop
	{
		resetscript
		wait 5
		wait 500
		accum 0 bitset 5
		wait 1000
		trigger nazi1 walk_away 
	}

	trigger walk_away
	{
		alertentity horn_stop
		wait 1000
		walktomarker n1spot1
		facetargetangles o1spot5
		walktomarker n1spot1a
		facetargetangles o1spot1a
		trigger nazi1 walk_away_anim
	}

	trigger walk_away_anim
	{
		accum 4 abort_if_equal 1
		playanim clipboard both
		wait 4000
		trigger nazi1 walk_away_anim	
	}

	trigger barrel_blown
	{
		accum 1 inc 1
		trigger nazi1 barrel_one
		wait 5
		trigger nazi1 barrel_two
		wait 5
		trigger nazi1 barrel_three
	}

	trigger barrel_one
	{
		accum 1 abort_if_not_equal 1
		resetscript
		playsound blank
		statetype alert
		wait 500 player
	}

	trigger barrel_two
	{
		accum 1 abort_if_not_equal 2
		resetscript
		playsound blank
		statetype alert
		wait 500 player
	}

	trigger barrel_three
	{
		accum 1 abort_if_not_equal 3
		resetscript
		playsound blank
		wait 500 player
		giveweaponfull weapon_luger
		statetype alert
		wait 500 player
	}

	trigger anim_loop
	{
		accum 4 abort_if_equal 1 
		playanim talking both 
	}

	trigger anim_loop2
	{
		wait 3000
		wait 8000
		trigger nazi1 anim_loop
	}

	trigger alarm_on
	{
		statetype alert
		trigger nazi1 alarm_on2
	}

	trigger alarm_on2
	{
		accum 4 set 1
		accum 0 abort_if_not_bitset 3
		clearanim
		giveweaponfull weapon_luger
		statetype alert
	}

	pain 40
	{
		clearanim
	}
	
	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		accum 4 set 1
		accum 0 bitset 20
		trigger checker2 sight_check_in
		clearanim
		statetype alert
		giveweaponfull weapon_luger
		playsound blank
	}

	inspectsoundstart
	{
		accum 4 set 1
		deny
		statetype alert
		giveweaponfull weapon_luger
		clearanim
		playsound blank
		wait 5 player
	}

	bulletimpact
	{
		accum 4 set 1
		trigger nazi2 alarm_on
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		accum 4 set 1
		clearanim
		statetype alert
		giveweaponfull weapon_luger
		playsound blank
		resetscript
		wait 5 player
	}

	inspectbodyend
	{
	}

	death
	{
		trigger checker1 death_check_out
		trigger officer1 nazi1_dead_checkin
		trigger checker1 backup_for_zone1	
	}
}

