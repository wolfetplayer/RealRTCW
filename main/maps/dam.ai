tower_nazi1	// This is blackguard patrolling dam after mg42 nest			
{
	attributes
	{
		tactical 1.0
		aggression 1.0
		inner_detection_radius 200
		alertness 1500	
		statetype alert	
	}

	spawn
	{
		#if g_fullarsenal == 0
		giveweaponfull weapon_fg42
		#endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
		#endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
		#endif
		accum 0 bitreset 20
		trigger checker1 alive_check_in
		trigger tower_nazi1 marchloop1	
	}
	
	trigger marchloop1			
	{
		walktomarker tn1spot1 
		facetargetangles tn1spot1
		playanim binocular both
		wait 3300
		walktomarker tn1spot2 
		facetargetangles tn1spot2
		playanim binocular both
		wait 2700
		walktomarker tn1spot3 
		facetargetangles tn1spot3
		wait 1500 
		playanim binocular both
		trigger tower_nazi1 marchloop1
	}

	trigger run_to_door
	{
		runtomarker tn1spot4
		runtomarker tn1spot5
		wait 8000 nazi1
		trigger tower_nazi1 marchloop1
	}

	trigger run_to_alarm
	{
		wait 5
		accum 3 abort_if_greater_than 0
		accum 3 inc 1
		resetscript
		alertentity alarm_on
		runtomarker turn_alarm_on_spot
		facetargetangles turn_alarm_on_spot
		trigger checker1 alarm_on
		wait 5
		trigger nazi1 alarm_on
		wait 5
		trigger officer1 alarm_on
		wait 5
		alertentity nazi3
		wait 5
		alertentity plank_guard
		resetscript
	}

	trigger alarm_on_response
	{
		resetscript
		statetype alert
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		accum 0 bitset 20
		trigger checker2 sight_check_in
		clearanim
		trigger checker1 if_alarm_on
		trigger checker1 if_alarm_off
	}

	inspectsoundstart
	{
		clearanim
		trigger tower_nazi1 run_to_alarm
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
		trigger tower_nazi1 run_to_alarm		
	}

	inspectbodyend
	{
	}

	death
	{
		trigger checker1 death_check_out	
		trigger tower_nazi1a run_to_alarm
		trigger checker1 backup_for_zone1
		accum 0 abort_if_not_bitset 20
		trigger checker2 sight_check_out
	}
}

tower_nazi1a // This is nazi near the gates in food room			
{
	attributes
	{
		tactical 1.0
		aggression 1.0
		inner_detection_radius 200
		alertness 2000		
	}

	spawn
	{
		accum 0 bitset 0 
		accum 0 bitreset 20
		accum 0 bitreset 25
		accum 0 bitreset 5
