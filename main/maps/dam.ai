player
{
	spawn
	{
		accum 5 set 0     // loadout randomizer
		
		cvar g_episode 5
		objectivesneeded 2	// taken down to 

		abort_if_loadgame
		mu_start sound/music/m_drums
	//	trigger radio static
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_drums

		#if g_midgame == 0
		accum 5 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif

		#if g_level_was_selected >= 1
		accum 5 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif

		cvar g_chapter_legit 1
		cvar g_level_was_selected 0

		trigger checker2 plane_cine1
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_1 #endif	// Spawn these guys after the player does, otherwise we see them poof out of thin air. --BreakinBenny
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_2 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_3 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_4 #endif

	}


	trigger give_loadout_1
	{
	    accum 5 abort_if_not_equal 1
		
		#if g_fullarsenal == 0
        applyloadout dam_vanilla_1
		#endif

		#if g_fullarsenal == 1
        applyloadout dam_realrtcw_1
		#endif
		
		#if g_fullarsenal == 2
        applyloadout dam_vanilla_shotgun_1
		#endif
	}
	
	trigger give_loadout_2
	{
	    accum 5 abort_if_not_equal 2
		 
		#if g_fullarsenal == 0
        applyloadout dam_vanilla_2
		#endif

		#if g_fullarsenal == 1
        applyloadout dam_realrtcw_2
		#endif
		
		#if g_fullarsenal == 2
        applyloadout dam_vanilla_shotgun_2
		#endif
	
	}

//----------Cameras-------------

	trigger plane_cam1
	{
		startcam damb25_01
	}

	trigger cam1
	{
		startcam dam_01
	}

	trigger cam2
	{
		startcam dam_02
	}

	trigger cam3
	{
		startcam dam_03
	}

	trigger cam3d
	{
		startcam dam_03d
	}

	trigger cam4
	{
		startcam dam_04
	}

	trigger cam5
	{
		startcam dam_05
	}

	trigger cam6		// Changed...
	{
		startcam dam_11
	}

	trigger cam7
	{
		startcam dam_07
	}

	trigger cam8
	{
		startcam dam_08
	}

	trigger cam9 
	{
		startcam dam_09
	}

	trigger cam10 
	{
		startcam dam_10
	}

//----------End Cameras --------

	trigger camerainterrupt
	{
		mu_fade 0 3000
		mu_queue sound/music/m_drums	
		stopcam
		alertentity nazi1
		trigger nazi1 cine1_stop	// Had to do this because of cutscene method...
		trigger officer1 cine1_stop
		trigger checker2 plane_cine1_stop
	}

	trigger alarm1_destroyed
	{
		trigger checker1 alarm1_destroyed
	}

	trigger alarm2_destroyed
	{
		trigger checker1 alarm2_destroyed
		trigger tower_nazi2 hide
	}

	trigger alarm_tunnel_destroyed
	{
		trigger checker1 alarm_tunnel_destroyed
	}

	trigger blowing_up_barrels
	{
		trigger nazi1 barrel_blown
	}

	trigger first_tower_alarm_destroyed
	{
		trigger radio first_tower_alarm_destroyed
	}

	trigger second_tower_alarm_destroyed
	{
		trigger radio second_tower_alarm_destroyed
	}

	trigger player_alarm1	//  This is used for player and ai to turn on alarm
	{
		wait 5
		trigger checker1 alarm_on
		wait 500
		trigger checker2 alarm1_on_check
	}

	trigger player_alarm2	//  This is used for player and ai to turn on alarm
	{
		wait 5
		trigger checker1 alarm_on
		wait 500
		trigger checker2 last_tower_alarm
	}

	trigger tower_blownup
	{
		trigger t2body player_seen
	}

	trigger in_zone1
	{
		trigger checker1 in_zone1
	}
	
	trigger in_zone2
	{
		trigger checker1 in_zone2
		trigger tower_nazi2 positon_stealth	
		
		wait 1000 
 savecheckpoint
	}

	trigger in_zone3
	{
		objectivemet 1
		trigger checker1 in_zone3
		alertentity nazi4
		alertentity nazi5
		wait 1000 
		savecheckpoint
	}

	trigger in_tunnel // this spawns in two mechaincs working and conversation
	{
		trigger elevator1 down_with_guys_on
		wait 5
		trigger checker1 in_zone2
		wait 5		
		trigger checker1 in_tunnel
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_5 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_6 #endif
	}

	trigger valve_trigger
	{
		trigger valve go1
	}

	trigger user_lower_alarm
	{
		wait 5
		trigger checker1 alarm_on
		wait 1500
		trigger checker2 alarm_on_check_underneath		
	}

	trigger use_sliding_door2
	{
		trigger sliding_door2 choose_to_move
	}

	trigger tunnel_from_elevator
	{
		#if g_spawndogs > 0	alertentity dog1 #endif
		trigger checker1 tunnel_from_elevator_spawn
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_9 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_10 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_11 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_12 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_13 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_14 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_15 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_16 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_17 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_18 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_19 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_20 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_21 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_22 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_23 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_24 #endif
		
		wait 1000 
		savecheckpoint
	}

	trigger elevator_down // this spawns guys coming doen elevator
	{
		wait 5
		trigger checker1 lower_alertness_guards_on_dam
//		Also being used as a zone checker to let script know player is in zone2
		trigger checker1 in_zone2 
		trigger nazi3 get_off_mg42 
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_7 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_8 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger radio_room // To do 
	{
		alertentity radio_nazi1
		alertentity radio_nazi2
		alertentity radio_nazi3
		wait 5
		trigger radio choose_tunes
	}

	trigger player_using_radio
	{
		trigger radio static
		trigger radio_button rotate1
	}

	trigger in_the_vents
	{
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity blackguard1 
		trigger checker2 choose_mechanic // This selects different starting points for mechanic...
		trigger checker1 vent2_off		// This is so that vent even turns off if the user goes this way
		wait 5
		trigger checker1 in_the_vents
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_26 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_28 #endif	
		
		wait 1000 
		savecheckpoint
		
	}

	trigger vent2 // This will keep track of vent being broken out of. 
	{
		trigger checker1 vent2
	}

	trigger last_room
	{
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_25 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_27 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_29 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_30 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_31 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_32 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_33 #endif
	}

	trigger last_room2
	{
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity blackguard1 
		trigger checker2 choose_mechanic	// This selects different starting points for mechanic...		
	}

	trigger last_hallway
	{
		alertentity blackguard1
		alertentity blackguard2
		alertentity blackguard3
		
		wait 1000 
 savecheckpoint
	}

	trigger kill_radio_sound
	{
		wait 5
		trigger radio turn_off
		trigger radio_nazi1 you_blew_up_my_radio
		trigger radio_nazi2 alarm_on_response
		trigger elevator1 radios_destroyed_now
	}

	trigger button1	// this activates button
	{
		trigger button1 buttons
	}

	trigger button2	// this activates button
	{
		trigger button2 buttons
	}

	trigger tank_explode_left
	{
		alertentity t641
	}

	trigger tankexplode
	{
		trigger tank blast
	}

	trigger tankexplode	//NEED TO ADD IN...
	{
		trigger radio door_status
		trigger tank blown_tank_response		
	}

	trigger alert_plank_guard
	{
		trigger checker1 plank_get_into_position
		trigger checker1 alarm_on_alert_plank_gaurd
		wait 5
		trigger checker1 alarm_off_spawn_in_relax_plank_guard
	}

	trigger to_make_plank_fall
	{
		trigger falling_plank fall1	
	}

	trigger first_tower_alarm_destroyed
	{
	}

	trigger radios_destroyed
	{
		trigger elevator1 radios_destroyed_now
	}

	trigger radios_destroyed_now
	{
	}

	trigger last_4_guys
	{
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity last_guard1
		alertentity last_guard2
		alertentity last_guard3
		alertentity last_guard4
		#if g_spawndogs > 0 
		alertentity dog2
		alertentity dog3
		#endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_34 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_35 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_36 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_37 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_38 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_39 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_40 #endif
	}

	trigger secret1
	{
		foundsecret
	}

	trigger last_objective
	{
		objectivemet 2
	}

	trigger endmap
	{
		changelevel village2 persistent
	}

	trigger endmap_bonus										
	{															
		#if g_fullarsenal == 0  	// Vanilla Bonus
		printbonus dam	
		giveammo ammo_30cal
		#endif
		
		#if g_fullarsenal == 1		// RealRTCW Bonus
		printbonus dam_alt
		giveweapon weapon_hdm
		setammo ammo_hdm full
		setclip weapon_hdm full
		#endif	

		#if g_fullarsenal == 2  	// Vanilla Bonus
		printbonus dam	
		giveammo ammo_30cal
		#endif		
	}
}

bj2
{
	attributes
	{
	}

	spawn
	{
		nosight 99999
		parachute on
		trigger bj2 anim_loop
	}

	trigger anim_loop
	{
		nosight 99999
		playanim para both forever			
	}
}


bj3
{
	attributes
	{
	}

	spawn
	{
		takeweapon all
		nosight 99999
		trigger bj3 go1
	}

	trigger go1
	{
		facetargetangles bj3_spot1
		trigger bj3 anim_loop		
	}

	trigger anim_loop
	{
		nosight 99999
		playanim plane_1 both holdframe	//forever	
	}

	trigger anim_loop2
	{
		clearanim
		nosight 99999
		playanim plane_2 both forever			
	}

	trigger anim_loop3
	{
		playanim plane_1 both
		wait 10000
		playanim plane_2 both	// pilots stays get ready
	}

	trigger talk1
