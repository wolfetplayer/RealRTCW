	{
		accum 1 abort_if_greater_than 1
		resetscript
		accum 1 inc 1
		runtomarker o1s1spot1a
		wait 2000
		runtomarker n3aspot1
		wait 2000
		runtomarker n3aspot1a
		trigger nazi3a alarm_march 
