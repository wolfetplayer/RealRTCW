///
///
/// The BIG BAD BOSS level
/// Chad and jeremy...
/// 10/03/00
//
// // DO NOT EDIT WITHOUT SPEAKING TO CHAD.  I DON'T CARE WHO YOU ARE.
//

player
{

	spawn
	{
		accum 0 bitreset 0
		abort_if_loadgame
		mu_fade 0 1000
		mu_queue sound/music/c_atmos

		cvar g_episode 6
		objectivesneeded 1		
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/c_chant
		trigger counter1 action1	these three events are beggining events
		trigger counter1 cinematic1	
		trigger player cam1
	}

	trigger cam_himmler1a
	{
		startcamblack cs18_04
	}

	trigger cam_himmler
	{
		startcamblack cs18_04
	}

	trigger cam1
	{
		startcam cs16_01
	}

	trigger cam2
	{
		startcam cs16_02
	}

	trigger cam3
	{
		startcam cs16_03
	}

	trigger cam3d
	{
		startcam cs16_03d
	}

	trigger cam4
	{
		startcam cs16_04
	}

	trigger cam5
	{
		startcam cs16_05
	}

	trigger cam6
	{
		startcam cs16_06
	}

	trigger cam6d
	{
		startcam cs15_06d
	}

	trigger cam7		// new camers for the end...
	{
		startcam cs16_07
	}

	trigger cam8
	{
		startcam cs16_08
	}

	trigger cam9
	{
		startcam cs16_09
	}

	trigger cam10
	{
		startcam cs16_10
	}

	trigger cam10d
	{
		startcam cs16_10d
	}

	trigger cam11
	{
		startcam cs16_11
	}
	trigger cam12
	{
		startcam cs16_12
	}

	trigger cam13
	{
		startcam cs16_13
	}

	trigger cam14
	{
		startcam cs16_14
	}

	trigger cam15
	{
		startcam cs16_15
	}

	trigger camerainterrupt
	{
		accum 0 abort_if_bitset 0
		trigger counter1 cine1_cleanup
		stopcam			
	}

	trigger 0bitset0
	{
		accum 0 bitset 0
		mu_fade 0 1000
		mu_queue sound/music/c_atmos
		wait 8000
		notarget on
	}
	
	trigger bg_run 
	{
	   alertentity bg_run1
	   alertentity bg_run2
	}

	trigger action1
	{
		trigger heinrich begin
		trigger pillar1 swing
		trigger rope1 swing
		alertentity dark4
		alertentity dark5
		alertentity dark6
		alertentity killknights
		
		wait 1000 
 savecheckpoint
	}

	trigger rocksfall
	{
		alertentity rocksfall
	}

	trigger rubblefall1
	{
		mu_fade 0 1000
		mu_queue sound/music/m_darktension
		trigger rubble1 begin
	}

	trigger pillar1fall
	{
		trigger pillar1 fall
	}

	trigger changelevel
	{
		achievement_chapter7
		#if g_gameskill >= 3
		achievement_chapter7_hard
		#endif
		// Bonus modes achievements
		achievement_ironman
		achievement_hardcore
		achievement_999
		achievement_nightmare
		achievement_walkinthepark
		changelevel cutscene19 5 silent 
	}

	death
	{
		trigger counter1 deathreset
	}
}

ps1
{

	attributes
	{
		headlook off
		starting_health 5
		aim_accuracy 1.0
		aggression 1.0
		camper 0.0
		tactical 0.0
		reaction_time 1.0
		aim_skill 1.0
	}

	spawn
	{
		wait 5
		headlook off
		nosight 99999
		takeweapon all
		knockback off
	}

	trigger go1
	{
	}

	trigger go2
	{
		walktomarker t691		// ps1spot2
	}

	trigger anim1a
	{
		playanim idle both 
	}

	trigger anim1
	{

		nosight 99999
		playanim stuff both //forever
	}

	trigger anim2
	{

		playanim bow both //forever
	}

	trigger talk1		// Yes yes
	{
		playsound end_cs16_pri_01_1
	}

	trigger talk2		// Yes it is true
	{
		nosight 99999
		playsound end_cs16_pri_02_6
	}

	trigger talk3		// I serve you my dark msater
	{
		playsound end_cs16_pri_03_7 
	}

	trigger talk4		// Ahahahaha
	{
		playsound end_cs16_pri_04_a
		alertentity spirit4
	}

	trigger talk5
	{
		playsound end_eg_solo_loop
	}

	trigger talk6
	{
		playsound  end_liftup
		wait 4000
	}

	trigger talk6_stop
	{
		playsound  blank
	}

 	enemysight
	{
		resetscript
	}

	death
	{
	}
}

