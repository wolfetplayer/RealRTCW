		playanim powered_down both forever
		setmovespeed fast
	}

	trigger anim1
	{
		clearanim
		playanim come_alive both forever
	}

	trigger talk1
	{
		playsound end_ss_powerup
	}

	trigger pain
	{
		playanim pain_ceremony both
		playanim asleep both forever
	}
}

