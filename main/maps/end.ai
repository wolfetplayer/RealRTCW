heinrich
{

	attributes
	{
		alertness 50000
		aim_accuracy 1.0
		aggression 1.0
		camper 0.0
		tactical 0.0
		reaction_time 0.1
		aim_skill 1.0
		fov 360
		statetype alert
	}

	spawn
	{
		nosight 99999
		knockback off
		noavoid off
		takeweapon monsterattack2
		trigger heinrich still
	}

	trigger sight_on 
	{
		sight
	}

	trigger quake
	{
		alertentity rocksfall
	}
	
	trigger still
	{
		playanim lift_still both
		trigger heinrich still
	}

	trigger anim1a		// newly added by jeremy for break up of animations
	{
		playanim lift both holdframe
	}

	trigger anim1
	{
		playanim alive both //holdframe
	}

	trigger anim2
	{
		playanim laughing both
	}

	trigger anim3
	{
		playanim who_are_you both
	}

	trigger anim4_reset
	{
		clearanim
	}


	trigger talk1		//  I live
	{
		playsound end_cs16_hei_01
	}

	trigger talk2		//  who are you
	{
		playsound end_cs16_hei_03 
	}

	trigger talk3		// Rargh
	{
    		playsound end_heinr127
	}

	trigger talk4		// So much to tend to 
	{
		playsound end_cs16_hei_05_4
	}

	trigger begin
	{
		explicit_routing on
		sight
		runtomarker hspot1
		gotocast player
	}

	trigger warzombiedead
	{
  		  accum 1 inc 1
  		  accum 1 abort_if_less_than 3
  		  giveweapon monsterattack2
  		  accum 1 set 0
	}
	
	pain 4000
	{
		alertentity bg1
		alertentity bg5
		alertentity bg9
	}

	pain 3000
	{
		alertentity bg2
		alertentity bg6
		alertentity bg10
		alertentity bg13
	}

	pain 2000
	{
		alertentity bg3
		alertentity bg7
		alertentity bg11
	}

	pain 1000
	{
		alertentity bg4
		alertentity bg8
		alertentity bg12
	}

 	enemysight
	{
		resetscript
	}

	death
	{
		trigger player 0bitset0
		achievement_boss3
		objectivemet 1	// mission objective complete
		trigger counter1 himmler_cine1
	}
}


