//
//AI Scripting
//Map: Malta_1 (after BOSS1)
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
	    objectivesneeded 2
		accum 0 bitreset 0	// Used to wait a few seconds before you are able to skip cinematic.
		accum 0 bitset 2
		accum 0 bitreset 3
		accum 1 set 0   // used for NPC random dialogue lines
		accum 2 set 0   // used for anims
		accum 3 set 0   // used for weapon loadout
		accum 4 set 0   // interrupt dialogue with colonel
		accum 5 set 0   // interrupt waters
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1000
		mu_stop 0 2000
		takeweapon all
		giveinventory key_binocs
		cvar cg_coronafardist 1024
	}
	
	trigger enable_timer
	{
	   trigger timer time_start
	}
	
	trigger bm_teleport
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport teleport_end
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	}
	
    trigger bm_teleport2
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport teleport_end2
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	}
	
	trigger sleepy
	{
	    lockplayer on
		screenfade 6000 in
		wait 12000
		sethealth 100
		teleport teleport_prison
		lockplayer off
		screenfade 6000 out
		setmovespeed veryslow
	}
	
	trigger dream_land_escape
	{
	   lockplayer on
	   screenfade 3000 in
	   wait 6000
	   teleport teleport_bed
	   lockplayer off
	   screenfade 3000 out
	   setmovespeed default
	   achievement_malta_nightmare
	}
	
	trigger briefing_1
	{
		trigger boss brief_player
		//lockplayer on
		//wait 40000
		//lockplayer off
	}
	
	trigger lock_waters
	{
	    //lockplayer on
		//wait 27000
		//lockplayer off
	}
	
	trigger leap_of_faith
	{
	    achievement_malta_leap
	}
	
    trigger player_using_radio
    {
        trigger radio static
    }

	trigger player_using_radio_cafe
    {
        trigger radio_cafe static
		trigger bar_guy1 stop_it
    }
	
	trigger disable_timer
	{
	   trigger timer time_stop
	   achievement_malta_course
	}
	
	trigger give_me_your_weapons
	{
	    takeweapon all
	}
	
	trigger take_knives
	{
	    takeweapon all
	}
	
	trigger planes_flyby
	{
		trigger plane_no1 cycle1
		trigger plane_no2 cycle2
		alertentity planes_sound
	}
	
	trigger took_key
	{
	   alertentity unlock_room
	}
	
	trigger e1_toggle_upbtn	// This triggers while the player is NOT on the elevator.
	{
		trigger e1upbtn toggle
	}

	trigger e1_toggle_dwnbtn	// This triggers while the player is NOT on the elevator.
	{
		trigger e1dwnbtn toggle
	}

	trigger e1lever1_toggle
	{
		trigger e1lever1 toggle
	}

	trigger e1_downlever
	{
		accum 0 abort_if_not_bitset 2
		trigger e1lever1 toggle
	}

	trigger enable_e1downlever
	{
		accum 0 bitset 2
	}

	trigger disable_e1downlever
	{
		accum 0 bitreset 2
	}

	trigger e1_uplever
	{
		accum 0 abort_if_not_bitset 3
		trigger e1lever1 toggle
	}

	trigger enable_e1uplever
	{
		accum 0 bitset 3
	}

	trigger disable_e1uplever
	{
		accum 0 bitreset 3
	}
	
    trigger package_taken
	{
		objectivemet 1
		accum 4 set 1
	}
	
	trigger armory_start
	{
		trigger waters greetings
	}
	
	trigger select_loadout_1
	{
	    accum 3 set 1
		accum 5 set 1
		objectivemet 2
		trigger waters goodtogo
	}
	
	trigger select_loadout_2
	{
	    accum 3 set 2
		accum 5 set 1
		objectivemet 2
		trigger waters goodtogo
	}
	
	trigger give_loadout_1
	{
		accum 3 abort_if_not_equal 1
		
		#if g_fullarsenal == 0
        applyloadout forest_vanilla_1
		#endif

		#if g_fullarsenal == 1
        applyloadout forest_realrtcw_1
		#endif
		
		#if g_fullarsenal == 2
        applyloadout forest_vanilla_shotgun_1
		#endif
		
	}
	
	trigger give_loadout_2
	{
		accum 3 abort_if_not_equal 2
		
		#if g_fullarsenal == 0
        applyloadout forest_vanilla_2
		#endif

		#if g_fullarsenal == 1
        applyloadout forest_realrtcw_2
		#endif
		
		#if g_fullarsenal == 2
        applyloadout forest_vanilla_shotgun_2
		#endif
		
	}
	
	trigger shocktreatment
	{
		trigger handle turnon
		//accum 0 abort_if_bitset 4
	}
	
	trigger dream_reinforce
	{
	   alertentity dream_nazi1
	   alertentity dream_nazi2
	   alertentity dream_nazi3
	   alertentity dream_nazi4
	   alertentity dream_eg1
	   alertentity dream_eg2
	   alertentity dream_hunter
	}
	
	trigger secret1
	{
	   foundsecret
	}
	
	trigger endmap
	{
		trigger player give_loadout_1
		trigger player give_loadout_2
		changelevel forest persistent
	}


}

//Black Market//

black_market_grunt1
{
	attributes
	{
	}

	spawn
	{
		takeweapon all	
		statetype relaxed
		wait 1000
	}
	
	activate player
    {
	   deny
    }

    trigger exit_the_bar
    {
	   walktomarker black_spot1
	   facetargetangles black_spot1
	   wait 2500
	   trigger black_market_grunt1 walkaway
	}
	
	trigger walkaway
	{
	    explicit_routing on
		walktomarker black_spot2
		walktomarker black_spot3
		walktomarker black_spot4
	    walktomarker black_spot5
		explicit_routing off
		wait 5000
		alertentity kill_grunt_script
	}
        	   
	
	enemysight
	{
	    deny
	}

	inspectsoundstart
	{
		clearanim
	}
	
	bulletimpact
	{
		deny
	}

	inspectsoundend
	{
	    deny
	}

	inspectbodystart
	{
	    deny
	}

	inspectbodyend
	{
	   deny
	}

	statechange query alert	
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
	    missionfailed 5 10
	}
}

//Civilians//

bartender
{
	attributes
	{
	}

	spawn
	{
		takeweapon all	
		statetype relaxed
		wait 1000
		trigger bartender cook
	}
	
	trigger check_speech
	{
	   accum 1 abort_if_not_equal 3
	   accum 1 set 0
	}
	
	trigger cook
	{
	   playanim cutting_food both holdframe forever
	}

	trigger welcome_bar
	{
	   playsound bartender_welcome // "Welcome!"
	   wait 5000
	   trigger bartender cook
	}
	
	trigger dialogue1 // starting banter with thug
	{
	  wait 3000
	  playsound bart_out // "I dont care about your bloody warnings! Get out!"
	  wait 2500
	  trigger black_market_grunt1 exit_the_bar
	  trigger bartender cook
	}
	
	trigger back_off
	{
	   wait 1000
	   face_entity player
	   wait 1000
	   playsound bart_back // "Back off pal!"
	   wait 3000
	   facetargetangles bart_spot2
	   resetscript
	   wait 5000
	   trigger bartender cook
	   wait 5000
	   achievement_malta_bartender
	}
	
	activate player
    {
	  trigger bartender check_speech
	  accum 1 inc 1
	  trigger bartender talk1
	  trigger bartender talk2
	  trigger bartender talk3
	  wait 0
    }	  
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  face_entity player
	  playsound bart_name // "My name is Evie"
	  wait 8000
	  facetargetangles bart_spot2
	  trigger bartender cook
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  face_entity player
	  playsound bart_new // "Are you new here?"
	  wait 4000
	  facetargetangles bart_spot2
	  trigger bartender cook
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  face_entity player
	  playsound bart_sleep // "If you are looking for a place to sleep - you can check out the hotel on the opposite side of the street."
	  wait 8000
	  facetargetangles bart_spot2
	  trigger bartender cook
	}
	
	enemysight
	{
	    deny
	}

	inspectsoundstart
	{
		clearanim
	}
	
	bulletimpact
	{
		deny
	}

	inspectsoundend
	{
	    deny
	}

	inspectbodystart
	{
	    deny
	}

	inspectbodyend
	{
	   deny
	}

	statechange query alert	
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
	    missionfailed 5 10
	}
}

