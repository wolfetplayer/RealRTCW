	trigger results
    {
	  wait 2000
	  accum 1 random_no_zero 5
	  trigger course_sarge talk1
	  trigger course_sarge talk2
	  trigger course_sarge talk3
	  trigger course_sarge talk4
    }	
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  playsound course_ok // "You looked ok"
	  face_entity player
	  wait 5000
	  facetargetangles sarge_spot2
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  playsound course_horrible // "Wasnt horrible"
	  face_entity player
	  wait 5000
	  facetargetangles sarge_spot2
	}
	
