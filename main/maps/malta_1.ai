course_sarge
{
	attributes
	{
	}

	spawn
	{
		takeweapon all
		statetype relaxed
		wait forever
	}

    trigger welcome
    {
      wait 1000
      playsound course_welcome
	  face_entity player
	  wait 5000
	  facetargetangles sarge_spot2
