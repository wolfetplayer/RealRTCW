boss
{
	attributes
	{
	}

	spawn
	{
		takeweapon all
		statetype relaxed
		wait 1000
	}

    activate player
    {
	  trigger boss check_speech
	  accum 1 inc 1
	  trigger boss talk1
	  trigger boss talk2
	  trigger boss talk3
	  trigger boss talk4
    }
	
	trigger brief_player
	{
	   accum 4 abort_if_equal 1
	   playsound col_namepresume 
	   wait 3000
	   trigger boss brief_player2
	}
	
	trigger brief_player2
	{
	   accum 4 abort_if_equal 1
	   playsound col_mynameis 
	   wait 4500
	   playsound col_mynameis2
       wait 7500	   
	   trigger boss brief_player3
	}
	
	trigger brief_player3
	{
	   accum 4 abort_if_equal 1
	   playsound col_brief1
	   wait 8500
	   playsound col_brief12
	   wait 7500
	   playsound col_brief13
	   wait 7500
	   trigger boss brief_player4
	}
	
	trigger brief_player4
	{
	   accum 4 abort_if_equal 1
	   playsound col_godspeed
	}
	
	trigger check_speech
	{
	   accum 1 abort_if_not_equal 4
	   accum 1 set 0
	}
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  playsound col_hell 
	  wait 2000
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  playsound col_watershelp 
	  wait 2000
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  playsound col_frank 
	  wait 2000
	}
	
	trigger talk4
	{
	  accum 1 abort_if_not_equal 4
	  playsound col_blazko? 
	  wait 2000
	}
	
