doc
{

	attributes
	{
	}

	spawn
	{
		takeweapon all
		statetype relaxed
		wait 1000
		trigger doc animloop
	}

	trigger check_speech
	{
	   accum 1 abort_if_not_equal 3
	   accum 1 set 0
	}	
	
	trigger animloop
	{
		nosight 99999
		playanim pointing both holdframe forever
	}
	
    activate player
    {
	  trigger doc check_speech
	  accum 1 inc 1
	  trigger doc talk1
	  trigger doc talk2
	  trigger doc talk3
    }	  
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  playsound doc_touch // "Please, dont touch anything here."
	  wait 2000
	  trigger doc animloop
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  playsound doc_busy // "Sorry, Captain, I'm too busy right now. Please, go bother someone else."
	  wait 2000
	  trigger doc animloop
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  playsound doc_syringes // "If you need any syringes - you can take it in the next room."
	  wait 2000
	  trigger doc animloop
	}	

	enemysight
	{
		deny
	}

