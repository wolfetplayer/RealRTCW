//
//AI Scripting
//Map: Malta_2 (after ASSAULT)
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
	    objectivesneeded 2
		accum 0 bitreset 0	// Used to wait a few seconds before you are able to skip cinematic.
		accum 0 bitset 2
		accum 0 bitreset 3
		accum 1 set 0   // used for NPC random dialogue lines
		accum 2 set 0   // used for anims
		accum 3 set 0   // used for weapon loadout
		accum 4 set 0   // interrupt dialogue with colonel
		accum 5 set 0   // interrupt waters
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1000
		mu_stop 0 2000
		takeweapon all
		giveinventory key_binocs
		cvar cg_coronafardist 1024
	}
	
	trigger enable_timer
	{
	   trigger timer time_start
	}
	
	trigger leap_of_faith
	{
	    achievement_malta_leap
	}
	
	trigger black_goat
	{
	    achievement_malta_goat
    }
	
	trigger bm_teleport
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport teleport_end
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	}
	
    trigger bm_teleport2
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport teleport_end2
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	}
	
	trigger balcony_tp
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport balcony_destination
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	}
	
	trigger balcony_tp_out
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport balcony_destination_out
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	   alertentity kill_jack_script
	   achievement_malta_osa
	}
	
	trigger sleepy
	{
	    lockplayer on
		screenfade 5000 in
		wait 15000
		sethealth 100
		lockplayer off
		screenfade 5000 out
	}
	
	trigger briefing_1
	{
		trigger boss brief_player
		//lockplayer on
		//wait 30000
		//lockplayer off
	}
	
	trigger lock_waters
	{
	    //lockplayer on
		//wait 13000
		//lockplayer off
	}
	
    trigger player_using_radio
    {
        trigger radio static
    }

	trigger player_using_radio_cafe
    {
        trigger radio_cafe static
		trigger bar_guy1 stop_it
    }
	
	trigger disable_timer
	{
	   trigger timer time_stop
	   achievement_malta_course
	}
	
	trigger give_me_your_weapons
	{
	    takeweapon all
	}
	
	trigger take_knives
	{
	    takeweapon all
	}
	
	trigger planes_flyby
	{
		trigger plane_no1 cycle1
		trigger plane_no2 cycle2
		alertentity planes_sound
	}
	
	trigger took_key
	{
	   alertentity unlock_room
	}
	
	trigger e1_toggle_upbtn	// This triggers while the player is NOT on the elevator.
	{
		trigger e1upbtn toggle
	}

	trigger e1_toggle_dwnbtn	// This triggers while the player is NOT on the elevator.
	{
		trigger e1dwnbtn toggle
	}

	trigger e1lever1_toggle
	{
		trigger e1lever1 toggle
	}

	trigger e1_downlever
	{
		accum 0 abort_if_not_bitset 2
		trigger e1lever1 toggle
	}

	trigger enable_e1downlever
	{
		accum 0 bitset 2
	}

	trigger disable_e1downlever
	{
		accum 0 bitreset 2
	}

	trigger e1_uplever
	{
		accum 0 abort_if_not_bitset 3
		trigger e1lever1 toggle
	}

	trigger enable_e1uplever
	{
		accum 0 bitset 3
	}

	trigger disable_e1uplever
	{
		accum 0 bitreset 3
	}
	
    trigger package_taken
	{
		objectivemet 1
		accum 4 set 1
	}
	
	trigger armory_start
	{
		trigger waters greetings
		trigger player lock_waters
	}
	
	trigger select_loadout_1
	{
	    accum 3 set 1
		objectivemet 2
		trigger waters goodtogo
	}
	
	trigger select_loadout_2
	{
	    accum 3 set 2
		objectivemet 2
		trigger waters goodtogo
	}
	
	trigger give_loadout_1
	{
	     accum 3 abort_if_not_equal 1

		#if g_fullarsenal == 0
        applyloadout sfm_vanilla_1
		#endif

		#if g_fullarsenal == 1
        applyloadout sfm_realrtcw_1
		#endif
		
		#if g_fullarsenal == 2
        applyloadout sfm_vanilla_shotgun_1
		#endif
	}
	
	trigger give_loadout_2
	{
	     accum 3 abort_if_not_equal 2
		 
		#if g_fullarsenal == 0
        applyloadout sfm_vanilla_2
		#endif

		#if g_fullarsenal == 1
        applyloadout sfm_realrtcw_2
		#endif
		
		#if g_fullarsenal == 2
        applyloadout sfm_vanilla_shotgun_2
		#endif
	}
	
	trigger secret1
	{
	    foundsecret
		achievement_malta_firefly
	}
	
	trigger endmap
	{
		trigger player give_loadout_1
		trigger player give_loadout_2
		changelevel sfm persistent
	}


}

//Civilians//

bartender
{
	attributes
	{
	}

	spawn
	{
		takeweapon all	
		statetype relaxed
		wait 1000
		trigger bartender cook
	}
	
	trigger check_speech
	{
	   accum 1 abort_if_not_equal 3
	   accum 1 set 0
	}
	
	trigger cook
	{
	   playanim cutting_food both holdframe forever
	}

	trigger welcome_bar
	{
	   playsound bart_leaving // "Are you waiting for someone? I wanna close early today."
	   wait 5000
	   trigger bar_guy1 just_a_min
	   trigger bartender cook
	}
	
	trigger welcome_bar2
	{
	   playsound bart_another // "Another one.."
	   wait 3000
	   trigger bartender cook
	}
	
	trigger back_off
	{
	   wait 1000
	   face_entity player
	   wait 1000
	   playsound bart_back // "Back off pal!"
	   achievement_malta_bartender
	   wait 3000
	   facetargetangles bart_spot2
	   resetscript
	   wait 5000
	   trigger bartender cook
	}
	
	activate player
    {
	  trigger bartender check_speech
	  accum 1 inc 1
	  trigger bartender talk1
	  trigger bartender talk2
	  trigger bartender talk3
	  wait 0
    }	  
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  face_entity player
	  playsound bart_name // "My name is Evie"
	  wait 8000
	  facetargetangles bart_spot2
	  trigger bartender cook
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  face_entity player
	  playsound bart_new // "Are you new here?"
	  wait 4000
	  facetargetangles bart_spot2
	  trigger bartender cook
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  face_entity player
	  playsound bart_sleep // "If you are looking for a place to sleep - you can check out the hotel on the opposite side of the street."
	  wait 8000
	  facetargetangles bart_spot2
	  trigger bartender cook
	}
	
	enemysight
	{
	    deny
	}

	inspectsoundstart
	{
		clearanim
	}
	
	bulletimpact
	{
		deny
	}

	inspectsoundend
	{
	    deny
	}

	inspectbodystart
	{
	    deny
	}

	inspectbodyend
	{
	   deny
	}

	statechange query alert	
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
	    missionfailed 5 10
	}
}

