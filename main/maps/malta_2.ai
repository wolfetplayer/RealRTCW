doc
{

	attributes
	{
	}

	spawn
	{
		takeweapon all
		statetype relaxed
		wait 1000
		trigger doc patrol
	}

	trigger check_speech
	{
	   accum 1 abort_if_not_equal 3
	   accum 1 set 0
	}	
	
	trigger hey_cap
	{
	  face_entity player
	  wait 500
	  playsound doc_heycap
	  wait 8000
	  trigger doc patrol
	}
	
	trigger patrol
	{
	   wait 1000
	   explicit_routing on
	   walktomarker doc_spot1
	   walktomarker doc_spot2
	   walktomarker doc_spot3
	   facetargetangles doc_spot3
	   explicit_routing off
	   playsound doc_where
	   wait 1000
	   trigger doc patrol
	}
	
    activate player
    {
	  trigger doc check_speech
	  accum 1 inc 1
	  trigger doc talk1
	  trigger doc talk2
	  trigger doc talk3
    }	  
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  face_entity player
	  playsound doc_off // "Get off me!"
	  wait 2000
	  trigger doc patrol
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  face_entity player
	  playsound doc_cant // "Cant you see I'm busy?"
	  wait 2000
	  trigger doc patrol
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  face_entity player
	  playsound doc_myself // "No,you cant help me. I will find it by myself."
	  wait 2000
	  trigger doc patrol
	}

	enemysight
	{
		deny
	}

