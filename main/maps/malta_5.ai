	trigger introduction
	{
	  playsound gimmewp_intro // "Welcome to the training facility, Captain."
	  face_entity player
	  wait 5000
      facetargetangles gimmewp_spot1
	  achievement_training
	}
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  playsound gimmewp_lt // "Leitanant McDermott is in the next section. He will guide you through our new course."
	  face_entity player
	  wait 5000
	  facetargetangles gimmewp_spot1
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  playsound gimmewp_justdont // "Sorry Captain, but you cant take those weapons outside this facility."
	  face_entity player
	  wait 5000
	  facetargetangles gimmewp_spot1
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  playsound gimmewp_resupply // "If you wanna resupply - use the ammo cabinet."
	  face_entity player
	  wait 5000
	  facetargetangles gimmewp_spot1
	}
	
	enemysight
	{
	    deny
