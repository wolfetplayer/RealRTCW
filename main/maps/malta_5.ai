//Military//

boss
{
	attributes
	{
	}

	spawn
	{
		takeweapon all
		statetype relaxed
		wait 1000
	}
	
	trigger check_speech
	{
	   accum 1 abort_if_not_equal 4
	   accum 1 set 0
	}


    activate player
    {
	  trigger boss check_speech
	  accum 1 inc 1
	  trigger boss talk1
	  trigger boss talk2
	  trigger boss talk3
	  trigger boss talk4
	  wait 0
    }
	
	trigger captain
	{
	   playsound col_blazko? // "Hey,BJ"
	}
	   
	   
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  playsound col_stayput // "Stay put, Captain. I'm pretty sure you will recieve new assignment soon."
	  wait 2000
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  playsound col_nonews // "No news from the OSA Headquarters. You are on R&R for now, Blazkowitz."
	  wait 2000
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  playsound col_italy // "Have you heard the news? We almost kicked out the Rommel out of Africa! I even heard some talks about invasion in Italy."
	  wait 2000
	}
	
	trigger talk4
	{
	  accum 1 abort_if_not_equal 4
	  playsound col_blazko? 
	  wait 2000
	}
	
	enemysight
	{
	    deny
	}

	inspectsoundstart
	{
		clearanim
	}
	
	bulletimpact
	{
		deny
	}

	inspectsoundend
	{
	    deny
	}

	inspectbodystart
	{
	    deny
	}

	inspectbodyend
	{
	   deny
	}

	statechange query alert	
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
		missionfailed 5 10
	}
}

