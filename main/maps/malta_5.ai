//
//AI Scripting
//Map: Malta_4 (after boss2)
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
	    objectivesneeded 0
		accum 0 bitreset 0	// Used to wait a few seconds before you are able to skip cinematic.
		accum 0 bitset 2
		accum 0 bitreset 3
		accum 1 set 0   // used for NPC random dialogue lines
		accum 2 set 0   // used for anims
		accum 3 set 0   // used for weapon loadout
		accum 4 set 0   // interrupt dialogue with colonel
		accum 5 set 0   // interrupt waters
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1000
		mu_stop 0 2000
		takeweapon all
		giveinventory key_binocs
	}
	
	trigger planes_flyby
	{
		trigger plane_no1 cycle1
		trigger plane_no2 cycle2
		alertentity planes_sound
	}
	
	trigger enable_timer
	{
	   trigger timer time_start
	}
	
	trigger bm_teleport
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport teleport_end
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	}
	
    trigger bm_teleport2
	{
	   lockplayer on
	   screenfade 6000 in
	   wait 10000
	   teleport teleport_end2
	   wait 2000
	   lockplayer off
	   screenfade 6000 out
	}
	
	trigger sleepy
	{
	    lockplayer on
		screenfade 5000 in
		wait 15000
		sethealth 100
		lockplayer off
		screenfade 5000 out
	}
	
	trigger briefing_1
	{
		trigger boss brief_player
		lockplayer on
		wait 40000
		lockplayer off
	}
	
	trigger lock_waters
	{
	    lockplayer on
		wait 15000
		lockplayer off
	}
	
	trigger lair
	{
	   achievement_malta_lair
	}
	
    trigger player_using_radio
    {
        trigger radio static
    }

	trigger player_using_radio_cafe
    {
        trigger radio_cafe static
		trigger bar_guy1 stop_it
    }
	
	trigger disable_timer
	{
	   trigger timer time_stop
	   achievement_malta_course
	}
	
	trigger give_me_your_weapons
	{
	    takeweapon all
	}
	
	trigger take_knives
	{
	    takeweapon all
	}
	
	trigger planes_flyby
	{
		trigger plane_no1 cycle1
		trigger plane_no2 cycle2
		alertentity planes_sound
	}
	
	trigger boat_goaway
	{
		alertentity escapeboat
		trigger escapeboat cycle1
	}
	
	trigger took_key
	{
	   alertentity unlock_room
	}
	
	trigger e1_toggle_upbtn	// This triggers while the player is NOT on the elevator.
	{
		trigger e1upbtn toggle
	}

	trigger e1_toggle_dwnbtn	// This triggers while the player is NOT on the elevator.
	{
		trigger e1dwnbtn toggle
	}

	trigger e1lever1_toggle
	{
		trigger e1lever1 toggle
	}

	trigger e1_downlever
	{
		accum 0 abort_if_not_bitset 2
		trigger e1lever1 toggle
	}

	trigger enable_e1downlever
	{
		accum 0 bitset 2
	}

	trigger disable_e1downlever
	{
		accum 0 bitreset 2
	}

	trigger e1_uplever
	{
		accum 0 abort_if_not_bitset 3
		trigger e1lever1 toggle
	}

	trigger enable_e1uplever
	{
		accum 0 bitset 3
	}

	trigger disable_e1uplever
	{
		accum 0 bitreset 3
	}
	
    trigger package_taken
	{
		objectivemet 1
		accum 4 set 1
	}
	
	trigger armory_start
	{
		trigger waters greetings
		trigger player lock_waters
	}
	
	trigger select_loadout_1
	{
	    accum 3 set 1
		objectivemet 2
		trigger waters goodtogo
	}
	
	trigger select_loadout_2
	{
	    accum 3 set 2
		objectivemet 2
		trigger waters goodtogo
	}
	
	trigger give_loadout_1
	{
	    accum 3 abort_if_not_equal 1
		#if g_fullarsenal == 0
		// weapons
		giveweapon weapon_knife
		giveweapon weapon_knife
		giveweapon weapon_knife

		giveweapon weapon_colt
		giveweapon weapon_colt

		giveweapon weapon_thompson

		giveweapon weapon_snooperrifle

		giveweapon weapon_venom
		giveweapon weapon_flamethrower
		
		// ammo
		setammo ammo_45cal full
		setammo ammo_grenades_american 5
		setammo ammo_fuel full
		setammo ammo_127mm 300
		setammo ammo_30cal full
		
		// misc
		setarmor 100
		giveinventory key_binocs
		setclip weapon_colt full
		setclip weapon_akimbo full
		setclip weapon_venom 200
		setclip weapon_thompson full
		setclip weapon_snooperrifle full
		selectweapon weapon_thompson
		#endif

		#if g_fullarsenal == 1
		// weapons
		giveweapon weapon_knife
		giveweapon weapon_knife
		giveweapon weapon_knife

		giveweapon weapon_colt
		giveweapon weapon_colt

		giveweapon weapon_sten

		giveweapon weapon_snooperrifle

		giveweapon weapon_m97

		giveweapon weapon_venom
		giveweapon weapon_flamethrower
		
		// ammo
		setammo ammo_45cal 128
		setammo ammo_9mm 250
		setammo ammo_m97ammo 40
		setammo ammo_fuel full
		setammo ammo_30cal full
		setammo ammo_127mm 300
		setammo ammo_grenades_american 5
		setammo ammo_poison_gas 5
		
		// misc
		setarmor 100
		giveinventory key_binocs
		setclip weapon_colt full
		setclip weapon_akimbo full
		setclip weapon_m97 full
		setclip weapon_sten full
		setclip weapon_venom 200
		setclip weapon_snooperrifle full
		selectweapon weapon_sten
		#endif

		#if g_dlc1 == 1
		takeweapon weapon_m97

		giveweapon weapon_auto5
		giveweapon weapon_delisle
		giveweapon weapon_m1941
		giveweapon weapon_m1941scope

		setammo ammo_m97ammo 50
		setammo ammo_45cal 200
		setammo ammo_m1941 full

		setclip weapon_auto5 full
		setclip weapon_delisle full
		setclip weapon_m1941 full
		setclip weapon_m1941scope full

		selectweapon weapon_delisle
		#endif
	}
	
	trigger give_loadout_2
	{
	    accum 3 abort_if_not_equal 2
		 
		 #if g_fullarsenal == 0
		// weapons
		giveweapon weapon_knife
		giveweapon weapon_knife
		giveweapon weapon_knife

		giveweapon weapon_colt
		giveweapon weapon_colt

		giveweapon weapon_sten

		giveweapon weapon_snooperrifle

		giveweapon weapon_tesla
		giveweapon weapon_panzerfaust
		
		// ammo
		setammo ammo_45cal 120
		setammo ammo_9mm 128
		setammo ammo_30cal full
		setammo ammo_127mm 500
		setammo ammo_grenades_american 5
		setammo ammo_panzerfaust full
		setammo ammo_cell full
		
		// misc
		setarmor 100
		giveinventory key_binocs
		setclip weapon_colt full
		setclip weapon_akimbo full
		setclip weapon_sten full
		setclip weapon_snooperrifle full
		setclip weapon_panzerfaust 1
		selectweapon weapon_venom
		#endif
		 
		 
		#if g_fullarsenal == 1
		// weapons
		giveweapon weapon_knife
		giveweapon weapon_knife
		giveweapon weapon_knife

		giveweapon weapon_colt
		giveweapon weapon_colt

		giveweapon weapon_sten

        giveweapon weapon_snooperrifle

		giveweapon weapon_m97

		giveweapon weapon_tesla
		giveweapon weapon_panzerfaust
		
		// ammo
		setammo ammo_45cal 128
		setammo ammo_9mm 250
		setammo ammo_m97ammo 40
		setammo ammo_cell full
		setammo ammo_panzerfaust full
		setammo ammo_30cal full
		setammo ammo_grenades_american 5
		setammo ammo_poison_gas 5
		
		// misc
		setarmor 100
		giveinventory key_binocs
		setclip weapon_colt full
		setclip weapon_akimbo full
		setclip weapon_m97 full
		setclip weapon_panzerfaust 1
		setclip weapon_sten full
		setclip weapon_snooperrifle full
		selectweapon weapon_sten
		#endif

		#if g_dlc1 == 1
		takeweapon weapon_m97

		giveweapon weapon_auto5
		giveweapon weapon_delisle
		giveweapon weapon_m1941
		giveweapon weapon_m1941scope

		setammo ammo_m97ammo 50
		setammo ammo_45cal 200
		setammo ammo_m1941 full

		setclip weapon_auto5 full
		setclip weapon_delisle full
		setclip weapon_m1941 full
		setclip weapon_m1941scope full

		selectweapon weapon_delisle
		#endif
	
	}
	
	trigger secret1
	{
	    foundsecret
	}
	
	trigger rug_run
	{
	   alertentity rug_dealer
	}
	
	trigger endmap
	{
		changelevel
		wait 9000
	}


}

//Civilians//

bartender
{
	attributes
	{
	}

	spawn
	{
		takeweapon all	
		statetype relaxed
		wait 1000
		trigger bartender cook
	}
	
	trigger cook
	{
	   playanim cutting_food both holdframe forever
	}
	
	trigger back_off
	{
	   wait 1000
	   face_entity player
	   wait 1000
	   playsound bart_back // "Back off pal!"
	   wait 3000
	   facetargetangles bart_spot2
	   resetscript
	   wait 5000
	   trigger bartender cook
	   wait 5000
	   achievement_malta_bartender
	}
	
	trigger medic_response
	{
	   face_entity medic
	   playsound bart_water
	   wait 5200
	   trigger medic response
	   trigger bartender cook
	}
	
	activate player
    {
	  trigger bartender check_speech
	  accum 1 inc 1
	  trigger bartender talk1
	  trigger bartender talk2
	  trigger bartender talk3
	  wait 0
    }	  
	
	trigger talk1
	{
	  accum 1 abort_if_not_equal 1
	  playsound bart_beer 
	  wait 2000
	  trigger bartender cook
	}
	
	trigger talk2
	{
	  accum 1 abort_if_not_equal 2
	  playsound bart_sleep
	  wait 2000
	  trigger bartender cook
	}
	
	trigger talk3
	{
	  accum 1 abort_if_not_equal 3
	  playsound bart_get
	  wait 2000
	  trigger bartender cook
	}
	
	enemysight
	{
	    deny
	}

	inspectsoundstart
	{
		clearanim
	}
	
	bulletimpact
	{
		deny
	}

	inspectsoundend
	{
	    deny
	}

	inspectbodystart
	{
	    deny
	}

	inspectbodyend
	{
	   deny
	}

	statechange query alert	
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
	    missionfailed 5 10
	}
}

