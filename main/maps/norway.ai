radio_nazi1				// this is back up gaurds who come out of 2nd radio house...
{
	attributes
	{
		tactical 1.0
		aggression 0.2
		camper 1.0
		inner_detection_radius 200
		alertness 2300		
	}

	spawn
	{
		#if g_fullarsenal == 0
		giveweaponfull weapon_fg42
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_fg42
	    #endif
		trigger checker1 radio_nazi1_activated
		trigger radio_nazi1 check_alarm_situation
	}

	trigger check_alarm_situation
	{
		trigger checker1 alive_check_in
		trigger checker1 alarm_on_response
		trigger checker1 alarm_off_response
	}
	
	trigger alarm_on_response		// this needs to be changed to only if alarm on mode..	
	{
		statetype alert
		runtomarker rn1spot1 nostop
		runtomarker rn1spot2 nostop
		runtomarker rn1spot3 nostop
		runtomarker rn1spot4
	}

	trigger activator_of_alarm  		// This will happen if alarm is off..
	{
	//	print RUNNING TO ALARM ON
		runtomarker rn1on_radio1
		trigger checker1 radio2_destroyed_response
	}

	trigger turn_alarm_on
	{
		alertentity alarm_sound
		trigger checker1 alarm_on
		trigger radio_nazi1 alarm_on_response  // He will use this once the alarm is on
	}

	trigger alarm_destroyed
	{
		wait 2000 player
		resetscript
	}

	trigger alarm_off_response  		// This will happen if the alarm is off  // TO DO !!!!
	{
		takeweapon all
		walktomarker rn1on_radio1
		facetargetangles rn1on_radio1
		trigger radio_nazi1 anim_loop
	}

	trigger anim_loop
	{
		playanim looking_over_table both
		wait 3000
		playanim looking_over_table both
		wait 6000
		trigger radio_nazi1 anim_loop
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		clearanim
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	statechange query alert			// Must have... so he gos back to script...
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
		trigger checker1 death_check_out
	}
}

