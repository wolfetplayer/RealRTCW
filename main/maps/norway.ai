		playsound m2_what_is_it		// What is it this time?
		wait 1700
		accum 4 abort_if_equal 1
		trigger mechanic1 talk2
	}

	trigger talk2
	{
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		playsound m2_oh_gott		// Oh god...
		wait 1500
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		trigger mechanic1 talk3
	}

	trigger talk3
	{
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		playsound m2_ja_ja		// Ja ja
		wait 1800
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		trigger mechanic1 talk4
	}

	trigger talk4
	{
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		playsound m2_dh_himself		// I headr it was Deathshead hiimself
		wait 6300
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		trigger mechanic1 talk5
	}

	trigger talk5
	{
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		playsound m2_now_what		// no what?
		wait 1700
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		trigger mechanic1 talk6
	}

	trigger talk6
	{
		accum 6 abort_if_equal 1
		accum 4 abort_if_equal 1
		playsound m2_dont_look_at_me		// Don't look at me these are my tools
		wait 2000
	}

	trigger talk7
	{
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		accum 4 set 1
		clearanim
		playsound blank
		resetscript
		giveweaponfull weapon_luger
	}

	bulletimpact
	{
		accum 4 set 1
		clearanim
		statetype alert
		giveweaponfull weapon_luger
	}

	statechange relaxed alert
	{
		accum 4 set 1
		clearanim
		statetype alert
		giveweaponfull weapon_luger
	} 

	inspectsoundstart
	{
		accum 4 set 1
		clearanim
		giveweaponfull weapon_luger
	}

	inspectsoundend
	{
		accum 4 set 1
	}

	inspectbodystart
	{
		accum 4 set 1
		clearanim
	}

	inspectbodyend
	{
	}	

	death
	{
		accum 6 set 1
		trigger checker1 death_check_out
		trigger checker1 backup_for_zone2
	}
}

