player
{
	spawn
	{
		accum 3 set 0   // used for weapon loadout
		
		// Objectives
		cvar g_episode 4
		objectivesneeded 2

		// Music
		abort_if_loadgame
		mu_start sound/music/m_drums
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/m_drums

		#if g_midgame == 0
		accum 3 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif

		#if g_level_was_selected >= 1
		accum 3 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif

		cvar g_chapter_legit 1
		cvar g_level_was_selected 0
		
		// Reinforced AI
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_1 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_2 #endif
	}
	
	trigger give_loadout_1
	{
	     accum 3 abort_if_not_equal 1

		#if g_fullarsenal == 0
        applyloadout norway_vanilla_1
		#endif

		#if g_fullarsenal == 1
        applyloadout norway_realrtcw_1
		#endif
		
		#if g_fullarsenal == 2
        applyloadout norway_vanilla_shotgun_1
		#endif
	}
	
	trigger give_loadout_2
	{
	     accum 3 abort_if_not_equal 2
		 
		#if g_fullarsenal == 0
        applyloadout norway_vanilla_2
		#endif

		#if g_fullarsenal == 1
        applyloadout norway_realrtcw_2
		#endif
		
		#if g_fullarsenal == 2
        applyloadout norway_vanilla_shotgun_2
		#endif
	
	}

	trigger first_conversation 
	{
		trigger checker1 conversation1
	//	trigger nazi2 talk1	
	}

	trigger tower_middle_alarm		// TODO
	{
		alertentity alarm_sound
		trigger checker1 alarm_on
		wait 5
	}

	trigger nazi4_check_out
	{
		trigger nazi4 run_to_generator
		trigger nazi2 run_to_generator
		trigger nazi3 run_to_generator
	}

	trigger second_conversation
	{
		trigger truck_nazi6 talk1	
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_5 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_6 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_7 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_8 #endif		
	}

	trigger truck_nazis				// This activates truck nazis...
	{
		trigger checker1 truck_nazis_spawn
		trigger checker1 in_zone1
		//trigger checker1
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_3 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_4 #endif
		
		wait 1000 
 savecheckpoint
	}
 
	trigger balcony_before_mechanics
	{
		alertentity balcony1_guard1
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_9 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_10 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger sniper1				// This activates the first encountered sniper..
	{
		objectivemet 1
		
		alertentity mechanic1
		alertentity mechanic2	
		alertentity sniper
		alertentity blackguard1
		alertentity blackguard2
		alertentity blackguard3		
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_11 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_12 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_13 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_14 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_15 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_16 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_17 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_18 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_19 #endif
	}

	trigger mg42nest			// This activates the nest...
	{
		trigger checker1 in_zone2
		alertentity nest_nazi1
		alertentity nest_nazi2
		alertentity nest_nazi3
		alertentity tower_nazi1
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_20 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_21 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger enter_mg42_nest
	{
		trigger nest_nazi1 unmount
		#if g_reinforce >= 1 alertentity reinforce_ai_venom_23 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_28 #endif
	}

	trigger trigger_after_nest
	{
		alertentity tower_nazi2
		trigger checker1 radio_nazi1_spawn
		alertentity radio_nazi2
		trigger checker1 zone2_backup_spawn
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_22 #endif	
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_24 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_25 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_26 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_27 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger stroopers
	{
		trigger checker1 stroopers_go
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_29 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_30 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_31 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_32 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_33 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_venom_34 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_35 #endif
		
		wait 1000
		wait 1000 
 savecheckpoint
	}

	trigger trigger_before_last_door
	{
		trigger checker1 in_zone3
		trigger checker1 before_last_door
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_36 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_37 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_38 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_39 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_40 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger radio_destroyed1
	{
		trigger checker1 radio_destroyed1
	}

	trigger radio_destroyed2
	{
		trigger checker1 radio_destroyed2
	}

	trigger backup_2ndradio			// they come out of the house looking around for the commotion...
	{
	}

	trigger turn_alarm_on
	{
		objectivemet 2
		
		trigger checker1 last_alarm
	}
	
	trigger button
	{
		trigger button go1
	}

	trigger shutter1
	{
		trigger shutter1 fall1
	}

	trigger barrells_blown1
	{
		trigger mechanic1 alarm_on
		trigger mechanic2 alarm_on
	}

	trigger barrells_blown2
	{
		trigger mechanic1 alarm_on
		trigger mechanic2 alarm_on
	}

	trigger barrells_blown3
	{
		trigger mechanic1 alarm_on
		trigger mechanic2 alarm_on
	}

	trigger barrells_blown4
	{
		trigger mechanic1 alarm_on
		trigger mechanic2 alarm_on
	}


	trigger secret1
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel xlabs persistent
	}

	trigger endmap_bonus										
	{															
		
	#if g_fullarsenal == 0  			// Vanilla Bonus
		printbonus norway	
		giveinventory holdable_xshield
	#endif
		
	#if g_fullarsenal == 1				// RealRTCW Bonus
		printbonus norway_alt
		giveinventory holdable_xshield
	#endif	

	#if g_fullarsenal == 2  			// Vanilla Bonus
		printbonus norway	
		giveinventory holdable_xshield
	#endif	
	
	}	
}

nazi1				// Nazi in front of generator
{
	attributes
	{
		fov 10
		tactical 1.0
		aggression 0.3
		camper 0.7
		inner_detection_radius 200
		alertness 1000
		hearing_scale 0.3
	}

	spawn
	{
		accum 4 set 0
		accum 5 set 0
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
		trigger checker1 alive_check_in
		trigger nazi1 go1	
	}
	
	trigger go1				// He faces generator
	{
		accum 4 abort_if_equal 1
		trigger checker1 alive_check_in
		walktomarker n1spot1
		facetargetangles n1spot1
		movetype crouch
		wait 8000 0
		trigger nazi1 anim_loop
	}

	trigger anim_loop
	{
		accum 4 abort_if_equal 1
		playanim scratching_chest both
		wait 2000
		accum 4 abort_if_equal 1
		playanim butt_scratch_2h both
		wait 6000
		accum 4 abort_if_equal 1
		playanim crotch_grab_2h both
		wait 1000
		trigger nazi1 looking_around
	}

	trigger anim_loop1
	{
	}

	
	//--------Conversation1---------

	trigger talk1
	{
		accum 4 abort_if_equal 1
		playsound g2_start_generator
		wait 2500
		trigger nazi2 talk2
	}

	trigger talk2
	{
		accum 4 abort_if_equal 1
		playsound g2_because_of_cold
		wait 1600
		trigger nazi2 talk3 
	}

	trigger talk3
	{
		accum 4 abort_if_equal 1
		playsound g2_crank_harder
		wait 2500
		trigger nazi2 talk4
	}

	trigger talk4
	{
		accum 4 abort_if_equal 1
		playsound g2_relax
		wait 5000
		trigger nazi2 talk5 
	}

	trigger talk5
	{
		accum 4 abort_if_equal 1
		playsound g2_alright
		trigger nazi1 walk_to_coolant
	}

	trigger looking_around
	{
		accum 4 abort_if_equal 1
		wait 8000
		accum 4 abort_if_equal 1
		wait 3000 
		attrib fov 120
		attrib alertness 2300
		attrib hearing_scale 1.0
		trigger nazi1 anim_loop
	}

	//---------End conversation1-------

	trigger go_to_alarm
	{
		accum 4 set 1
		statetype alert
		runtocast nazi4
		runtocast player
	}

	trigger walk_to_coolant				// This is his path to walk to get coolant
	{
		clearanim
		resetscript
		walktomarker n2spot4 nostop
		walktomarker n2spot5 nostop
		walktomarker n2spot6 nostop
		walktomarker n2spot7 nostop
		walktomarker n2spot8 nostop
		walktomarker n2spot9
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		attrib fov 120
		attrib alertness 2300
		attrib hearing_scale 1.0
		accum 4 set 1
		alertentity kill_creak_sound
		attrib alertness 2000
		clearanim
		playsound blank
	}

	bulletimpact
	{
		accum 4 set 1
	}

	inspectsoundstart
	{
		accum 4 set 1
		clearanim
		playsound blank
		attrib hearing_scale 0.8
	}

	trigger inspectsoundstart2		// event to help nazi on sub if to many sounds
	{
		accum 4 set 1
		clearanim
		playsound blank
		attrib fov 240
		attrib alertness 2000
		attrib hearing_scale 0.8
		statetype alert
		runtocast nazi3
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	statechange query alert			// This makes the nazi, not return back to his script		
	{
		resetscript
	}

	statechange relaxed alert
	{
		accum 4 set 1
		clearanim
		statetype alert
	}	

	death
	{
		alertentity kill_creak_sound
		trigger checker1 death_check_out
		trigger checker1 backup_for_zone1
	}

}

nazi2				// Nazi in front of generator who goes for coolant
{
	attributes
	{
		tactical 1.0
		aggression 1.0
		inner_detection_radius 200
		alertness 500
		hearing_scale 0.4
	}

	spawn
	{
		takeweapon all
		accum 0 bitset 0 
		accum 1 set 0 
		accum 2 set 0 
		accum 4 set 0
		accum 5 set 0
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
		walktomarker n2spot1
		facetargetangles n2spot1
		trigger checker1 alive_check_in
		trigger checker1 nazi2_alive
		playanim tools both forever	
	}
	
	trigger go1				// He faces generator
	{
		walktomarker n2spot1
		facetargetangles n2spot1
		wait 17000
	}

	trigger tools_animloop
	{	
		accum 4 abort_if_equal 1
		playanim tools both
		wait 4000 nazi1
		playanim tools both
		wait 3000
		playanim tools both
		trigger nazi2 tools_animloop
	}
	
	trigger anim_loop_forever
	{
		accum 4 abort_if_equal 1
		playanim tools both forever	
	}

	trigger anim_loop_forever2
	{
		accum 4 abort_if_equal 1
		alertentity play_metal_creak
		playanim tools both //forever
		wait 1000
		alertentity play_metal_creak
		wait 1000
		alertentity play_metal_creak
		trigger nazi2 anim_loop_forever	
	}

	trigger look_at_nazi1
	{		
	}

//---------Conversation---------

	trigger talk1
	{
		accum 4 abort_if_equal 1
		accum 0 abort_if_bitset 1
		alertentity play_metal_creak
		wait 1000
		alertentity play_metal_creak
		wait 1000 
		alertentity play_metal_creak
		wait 1000
		alertentity play_metal_creak 
		accum 4 abort_if_equal 1
		playsound g1_worthless	// Acch, this worhtless pile of junk won't start.
		wait 4500
		trigger nazi1 talk1
		wait 5
		trigger nazi2 anim_loop_forever
	}

	trigger talk2
	{
		accum 4 abort_if_equal 1
		playsound g1_no_upper_body		//No, I'm working on my upper body strenght one arm at a time.
		wait 6250
		trigger nazi1 talk2
	}

	trigger talk3
	{
		accum 4 abort_if_equal 1
		playsound g1_shrewd_observation		// tell me, do you often make such swred observations? You should seroiusly consider officers traning.
		wait 7400
		trigger nazi1 talk3
		wait 5
		trigger nazi2 anim_loop_forever
	}

	trigger talk4
	{
		accum 4 abort_if_equal 1
		playsound g1_frozen_solid		//Look are you acting stupid just to annoy me? don't you see me here practically taering my arm off.
		wait 11000
		trigger nazi1 talk4
	}

	trigger talk5
	{
		accum 4 abort_if_equal 1
		playsound g1_look_for_antifreeze	// You want to be helpfull go get the antifreeze
		wait 5900
		trigger nazi1 talk5
		wait 5
		trigger nazi2 anim_loop_forever2
	}

//-------------------------------

	trigger walk_to_coolant				// This is his path to walk to get coolant
	{
		walktomarker n2spot2 nostop
		walktomarker n2spot3 nostop
		walktomarker n2spot4 nostop
		walktomarker n2spot5 nostop
		walktomarker n2spot6 nostop
		walktomarker n2spot7
	}

	trigger run_to_alarm				// This is his path to tell other about alarm...
	{
		accum 4 set 1
		resetscript
		statetype alert
		nosight 99
		runtomarker n2spot2 nostop
		runtomarker n2spot3 nostop
		runtomarker n4_gen1
		trigger nazi4 help_nazi2
		playsound g1_alarm
		alertentity truck_nazi5			// This wakes all three truck nazis	
		alertentity truck_nazi6
		alertentity truck_nazi7
		trigger truck_nazi7 check_run_to_alarm	// This has truck_nazi7 run to an alarm..	
	}

	trigger run_to_generator
	{
		accum 4 set 1
		statetype alert
		runtomarker n2spot1
		trigger nazi2 run_to_alarm
	}

	trigger go_to_alarm
	{
		accum 4 set 1
		statetype alert
		runtocast nazi4
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
		runtocast player
	}

	pain 10
	{
		attrib aggression 0.3
		attrib camper 1.0
	}

	enemysight
	{
		clearanim
		accum 4 set 1
		accum 0 bitset 1
		alertentity kill_creak_sound
		attrib alertness 2000
		playsound blank
		resetscript
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
		trigger nazi2 run_to_alarm		// This has him go and alert truck nazi7
	}

	bulletimpact
	{
		clearanim
		accum 5 inc 1
		accum 5 abort_if_not_equal 3
		accum 4 set 1
		statetype alert
		resetscript
		clearanim
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
	}

	statechange relaxed alert
	{
		accum 4 set 1
		clearanim
		statetype alert
		resetscript
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
	}

	inspectsoundstart
	{
		clearanim
		accum 5 inc 1
		accum 5 abort_if_not_equal 3
		accum 4 set 1
		accum 0 bitset 1
		clearanim
		alertentity kill_creak_sound
		attrib alertness 2200
		attrib hearing_scale 0.8
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
		playsound blank
		resetscript
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		accum 0 bitset 1
		accum 4 set 1
		alertentity kill_creak_sound
		clearanim
		attrib alertness 2000
		playanim nono both player
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
		resetscript
	}

	trigger inspectsoundstart2		// event to help nazi on sub if to many sounds
	{
		clearanim
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
		playsound blank
		attrib alertness 2000
		attrib hearing_scale 0.8
		attrib fov 240
		statetype alert
		runtocast nazi3
		wait 500 0 player
	}

	inspectbodyend
	{
	}

	statechange query alert			// This makes the nazi, not return back to his script
	{
		resetscript
		clearanim
	}

	statechange relaxed alert
	{
		resetscript
		clearanim
		statetype alert
		#if g_fullarsenal == 0
		giveweaponfull weapon_mp40
	    #endif
		#if g_fullarsenal == 1
		giveweaponfull weapon_mp44
	    #endif
		#if g_fullarsenal == 2
		giveweaponfull weapon_mp40
	    #endif
	}	

	death
	{
		accum 0 bitset 0
		alertentity kill_creak_sound
		trigger checker1 nazi2_dead
		trigger checker1 death_check_out
		trigger checker1 backup_for_zone1
	}

}


nazi3					// this is nazi on submarine
{
	attributes
	{
		tactical 0.6
		aggression 0.7
		inner_detection_radius 200
		alertness 1300
		hearing_scale 5
	}

	spawn
	{
		accum 4 set 0		// so he deosn't call animations
		accum 5 set 0		// So he hears 2 times before going alert
		trigger checker1 alive_check_in
		giveweaponfull weapon_mauserrifle
		trigger nazi3 marchloop1	
	}

	trigger marchloop1			// This is loop on top sub..
	{
		accum 4 abort_if_equal 1
		walktomarker n3spot1
		facetargetangles n3spot1
		wait 5000
		playanim scratching_chest torso
		walktomarker n3spot2
		facetargetangles n3spot1
		wait 5300
		trigger nazi3 marchloop2		
	}

	trigger marchloop2			// This is loop on top sub..
	{
		accum 4 abort_if_equal 1
		walktomarker n3spot1
		facetargetangles n3spot1
		wait 5000
		cigarette on
		playanim smoking both
		cigarette off
		walktomarker n3spot2
		facetargetangles n3spot1
		wait 5300
		trigger nazi3 marchloop1		
	}
	
	trigger go1				// smal march loop1
	{
	}

	trigger go_to_alarm
	{
		statetype alert
		runtocast nazi4
		runtocast player
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		accum 4 set 1
		clearanim
		wait 500
		attrib alertness 2000
		trigger nazi1 inspectsoundstart
		trigger nazi2 inspectsoundstart
		playanim nono torso
	}

	trigger run_to_generator
	{
		accum 4 set 1
		statetype alert
		runtomarker n2spot1
	}

	bulletimpact
	{
		clearanim
		accum 5 inc 1
		accum 5 abort_if_not_equal 3
		accum 4 set 1
		clearanim
		statetype alert	
		trigger nazi1 inspectsoundstart2		// This calls guards over
		trigger nazi2 inspectsoundstart2	
	}

	inspectsoundstart
	{
		clearanim
		accum 5 inc 1
		accum 5 abort_if_not_equal 3
		accum 4 set 1
		clearanim
		statetype alert	
		playsound blank
		trigger nazi1 inspectsoundstart2		// This calls guards over
		trigger nazi2 inspectsoundstart2
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

