tower_nazi1				// This is nazi at water tower...
{
	attributes
	{
		tactical 1.0
		aggression 1.0
		inner_detection_radius 200
		alertness 2400
	}

	spawn
	{
		trigger tower_nazi1 go1	
	}
	
	trigger go1			
	{
		giveweaponfull weapon_mauserrifle
		trigger checker1 alive_check_in
		trigger checker1 alarm_on_response
		trigger checker1 alarm_off_response
	}

	trigger alarm_off
	{
		walktomarker tw1spot1
		facetargetangles tw1spot1
		wait 3000
		walktomarker tw1spot2
		facetargetangles tw1spot2
		wait 3000
		walktomarker tw1spot3
		facetargetangles tw1spot3
		wait 3000
		walktomarker tw1spot4
		facetargetangles tw1spot4
		wait 3000
		walktomarker tw1spot5
		facetargetangles tw1spot5
		wait 3000
		walktomarker tw1spot6
		facetargetangles tw1spot6
		wait 3000
		walktomarker tw1spot7
		facetargetangles tw1spot7
		wait 3000
		trigger tower_nazi1 marchloop1		
	}

	trigger alarm_on_response
	{
		alertentity radio_nazi3
		alertentity radio_nazi4		
		alertentity radio_nazi5	
		statetype alert
		runtomarker tw1spot2
		wait 2000
		wait 2000
		trigger tower_nazi1 tactic1
	}

	trigger tactic1
	{
		runtomarker tw1spot2
		wait 2000
	//	runtomarker tw1spot1
		wait 2000
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		clearanim
		trigger checker1 alarm_on_response   
		trigger checker1 alarm_off_response2  
	}

	trigger activate_alarm			// Basicaly alarm off...
	{
		alertentity radio_nazi1
		alertentity radio_nazi3
		alertentity radio_nazi4		
		alertentity radio_nazi5	
		wait 5
		trigger checker1 radio_nazi1_spawn
		trigger radio_nazi1 activator_of_alarm 	
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		clearanim
		deny
	}

	inspectbodyend
	{
	}

	statechange query alert			// This makes the nazi, not return back to his script
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}	

	death
	{
		alertentity tower_nazi3			/// Test to see if this works out...
		trigger checker1 death_check_out
	}
}

