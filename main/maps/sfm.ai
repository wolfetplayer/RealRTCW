	{
		deny
	}

	bulletimpactsound
	{
		deny
	}

	inspectsoundstart	
	{
		deny
	}

	inspectbodystart	
	{
		deny
	}

	death player
	{
	}
	
	sight player
	{
	}

	enemysight
	{
	}
}

nazi1
{
	attributes
	{
		fov 120
		aggression 0.6
	}

	spawn
	{
		setammo ammo_grenades 1
		giveweaponfull weapon_mp40
		statetype alert

		wait 200
		runtomarker spotn1a spotn1b noattack	
		facetargetangles spotn1a
		wait 5000 128
		runtomarker spotn1b
	}

	enemysight
	{
		resetscript
		runtomarker spotn1a
		wait 3000 128
	}

	pain 40		// triggered when health goes below 40
	{
		resetscript
		noattack 4000
		runtomarker spotn1c
		runtomarker spotn1d
		facetargetangles spotn1d
		attack
		wait 5000
	}

	trigger courtyard1	// tigger by player entering courtyard
	{
		resetscript
		noattack 3000
		runtomarker spotn1e nostop
		runtomarker spotn1f
		attack
		wait 1000
	}
	
	bulletimpact
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	death 
	{
		trigger counter zone1enemy
	}
}

