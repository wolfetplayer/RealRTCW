nazi10
{
	attributes
	{
		attack_crouch 0.2
		fov 120
	}

	spawn
	{
		accum 0 bitset 0 // set far away, reset = close
		accum 0 bitset 1
		accum 0 bitset 2 // set = stay, reset = unmount
		accum 0 bitset 3 // set = off gun, reset = on gun
		setammo ammo_grenades 0
		statetype alert

		wait 100
		giveweaponfull weapon_mp40
		gotomarker spotn10a
		facetargetangles spotn10a
		wait 5000 0
		gotomarker spotn10b nostop
		gotomarker spotn10c nostop
		gotomarker spotn10d
		accum 0 bitreset 0
		trigger nazi10 mount10
	}

	trigger getgun10
	{
		accum 0 abort_if_not_bitset 0
		gotomarker spotn10c nostop
		gotomarker spotn10d
		accum 0 bitreset 0
		trigger nazi10 mount10
	}

	trigger mount10
	{
		accum 0 abort_if_not_bitset 3
		gotomarker spotmg42_1
		mount mg42_1
		accum 0 bitreset 3
	}

	trigger mountnow
	{
		trigger nazi10 getgun10
		accum 0 abort_if_bitset 0
		trigger nazi10 mount10
	}

	trigger free
	{
		accum 0 bitreset 2
	}

	trigger stay
	{
		accum 0 bitset 2
	}

	forced_mg42_unmount
	{
		accum 0 bitset 3
		accum 0 abort_if_not_bitset 2
		deny
		accum 0 bitreset 3
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}

	death 
	{
		trigger counter zone2enemy
	}
}

