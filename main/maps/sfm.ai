//
//AI Scripting
//Map: Street Fighting Man
//Last edited by: WolfETPLayer & William Faure
//

player
{
	spawn
	{
		accum 0 set 1
		accum 1 set 1
		accum 2 set 0
		
		accum 5 set 0     // loadout randomizer
		
		cvar g_episode 3
		objectivesneeded 4

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}
	
	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/m_situation
		
		#if g_midgame == 0
		accum 5 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif

		#if g_level_was_selected >= 1
		accum 5 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif

		globalaccum 0 set 1
		cvar g_level_was_selected 0
	}
	
	trigger give_loadout_1
	{
	    accum 5 abort_if_not_equal 1
		
		#if g_fullarsenal == 0
        applyloadout sfm_vanilla_1
		#endif

		#if g_fullarsenal == 1
        applyloadout sfm_realrtcw_1
		#endif
		
		#if g_fullarsenal == 2
        applyloadout sfm_vanilla_shotgun_1
		#endif
	}
	
	trigger give_loadout_2
	{
	    accum 5 abort_if_not_equal 2
		
		#if g_fullarsenal == 0
        applyloadout sfm_vanilla_2
		#endif

		#if g_fullarsenal == 1
        applyloadout sfm_realrtcw_2
		#endif
		
		#if g_fullarsenal == 2
        applyloadout sfm_vanilla_shotgun_2
		#endif
	}

	trigger action1
	{
		alertentity nazi1
		alertentity nazi2
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_1 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_2 #endif
	}

	trigger action2
	{
		alertentity nazi6
		alertentity nazi21
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_3 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_4 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_5 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_6 #endif
	}

	trigger action3
	{
		trigger nazi1 courtyard1
		trigger nazi3 courtyard3
		alertentity nazi4
		alertentity nazi5
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_7 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_8 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action4
	{
		trigger nazi4 upstairs4
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_9 #endif
	}
	
	trigger action5
	{
		alertentity nazi7
	}
	
	trigger action6
	{
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
		alertentity dummy2
		alertentity remove_grp1
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_10 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_11 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_13 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_14 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_15 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_17 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_18 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action6b
	{
		alertentity venom1
		alertentity nazi12
		alertentity charley
		alertentity sagewycke
		alertentity joe
		alertentity dummy1
		#if g_reinforce >= 1 alertentity reinforce_ai_venom_12 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_16 #endif
	}

	trigger action6c
	{
		alertentity nazi14
		alertentity nazi15
		trigger baracade1 countdown
		trigger nazi10 mountnow
	}

	trigger action6d
	{
		trigger venom1 moveup
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_19 #endif
	}

	trigger action7
	{
		trigger sagewycke rem_clear
		trigger joe rem_clear
		trigger charley rem_clear
		trigger counter zone2end
		alertentity rem_kreisau
		alertentity nazi22
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		#if g_reinforce >= 1 alertentity reinforce_ai_venom_20 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_22 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_23 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_24 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_25 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_26 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_27 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_28 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_29 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action8
	{
		alertentity venom2
		alertentity nazi20
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_21 #endif
	}

	trigger action9
	{
		trigger nazi17 takecover17
		
		wait 1000 
 savecheckpoint
	}

	trigger action10
	{
		accum 1 abort_if_less_than 1
		accum 1 set 0
		trigger nazi20 takecover20
	}

	trigger action11
	{
		accum 1 abort_if_less_than 1
		accum 1 set 0
		trigger nazi20 takecover20
	}

	trigger action12
	{
		trigger venom2 backway2
	}

	trigger action13
	{
		alertentity venom3
		alertentity nazi26
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_30 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_31 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_32 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_33 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_34 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_venom_35 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_36 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action14
	{
		alertentity nazi19
	}

	trigger gun_release
	{
		trigger nazi10 free
	}

	trigger gun_stay
	{
		trigger nazi10 stick
	}

	trigger situation
	{
		accum 2 abort_if_equal 0
		accum 2 set 0
		mu_fade 0 1500
		mu_queue sound/music/m_situation
	}

	trigger action
	{
		accum 2 abort_if_equal 1
		accum 2 set 1
		mu_fade 0 1500
		mu_queue sound/music/m_action
	}

	trigger mission
	{
		accum 2 abort_if_equal 2
		accum 2 set 2
		mu_fade 0 1000
		mu_queue sound/music/m_mission_2
	}

	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}

	trigger got_objective2
	{
		objectivemet 2	// mission objective complete
	}

	trigger got_objective3
	{
		objectivemet 3	// mission objective complete
	}

	trigger got_objective4
	{
		objectivemet 4	// mission objective complete
	}

	trigger secret1
	{
		foundsecret
	}

	trigger endmap
	{
	}

	trigger realend
	{
		changelevel factory persistent
	}

	trigger endmap_bonus										
	{															
		
	#if g_fullarsenal == 0  			// Vanilla Bonus
		printbonus sfm
        giveinventory holdable_wine		
		giveammo .45cal Box
	#endif
		
	#if g_fullarsenal == 1				// RealRTCW Bonus
		printbonus sfm_alt
		giveammo .45cal Box
		giveammo barammol
	#endif	

	#if g_fullarsenal == 2  			// Vanilla Bonus
		printbonus sfm
        giveinventory holdable_wine		
		giveammo .45cal Box
	#endif	
	}	
}

ast
{
	attributes
	{
		starting_health 999
		fov 300
		alertness 1024
		hearing_scale 0.0
	}

	spawn
	{
		takeweapon all
		nosight 99999
		noavoid
	}

	trigger talk1
	{
		playsound sound/scenaric/sfm/ast_1.wav
	}

	trigger talk2
	{
		playsound sound/scenaric/sfm/ast_2.wav
