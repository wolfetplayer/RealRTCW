nazi1
{
	attributes
	{
	}

	spawn
	{
		accum 0 set 0	// 1= sighted player or pained by player

		setammo ammo_grenades 0
		giveweaponfull weapon_mp40
		wait 100
		trigger nazi1 idle1
	}

	trigger idle1
	{
		accum 0 abort_if_not_equal 0

		walktomarker n1spot1
		facetargetangles n1spot1
		wait 1000
		playanim crotch_grab_2h both
		wait 2000
		walktomarker n1spot2
		facetargetangles n1spot2
		wait 500
		playanim crotch_grab_2h both
		wait 4000
		playsound Cough2
		playanim coughing_2h both
		wait 3000
		trigger nazi1 idle1
	}

	trigger elevworks
	{
		accum 0 abort_if_not_equal 0
		playsound SWFNazi1_1
	}

	pain 38
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		playsound Blank
		clearanim
		trigger elevator spawnin
		resetscript
		trigger nazi13 alerton
		trigger nazi2 alerton
	}

	bulletimpact
	{
		playsound Blank
		clearanim
	}

	inspectsoundstart
	{
		playsound Blank
		clearanim
	}

	enemysight
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		playsound Blank
		clearanim
		trigger elevator spawnalert
		resetscript
	}

	death
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger elevator spawnin
		resetscript
	}
}

