//AI Scripting
//Map: SWF (Secret Weapons Facility)
//Last edited by: WolfETPLayer & William Faure

player
{
	spawn
	{
		accum 0 bitset 0
		
		cvar g_episode 3
		objectivesneeded 2

		accum 7 set 0
		#if g_gameskill < 3
		accum 7 set 1
		#endif
		#if g_chapter_legit < 1
		accum 7 set 1
		#endif
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	trigger give_loadout_1
	{
		accum 1 abort_if_not_equal 1
		#if g_fullarsenal == 0
		applyloadout sfm_vanilla_1
		#endif
		#if g_fullarsenal == 1
		applyloadout sfm_realrtcw_1
		#endif
		#if g_fullarsenal == 2
		applyloadout sfm_vanilla_shotgun_1
		#endif
	}

	trigger give_loadout_2
	{
		accum 1 abort_if_not_equal 2
		#if g_fullarsenal == 0
		applyloadout sfm_vanilla_2
		#endif
		#if g_fullarsenal == 1
		applyloadout sfm_realrtcw_2
		#endif
		#if g_fullarsenal == 2
		applyloadout sfm_vanilla_shotgun_2
		#endif
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		cvar g_chapter_legit 0
		accum 1 random_no_zero 3
		trigger player give_loadout_1
		trigger player give_loadout_2
		#endif
		cvar g_level_was_selected 0

		mu_fade 0 1500
		mu_queue sound/music/l_briefing_2

		trigger elevator cinematic1
		trigger player cam1
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_1 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_2 #endif
	}

	// ---Start Camera Section---
	trigger cam1
	{
		startcam cs10_01
	}

	trigger cam2
	{
		startcam cs10_02
	}

	trigger cam3
	{
		startcam cs10_03
	}

	trigger cam3d
	{
		startcam cs10_03d
	}

	trigger cam4
	{
		startcam cs10_04
	}

	trigger camend1
	{
		startcam swfend2
	}

	trigger camend2
	{
		startcam swfend2d
	}

	// ---End Camera Section---
	trigger camstop
	{
		stopcam
	}

	trigger camerainterrupt
	{
		accum 0 abort_if_not_bitset 0
		stopcam
		trigger elevator cine_cleanup
	}


	trigger action1
	{
		trigger elevator spawnin
		alertentity nazi3
		alertentity nazi4
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_3 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_4 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action2
	{
		accum 0 bitreset 0
		alertentity nazi5
		alertentity nazi14
	
	}

	trigger action3
	{
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi15
		#if g_spawnxshepherds > 0 alertentity xdog1 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_5 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action4
	{
		trigger nazi6 closewindow
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_6 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_7 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_8 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_9 #endif
	}

	trigger action5
	{
		trigger crane1 spawnaction
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_10 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_16 #endif
	}

	trigger action6
	{
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
		alertentity loper4
		#if g_spawnxshepherds > 0 alertentity xdog2 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_11 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_12 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action7
	{
		alertentity loper1
	}

	trigger action8
	{
		alertentity nazi12
		trigger loper1 crash
		#if g_reinforce >= 1 alertentity reinforce_ai_loper_13 #endif
		#if g_reinforce == 2 alertentity reinforce_ai_loper_14 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action9
	{
		alertentity lab3
		alertentity loper3
	}

	trigger action10	// just spawn the guys in
	{
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_15 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action11	// get them to attack ... cover fire and movement
	{
		trigger nazi18 moveout18
		trigger nazi19 moveout19
		trigger nazi20 moveout20
	}
	
	trigger action12
	{
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity lab4
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_17 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_18 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_19 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_loper_20 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_21 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action13
	{
		alertentity nazi24
		alertentity lab5
	}

	trigger action14
	{
		alertentity black1
		trigger lab5 takecover5
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_22 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_23 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_26 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_27 #endif
	}

	trigger action15
	{
		objectivemet 1
		
		alertentity black2
		alertentity black3
		alertentity black4
		alertentity black8
		trigger submarine leaving
		alertentity lab6
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_28 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_29 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_30 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_33 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_blackguard_34 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger action16
	{
		alertentity black5
		#if g_reinforce >= 1 alertentity reinforce_ai_venom_32 #endif
	}

	trigger action17
	{
		trigger black8 openfire8
		trigger black5 openfire5
	}

	trigger action18
	{
		objectivemet 2
		
		alertentity black6
		alertentity black7
		#if g_reinforce >= 2 alertentity reinforce_ai_venom_35 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_venom_36 #endif
	}

	trigger action19
	{
		trigger black8 takecover8
	}

	trigger raisewater
	{
		trigger waterwheel raise
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger secret3
	{
		foundsecret
		
		#if g_reinforce >= 2 alertentity reinforce_ai_loper_24 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_blackguard_25 #endif
	}

	trigger secret4
	{
		foundsecret
	}

	trigger end_cutscene
	{
		trigger elevator end_cutscene
	}

	trigger endmap
	{
	
	}

	trigger achievement_hard_check
	{
		accum 7 abort_if_equal 1
		achievement_chapter4_hard
	}

	trigger endnow
	{
		#if g_chapter_legit >= 1
		achievement_chapter4
		achievement_ironman
		achievement_hardcore
		achievement_999
		achievement_nightmare
		achievement_walkinthepark
		#endif
		trigger player achievement_hard_check
		changelevel cutscene11 4000
	}

	trigger endmap_bonus										
	{															
		
	#if g_fullarsenal == 0  	// Vanilla Bonus
		printbonus swf
	#endif
		
	#if g_fullarsenal > 0		// RealRTCW Bonus
		printbonus swf_alt
	#endif	

	}
}

cine_death
{
	attributes
	{
		hearing_scale 0.0
	}

	spawn
	{
		accum 0 bitset 0
		headlook off
		takeweapon all
		noavoid
		nosight 99999
		explicit_routing on
	}

	trigger anim1
	{
		playanim talking both
	}

	trigger dtalk1
	{
		accum 0 abort_if_not_bitset 0
		playsound SWFdeath_1
	}

	trigger dtalk2
	{
		accum 0 abort_if_not_bitset 0
		playsound SWFdeath_2
	}

	trigger go
	{
		clearanim
		resetscript
		wait 500 0 black3
		walktomarker cdeath_spot1 cdeath_spot1 noattack
	}

	death 
	{
		accum 0 bitreset 0
	}
}

