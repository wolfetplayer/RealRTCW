//
//AI Scripting
//Map: Tram
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 bitset 0
		accum 0 bitset 1
		accum 0 bitset 2
		accum 0 bitset 3
		accum 0 bitset 4
		accum 1 set 0
		objectivesneeded 3

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		globalaccum 0 set 0
		applyloadout village1
		#endif
		cvar g_level_was_selected 0

		mu_fade 0 1500
		mu_queue sound/music/m_drums
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_1 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_2 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_3 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_4 #endif
	}

	trigger switch1on
	{
		objectivemet 1
		alertentity light1on
		trigger gear1 on1
		trigger gear2 on2		
		trigger gear3 on3
	}

	trigger starttram
	{
		trigger tramcar tramup
		trigger trammount mountup

		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		alertentity nazi6
		alertentity nazi7
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_12 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_13 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger tramgo
	{
		trigger tramcar tramdown
		trigger trammount mountdown

		accum 0 abort_if_not_bitset 1
		accum 0 bitreset 1
		objectivemet 2
		alertentity nazi13
		alertentity nazi14
		alertentity nazi23
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_14 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_16 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_17 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_18 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_19 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_20 #endif
		accum 1 abort_if_equal 2
		accum 1 set 2
		mu_fade 0 500
		mu_queue sound/music/m_drums
		
	}

	trigger startlower
	{
		trigger tramcar tramcontinue
		trigger trammount mountcontinue
		accum 0 abort_if_not_bitset 2
		accum 0 bitreset 2
		alertentity nazi16
		alertentity nazi17
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_21 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_22 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_23 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_24 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_33 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_34 #endif
		
		wait 1000 
 savecheckpoint
	}

	trigger powermid
	{
		accum 0 abort_if_not_bitset 3
		accum 0 bitreset 3
		alertentity light3on
		alertentity light4on
		trigger button2 resetbutton2
	}

	trigger returnmid
	{
		trigger tramcar tramreturn
		trigger trammount mountreturn
	}

	trigger openlocker1
	{
		trigger locker1 toggle
	}

	trigger upstairs
	{
		alertentity nazi1
	}

	trigger action1
	{
		alertentity nazi2
		alertentity nazi3
		alertentity nazi4
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_5 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_6 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_7 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_8 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_9 #endif
		
	}

	trigger lookout
	{
		trigger nazi2 shootwindows
	}

	trigger action2
	{
		trigger zone1 loweralarm
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_10 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_11 #endif
	}

	trigger action3
	{
		trigger nazi8 loweralarm8
		trigger nazi10 loweralarm10
	}

	trigger action4
	{
		alertentity nazi15
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_15 #endif
	}

	trigger action5
	{
		alertentity nazi18
		alertentity nazi19
		alertentity nazi24
		trigger nazi16 newspot16
		
		wait 1000 
 savecheckpoint
	}

	trigger action6a // lower entrance
	{
		trigger nazi24 blowbarrel24
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_25 #endif
	}

	trigger action6b // upper entrance
	{
		trigger nazi24 clearorders24
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_26 #endif
	}

	trigger action7
	{
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_27 #endif
		#if g_reinforce >= 2 alertentity reinforce_ai_soldier_28 #endif
		#if g_reinforce >= 1 alertentity reinforce_ai_soldier_29 #endif
	}

	trigger action8
	{
		trigger nazi20 action20
		trigger nazi21 action21
		trigger nazi22 action22
		
		wait 1000 
 savecheckpoint
	}

	trigger action9
	{
		trigger kesler dont_shoot
		
	}

	trigger explode_alarm
	{
		trigger zone1 explode_upper
	}

	trigger on_alarm
	{
		trigger zone1 upperalarm
		accum 1 abort_if_equal 1
		accum 1 set 1
		mu_fade 0 500
		mu_queue sound/music/m_alarm
	}

	trigger playalarm
	{
		accum 1 abort_if_equal 1
		accum 1 set 1
		mu_fade 0 500
		mu_queue sound/music/m_alarm
	}

	trigger playdrums
	{
		accum 1 abort_if_equal 2
		accum 1 set 2
		mu_fade 0 500
		mu_queue sound/music/m_drums
	}

	trigger button1used
	{
		trigger button1 pushbutton1
	}

	trigger button2used
	{
		trigger button2 pushbutton2
	}

	trigger achievement_base_check
	{
		globalaccum 0 abort_if_not_equal 1
		achievement_chapter1
		achievement_ironman
		achievement_hardcore
		achievement_999
		achievement_nightmare
		achievement_walkinthepark
	}

	trigger achievement_hard_check
	{
		accum 7 set 0
		#if g_gameskill < 3
		accum 7 set 1
		#endif
		globalaccum 0 abort_if_not_equal 1
		accum 7 abort_if_equal 1
		achievement_chapter1_hard
	}

	trigger endmap
	{
		trigger player achievement_base_check
		trigger player achievement_hard_check
		trigger kesler follow_me
		changelevel village1 5000 persistent silent
	}

	trigger got_objective3
	{
		objectivemet 3
	}

	trigger cam1
	{
		startcam cs02_02
	}

	trigger clear_cam
	{
		stopcam
	}

	death
	{
		trigger locker1 midreset
	}
}

nazi1
{
	attributes
	{
		attack_crouch 0.8
		fov 120
		inner_detection_radius 384
	}

	spawn
	{
		accum 0 set 0 // 1 = alerted
		accum 1 set 0 // 1 = others sighted player first
		setammo ammo_grenades 0
		takeweapon weapon_mp40

		wait 100
		gotomarker spotn1a
		facetargetangles spotn1a
		movetype crouch
		trigger nazi1 working1
	}

	trigger working1
	{
		accum 0 abort_if_not_equal 0
		playanim working_with_tools both
		trigger nazi1 working1
	}

	statechange relaxed alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi1 alert1
	}

	statechange query alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi1 alert1
	}

	statechange relaxed combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi1 alert1
	}

	statechange query combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi1 alert1
	}

	bulletimpact
	{
		statetype alert
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi1 alert1
	}

	inspectsoundstart
	{
		statetype alert
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi1 alert1
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi1 alert1
	}

	inspectfriendlycombatstart
	{
		deny
	}

	trigger alert1
	{
		clearanim
		giveweaponfull weapon_luger

		wait 50 player
		gotomarker spotn1b
		facetargetangles spotn1b
		wait 1000
	}

	trigger sighted1 // called by other ai's
	{
		accum 1 set 1
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		clearanim
		statetype alert
		giveweaponfull weapon_luger

		wait 50 player
		gotomarker spotn1b
		facetargetangles spotn1b
		wait 1000
	}

	enemysight
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		playsound male_ze_american
	}

	death
	{
		accum 1 set 1
		trigger zone1 firstgroupdead
		trigger nazi3 nazi1dead

	}
}

nazi2
{
	attributes
	{
		fov 220
		inner_detection_radius 384
	}

	spawn
	{
		accum 0 set 0 // 1 = alerted
		accum 1 set 0 // 1 = others sighted player first
		setammo ammo_grenades 0
		giveweaponfull weapon_mauserrifle

		wait 100
		gotomarker spotn2a
		wait forever 0
	}

	trigger shootwindows
	{
		runtomarker spotn2b
		facetargetangles spotn2b
		attrib aim_accuracy 0.8
		fireattarget shootat2a
		fireattarget shootat2a
		fireattarget shootat2a
		fireattarget shootat2b
		fireattarget shootat2b
		fireattarget shootat2b
		attrib aim_accuracy 0.3
	}

	trigger sighted2
	{
		accum 1 set 1
		statetype alert
		runtomarker spotn2b
		facetargetangles spotn2b	
	}

	enemysight
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger nazi1 sighted1
		trigger nazi3 sighted3
		trigger nazi4 sighted4
	}

	inspectbodystart
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}

	death
	{
		trigger zone1 firstgroupdead
	}
}

nazi3
{
	attributes
	{
		inner_detection_radius 384
	}

	spawn
	{
		accum 0 bitset 0
		accum 1 set 0
		setammo ammo_grenades 0

		wait 100
		walktomarker spotn3a
		trigger nazi3 marchloop
	}

	trigger marchloop
	{
		walktomarker spotn3b
		facetargetangles spotn3b
		wait 200
		wait 500 nazi1
		trigger nazi3 nazi1check
		facetargetangles spotn3a
		wait 400
		walktomarker spotn3a
		walktomarker spotn3c
		facetargetangles spotn3c
		wait 400
		walktomarker spotn3a
		trigger nazi3 marchloop
	}

	trigger nazi1dead
	{
		accum 0 bitreset 0 // nazi1dead go check
	}

	trigger nazi1check
	{
		accum 0 abort_if_bitset 0
		runtomarker spotn1a
		wait 5 player
		playsound MiscAlarm1
		trigger zone1 firstgroupdead
	}

	inspectbodystart nazi1
	{
		deny
		runtocast nazi1
		wait 5 player
	}

	inspectbodystart
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}

	trigger sighted3
	{
		accum 1 set 1
		statetype alert
		resetscript
	}

	enemysight
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger nazi1 sighted1
		trigger nazi2 sighted2
		trigger nazi4 sighted4
		resetscript
	}

	death
	{
		trigger zone1 firstgroupdead
	}
}

