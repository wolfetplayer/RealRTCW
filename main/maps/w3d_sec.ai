player
{
		
	spawn
	{
		objectivesneeded 2	// tells the number of objectives
		 		abort_if_loadgame
		mu_queue sound/music/m_stealth_new
	} 
	playerstart
	{
		giveweapon weapon_knife
		giveweapon weapon_luger
		giveweapon weapon_mp40
		setammo ammo_9mm 200
		selectweapon weapon_mp40
		mu_fade 0 1000
		mu_queue sound/music/m_stealth_new
	}
