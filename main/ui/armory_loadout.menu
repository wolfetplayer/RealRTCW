#include "ui/menudef.h"
{

menuDef {
	name "armory_loadout"
	visible 0
	fullscreen 0
	rect 0 0 640 480
	focusColor 1 .75 0 1
	style 1
	border 1

	onOpen { play "sound/misc/kcaction.wav" ; uiScript loadArmoryRoster }

	itemDef {
		name background
		rect 20 20 600 440
		style WINDOW_STYLE_FILLED
		backcolor 0 0 0 .96
		border 1
		bordercolor .5 .5 .5 .6
		forecolor 1 1 1 1
		visible 1
		decoration
	}

	itemDef {
		name backgroundGradientTrim
		rect 20 20 600 440
		style WINDOW_STYLE_EMPTY
		border WINDOW_BORDER_KCGRADIENT
		bordersize 4
		bordercolor .8 .65 .3 1
		visible 1
		decoration
	}

	itemDef {
		name title
		text "@ARMORY_TITLE"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .3
		textstyle 6
		rect 20 32 600 20
		textalign ITEM_ALIGN_CENTER
		textalignx 300
		textaligny 14
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor .15 .13 .08 .55
		border 1
		bordercolor .6 .55 .35 .5
		visible 1
		decoration
	}

	itemDef {
		name pointsLabel
		text "@ARMORY_POINTS_LABEL"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .28
		textstyle 6
		rect 185 54 165 20
		textalign ITEM_ALIGN_RIGHT
		textalignx 165
		textaligny 15
		forecolor .85 .85 .85 1
		visible 1
		decoration
	}

	itemDef {
		name pointsValue
		type ITEM_TYPE_OWNERDRAW
		ownerdraw UI_ARMORY_POINTS
		textfont UI_FONT_BIG
		textscale .28
		textstyle 6
		rect 355 54 90 20
		textaligny 15
		forecolor 1 .85 .3 1
		visible 1
		decoration
	}

	//////////////// column outlines (equal for all three) ////////////////

