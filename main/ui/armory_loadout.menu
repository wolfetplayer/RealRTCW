#include "ui/menudef.h"
{

menuDef {
	name "armory_loadout"
	visible 0
	fullscreen 0
	rect 0 0 640 480
	focusColor 1 .75 0 1
	style 1
	border 1

	onOpen { uiScript loadArmoryRoster }
	onESC { uiScript armoryCancel }

	itemDef {
		name background
		rect 20 20 600 440
		style WINDOW_STYLE_FILLED
		backcolor 0 0 0 .85
		border 1
		bordercolor .5 .5 .5 .6
		forecolor 1 1 1 1
		visible 1
		decoration
	}

	itemDef {
		name title
		text "@ARMORY_TITLE"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .3
		rect 20 32 600 20
		textalign ITEM_ALIGN_CENTER
		textalignx 300
		textaligny 14
		forecolor 1 1 1 1
		visible 1
		decoration
	}

	itemDef {
		name pointsLabel
		text "@ARMORY_POINTS_LABEL"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .22
		rect 230 56 110 16
		textaligny 12
		forecolor .85 .85 .85 1
		visible 1
		decoration
	}

	itemDef {
		name pointsValue
		type ITEM_TYPE_OWNERDRAW
		ownerdraw UI_ARMORY_POINTS
		textfont UI_FONT_BIG
		textscale .22
		rect 340 56 60 16
		textaligny 12
		forecolor 1 .85 .3 1
		visible 1
		decoration
	}

	//////////////// weapons (left) ////////////////

	itemDef {
		name weaponsLabel
		text "@ARMORY_WEAPONS"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .24
		rect 40 88 170 18
		textaligny 13
		forecolor 1 1 1 1
		visible 1
		decoration
	}

	itemDef {
		name weaponList
		rect 40 110 170 260
		type ITEM_TYPE_LISTBOX
		style WINDOW_STYLE_FILLED
		textfont UI_FONT_BIG
		elementwidth 170
		elementheight 24
		textscale .19
		columns 2  2 20 0  26 140 22
		elementtype LISTBOX_TEXT
		feeder FEEDER_ARMORY_WEAPONS
		textalign ITEM_ALIGN_LEFT
		textaligny 14
		forecolor .9 .9 .9 1
		backcolor .12 .12 .12 .7
		outlinecolor .5 .5 .5 .3
		visible 1
	}

	//////////////// current build (middle) ////////////////

	itemDef {
		name buildLabel
		text "@ARMORY_BUILD"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .24
		rect 235 88 170 18
		textaligny 13
		forecolor 1 1 1 1
		visible 1
		decoration
	}

	itemDef {
		name buildList
		rect 235 110 170 260
		type ITEM_TYPE_LISTBOX
		style WINDOW_STYLE_FILLED
		textfont UI_FONT_BIG
		elementwidth 170
		elementheight 24
		textscale .19
		columns 2  2 20 0  26 140 22
		elementtype LISTBOX_TEXT
		feeder FEEDER_ARMORY_BUILD
		textalign ITEM_ALIGN_LEFT
		textaligny 14
		forecolor 1 .9 .6 1
		backcolor .12 .12 .12 .7
		outlinecolor .5 .5 .5 .3
		visible 1
	}

	//////////////// equipment (right) ////////////////

	itemDef {
		name equipLabel
		text "@ARMORY_EQUIPMENT"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .24
		rect 430 88 170 18
		textaligny 13
		forecolor 1 1 1 1
		visible 1
		decoration
	}

	itemDef {
		name equipList
		rect 430 110 170 260
		type ITEM_TYPE_LISTBOX
		style WINDOW_STYLE_FILLED
		textfont UI_FONT_BIG
		elementwidth 170
		elementheight 24
		textscale .19
		columns 2  2 20 0  26 140 22
		elementtype LISTBOX_TEXT
		feeder FEEDER_ARMORY_EQUIP
		textalign ITEM_ALIGN_LEFT
		textaligny 14
		forecolor .9 .9 .9 1
		backcolor .12 .12 .12 .7
		outlinecolor .5 .5 .5 .3
		visible 1
	}

	//////////////// buttons ////////////////

	itemDef {
		name randomizeButton
		text "@ARMORY_RANDOMIZE"
		type ITEM_TYPE_BUTTON
		rect 40 378 170 20
		textscale .25
		style 1
		border 1
		bordercolor .5 .5 .5 .5
		backcolor 0 0 .3 .35
		textaligny 13
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 85
		forecolor 1 1 1 1
		mouseEnter { setitemcolor randomizeButton backcolor 0 0 .5 .45 }
		mouseExit { setitemcolor randomizeButton backcolor 0 0 .3 .35 }
		action { play "sound/misc/kcswish.wav" ; uiScript armoryRandomize }
		visible 1
	}

	itemDef {
		name recommendedButton
		text "@ARMORY_RECOMMENDED"
		type ITEM_TYPE_BUTTON
		rect 235 378 170 20
		textscale .25
		style 1
		border 1
		bordercolor .5 .5 .5 .5
		backcolor .25 .2 0 .35
		textaligny 13
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 85
		forecolor 1 1 1 1
		mouseEnter { setitemcolor recommendedButton backcolor .4 .35 0 .45 }
		mouseExit { setitemcolor recommendedButton backcolor .25 .2 0 .35 }
		action { play "sound/misc/kcswish.wav" ; uiScript armoryRecommended }
		visible 1
	}

	itemDef {
		name confirmButton
		text "@ARMORY_CONFIRM"
		type ITEM_TYPE_BUTTON
		rect 235 402 170 20
		textscale .25
		style 1
		border 1
		bordercolor .5 .5 .5 .5
		backcolor 0 .3 0 .35
		textaligny 13
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 85
		forecolor 1 1 1 1
		mouseEnter { setitemcolor confirmButton backcolor 0 .5 0 .45 }
		mouseExit { setitemcolor confirmButton backcolor 0 .3 0 .35 }
		action { play "sound/misc/kcswish.wav" ; uiScript armoryConfirm }
		visible 1
	}

	itemDef {
		name cancelButton
		text "@ARMORY_CANCEL"
		type ITEM_TYPE_BUTTON
		rect 40 402 170 20
		textscale .25
		style 1
		border 1
		bordercolor .5 .5 .5 .5
		backcolor .3 0 0 .35
		textaligny 13
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 85
		forecolor 1 1 1 1
		mouseEnter { setitemcolor cancelButton backcolor .5 0 0 .45 }
		mouseExit { setitemcolor cancelButton backcolor .3 0 0 .35 }
		action { play "sound/misc/kcswish.wav" ; uiScript armoryCancel }
		visible 1
	}

	itemDef {
		name hint
		text "@ARMORY_HINT"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .16
		rect 40 430 520 14
		textalign ITEM_ALIGN_CENTER
		textalignx 260
		forecolor .7 .7 .7 1
		visible 1
		decoration
	}
}
}
