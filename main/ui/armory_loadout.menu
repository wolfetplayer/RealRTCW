	}

	itemDef {
		name weaponList
		rect 43 210 167 198
		type ITEM_TYPE_LISTBOX
		style WINDOW_STYLE_FILLED
		textfont UI_FONT_BIG
		elementwidth 167
		elementheight 22
		textscale .2
		elementtype LISTBOX_TEXT
		feeder FEEDER_ARMORY_WEAPONS
		columns 2 2 20 1 26 140 24
		textalign ITEM_ALIGN_LEFT
		textaligny 14
		forecolor .9 .9 .9 1
		backcolor .12 .12 .12 .88
		outlinecolor 1 .75 0 .22
		visible 1
		mouseEnter { setitemcolor weaponsColumnOutline bordercolor 1 .8 .3 .9 }
		mouseExit { setitemcolor weaponsColumnOutline bordercolor .6 .55 .35 .6 }
	}

	itemDef {
		name weaponsAddTag
		text "@ARMORY_ADD"
		type ITEM_TYPE_BUTTON
		rect 90 412 70 16
		textscale .16
		style WINDOW_STYLE_FILLED
		backcolor .1 .3 .4 .9
		border 1
		bordercolor .5 .7 .8 .8
		textaligny 11
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 35
		forecolor 1 1 1 1
		mouseEnter { setitemcolor weaponsAddTag backcolor .15 .45 .6 .95 }
		mouseExit { setitemcolor weaponsAddTag backcolor .1 .3 .4 .9 }
		action { play "sound/misc/kcswish.wav" ; uiScript armoryAddWeapon }
		visible 1
	}

