		itemDef {
		name packsback
		group campPacks
		textfont UI_FONT_BIG
		text "@CREDITS_BACK"
		type 1
		textscale .24
		style WINDOW_STYLE_FILLED
		rect 295 300 138 20
		textalign ITEM_ALIGN_CENTER
		textalignx 69
		textaligny 15
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .1
		visible 0
		border 1
		bordercolor .5 .5 .5 .5
		action { hide campPacks ; show campOptions }
		mouseEnter { setitemcolor packsback backcolor .5 .5 .5 .25 }
      	mouseExit { setitemcolor packsback backcolor .1 .1 .1 .1 }
	}

