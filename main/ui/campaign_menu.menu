					backcolor		0 0 0 0
					outlinecolor	.7 .7 .0 .25
					visible			1
					columns			1 2 190 35
					mouseEnter {

						}
					mouseExit {

						setitemcolor maplist bordercolor .5 .5 .5 .5 }
					}

