#include "ui/menudef.h"

{
// MAIN WINDOW

  menuDef {
    	name "campaign_menu"
    	visible MENU_FALSE
    	fullscreen 1
    	rect 0 0 640 480
		focusColor .9 .9 .9 1
    	style 1
    	border 1
      	style WINDOW_STYLE_FILLED
		forecolor 0 0 0 0
		backcolor 0 0 0 0

	onOpen {
		uiScript loadCampaignArenas ;
		setitemcolor fadebox backcolor 0 0 0 1 ;
		fadeout fadebox ;
		show back ;
		show campCreate ;
		show campOptions ;
	}

	onEsc {
		close campaign_menu;
		open main
	}

itemDef
	{
		name realrtcw_background
		style WINDOW_STYLE_SHADER
		rect -120 -9.25 917 500
		background "realrtcw_background"
		visible 1
		decoration
	}


itemDef
	{
		name realrtcw_logo
		style WINDOW_STYLE_SHADER
		rect -107 0 480 480
		background "ui/assets/realrtcw_logo.tga"
		visible 1
		decoration
	}


