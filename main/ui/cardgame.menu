	//////////////// result banner + bet / deal controls ////////////////

	itemDef {
		name resultText
		type ITEM_TYPE_OWNERDRAW
		ownerdraw UI_CARDGAME_RESULT
		textfont UI_FONT_BIG
		textscale .22
		textstyle 6
		textaligny 16
		rect 20 356 600 22
		forecolor 1 .9 .5 1
		visible 1
		decoration
	}

	// Backing plaque for the chips readout, matching the title bar's dark-plaque-with-gold-edge look.
	itemDef {
		name chipsPlaque
		rect 164 376 320 20
		style WINDOW_STYLE_FILLED
		backcolor .15 .13 .08 .6
		border 1
		bordercolor .6 .55 .35 .6
		visible 1
		decoration
	}

	itemDef {
		name chipsReadout
		type ITEM_TYPE_OWNERDRAW
		ownerdraw UI_CARDGAME_CHIPS
		textfont UI_FONT_BIG
		textscale .22
		textstyle 6
		textaligny 12
		rect 252 378 145 20
		forecolor 1 .85 .3 1
		visible 1
		decoration
	}

	itemDef {
		name betDownButton
		text "@CARDGAME_BET_MINUS"
		type ITEM_TYPE_BUTTON
		rect 290 400 30 26
		textscale .24
		style 1
		border 1
		bordersize 2
		bordercolor .55 .45 .25 .8
		backcolor .25 .1 .06 .55
		textaligny 18
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 15
		forecolor 1 1 1 1
		mouseEnter { setitemcolor betDownButton backcolor .4 .18 .1 .72 ; setitemcolor betDownButton bordercolor .85 .7 .35 1 }
		mouseExit { setitemcolor betDownButton backcolor .25 .1 .06 .55 ; setitemcolor betDownButton bordercolor .55 .45 .25 .8 }
		action { uiScript cardGameBetDown }
		visible 1
	}

	itemDef {
		name betUpButton
		text "@CARDGAME_BET_PLUS"
		type ITEM_TYPE_BUTTON
		rect 325 400 30 26
		textscale .24
		style 1
		border 1
		bordersize 2
		bordercolor .55 .45 .25 .8
		backcolor .12 .2 .08 .55
		textaligny 18
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 15
		forecolor 1 1 1 1
		mouseEnter { setitemcolor betUpButton backcolor .2 .32 .13 .72 ; setitemcolor betUpButton bordercolor .85 .7 .35 1 }
		mouseExit { setitemcolor betUpButton backcolor .12 .2 .08 .55 ; setitemcolor betUpButton bordercolor .55 .45 .25 .8 }
		action { uiScript cardGameBetUp }
		visible 1
	}

	itemDef {
		name dealButton
		text "@CARDGAME_DEAL"
		type ITEM_TYPE_BUTTON
		rect 410 400 60 26
		textscale .18
		style 1
		border 1
		bordersize 2
		bordercolor .55 .45 .25 .8
		backcolor .3 .2 .05 .6
		textaligny 18
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 30
		forecolor 1 1 1 1
		mouseEnter { setitemcolor dealButton backcolor .45 .32 .1 .78 ; setitemcolor dealButton bordercolor .85 .7 .35 1 }
		mouseExit { setitemcolor dealButton backcolor .3 .2 .05 .6 ; setitemcolor dealButton bordercolor .55 .45 .25 .8 }
		action { uiScript cardGameDeal }
		visible 1
	}

	itemDef {
		name continueButton
		text "@CARDGAME_NEXT"
		type ITEM_TYPE_BUTTON
		rect 478 400 60 26
		textscale .18
		style 1
		border 1
		bordersize 2
		bordercolor .55 .45 .25 .8
		backcolor .08 .14 .22 .55
		textaligny 18
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 30
		forecolor 1 1 1 1
		mouseEnter { setitemcolor continueButton backcolor .14 .22 .34 .72 ; setitemcolor continueButton bordercolor .85 .7 .35 1 }
		mouseExit { setitemcolor continueButton backcolor .08 .14 .22 .55 ; setitemcolor continueButton bordercolor .55 .45 .25 .8 }
		action { play "sound/cardgame/click.wav" ; uiScript cardGameContinue }
		visible 1
	}

	itemDef {
		name exitButton
		text "@CARDGAME_EXIT"
		type ITEM_TYPE_BUTTON
		rect 546 400 54 26
		textscale .18
		style 1
		border 1
		bordersize 2
		bordercolor .55 .45 .25 .8
		backcolor .22 .08 .06 .55
		textaligny 18
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 27
		forecolor 1 1 1 1
		mouseEnter { setitemcolor exitButton backcolor .35 .13 .1 .72 ; setitemcolor exitButton bordercolor .85 .7 .35 1 }
		mouseExit { setitemcolor exitButton backcolor .22 .08 .06 .55 ; setitemcolor exitButton bordercolor .55 .45 .25 .8 }
		action { play "sound/cardgame/click.wav" ; uiScript cardGameExit }
