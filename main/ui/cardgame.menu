#include "ui/menudef.h"
{

menuDef {
	name "cardgame"
	visible 0
	fullscreen 0
	rect 0 0 640 480
	focusColor 1 .75 0 1
	style 1
	border 1

	// Sized with a generous margin beyond the felt's own rect (20,54,600,404 below) to contain it reliably.
	itemDef {
		name background
		rect 8 8 624 464
		style WINDOW_STYLE_FILLED
		backcolor 0 .12 .04 .96
		border 1
		bordercolor .5 .5 .5 .6
		forecolor 1 1 1 1
		visible 1
		decoration
	}

	itemDef {
		name backgroundGradientTrim
		rect 8 8 624 464
		style WINDOW_STYLE_EMPTY
		border WINDOW_BORDER_KCGRADIENT
		bordersize 4
		bordercolor .8 .65 .3 1
		visible 1
		decoration
	}

	itemDef {
		name title
		text "@CARDGAME_TITLE"
		type ITEM_TYPE_TEXT
		textfont UI_FONT_BIG
		textscale .3
		textstyle 6
		rect 20 32 600 20
		textalign ITEM_ALIGN_CENTER
		textalignx 300
		textaligny 14
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor .15 .13 .08 .55
		border 1
		bordercolor .6 .55 .35 .5
		visible 1
		decoration
	}

	itemDef {
