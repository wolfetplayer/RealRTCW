#include "ui/menudef.h"

{
\\ SETUP MENU \\

menuDef {
    name "ingame_controls"
    visible 0
    fullscreen 0
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
	rect 200 100 500 340
    focusColor 1 1 1 1
    style 1
    border 1
	onClose {
	uiScript saveControls
	}
	onopen { hide grpControls ; show look ; uiScript loadControls }




itemDef {
	name window
	group ingamebox	
	rect 0 2 443 320
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 .5
	forecolor 1 1 1 1
	backcolor 0 0 0 .85
	visible 1
	decoration
}


itemDef {
    name keyBindStatus
    rect 0 400 320 15 
	ownerdraw UI_KEYBINDSTATUS
	text " "      
	forecolor 1 .75 0 1
	textscale .230
	textalignx 187
	textalign 1
	textaligny 10
	visible 0
    decoration 
	}


	itemDef 
	{
	name window
	group ingamebox2
	rect 2 4 439 20	
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .1 .1 .1 .2
	forecolor 1 1 1 1
	backcolor .3 0.6 0.2 .25 
	visible 1
	decoration
	}




#include "ui/ingame_controls_look.menu"
#include "ui/ingame_controls_move.menu"
#include "ui/ingame_controls_shoot.menu"
#include "ui/ingame_controls_misc.menu"

}


}
