// NOTE: fragment of the "ingame_controls" menuDef (ui/ingame_controls.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

itemDef {
	name ctr_look
	text "@LOOK"
	type 1
	textscale .23
	group grpControlbutton
	rect 30 3.5 45 20
	textalign 1
	textalignx 22
	textfont UI_FONT_BIG
	textaligny 14
	border 1
	bordercolor .1 .1 .1 0
	forecolor 1 1 1 1
	visible 1
	action { hide grpControls ; show look }
	mouseEnter { setitemcolor ctr_look backcolor .1 .37 .1 1 }
    mouseExit { setitemcolor ctr_look backcolor .37 .1 .1 1 }
	}

	    itemDef {
	    name look
		group grpControls
	    text "@MOUSE_SETTINGS"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 190 25 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}
	
		itemDef {
		name look
		group grpControls
		type ITEM_TYPE_SLIDER
		text "@MOUSE_SENS"
		cvarfloat "sensitivity" 5 1 30
		rect 82 50 290 12
		textalign ITEM_ALIGN_RIGHT
		textfont UI_FONT_BIG
		textalignx 142
		textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07            
		forecolor 1 1 1 1
		visible 0 
		mouseenter { show slider_message }
		mouseexit { hide slider_message }
    }
	
		itemDef {
		name look
		group grpControls
		type ITEM_TYPE_YESNO
		text "@MOUSE_INVERT"
		cvar "ui_mousePitch"
		rect 82 65 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142
		textaligny 10
		textscale .23 
		style WINDOW_STYLE_FILLED
		textfont UI_FONT_BIG
		backcolor 1 1 1 .07           
		forecolor 1 1 1 1
		visible 0 
		action { uiScript update ui_mousePitch }
		mouseenter { show yesno_message }
		mouseexit { hide yesno_message }
    }


