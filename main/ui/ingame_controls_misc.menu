// NOTE: fragment of the "ingame_controls" menuDef (ui/ingame_controls.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

itemDef {
	name ctr_miscellaneous
	text "@CONTROLS_MISC"
	type 1
	textscale .23
	group grpControlbutton
	textfont UI_FONT_BIG
	rect 372 3.5 45 20
//	rect 280 3.5 45 20
	textalign 1
	textalignx 22
	textaligny 14
	border 1
	bordercolor .1 .1 .1 0
	forecolor 1 1 1 1
	backcolor .1 .1 .1 0 
	visible 1
	action { hide grpControls ; show misc }
	mouseEnter { setitemcolor ctr_miscellaneous backcolor .1 .37 .1 1 }
      	mouseExit { setitemcolor ctr_miscellaneous backcolor .37 .1 .1 1 }
	}

		itemDef {
	    name misc
		group grpControls
	    text "@CONTROLS_ACTIONS"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 190 25 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    forecolor 1 1 1 1
	    visible 0
	}
	
		itemDef {
		name misc
		group grpControls
		type ITEM_TYPE_BIND
		text "@CONTROLS_ACTIVATE"
		cvar "+activate"
		rect 82 50 290 12
		textalign ITEM_ALIGN_RIGHT
		textfont UI_FONT_BIG
		textalignx 142
		textaligny 10
		textscale .23 
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07           
		forecolor 1 1 1 1
		visible 0 
		mouseenter { show keyBindStatus }
		mouseexit { hide keyBindStatus }
    }
	
