// NOTE: fragment of the "ingame_controls" menuDef (ui/ingame_controls.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

itemDef {
	name ctr_move
	text "@CONTROLS_MOVE"
	type 1
	textscale .23
	textfont UI_FONT_BIG
	group grpControlbutton
	rect 146 3.5 45 20
	textalign 1
	textalignx 22
	textaligny 14
	border 1
	bordercolor .1 .1 .1 0
	forecolor 1 1 1 1 
	backcolor .1 .1 .1 0
	visible 1
	action { hide grpControls ; show move }
	mouseEnter { setitemcolor ctr_move backcolor .1 .37 .1 1 }
      mouseExit { setitemcolor ctr_move backcolor .37 .1 .1 1 }
	}


	itemDef {
		name move
		group grpControls
		type ITEM_TYPE_BIND
		text "@CONTROLS_FWD"
		cvar "+forward"
		rect 82 30 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142
		textaligny 10
		textscale .23            
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		textfont UI_FONT_BIG
		visible 0 
		mouseenter { show keyBindStatus }
		mouseexit { hide keyBindStatus }
    		}
			
			
