// NOTE: fragment of the "ingame_controls" menuDef (ui/ingame_controls.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

itemDef {
	name ctr_shoot
	text "@CONTROLS_SHOOT"
	type 1
	textscale .23
	group grpControlbutton
	textfont UI_FONT_BIG
//	rect 200 3.5 45 20
rect 260 3.5 47 20
	textalign 1
	textalignx 22
	textaligny 14
	border 1
	bordercolor .1 .1 .1 0
	forecolor 1 1 1 1
	backcolor .1 .1 .1 0 
	visible 1
	action { hide grpControls ; show shoot }
	mouseEnter { setitemcolor ctr_shoot backcolor .1 .37 .1 1 }
      mouseExit { setitemcolor ctr_shoot backcolor .37 .1 .1 1 }
	}
		itemDef {
		name shoot				
		group grpControls
		type ITEM_TYPE_BIND
		text "@CONTROLS_ATTACK"
		cvar "+attack"
		rect 82 30 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142 
		textaligny 10
		textscale .23        
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		textfont UI_FONT_BIG
		visible 0 
		mouseenter { show keyBindStatus }
		mouseexit { hide keyBindStatus }
    }
	
