#include "ui/menudef.h"

{
\\ SETUP MENU \\

menuDef {
		name "ingame_options"
		visible 0
		fullscreen 0
		outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
		rect 200 100 443 340
		focusColor 1 1 1 1
		style 1
		border 1

		onopen { hide grpOptions ; show view }



itemDef 
	{
	name window
	group ingamebox
	rect 0 2 443 330	
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 .5
	forecolor 1 1 1 1
	backcolor 0 0 0 .85
	visible 1
	decoration
	}

	itemDef 
	{
		name window2
		group grpControlbutton
		rect 2 4 439 20	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .1 .1 .1 .2
		forecolor 1 1 1 1
		backcolor .3 0.6 0.2 .25 
		visible 1
		decoration
	}
	



#include "ui/ingame_options_gameplay.menu"
#include "ui/ingame_options_view.menu"
#include "ui/ingame_options_crosshair.menu"


}


}
