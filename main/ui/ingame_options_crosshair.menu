// NOTE: fragment of the "ingame_options" menuDef (ui/ingame_options.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

itemDef {
	name ctr_crosshair
	text "@VIEW"
	type 1
	textscale .23
	group grpControlbutton
	rect 270 10 100 12
	textalign 1
	textalignx 50
	textfont UI_FONT_BIG
	textaligny 10
	forecolor 1 1 1 1
	backcolor .1 .1 .1 0 
	visible 1
	action { hide grpOptions ; show crosshair }
	mouseEnter { setitemcolor ctr_performance backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor ctr_performance backcolor .37 .1 .1 1 }
	}
	
	
				itemDef {
	    name crosshair
		group grpOptions
	    text "@GM_CROSSHAIR"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 200 20 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}
	
	
    itemDef {
		name crosshair
		group grpOptions
		type ITEM_TYPE_MULTI
        textfont UI_FONT_BIG		
		text "@GM_CROSSHAIR_SIZE"
		cvar "cg_crosshairsize"
		cvarFloatList { "@GM_CROSSHAIR_SMALL" 24 "@GM_CROSSHAIR_MEDIUM" 32 "@GM_CROSSHAIR_BIG" 40 "@GM_CROSSHAIR_LARGE" 48 "@GM_CROSSHAIR_HUGE" 64 "@GM_CROSSHAIR_TINY" 12 }
		rect 82 40 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142
      	textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07        
      	forecolor 1 1 1 1
      	visible 0
    }

