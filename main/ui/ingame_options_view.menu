// NOTE: fragment of the "ingame_options" menuDef (ui/ingame_options.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

    itemDef {
	name ctr_view
	text "@HUD"
	type 1
	textscale .23
	group grpControlbutton
	rect 50 10 100 12
	textalign 1
	textalignx 50
	textfont UI_FONT_BIG
	textaligny 10
	forecolor 1 1 1 1
	backcolor .1 .1 .1 0 
	visible 1
	action { hide grpOptions ; show view }
	mouseEnter { setitemcolor ctr_view backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_view backcolor .37 .1 .1 1 }

}

		itemDef {
		name view
		group grpOptions
		type ITEM_TYPE_YESNO
		text "@HUD_ENABLE"
		cvar "cg_draw2D"
		rect 82 45 290 12
		textalign ITEM_ALIGN_RIGHT
		textfont UI_FONT_BIG
		textalignx 142
		textaligny 10
		textscale .23 
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07           
		forecolor 1 1 1 1
		visible 0 
    }
	
		itemDef {
		name view
		group grpOptions
		type ITEM_TYPE_MULTI
		text "@HUD_STYLE_INGAME"
		cvar "cg_hudstyle"
