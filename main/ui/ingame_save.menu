		action { 
			close save_overwrite_popmenu;
			open ingame_save
		}
		mouseEnter { setitemcolor overwrite_no backcolor .37 .37 .37 0 } 
		mouseExit { setitemcolor overwrite_no backcolor .37 .1 .1 0 } 		
		}


	}	// end menudef


