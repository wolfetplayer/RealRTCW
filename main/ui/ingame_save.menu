		textaligny 22
		forecolor 1 1 1 1
		visible 1
		action { uiScript Savegame2 }
		mouseEnter { setitemcolor overwrite_ok backcolor .37 .37 .37 0 } 
		mouseExit { setitemcolor overwrite_ok backcolor .37 .1 .1 0 } 		
		}

	itemDef {
		name overwrite_no
