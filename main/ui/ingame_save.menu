		open ingame_save
		}



	itemDef {
		name confirm
		text "@SAVEGAME_OVERWRITE"
		style 0
		textscale .24
		textfont UI_FONT_BIG
		textstyle 3
		rect 0 0 212 60
		textalign ITEM_ALIGN_CENTER
		textalignx 100
		textaligny 20
		decoration
		forecolor 1 1 1 1
		visible 1
		}



	itemDef {
		name overwrite_ok
		text "@SAVEGAME_OK"
