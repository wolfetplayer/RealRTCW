// NOTE: fragment of the "ingame_system" menuDef (ui/ingame_system.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

	itemDef {
		name ctr_graphics
	    text "@SYSTEM_DISPLAY"
		type 1	
		textscale .23
		group grpControlbutton
		background "ui/assets/button_back.tga"
		rect 10 10 100 12
		textfont UI_FONT_BIG
		textalign 1
		textalignx 50
		textaligny 10
		forecolor 1 1 1 1
 		visible 1
		action { hide grpSystem ; show graphics ; show graphicsapply }
		mouseEnter { setitemcolor ctr_graphics backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_graphics backcolor .37 .1 .1 1 }
		}


	    itemDef {
	    name graphics
		group grpSystem
	    text "@SYSTEM_DISPLAYSETTINGS"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 190 25 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}
	
		itemDef {
   		name graphics
		group grpSystem
   		type ITEM_TYPE_MULTI	
		text "@SYSTEM_RESOLUTION"
		cvar "r_mode"
		cvarFloatList {  "640*480" 3 "800*600" 4 "960*720" 5 "1024*768" 6 "1152*864" 7 "1280*1024" 8 "1600*1200" 9 "2048*1536" 10 "856*480" 11 }
//		"320*240" 0 "400*300" 1 "512*384" 2
		rect 82 50 290 12
      	textalign ITEM_ALIGN_RIGHT
		textfont UI_FONT_BIG
      	textalignx 142
      	textaligny 10
		textscale .22 
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07       
      	forecolor 1 1 1 1
      	visible 0 
		action { uiScript glCustom }
	}
	
		itemDef {
      	name graphics
		group grpSystem
      	type ITEM_TYPE_MULTI			
		text "@SYSTEM_ASPECTRATIO"
		cvar "cg_fixedaspect"
		cvarFloatList { "@OFF" 0 "4:3" 1 "@SYSTEM_WIDESCREEN" 2  }
		rect 82 65 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142
      	textaligny 10
		textscale .22   
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07     
      	forecolor 1 1 1 1
		textfont UI_FONT_BIG
      	visible 0 
		action { uiScript glCustom }
	}

	
	itemDef {
   		name graphics
		group grpSystem
      	type ITEM_TYPE_YESNO
		text "@SYSTEM_FULLSCREEN"
		cvar "r_fullscreen"
		rect 82 80 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142
      	textaligny 10
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
        textfont UI_FONT_BIG        
      	forecolor 1 1 1 1
      	visible 0 
		action { uiScript glCustom }
	}
	
		itemDef {
 		cvarTest "r_ignorehwgamma"
		textfont UI_FONT_BIG
		showcvar { "1" }
 		name graphics
		group grpSystem
      	type ITEM_TYPE_SLIDER
		text "@SYSTEM_BRIGHTNESS"
		cvarfloat "r_gamma" 1.3 0.5 3
		rect 82 110 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142 
      	textaligny 10
		textscale .22 
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07       
      	forecolor 1 1 1 1
      	visible 0 
		action { uiScript glCustom }
    }
	
    		
	itemDef {
 		cvarTest "r_ignorehwgamma"
		showcvar { "0" }
 		name graphics
		group grpSystem
      	type ITEM_TYPE_SLIDER
		textfont UI_FONT_BIG
		text "@SYSTEM_BRIGHTNESS"
		cvarfloat "r_gamma" 1 0.5 2
		rect 82 110 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142 
      	textaligny 10
		textscale .22 
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07       
      	forecolor 1 1 1 1
      	visible 0 
		action { uiScript glCustom }
    }
	
	    itemDef {
	    name graphics
		group grpSystem
	    text "@GM_MISC"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 190 125 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}
	
	
			itemDef {
		name graphics		
		group grpSystem
		type ITEM_TYPE_YESNO
		textfont UI_FONT_BIG
		text "@SYSTEM_VSYNC"
		cvar "r_swapinterval"
		rect 82 150 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142
      	textaligny 10
		textscale .23 
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07       
      	forecolor 1 1 1 1
      	visible 0 
