    }
	
		itemDef {
		name graphics	
		group grpSystem
		type ITEM_TYPE_YESNO
        textfont UI_FONT_BIG		
		text "@SYSTEM_SHOWFPS"
		cvar "cg_drawfps"
		rect 82 165 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142
      	textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07        
      	forecolor 1 1 1 1
      	visible 0
    }
	
		itemDef {
		name graphics			
		type ITEM_TYPE_MULTI
        textfont UI_FONT_BIG		
		group grpSystem
		text "@SYSTEM_MAXFPS"
		cvar "com_maxfps"
		cvarFloatList { "30 FPS" 30 "60 FPS" 60 "76 FPS" 76 "90 FPS" 90 "100 FPS" 100 "144 FPS" 144 "240 FPS" 240 }
		textalign ITEM_ALIGN_RIGHT
		rect 82 180 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142
		textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
	}



			


	itemDef {
		name graphicsapply
		text "@SYSTEM_APPLY"
		type 1	
		textscale .25
		style WINDOW_STYLE_FILLED
		textfont UI_FONT_BIG
		group grpsystem
		rect 181 280 100 20
		textalign 1
		textalignx 50
		textaligny 15
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .1 
		visible 1
		border 1
		bordercolor .5 .5 .5 .5
		action { play "sound/misc/kcaction.wav" ; 
open in_vid_restart_popmenu ; hide graphics ; hide graphicsapply ; hide iortcwgraphics }
		mouseEnter { setitemcolor graphicsapply backcolor .5 .5 .5 .25 }
      	mouseExit { setitemcolor graphicsapply backcolor .1 .1 .1 .1 }

		}

    		
