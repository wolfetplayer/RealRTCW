// NOTE: fragment of the "ingame_system" menuDef (ui/ingame_system.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

	itemDef {
	    name ctr_iortcw
	    text "@SYSTEM_GRAPHICS"
	    type 1
		textfont UI_FONT_BIG
	    textscale .23
	    group grpControlbutton
	    rect 120 10 100 12
		background "ui/assets/button_back.tga"
	    textalign 1
	    textalignx 50
	    textaligny 10
	    forecolor 1 1 1 1
 	    visible 1
	    action { hide grpsystem ; show iortcwgraphics ; show graphicsapply }
		mouseEnter { setitemcolor ctr_sound backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_sound backcolor .37 .1 .1 1 }
	}
	
    itemDef {
		name iortcwgraphics	
		group grpsystem
	    text "@SYSTEM_PRESET"
   	    type ITEM_TYPE_MULTI
	    textfont UI_FONT_BIG
	    cvar "ui_glCustom"
	    cvarFloatList { "@SYSTEM_ULTRA" 0 "@SYSTEM_HIGHQUALITY" 1 "@SYSTEM_NORMALQUALITY" 2 "@SYSTEM_LOWQUALITY" 3 "@SYSTEM_CUSTOMQUALITY" 4 }
	    cvarTest		"ui_glCustom"
	    hideCvar		{ "999" }	// 999 is 'recommended'
		rect 82 40 290 12
   	    textalign ITEM_ALIGN_RIGHT
   	    textalignx 142 
   	    textaligny 10
	    textscale .22
	    style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07     
      	forecolor 1 1 1 1
   	    visible 0 
	    action { uiScript update "ui_glCustom" }
	}

	itemDef {
		name iortcwgraphics	
		group grpsystem
		text "@SYSTEM_DEFAULTPRESET"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON	
		cvarTest		"ui_glCustom"
		showCvar		{ "999" }	// 999 is 'recommended'
		rect 82 40 290 12
		textalign ITEM_ALIGN_CENTER
		textalignx 142
		textaligny 10
		textscale .22
		backcolor 1 1 1 .07     
      	forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		visible 0
		action {setcvar ui_glCustom 0; uiScript update "ui_glCustom" }
	}
	
	
