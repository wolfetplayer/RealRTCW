// NOTE: fragment of the "ingame_system" menuDef (ui/ingame_system.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

		itemDef {
	    name ctr_perf
	    text "@PERFORMANCE"
	    type 1
		textfont UI_FONT_BIG
	    textscale .23
	    group grpControlbutton
	    rect 230 10 100 12
		background "ui/assets/button_back.tga"
	    textalign 1
	    textalignx 50
	    textaligny 10
	    forecolor 1 1 1 1
 	    visible 1
	    action { hide grpsystem ; show performancegraphics ; show graphicsapply }
		mouseEnter { setitemcolor ctr_sound backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_sound backcolor .37 .1 .1 1 }
	}
	
	
			itemDef {
		name performancegraphics
		group grpsystem
		text "@PERF_WALLMARK"
		type ITEM_TYPE_MULTI
        textfont UI_FONT_BIG		
		cvar "cg_markTime"
        cvarFloatList {"@PERF_MARK_NORMAL" 20000 "@PERF_MARK_SHORT" 10000 "@OFF" 0 "@PERF_MARK_LONG" 30000 "@PERF_MARK_VERYLONG" 99999  }
		rect 82 35 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142
		textaligny 10
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0 
    }

