// NOTE: fragment of the "ingame_system" menuDef (ui/ingame_system.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

	itemDef {
		name ctr_sound
	    text "@SOUND"
		type 1
		textscale .23
		group grpControlbutton
		rect 340 10 100 12
		textalign 1
		textalignx 50
		textfont UI_FONT_BIG
		textaligny 10
		forecolor 1 1 1 1
		backcolor .1 .1 .1 0 
		visible 1
		action { hide grpSystem ; show sound }
		mouseEnter { setitemcolor ctr_sound backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_sound backcolor .37 .1 .1 1 }
	}
	
		 itemDef {
	    name sound
		group grpSystem
	    text "@SOUND_SETTINGS"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 190 25 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}

	itemDef {
	    name sound
		group grpsystem
		type ITEM_TYPE_SLIDER
		textfont UI_FONT_BIG
		text "@SOUND_EFFECTS"
		cvarfloat "s_volume" 0.7 0 1
		rect 82 50 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142
		textaligny 10
		textscale .22    
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07   
		forecolor 1 1 1 1
		visible 0 
    }
	
