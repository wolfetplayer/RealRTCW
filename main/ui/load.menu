		textsavegame	// get text from current savegame file
		autowrapped
		rect 492 300 200 60
		backcolor 1 1 1 .25
//		border 1
//		bordersize 1
//		bordercolor .1 .1 .1 .7
        textfont UI_FONT_BIG
		visible MENU_TRUE
		textalign ITEM_ALIGN_CENTER
		textscale .25
//		textfont UI_FONT_HANDWRITING
		textfont UI_FONT_BIG
		textstyle 6
