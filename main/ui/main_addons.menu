		textalignx 0
		textaligny -8
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 0.8
		outlinecolor .45 .45 .45 .20
		visible 0
		doubleClick { uiScript RunMod }
	}

