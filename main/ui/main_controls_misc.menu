    itemDef {
	    name miscbutton
	    text "@CONTROLS_MISC"
	    type 1
	    textscale .23
	    group controlbuttons
	    style WINDOW_STYLE_FILLED
		textfont UI_FONT_BIG
	    rect 590 105 45 20
	    textalign 1
	    textalignx 22
	    textaligny 14
	    border 1
	    bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    backcolor .1 .1 .1 0 
	    visible 0
	    action { hide controls ; show misc }
	    mouseEnter { show message_misc ; setitemcolor miscbutton backcolor .3 .3 .3 0 } 
	    mouseExit { hide message_misc ; setitemcolor miscbutton backcolor .1 .1 .1 0} 
	}
	
		itemDef {
	    name misc
		group controls
