// NOTE: fragment of the "main" menuDef (ui/main.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////               SHOOT CONTROLS MENU          //////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    itemDef {
	    name shootbutton
	    text "@CONTROLS_SHOOT"
	    type 1
	    textscale .23
	    group controlbuttons
	    type ITEM_TYPE_BUTTON
	    style WINDOW_STYLE_FILLED
	    background "ui/assets/button_back.tga"
	    rect 470 105 47 20
	    textalign 1
	    textalignx 22
	    textaligny 14
		textfont UI_FONT_BIG
	    border 1
	    bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    backcolor .1 .1 .1 0 
	    visible 0
	    action { hide controls ; show shoot ; show advancedshootbutton }
	    mouseEnter { show message_shoot ; setitemcolor ctr_shoot backcolor .3 .3 .3 0 } 
	    mouseExit { hide message_shoot ; setitemcolor ctr_shoot backcolor .1 .1 .1 0 }
	}
	
	itemDef {
		name shoot				
		group controls
		type ITEM_TYPE_BIND
		text "@CONTROLS_ATTACK"
		cvar "+attack"
		rect 300 135 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142 
		textaligny 10
		textscale .23        
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		textfont UI_FONT_BIG
		visible 0 
		mouseenter { show keyBindStatus }
		mouseexit { hide keyBindStatus }
    }
	
