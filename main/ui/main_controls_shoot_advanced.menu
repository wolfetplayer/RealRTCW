    itemDef {
	    name advancedshootbutton
	    text "@CONTROLS_SHOOT_ADVANCED"
	    type 1
	    textscale .25
	    group controls
	    style WINDOW_STYLE_FILLED
	    rect 395 380 80 18
	    textalign 1
	    textalignx 36
	    textaligny 12
	    forecolor 1 1 1 1
	    backcolor .3 0.6 0.2 .25 
	    border 1
	    bordercolor .1 .1 .1 0
	    visible 0
		textfont UI_FONT_BIG
	    action { hide controls ; show shoot_advanced }
	}

	itemDef {
		name shoot_advanced
		group controls
		type ITEM_TYPE_BIND
		text "@CONTROLS_ALTFIRE"
		cvar "+attack2"
		rect 300 135 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 176
		textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07        
		forecolor 1 1 1 1
		textfont UI_FONT_BIG
		visible 0 
		mouseenter { show keyBindStatus }
		mouseexit { hide keyBindStatus }
    }
	
