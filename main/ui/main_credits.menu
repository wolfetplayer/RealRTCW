	itemDef {
		name credits1
		group credits
		rect 205 100 440 350	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .8
		visible 0
		decoration
	}
	
	itemDef {
		name credits1
		text "@CREDITS_PSYCHO"
		type 1
	    group credits
		textscale .3
		style WINDOW_STYLE_FILLED		
		rect 530 410 100 20
		textalign 1
		textalignx 48
		textfont UI_FONT_BIG
		textaligny 14
		backcolor .5 0.0 0.0 .25
		forecolor 1 0 0 1
		border 1
		bordercolor .1 .0 .0 .3
		visible 0
		action { setCvar g_gameskill "1" ; exec "spmap w3d" }		
	}
	
	
