// NOTE: fragment of the "main" menuDef (ui/main.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

		itemDef {
	    name content_packs
		group options
	    text "@HDASSETS"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 410 125 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}
	
