		itemDef {
		name crosshair
		group options
	    text "@GM_CROSSHAIR"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 410 125 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}
	
    itemDef {
		name crosshair
		group options
		type ITEM_TYPE_MULTI
        textfont UI_FONT_BIG		
