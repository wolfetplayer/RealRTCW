	itemDef {
		name graphicsapply
		textfont UI_FONT_BIG
		text "@SYSTEM_APPLY"
		type 1	
		textscale .25
		style WINDOW_STYLE_FILLED
		group system
		rect 395 390 100 20
		textalign 1
		textalignx 50
		textaligny 15
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .1 
		visible 0
		border 1
		bordercolor .5 .5 .5 .5
		action { exec "vid_restart"  }
		mouseEnter { setitemcolor graphicsapply backcolor .5 .5 .5 .25 }
      	mouseExit { setitemcolor graphicsapply backcolor .1 .1 .1 .1 }
	}
	
	
