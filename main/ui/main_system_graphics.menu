// NOTE: fragment of the "main" menuDef (ui/main.menu), pulled in via #include. Not a standalone menu - do not add to menus.txt.

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////               GRAPHICS SYSTEM MENU          //////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	    itemDef {
	    name systembutton
	    text "@SYSTEM_GRAPHICS"
	    type ITEM_TYPE_BUTTON
		textfont UI_FONT_BIG
	    textscale .23
	    group systemmenus
	    style WINDOW_STYLE_FILLED
	    rect 335 105 45 20
	    textalign 1
	    textalignx 22
	    textaligny 14
	    forecolor 1 1 1 1
 	    visible 0
	    action { hide system ; show iortcwgraphics ; show graphicsapply }
	}

    itemDef {
    	name iortcwgraphics				
	    group system
	    text "@SYSTEM_PRESET"
   	    type ITEM_TYPE_MULTI
	    textfont UI_FONT_BIG
	    cvar "ui_glCustom"
	    cvarFloatList { "@SYSTEM_ULTRA" 0 "@SYSTEM_HIGHQUALITY" 1 "@SYSTEM_NORMALQUALITY" 2 "@SYSTEM_LOWQUALITY" 3 "@SYSTEM_CUSTOMQUALITY" 4 }
	    cvarTest		"ui_glCustom"
	    hideCvar		{ "999" }	// 999 is 'recommended'
	    rect 300 140 290 12
   	    textalign ITEM_ALIGN_RIGHT
   	    textalignx 142 
   	    textaligny 10
	    textscale .22
	    style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07     
      	forecolor 1 1 1 1
   	    visible 0 
	    action { uiScript update "ui_glCustom" }
	}

	itemDef {
		name iortcwgraphics				
		group system
		text "@SYSTEM_DEFAULTPRESET"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON	
		cvarTest		"ui_glCustom"
		showCvar		{ "999" }	// 999 is 'recommended'
		rect 300 140 290 12
		textalign ITEM_ALIGN_CENTER
		textalignx 142
		textaligny 10
		textscale .22
		backcolor 1 1 1 .07     
      	forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		visible 0
		action {setcvar ui_glCustom 0; uiScript update "ui_glCustom" }
	}

