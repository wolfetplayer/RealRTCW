		itemDef {
	    name systembutton
	    text "@PERFORMANCE"
	    type ITEM_TYPE_BUTTON
		textfont UI_FONT_BIG
	    textscale .23
	    group systemmenus
	    style WINDOW_STYLE_FILLED
		rect 420 105 47 20
	    textalign 1
	    textalignx 22
	    textaligny 14
	    forecolor 1 1 1 1
 	    visible 0
	    action { hide system ; show performancegraphics ; hide graphicsapply }
	}
	
		itemDef {
	    name performancegraphics
		group system
	    text "@GM_MISC"
	    textscale .25
		decoration
	    style WINDOW_STYLE_FILLED
	    rect 410 125 290 12
	    textalign 1
		textfont UI_FONT_BIG
	    textalignx 22
	    textaligny 14
	    border 1
	    //bordercolor .1 .1 .1 0
	    forecolor 1 1 1 1
	    visible 0
	}
	
