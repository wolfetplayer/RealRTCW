#include "ui/menudef.h"
{

	assetGlobalDef {
//		cursor "gfx/2d/usablehint.tga"			// cursor	
	}



menuDef {
	name "notebook"
   	visible 0
   	fullscreen 0
   	rect 0 0 640 480
	focusColor 1 .75 0 1
   	style 1
   	border 1
	onOpen
	{
	play "sound/notebook/book_open.wav";
	setitemcolor button_prev forecolor 1 1 1 .9;
	setitemcolor button_next forecolor 1 1 1 .9;
	hide debrief;
	hide "page*";
	showpage 0 }
	
	// showpage 0 - show currently active page
	
	onESC { play "sound/notebook/book_close.wav" }


//	BUTTONS	//

itemDef {
	name background
	
	cvarTest "cg_hudStyle"
	showCvar { "1" }
	
	rect -18 23 674 433	// centered
	style WINDOW_STYLE_SHADER
	background "ui/assets/wolf09/notebook1.tga"
	forecolor 1 1 1 1
	visible 1
	decoration
	}

itemDef {
	name background
	
	cvarTest "cg_hudStyle"
	hideCvar { "1" }
	
	rect 20 30 600 420	// centered
	style WINDOW_STYLE_SHADER
	background "ui/assets/notebook1.tga"
	forecolor 1 1 1 1
	visible 1
	decoration
	}



itemDef {
	name button_prev
	
	cvarTest "cg_hudStyle"
	showCvar { "1" }
	
	type 1
	textscale .25
	group grpControlbutton
	type ITEM_TYPE_BUTTON
	style WINDOW_STYLE_SHADER
	background "ui/assets/wolf09/pageturn.tga"
	rect 26 365 64 64
	textalign 1
	textalignx 22
	textaligny 20
	forecolor 1 1 1 .9
	backcolor .37 .1 .1 1
	visible 1
	action { play "sound/notebook/book_pageflip.wav"; hide debrief; showpage "-1" }	// go to previous available page
	mouseEnter { setitemcolor button_prev forecolor 1 1 1 1 } 
	mouseExit { setitemcolor button_prev forecolor 1 1 1 .9 } 
	}

itemDef {
	name button_prev
	
	cvarTest "cg_hudStyle"
	hideCvar { "1" }
	
	type 1
	textscale .25
	group grpControlbutton
	type ITEM_TYPE_BUTTON
	style WINDOW_STYLE_SHADER
	background "ui/assets/pageturn.tga"
	rect 29 380 64 64
	textalign 1
	textalignx 22
	textaligny 20
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	action { play "sound/notebook/book_pageflip.wav"; hide debrief; showpage "-1" }	// go to previous available page
	mouseEnter { setitemcolor button_prev backcolor .1 .37 .1 1 } 
	mouseExit { setitemcolor button_prev backcolor .37 .1 .1 1 } 
	}



