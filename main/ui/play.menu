#include "ui/menudef.h"

{
\\ play MENU \\

menuDef {
    name "play_menu"
    visible MENU_FALSE
    fullscreen 1
    rect 0 0 640 480
	 //background "menu_load"
    soundloop ""
    focusColor .9 .9 .9 1
    style 1
    border 0

	onEsc 
	{
		close play_menu;
		open main
	}

	onOpen {
		setitemcolor fadebox backcolor 0 0 0 1 ;
		//close load_menu;		
		play "sound/misc/kcswish.wav";

		fadeout fadebox;
		
		// 5.1 //
		show realrtcw_main_play;
		hide select;
		//
		
		hide realrtcw_play;
		hide realrtcw_play_2;
		hide realrtcw_play_skill0;
		hide realrtcw_play_skill1;
		hide realrtcw_play_skill2;
		hide realrtcw_play_skill3;
		hide realrtcw_play_skill4;
		hide realrtcw_play_back;
		
		hide realrtcw_play_bonus; 
		hide realrtcw_skills_bonus;
		hide realrtcw_walkpark;
		hide realrtcw_ironman;
		hide realrtcw_hardcore;
		hide realrtcw_999;
		hide realrtcw_nightmare;
		hide realrtcw_bonus_back;
		
		hide realrtcw_chapters; // 5.1 //
		// 5.1 // show realrtcw_chapters;
		hide realrtcw_chapter1;
		hide realrtcw_chapter2;
		hide realrtcw_chapter3;
		hide realrtcw_chapter4;
		hide realrtcw_chapter5;
		hide realrtcw_chapter6;
		hide realrtcw_chapter7;
		hide realrtcw_chapters_back;
		
		hide chapter1_play;
		hide chapter2_play;
		hide chapter3_play;
		hide chapter4_play;
		hide chapter5_play;
		hide chapter6_play;
		hide chapter7_play;
		
		hide chapter1_bonus;
		hide chapter2_bonus;
		hide chapter3_bonus;
		hide chapter4_bonus;
		hide chapter5_bonus;
		hide chapter6_bonus;
		hide chapter7_bonus;
		hide realrtcw_campaign_customize
	}
