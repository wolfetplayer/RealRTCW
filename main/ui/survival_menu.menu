#include "ui/menudef.h"

{
// MAIN WINDOW

  menuDef {
    	name "survival_menu"
    	visible MENU_FALSE
    	fullscreen 1
    	rect 0 0 640 480
		focusColor .9 .9 .9 1
    	style 1
    	border 1
      	style WINDOW_STYLE_FILLED
		forecolor 0 0 0 0
		backcolor 0 0 0 0

	onOpen {
		uiScript loadArenas ;
		setitemcolor fadebox backcolor 0 0 0 1 ; 
		fadeout fadebox ;
		setitemcolor easy backcolor .7 .7 .0 .25 ;
		show back ;
		show srvCreate ;
		uiScript skill_surv ;
	}

	onEsc {
		close survival_menu;
		open main
	}

itemDef
