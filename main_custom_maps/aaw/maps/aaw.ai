//////////////////////////////////
// Prisoners script starts here///
///////////////////////////////////

pow1
{
	attributes
	{
		tactical 0.0
		alertness 0.0
		fov 360
		hearing_scale 0.0
		attack_crouch 0.0
		attack_skill 0.0
		aim_skill 0.0
		agression 0.0
		inner_detection_radius 0.0
	}

	spawn
	{
		noavoid
		nosight 999999
		statetype relaxed
		takeweapon all
		trigger pow1 marchloop 		// This will begin the Marching loop.
	}

    trigger marchloop
    {
      facetargetangles pow1-1
	  walktomarker pow1-1 nostop
	  facetargetangles pow1-2
      walktomarker pow1-2 nostop
      facetargetangles b1d1_out
      walktomarker b1d1_out nostop
      facetargetangles b1d1_in
      walktomarker b1d1_in nostop
      facetargetangles pow1-3
      walktomarker pow1-3
      facetargetangles pow1-2
      playsound pow_cough
      wait 5000
      facetargetangles b1d1_in
      walktomarker b1d1_in nostop
      facetargetangles b1d1_out
      walktomarker b1d1_out nostop
      facetargetangles pow1-2
      walktomarker pow1-2 nostop
      playsound pow_cough
      wait 5000
      trigger pow1 marchloop 		// Restarts the marching loop.
    }

	blocked player
	{
		deny
		pushaway player
	}

	activate player
	{
		wait 5000
	}

	death player
	{
		missionfailed 8 12
	}
}

pow2
{
	attributes
	{
		tactical 0.0
		alertness 0.0
		fov 360
		hearing_scale 0.0
		attack_crouch 0.0
		attack_skill 0.0
		aim_skill 0.0
		agression 0.0
		inner_detection_radius 0.0
	}

	spawn
	{
		noavoid
		nosight 999999
		statetype relaxed
		takeweapon all
		trigger pow2 marchloop // This will begin the Marching loop.
	}

    trigger marchloop
    {
      facetargetangles pow2-1
	  walktomarker pow2-1 nostop
	  facetargetangles pow2-2
	  playsound pow_cough
      wait 10000
	  walktomarker pow2-2 nostop
	  facetargetangles pow2-1
	  walktomarker pow2-1 nostop
	  facetargetangles pow2-3
	  playsound pow_cough
	  wait 10000
	  walktomarker pow2-3 nostop
	  facetargetangles pow2-4
	  walktomarker pow2-4 nostop
	  facetargetangles pow2-5
	  playsound pow_cough
	  wait 10000
	  trigger pow2 marchloop // Restarts the marching loop.
    }

    blocked player
	{
		deny
		pushaway player
	}

	activate player
	{
		wait 5000
	}

	death player
	{
		missionfailed 8 12
	}
}

