//////////////////////////////////////////////////////////

// If you have any questions, remarks about this map meet me
// at the Tram design forum - http://www.planetwolfenstein.com/tramdesign
// Or visit my site at: http://kos.nem3d.net

// You are free to copy want you want from this script as long as you don`t profit from that.


player 										//Player info
{
	spawn
	{
		cvar g_episode 7
		objectivesneeded 2

		abort_if_loadgame
		accum 0 bitset 3 					// mission objective
		}

	playerstart
	{
		applyloadout aaw
		cvar g_level_was_selected 0
	}

	trigger cementary1						//Triggers when player destroy wall at cementary
	{
		alertentity grave_nazi1
		trigger grave_nazi1 lookplayer
		alertentity grave_nazi2
		trigger grave_nazi2 lookplayer
		alertentity grave_drz1
		trigger grave_drz1 lookplayer
		alertentity grave_officer1
	}

		trigger cementary2						// Triggers nazi attack at cementary (8 nazis)
	{
		mu_fade 0 5000
		mu_start sound/music/s_highramp.wav 4000
		mu_start sound/music/m_situation.wav 5000
		alertentity grave_nazi3
		alertentity grave_nazi4
		alertentity grave_nazi5
		alertentity grave_nazi6
		trigger grave_nazi3 cementary_attack
		trigger grave_nazi4 cementary_attack
		trigger grave_nazi5 cementary_attack
		trigger grave_nazi6 cementary_attack
		trigger music1
	}

		trigger underground_passage0				// Triggers nazi hiding behind crates
	{
		alertentity underground_passage1_nazi5
	}

		trigger underground_passage1				// Triggers nazi underground charge (4 nazis)+3 hiding
	{
		alertentity underground_passage1_nazi1
		alertentity underground_passage1_nazi2
		alertentity underground_passage1_nazi3
		alertentity underground_passage1_nazi4
		alertentity underground_passage1_nazi6		// 1 nazi hiding (no trigger action)
		alertentity underground_passage1_nazi7		// 1 nazi hiding (no trigger action)
		alertentity underground_passage1_nazi8		// 1 nazi hiding (no trigger action)
		trigger underground_passage1_nazi1 charge
		trigger underground_passage1_nazi2 charge
		trigger underground_passage1_nazi3 charge
		trigger underground_passage1_nazi4 charge
	}

/////////////////////////// Music trigers///////////////////

	trigger music_stop				//STOP !!!!!!!!!!
	{
	mu_stop 1000
	}

	trigger music1				//Entering barak
	{
	mu_play sound/music/s_query.wav 0
	}

	trigger music2 				//Entering cementary1
	{
	mu_fade 0 5000
	mu_start /sound/music/m_grave.wav 3000
	}

	trigger music3 				//Entering cementary2
	{
	mu_fade 0 3000
	mu_queue /sound/music/m_action.wav 3000
	}

	trigger music4 				//entering catacombs
	{
	mu_fade 0 5000
	mu_queue /sound/music/m_tension.wav
	}

/////////////////////Sicred triggers////////////////////////////
	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

/////////////////////////Objectives////////////////////////
	trigger objective_1
	{
		objectivemet 1				// mission objective complete
	}

	trigger objective_2
	{
		objectivemet 2				// mission objective complete
	}

/////////////////////////end map////////////////////////
	trigger endmap
	{
		changelevel aaw2 persistent
	}
}

/////////////////////////////////////////////////////////////
///////////// Graveyard AI's start here (12 AIs) ////////////
////////////////////////////////////////////////////////////

grave_nazi1
{
	attributes
	{
		fov 300
		aim_skill 0.5
		attack_skill 1.0
		inner_detection_radius 15000
		alertness 15000
		hearing_scale 0.8
		inner_detection_radius 15000
		Aggression 0.8
		tactical 1.0
	}

	spawn
	{
		giveweaponfull weapon_luger
		setammo ammo_grenades 3

	}

	trigger lookplayer
	{
		explicit_routing on
		facetargetangles cementary_lookplayer1
		runtomarker cementary_lookplayer1 nostop
		statetype alert
		wait forever
		resetscript
	}

	death
	{
		alertentity remove_grave_nazi1
	}
}

grave_officer1							// Boss of Camp A ??? Having only luger ???
										// he is strong in nazi powers ???
