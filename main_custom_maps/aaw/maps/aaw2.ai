ammo_nazi8
{
	attributes
	{
		aim_accuracy 0.5
		aim_skill 0.5
		attack_skill 0.5
		inner_detection_radius 0
		alertness 0
		hearing_scale 0.0
		Aggression 0.8
		tactical 0.4
		}

	spawn
	{
		nosight 999999
		sethealth 25
		noaidamage on
		takeweapon all
		giveweapon weapon_mp44
		setammo ammo_44ammo 999
		selectweapon weapon_mp44
	}

		trigger mg_42_use
	{
		explicit_routing on
		facetargetangles ammo_mg2_1
		runtomarker ammo_mg2_1 nostop
		facetargetangles ammo_mg2_2
		runtomarker ammo_mg2_2 nostop
		facetargetangles ammo_mg2_0
		mount ammo_mg2
		sight
		attrib inner_detection_radius 3000
		attrib alertness 3000
		attrib hearing_scale 0.5
	}

	trigger unmount_mg_42
	{
		unmount
		attrib fov 360
		resetscript
	}

	forced_mg42_unmount
	{
		deny
	}

	death
	{
		alertentity ammo_nazi9
		alertentity remove_ammo_nazi8
	}
}

