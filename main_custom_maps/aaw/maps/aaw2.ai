player 										//Player info
{
	spawn
	{
		cvar g_episode 8
		objectivesneeded 2

		abort_if_loadgame
	}

	playerstart
	{
		mu_fade 0 5000
		mu_queue sound/music/m_drums

		// Weapons							//delete after level finish
//		takeweapon all						//delete after level finish
//		giveweapon weapon_mauserRifle		//delete after level finish
//		giveweapon weapon_sniperscope		//delete after level finish
//		giveweapon weapon_luger				//delete after level finish
//		giveweapon weapon_mp40				//delete after level finish
//		selectweapon weapon_mp40			//delete after level finish

		// Ammo								//delete after level finish
//		setammo ammo_grenades 3				//delete after level finish
//		setammo ammo_9mm 250				//delete after level finish
//		setammo ammo_792mm 150				//delete after level finish


		// Items							//delete after level finish
//		setarmor 25							//delete after level finish
//		giveinventory key_binocs			//delete after level finish
	}


	trigger kill_ammo_mg1
	{
		alertentity kill_at_ones_nazi_trap1
		alertentity kill_at_ones_nazi_trap2
	}


	trigger unmount_mg2
	{
		trigger ammo_nazi8 unmount_mg_42
		alertentity remove_at_ones_ammo_nazi9
		alertentity remove_at_ones_ammo_nazi10
		alertentity remove_at_ones_ammo_nazi11

		// trigger ammo_nazi9 go_teleport
		// trigger ammo_nazi10 go_teleport
		// trigger ammo_nazi11 go_teleport
	}

	trigger unmount_ammo_mg3
	{
		mu_play sound/music/s_bighits 0
		trigger player music_stop
		trigger ammo_nazi12 free_ammo_mg3
		trigger ammo_nazi13 free_ammo_mg3
	}

	trigger objective1
	{
		objectivemet 1								// mission objective 1 complete
	}

	trigger objective2
	{
		objectivemet 2								// mission objective 2 complete
	}

	trigger nazi_trap								//Nazi trap at the barel
	{
		alertentity nazi_trap1
		trigger nazi_trap1 charge
	}

	trigger ammo_depot_1							// Entering ammo depot 1
	{
		alertentity ammo_nazi1
		alertentity ammo_nazi2
		alertentity ammo_nazi3
		alertentity ammo_nazi3_patrol
	}

	trigger ammo_depot_2							// Nazi charge in ammo depot 2
	{
		alertentity ammo_nazi4
		alertentity ammo_nazi5
		alertentity ammo_nazi6
		alertentity ammo_nazi7
		trigger ammo_nazi4 charge
		trigger ammo_nazi5 charge
		trigger ammo_nazi6 charge
		trigger ammo_nazi7 charge
	}

	trigger ammo_depot_3							// Nazi at mg42 at the end of hallway ammo depot2
	{
		alertentity ammo_nazi8
		alertentity ammo_nazi12
		trigger ammo_nazi8 mg_42_use
	}

	trigger hiding_ammo_main						//Nazi hiding at ammo main facility
	{
		alertentity Ammo_facility_hiding_1
		alertentity Ammo_facility_hiding_2
		alertentity Ammo_facility_hiding_3

	}

	trigger Ammo_main_charge1						//Nazi ambush 1
	{
		alertentity Ammo_main_charge1_nazi1
		alertentity Ammo_main_charge1_nazi2
		alertentity Ammo_main_charge1_nazi3
		trigger Ammo_main_charge1_nazi1 charge
		trigger Ammo_main_charge1_nazi2 charge
		trigger Ammo_main_charge1_nazi3 charge
	}

	trigger airplane_workers 						// workers at airplane

	{
		alertentity airplane_worker_1
		alertentity airplane_worker_2
	}

	trigger airplane_worker_officer_trigger 		// workers at airplane - officer
	{
		alertentity airplane_worker_officer
	}

	trigger airplane_worker_liftman_trigger			// liftman
	{
		alertentity airplane_worker_liftman
	}


/////////////////////////// Music trigers///////////////////

	trigger music_stop				//STOP !!!!!!!!!!
	{
		wait 10000
		mu_stop 0 5000
	}

	trigger music1
	{
		mu_fade 0 3000
		mu_queue /sound/music/m_action.wav
	}

	trigger music2  						// After the plain
	{
		mu_fade 0 2000
		mu_queue /sound/music/l_theme.wav
	}

	trigger music3
	{
		mu_play /sound/music/s_longout.wav 0
	}

	trigger music4
	{
		mu_play /sound/music/s_lowramp.wav 0
	}

/////////////////////////sicreds////////////////////////

	trigger sicred1
	{
		foundsecret
	}

/////////////////////////end map////////////////////////
	trigger endmap
	{
		changelevel aaw3 4000 persistent
	}
}

/////////////////////////////////////////////////////////////
///////////// Nazi at barel trap/////////////// /////////////
/////////////////////////////////////////////////////////////

nazi_trap1
{
	attributes
	{
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.2
		attack_crouch 0.5
		Aggression 0.8
		tactical 0.5
		inner_detection_radius 3000
		alertness 3000
		hearing_scale 0.5
	}

	spawn
	{
		sethealth 25
		takeweapon all
		setammo ammo_grenades 3
		setammo ammo_9mm 999
		giveweapon weapon_mp40
		selectweapon weapon_mp40
	}

	trigger charge
	{
	explicit_routing on
	runtomarker nazi_trap1_1 nostop
	facetargetangles trap
	mount ammo_mg1
	wait forever
	}

	forced_mg42_unmount
	{
	deny
	}

	death
	{
	alertentity nazi_trap2
	alertentity remove_nazi_trap1
	}
}

nazi_trap2
{
	attributes
	{
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.2
		attack_crouch 0.5
		Aggression 0.8
		tactical 0.5
		inner_detection_radius 2000
		alertness 2000
		hearing_scale 0.5
	}

	spawn
	{
		sethealth 25
		takeweapon all
		setammo ammo_grenades 3
		setammo ammo_9mm 999
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		trigger nazi_trap2 charge
	}

	trigger charge
	{
	explicit_routing on
	runtomarker nazi_trap1_1 nostop
	facetargetangles trap
	mount ammo_mg1
	wait forever
	}

	forced_mg42_unmount
	{
	deny
	}

	death
	{
	alertentity remove_nazi_trap2
	}
}

/////////////////////////////////////////////////////////////
///////////// Nazi at checkpoint/////////////// /////////////
/////////////////////////////////////////////////////////////

checkpoint_nazi

{
	attributes
	{
		aim_accuracy 0.4
		starting_health 25
		hearing_scale 0.8
		aggression 0.8
	}

	spawn
	{
		setammo ammo_grenades 3
		takeweapon all
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger

		trigger checkpoint_nazi play_animation1

	}

	trigger play_animation1
	{
	playanim looking_over_table both
	playsound whistle
	trigger checkpoint_nazi play_animation1					//restarts anim.
	}

	enemysight
	{
		resetscript
		playsound MiscStopHim
	}

	inspectsoundstart
	{
		resetscript
	}

	death
	{
		alertentity remove_checkpoint_nazi
	}
}

/////////////////////////////////////////////////////////////
///////////// Nazi at hallway to Ammo depot 1 //////////////////////////
/////////////////////////////////////////////////////////////

nazi1_hallway_to_ammo_1

{
	attributes
	{
		starting_health 25
	}

	spawn
	{
		// takeweapon mp40
		// fireattarget
		// giveweapon weapon_grenadelauncher
		// selectweapon weapon_grenadelauncher
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		setammo ammo_grenades 999
		trigger nazi1_hallway_to_ammo_1 talk
	}

	// trigger toss_grenade
	// {
	//	crouchtomarker ???
	//	selectweapon weapon_grenadelauncher
	//	fireattarget ???? 3000
	//	selectweapon weapon_sten
	// }


	trigger talk
	{
		wait 3000
		playsound talk_1
		wait 6000
		playsound talk_2
		trigger nazi2_hallway_to_ammo_1 talk
	}

	enemysight
	{
		takeweapon weapon_mp40
		giveweapon weapon_grenadelauncher
		selectweapon weapon_grenadelauncher
		fireattarget ammo1_grenade_target1 5000
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		trigger nazi1_hallway_to_ammo_1 grenade_loop
		}

		trigger grenade_loop
		{
		wait 10000
		selectweapon weapon_grenadelauncher
		fireattarget ammo1_grenade_target1 3000
		selectweapon weapon_mp40
		trigger nazi1_hallway_to_ammo_1 grenade_loop //  restart loop
		}

	death
	{
		alertentity remove_nazi1_hallway_to_ammo_1
	}
}

nazi2_hallway_to_ammo_1

{
	attributes
	{
		starting_health 25
	}

	spawn
	{
	}

	trigger talk
	{
		wait 3000
		playsound talk_3
	}

	enemysight
	{
		resetscript
	}

	death
	{
		alertentity remove_nazi2_hallway_to_ammo_1
	}
}


ammo_nazi1	// Smoking guy  -------------> Smoking nazi script by Byz, Email: unaimed@hotmail.com
			// taken from ai_list1.pk3 a complete list of all AI in RTCW.

{
	attributes
	{
		starting_health 25
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.5
		inner_detection_radius 5000
		alertness 5000
		hearing_scale 0.7
		attack_crouch 0.5
		Aggression 0.8
		tactical 0.5
	}

	spawn
	{
		accum 0 set 0
		setammo ammo_9mm 999
		takeweapon weapon_mp40
		wait 100
		trigger ammo_nazi1 smoking
	}

	trigger smoking
	{
		cigarette on
		playanim smoking both
		cigarette off
		playsound cough2
		playanim coughing_1h both
		wait 1000
		trigger ammo_nazi1 standguard
	}

	trigger standguard
	{
		giveweapon weapon_mp40
		wait 5000
		trigger ammo_nazi1 anim_loop
	}

	trigger anim_loop
	{
		accum 0 random 4
		trigger ammo_nazi1 rnd0
		trigger ammo_nazi1 rnd1
		trigger ammo_nazi1 rnd2
		trigger ammo_nazi1 rnd3
	}

	trigger rnd0
	{
		accum 0 abort_if_not_equal 0
		playsound cough2
		playanim coughing_2h both
		wait 4000
		trigger ammo_nazi1 anim_loop
	}

	trigger rnd1
	{
		accum 0 abort_if_not_equal 1
		playanim butt_scratch_1h both
		wait 3500
		trigger ammo_nazi1 anim_loop
	}

	trigger rnd2
	{
		accum 0 abort_if_not_equal 2
		playanim crotch_grab_2h both
		wait 3500
		trigger ammo_nazi1 anim_loop
	}

	trigger rnd3
	{
		accum 0 abort_if_not_equal 3
		playanim scratching_chest both
		wait 5000
		trigger ammo_nazi1 anim_loop
	}

	enemysight player
	{
		resetscript
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		cigarette off
	}

	inspectsoundstart
	{
		resetscript
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		cigarette off
	}

	death
	{
		cigarette off
		alertentity remove_ammo_nazi1
	}
}

