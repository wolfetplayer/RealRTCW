airplane_worker_liftman

{

	attributes
	{
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.5
		inner_detection_radius 3000
		alertness 2500
		hearing_scale 0.5
		Aggression 0.5
		tactical 0.7
	}

	spawn
	{
		sethealth 10
		takeweapon all
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		statetype alert
		trigger airplane_worker_liftman use_lift
	}

	trigger use_lift
	{
		alertentity lift_down_activatior_relay
		wait 10000
		alertentity lift_down_activatior_relay
		wait 10000
		trigger airplane_worker_liftman use_lift 		//restarts lift sequence
	}

	death
	{
	alertentity remove_airplane_worker_liftman
	resetscript
	}
}