pow1
{
	attributes
	{
		tactical 0.0
		alertness 0.0
		fov 360
		hearing_scale 0.0
		attack_crouch 0.0
		attack_skill 0.0
		aim_accuracy 0.0
		aim_skill 0.0
		agression 0.0
		inner_detection_radius 0.0
	}

	spawn
	{
		noavoid
		nosight 999999
		statetype relaxed
		takeweapon all
		trigger pow1 marchloop 		// This will begin the Marching loop.
	}

    trigger marchloop
    {
      noattack 999999
	  facetargetangles pow1-1
	  walktomarker pow1-1 nostop
	  playsound pow_cough
	  wait 5000
	  facetargetangles pow1-2
      walktomarker pow1-2 nostop
      facetargetangles pow1-3
      playsound pow_cough
      wait 2000
      walktomarker pow1-3 nostop
      facetargetangles pow1-2
      walktomarker pow1-2 nostop
      trigger pow1 marchloop 		// Restarts the marching loop.
    }

	blocked player
	{
		deny
		pushaway player
	}

	enemysightcorpse
	{
		statetype relaxed
	}

	friendlysightcorpse
	{
		statetype relaxed
	}

	inspectsoundstart
	{
		statetype relaxed
	}

	inspectsoundend
	{
		statetype relaxed
	}

	attacksound
	{
		statetype relaxed
	}

	bulletimpactsound
	{
		statetype relaxed
	}

	inspectfriendlycombatstart
	{
		statetype relaxed
	}

	pain 90
	{
		statetype relaxed
	}

	death player
	{
		missionfailed 8 12		// 8 - seconds of sreen fade-out to mission failed
								// 10 - nr. of mission fail info in "strings.txt"
	}
}

