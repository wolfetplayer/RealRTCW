center_left_tower_nazi_1		/////////////////////center_left_tower
								/////////////////// blackguard with binecolars
{
	attributes
	{
		fov 300
		starting_health 25
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.5
		inner_detection_radius 100
		alertness 100
		hearing_scale 0.0
		attack_crouch 0.8
		Aggression 0.8
		tactical 0.8
		reaction_time 0.8
	}

	spawn
	{
		noaidamage on
		nosight 99999
		trigger center_left_tower_nazi_1 patrol
	}

	trigger patrol
	{
		facetargetangles patrol2
		walktomarker patrol2
		giveinventory key_binocs
		zoom on
		facetargetangles looking
		playanim binocular both
		facetargetangles looking
		wait 5000 looking
		zoom off
		facetargetangles patrol3
		walktomarker patrol3
		facetargetangles patrol2
		walktomarker patrol2
		facetargetangles patrol1
		walktomarker patrol1
		trigger center_left_tower_nazi_1 patrol 		//Restart
	}

	trigger give_sight
	{
		sight
		attrib inner_detection_radius 5000
		attrib alertness 5000
		attrib hearing_scale 0.8
	}

	enemysight player
	{
		statetype alert
		attrib Aggression 1.0
		resetscript
	}

	death
	{
		alertentity remove_center_left_tower_nazi_1
		trigger player music1
		alertentity mg1_nazi1
		alertentity mg2_nazi1
		alertentity mg3_nazi1
		trigger right_tower_nazi_1 give_sight
		trigger center_right_tower_nazi_1 give_sight
		trigger center_left_tower_nazi_1 give_sight
		trigger left_tower_nazi_1 give_sight
		trigger camp_door_1_nazi_b2 give_sight
		trigger camp_door_1_nazi_b1 give_sight
		trigger camp_door_1_nazi_left_inside give_sight
		trigger camp_door_1_nazi_right_inside give_sight
		alertentity center_left_tower_nazi_2
	}
}

