player 										//Player info
{
	spawn
	{
		cvar g_episode 9
		
		objectivesneeded 1
		abort_if_loadgame
	}

	playerstart
	{
		// mu_fade 0 5000
		// mu_queue sound/music/c_military

		// Weapons
		// takeweapon all
		// giveweapon weapon_mauserRifle
		// giveweapon weapon_sniperscope
		// giveweapon weapon_luger
		// giveweapon weapon_mp40
		// selectweapon weapon_mp40

		// Ammo
		// setammo ammo_grenades 3
		// setammo ammo_9mm 300
		// setammo ammo_792mm 150

		// Items
		// setarmor 25
		// giveinventory key_binocs
	}



	trigger 4guards_alerted
	{
		trigger camp_door_1_nazi_right_inside give_sight
		trigger camp_door_1_nazi_b2 give_sight
		trigger camp_door_1_nazi_b1 give_sight
		trigger camp_door_1_nazi_left_inside give_sight
	}


	trigger kill_mg2
	{
		trigger mg2_nazi2 go_teleport
		trigger mg2_nazi3 go_teleport
		trigger mg2_nazi4 go_teleport
	}

	trigger kill_mg3
	{
		trigger mg3_nazi2 go_teleport
		trigger mg3_nazi3 go_teleport
		trigger mg3_nazi4 go_teleport
	}

	trigger objective1
	{
		objectivemet 1								// mission objective 1 complete
	}

	trigger towers_guards 							// whem player comes off the toalette in camp B
	{
		alertentity right_tower_nazi_1
		alertentity center_right_tower_nazi_1
		alertentity center_left_tower_nazi_1
		alertentity left_tower_nazi_1
	}

	trigger dont_cross								// Triggers (don't cross section of camp B)
	{
		alertentity mg1_nazi1
		alertentity mg2_nazi1
		alertentity mg3_nazi1
		trigger right_tower_nazi_1 give_sight
		trigger center_right_tower_nazi_1 give_sight
		trigger center_left_tower_nazi_1 give_sight
		trigger left_tower_nazi_1 give_sight
	}

		/////////////////////////sicreds////////////////////////

	trigger sicred1
	{
		foundsecret
	}

	trigger sicred2
	{
		foundsecret
	}



	/////////////////////////// Music trigers///////////////////

	trigger music1
	{
		mu_fade 0 0
		mu_queue /sound/music/m_action.wav 0
	}

	trigger music2
	{
		mu_fade 0 2000
		mu_queue /sound/music/l_theme.wav
	}

	/////////////////////////end map////////////////////////
	trigger endmap
	{
		changelevel aaw4 persistent
	}
}

///////////////////////////////////////////////////////////////////// 			towers_guards

right_tower_nazi_1 						//right_tower
{
	attributes
	{
		fov 300
		starting_health 25
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.5
		inner_detection_radius 300
		alertness 300
		hearing_scale 0.0
		attack_crouch 0.5
		Aggression 1.0
		tactical 0.5
	}

	spawn
	{
		noaidamage on
		takeweapon all
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		setammo ammo_9mm 999
		nosight 99999
	}

	trigger give_sight
	{
		sight
		attrib hearing_scale 0.8
		attrib inner_detection_radius 5000
		attrib alertness 5000
	}

	enemysight player
	{
		statetype alert
		attrib Aggression 1.0
	}

	death
	{
		alertentity remove_right_tower_nazi_1
		trigger player music1
		alertentity mg1_nazi1
		alertentity mg2_nazi1
		alertentity mg3_nazi1
		trigger right_tower_nazi_1 give_sight
		trigger center_right_tower_nazi_1 give_sight
		trigger center_left_tower_nazi_1 give_sight
		trigger left_tower_nazi_1 give_sight
		trigger camp_door_1_nazi_b2 give_sight
		trigger camp_door_1_nazi_b1 give_sight
		trigger camp_door_1_nazi_left_inside give_sight
		trigger camp_door_1_nazi_right_inside give_sight
		alertentity right_tower_nazi_2
	}
}

