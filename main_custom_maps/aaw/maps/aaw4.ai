siergiej						// This guy gives me pain in the ....
								// He walk and do everything he wants
								// :-( and gets in the way all the time. buuuuuuuuuuuu
								// I think I was debugging him in the engine 50 times at least.
{
	attributes
	{
		// camper 0.1
		running_speed 300		// he is so slow........  :-(	// 300 is the max? 1000 do not help !
		starting_health	100
		tactical 0.3
		alertness 0.0
		fov 360
		hearing_scale 0.0
		attack_crouch 0.9
		attack_skill 0.8
		aim_accuracy 0.7
		aim_skill 0.6
		agression 0.0
		inner_detection_radius 0.0

	}

	spawn
	{
		nosight 999999
		// noattack 999999
		statetype relaxed
		takeweapon all
	}

    trigger dialog 		//when he see player for first time
    {
		wait 1000
		playsound siergiej_is_it_you
		wait 1000
		trigger siergiej focus_on_player
		wait 3000
		playsound siergiej_glad_to_see_you
		wait 8000
		playsound let_me_out_2		// let me out and I will help you !
		wait 5000
		trigger siergiej letmeout
	}


    trigger focus_on_player
    {
	    followcast player
    }

    trigger letmeout
    {
	    wait 1000
	    playsound let_me_out_1				// let me out !!
	    wait 10000
	    trigger siergiej letmeout			 // restart
    }

    trigger free
    {
	    pushaway player
	    wait 5
	    pushaway player
	    wait 5
	    pushaway player
	    wait 5
	    trigger player lockon
	    gotomarker s1
	    wait 1000
	    gotomarker s2
	    followcast player
	    playsound sieriej_thanks 			 	//thanks for helping me out
	    wait 3000
	    trigger siergiej got3
	    wait 500
	    alertentity kill_food
	    alertentity kill_weapon
	    alertentity kill_vine
	    gotomarker food nostop
	    playsound sieriej_food				// OOOOoo food, I'm very hungry, I must it something before we can proside
	    wait 3000
	    playsound siergiej_food
	    wait 1000
	    gotomarker weapon nostop
	    followcast player
	    playsound sieriej_finds_weapon
	    wait 1000
	    playsound siergiej_weapon_1
	    wait 1000
	    playsound siergiej_weapon_2
	    giveweapon weapon_mp40
	    setammo ammo_9mm 999
	    selectweapon weapon_mp40
	    gotomarker vine
	    playsound sieriej_finds_vine 		//And..... the vine
	    wait 2000
	    playsound siergiej_vine
	    wait 1000
	    playsound siergiej_vine
	    trigger siergiej leader_and_5
	    trigger siergiej lets_go
	}

    trigger lets_go		// proclames he is ready to go with player
    {
		wait 1000
	    gotomarker s2
	    wait 500
	    gotomarker s1
	    wait 2000
	    gotomarker s2
	    followcast player
	    playsound sieriej_not_eat_everything
	    wait 2000
	    gotomarker food
	    trigger player lockoff
		gotomarker s3
		gotomarker s_wait
		wait 500
		facetargetangles s3
		playsound sieriej_ready				//we_are ready! we are now ready to go!!
		sight
		attrib alertness 3000
		attrib hearing_scale 0.5
		attrib inner_detection_radius 3000
		attrib reaction_time 1.0
		attrib agression 1.0
		attrib leader 1.0
		statetype alert
		wait forever
		resetscript
    }

	trigger siergiej_will_follow2
	{
		followcast player
		avoid
	}

   	trigger resetsiergiej
   	{
		resetscript
		statetype alert
		wait forever
	}

	trigger leader_and_5
	{
		alertentity leader_1
		alertentity leader_follower_1
		alertentity leader_follower_2
		alertentity leader_follower_3
		alertentity leader_follower_4
		alertentity leader_follower_5
	}


	trigger relax
	{
		// noattack 999999
		statetype relaxed
	}

	blocked player
	{
		pushaway player
	}

	trigger got3
	{
		objectivemet 3							// got Siergiej
	}

	death player				// Death caused by player
	{
		missionfailed 8 10		// 8 - seconds of sreen fade-out to mission failed
								// 10 - nr. of mission fail info in "strings.txt"
	}

	death						// Death caused by enemy
	{
		missionfailed 10 11 	// Survival of Siergiej is essential to continuances of your mission.
								// He must survive
	}
}

mg4_nazi1	///////////////////////////////////////////// mg4
{
	attributes
	{
		fov 300
		starting_health 25
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.5
		inner_detection_radius 0
		alertness 0
		hearing_scale 0.0
		Aggression 0.8
		tactical 0.0
		reaction_time 1.0
		yaw_speed 500
		attack_crouch 0.8
	}

	spawn
	{
		nosight 999999
		noaidamage on
		takeweapon all
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		setammo ammo_9mm 999
		trigger mg4_nazi1 run_and_mount
	}

	trigger run_and_mount
	{
		facetargetangles marker_mg_4
		runtomarker marker_mg_4
		mount mg_4
		sight
		attrib inner_detection_radius 5000
		attrib alertness 5000
		attrib hearing_scale 0.8
		statetype alert
	}

	trigger free_mg_4
	{
		unmount
	 	facetargetangles free_mg_4_marker
	 }

	forced_mg42_unmount
	{
		deny
	}

	enemysight
	{
		playsound who_are_you
	}

	death
	{
		alertentity mg4_nazi2
		alertentity remove_mg4_nazi1
	}
}

