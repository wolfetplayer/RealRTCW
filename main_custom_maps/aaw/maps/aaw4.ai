under_nazi1 			//patroling	blackguard
{
	attributes
	{
		fov 220
		starting_health 25
		aim_accuracy 0.5
		aim_skill 0.5
		attack_skill 0.5
		inner_detection_radius 200
		alertness 1000
		hearing_scale 0.2
		attack_crouch 0.8
		Aggression 0.5
		tactical 0.5
	}

	spawn
	{
		noaidamage on
		trigger under_nazi1 patrol
	}

	trigger patrol
	{
		playsound la_la_3
		facetargetangles under1
		walktomarker under1 nostop
		playsound la_la_3
		facetargetangles under2
		walktomarker under2 nostop
		facetargetangles under3
		playsound la_la_3
		walktomarker under3 nostop
		facetargetangles under4
		walktomarker under4 nostop
		playsound la_la_3
		facetargetangles under5
		walktomarker under5 nostop
		facetargetangles under6
		walktomarker under6 nostop
		facetargetangles under7
		walktomarker under7 nostop
		playsound la_la_3
		facetargetangles under6
		playsound la_la_3
		wait 5000
		walktomarker under6 nostop
		facetargetangles under5
		walktomarker under5 nostop
		facetargetangles under4
		walktomarker under4 nostop
		facetargetangles under3
		walktomarker under3 nostop
		facetargetangles under2
		walktomarker under2 nostop
		trigger patrol				// restart patroling
	}

	trigger get_alerted
	{
		attrib inner_detection_radius 500
		attrib alertness 500
		attrib hearing_scale 0.5
		wait 2000
		playsound under_nazi1_voice1
	}

	enemysight
	{
		noattack 4000
		playsound who_are_you
		wait 500
		playsound intruder_alarm_alarm
		// attack
		trigger under_nazi1 get_alerted
		resetscript
	}

	death
	{
		alertentity remove_under_nazi1
	}
}

