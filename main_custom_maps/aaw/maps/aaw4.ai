////////////////////////////  Officer SCRIPT ////////////////////////////////////////////////////////////////////////
////////////////////////////  Officer SCRIPT ////////////////////////////////////////////////////////////////////////
////////////////////////////  Officer SCRIPT ////////////////////////////////////////////////////////////////////////

officer
{
	attributes
	{
		running_speed 300
		fov 240
		starting_health 50
		aim_accuracy 0.8
		aim_skill 0.8
		attack_skill 0.8
		inner_detection_radius 0
		alertness 0
		hearing_scale 0.0
		attack_crouch 0.7
		Aggression 0.2
		tactical 1.0
		camper 0.3
	}

	spawn
	{
		nosight 999999
		noaidamage on
		takeweapon all
		godmode on
		trigger officer go
	}

	blocked player
	{
		deny
		pushaway player
	}

	trigger go
	{
		wait 500
		facetargetangles officer_marker1
		runtomarker officer_marker1 nostop
		facetargetangles officer_marker2
		runtomarker officer_marker2 nostop
		facetargetangles officer_marker3
		runtomarker officer_marker3 nostop
		facetargetangles officer_marker4
		runtomarker officer_marker4 nostop
		facetargetangles officer_marker5
		runtomarker officer_marker5 nostop
		facetargetangles officer_marker6
		runtomarker officer_marker6 nostop
		facetargetangles officer_marker7
		runtomarker officer_marker7 nostop
		facetargetangles officer_marker8
		runtomarker officer_marker8 nostop
		facetargetangles officer_marker9
		runtomarker officer_marker9 nostop
		facetargetangles officer_marker12
		runtomarker officer_marker12 nostop
		facetargetangles officer_marker13
		runtomarker officer_marker13 nostop
		runtomarker officer_marker_end nostop
		alertentity kill_officer
	}

	death
	{
	}
}

officer_2 								// Jego wcielenie //////////////////////////////////////
{
	attributes
	{
		starting_health 30
		inner_detection_radius 0
		alertness 0
		hearing_scale 0.0
	}

	spawn
	{
		nosight 999999
		takeweapon all
		trigger officer_2 door
	}

	trigger turnback
	{
		wait 5000
		statetype alert
		giveweapon weapon_luger
		setammo ammo_9mm 999
		sight
		attrib fov 240
		attrib inner_detection_radius 500
		attrib alertness 500
		attrib hearing_scale 0.5
		attrib starting_health 40
		attrib aim_accuracy 0.8
		attrib aim_skill 0.8
		attrib attack_crouch 1.0
		attrib Aggression 0.5
		attrib tactical 1.0
		facetargetangles under7
		playsound intruder_alarm_alarm
	}

	trigger door
	{
		facetargetangles officer_2_marker_1
		walktomarker officer_2_marker_1
		trigger officer_2 open_this_door
	}

	trigger open_this_door
	{
		wait 5
		playsound officer_bang_bang
		wait 2000
		playsound officer_doc1
		wait 3000
		playsound officer_doc2
		wait 3000
		playsound officer_bang_bang
		wait 3000
		playsound officer_doc3
		wait 3000
		playsound officer_doc1
		trigger officer_2 bang_and_animate
	}

	trigger bang_and_animate
	{
		wait 6000
		playsound officer_bang_bang
		// 	playanim looking_over_table both
		trigger officer_2 bang_and_animate
	}


	// trigger open_this_door			//animation too long. Must // this
	// {
	// 	wait 5
	// 	playsound officer_bang_bang
	// 	playanim looking_over_table both
	// 	playsound officer_doc1
	// 	playanim looking_over_table both
	// 	playsound officer_bang_bang
	// 	playanim looking_over_table both
	// 	playsound officer_doc2
	// 	playanim looking_over_table both
	// 	playsound officer_bang_bang
	// 	playanim looking_over_table both
	// 	playsound officer_doc3
	// 	trigger officer_2 bang_and_animate
	// }

	// trigger bang_and_animate
	// {
	// 	wait 5
	// 	playanim looking_over_table both
	// 	playsound officer_bang_bang
	// 	trigger officer_2 bang_and_animate
	// }

	death
	{
		objectivemet 2									// got officer
	}
}

