player 										//Player info
{
	spawn
	{
		cvar g_episode 10
		objectivesneeded 3

		abort_if_loadgame
	}

	playerstart
	{
	mu_fade 0 5000
	mu_queue sound/music/m_mission

		// Weapons
		// takeweapon all
		// giveweapon weapon_mauserRifle
		// giveweapon weapon_sniperscope
		// giveweapon weapon_luger
		// giveweapon weapon_mp40
		// selectweapon weapon_mp40

		// Ammo
		// setammo ammo_grenades 3
		// setammo ammo_9mm 300
		// setammo ammo_792mm 150

		// Items
		// setarmor 25
		// giveinventory key_binocs
	}

	trigger relax_siergiej
	{
		trigger siergiej relax
	}

	trigger reset_siergiej
	{
		trigger siergiej resetsiergiej
	}

	trigger lockon
	{
		lockplayer on
	}

	trigger lockoff
	{
		lockplayer off
	}

	trigger siergiej_will_follow
	{
		trigger siergiej siergiej_will_follow2
	}

	trigger siergiej_starton
	{
		trigger siergiej dialog
	}

	trigger siergiej_free
	{
		trigger siergiej free
	}

	trigger objective1
	{
		objectivemet 1								// got letter
	}

	trigger blackguard
	{
		alertentity forest_nazi1				 //blackguard
		alertentity mg4_nazi1
	}

	trigger go_1
	{
		alertentity mg8_nazi1
		// mu_fade 0 5000
		// mu_queue sound/music/m_moving
	}

	trigger go_2
	{
		alertentity mg5_nazi1
		alertentity venom1
		alertentity venom2
	}

	trigger go_3
	{
		alertentity mg7_nazi1
		alertentity mg6_nazi1
	}

	trigger unmount_mg4
	{
		mu_play sound/music/s_bighits 0		//when standing on top of bunker 1 and going into it
		// mu_fade 0 4000
		mu_queue sound/music/m_mission		//returns to "m_mission" music
		trigger mg4_nazi1 free_mg_4
		trigger mg4_nazi2 free_mg_4
		trigger mg4_nazi3 free_mg_4
		///////////////////////////

	}

	trigger unmount_mg5	 	//////////////////////mg5 + mg6 + mg8
	{

		mu_play sound/music/s_barrelfall 0 			// entering bunker 2
		// playsound _blank_
		// mu_queue sound/scenaric/general/blank 0

		///////////////////////////
		trigger mg5_nazi1 free_mg_5
		trigger mg5_nazi2 free_mg_5
		trigger mg5_nazi3 free_mg_5

		///////////////////////////
		trigger mg6_nazi1 free_mg_6
		trigger mg6_nazi2 free_mg_6
		trigger mg6_nazi3 free_mg_6

		///////////////////////////
		trigger mg8_nazi1 free_mg_8
		trigger mg8_nazi2 free_mg_8
		trigger mg8_nazi3 free_mg_8

		///////////////////////////
		alertentity kill_ai_wall_1
		alertentity kill_ai_wall_2
	}

	trigger unmount_mg7
	{
		trigger mg7_nazi1 free_mg_7
		trigger mg7_nazi2 free_mg_7
		trigger mg7_nazi3 free_mg_7
		///////////////////////////
	}

	//////////////////////// Underground triggers //////////////////////////

	trigger under_start		// underground bunker complex starts here - with discovery of Siergiej
	{
		alertentity siergiej
		alertentity under_nazi1
		alertentity under_nazi2
		alertentity under_nazi3
		alertentity under_nazi4
		alertentity under_venom1
		alertentity under_venom2
		trigger dialog 3_guys_talk 			//under_nazi2 talk
	}

	trigger officer_documents
	{
		alertentity officer_2
		mu_fade 0 3000
		mu_play sound/music/s_highramp.wav 0
	}

	trigger officer_turnback
	{
		trigger officer_2 turnback
	}

	//////////////////////// Music ////////////////////////
	trigger music_action_1
	{
		mu_play sound/music/s_longout 0
	}

	trigger music_action_2
	{
		mu_fade 0 4000
		mu_queue sound/music/x_atmos 		//very good background music
	}

	trigger music_action_3
	{
		mu_fade 0 1000
		mu_queue sound/music/m_assault 0
	}

	/////////////////////////sicreds////////////////////////

	trigger sicred1
	{
		foundsecret
	}


	/////////////////////////end map////////////////////////
	trigger endmap
	{
		changelevel aaw5 persistent
	}
}

leader_1					// blackguard // Leader for band of 5 blackguards nazis
{
	attributes
	{
		leader 1.0
		fov 220
		starting_health 25
		aim_accuracy 0.6
		aim_skill 0.6
		attack_skill 0.8
		inner_detection_radius 5000
		alertness 5000
		hearing_scale 0.6
		attack_crouch 0.8
		Aggression 0.2
		tactical 0.5
	}

	// trigger march
	//{
	//	walktomarker leader_1
	//	walktomarker leader_2
	//	walktomarker leader_3
	//	walktomarker leader_4
	//	walktomarker leader_5
	//	walktomarker leader_6
	//	walktomarker leader_7
	//	walktomarker leader_8
	//	resetscript
	//}

	spawn
	{
		noaidamage on
	}

	enemysight
	{
		playsound intruder_alarm
		wait 2000
		playsound intruder_alarm
	}

	death
	{
		alertentity remove_leader_1
	}
}

