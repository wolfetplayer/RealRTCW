camp1_partisan1
{
	attributes
	{

		// camper 0.1
		starting_health	120
		tactical 1.0
		fov 360
		attack_crouch 0.0
		attack_skill 1.0
		aim_accuracy 1.0
		aim_skill 1.0
		agression 0.5
		inner_detection_radius 5000
		hearing_scale 0.5
		alertness 32000

	}

	spawn
	{
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 500
		selectweapon weapon_mp40
		statetype alert
		trigger camp1_partisan1 mount_part_mg_1
	}

	trigger run
	{
		resetscript
		unmount part_mg_1
		explicit_routing on
		runtomarker camp1_partisan2_marker3
	}

	trigger mount_part_mg_1
	{
