player 										//Player info
{
	spawn
	{
		cvar g_episode 11
		objectivesneeded 2

		abort_if_loadgame
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
	       // Weapons
		giveweapon weapon_knife
		giveweapon weapon_thompson
		selectweapon weapon_thompson
		suggestweapon weapon_thompson

		// Ammo
		setammo ammo_panzerfaust 0
		setammo ammo_fuel 0
		setammo ammo_792mm 0
		setammo ammo_9mm 0
		setammo ammo_45cal 50
		setammo ammo_30cal 0
		setammo ammo_grenades 0
		setclip weapon_thompson 30
		
		// Items
		setarmor 50
		giveinventory key_binocs
		//trigger player lockon 
		trigger player musicmission
	}

	trigger musicmoving
	{
		accum 1 abort_if_equal 1
		accum 1 set 2
		mu_fade 0 3000
		mu_queue sound/music/m_moving
	}

	trigger musicmission
	{
		accum 1 abort_if_equal 2
		accum 1 set 2
		mu_fade 0 5000
		mu_queue sound/music/m_mission
	}

	trigger musicsituation
	{
		accum 1 abort_if_equal 3
		accum 1 set 3
		mu_fade 0 3000
		mu_queue sound/music/m_situation
	}

	trigger musicassault
	{
		accum 1 abort_if_equal 4
		accum 1 set 4
		mu_fade 0 3000
		mu_queue sound/music/m_assault
	}
	
	trigger attack
	{
		trigger camp1_partisan4 alert
		wait 2500
		trigger camp1_partisan3 alert
		wait 2000
		stopcam
		alertentity remove_bj1
		teleport bj_2
		wait 5000
		trigger player first_attack
	}

	trigger first_attack
	{
		alertentity officer1
		alertentity nazi1
		alertentity nazi2
		alertentity nazi3
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		trigger officer1 fire1
		wait 3000
		trigger m109 go
		trigger siergiej2 attack
		alertentity remove_fire
		trigger player musicmoving
	}

	trigger second_attack
	{
		trigger m109_2 go
		trigger siergiej3 go
	}

	trigger wake_up_tank
	{
		trigger zp_m1_chsx_forest f0
		trigger zp_m1_tur_forest2 f0
		trigger zp_m1_cn_forest2 f0
		trigger zp_m1_whll f0
		trigger zp_m1_whlr f0
		trigger zp_m1_trkl f0
		trigger zp_m1_trkr f0
		wait 1000
		trigger zp_m1_chsx_forest f1
		trigger zp_m1_tur_forest2 f1
		trigger zp_m1_cn_forest2 f1
		trigger zp_m1_whll f1
		trigger zp_m1_whlr f1
		trigger zp_m1_trkl f1
		trigger zp_m1_trkr f1
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		startcam aaw5_2
		trigger player musicsituation
	}

	trigger spawn_gunners
	{
		trigger zp_m1_chsx_forest f2
		trigger zp_m1_tur_forest2 f2
		trigger zp_m1_cn_forest2 f2
		trigger zp_m1_whll f2
		trigger zp_m1_whlr f2
		trigger zp_m1_trkl f2
		trigger zp_m1_trkr f2
		trigger nazi12 go2
		trigger nazi14 go2
		trigger nazi13 go2
		trigger nazi15 go2
		alertentity remove_mg42
		alertentity nazi_mg42_3
		alertentity nazi11
		alertentity mech1
		alertentity mech2
		alertentity part_radio
		startcam aaw5_3
		wait 23000
		startcam aaw5_5
		wait 6000
		startcam aaw5_4
	}			

	trigger relax_siergiej
	{
		trigger siergiej relax
	}

	trigger reset_siergiej
	{
		trigger siergiej resetsiergiej
	}

	trigger lockon
	{
		lockplayer on
	}

	trigger lockoff
	{
		lockplayer off
	}

	trigger action_corridor
	{
		alertentity unlock_01
		alertentity nazi_corridor1
		alertentity nazi_corridor2
		alertentity nazi_corridor3
	}

	trigger signblow
	{
		trigger signleg1 choosefall
		trigger signleg2 choosefall
	}

	trigger gocounter
	{
		alertentity removespin
		trigger board1 counter_clockwise
	}

	trigger goclock
	{
		alertentity removespin
		trigger board1 clockwise
	}

	trigger radio1
	{
		trigger counter1 counter
	}

	trigger radio2
	{
		trigger counter1 counter
	}

	trigger open_close
  	{
		trigger gate toggle
		wait 1300
		trigger gate yellow_loop
		wait 10000
		trigger gate stop_yellow
 	}

	trigger housefire
	{
		trigger house_fire go	
		trigger cabinet go			
	}

	trigger siergiej_will_follow
	{
		trigger siergiej siergiej_will_follow2
	}

	trigger siergiej_starton
	{
		trigger siergiej dialog
	}

	trigger camp1_spawn_partisans
	{
		alertentity camp1_partisan1
		alertentity camp1_partisan2
		alertentity camp1_partisan3
		alertentity camp1_partisan4
		alertentity siergiej3
	}

	////////////////// camp1_partisan1_player_attack /////////////

	trigger camp1_partisan1_player_attack
	{
		// trigger ?? c1_p1_a1
		// trigger ?? c1_p1_a1
	}

	trigger start_dialog
	{
		trigger dialog start
	}

	//////////////////////////////////////////////////////////////

	///////////////////////// Objectives ////////////////////////

	trigger objective1
	{
		objectivemet 1
		trigger counter1 counter2
		alertentity activate_button
	}

	trigger objective2
	{
		objectivemet 2
		trigger counter1 counter2
	}

	/////////////////////////secrets////////////////////////

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
		alertentity remove_team2
	}

	trigger secret3
	{
		foundsecret
	}
	
/////////////////////////////////////////////////////////	
	
	trigger explofire1
	{
		trigger explo_fire1	go 				// Trigger group. [APPEAR] script mover for fire.
		trigger fire_tree_and_ammo go		// Triggers Appear mover for tree and ammo fire
	}

	trigger ammo_explo
	{
		alertentity sparks1
		wait 2000
		alertentity sparks1
		wait 2000
		alertentity sparks1
		wait 2000
		alertentity ammo_smoke
		wait 5000							// trigger timer
		alertentity ammo_cover_open_sound
		trigger player ammo_cover_open_smoke0

	}

	trigger ammo_cover_open_smoke0
	{
		trigger flying_cover go
		alertentity ammo_cover_open_smoke0
		wait 1000
		alertentity ammo_cover_open_smoke0
		trigger ammo_fire_up go		// -------------> mover
		trigger player creaking
	}

	trigger creaking
	{
		wait 3000
		alertentity creaking2
		wait 3200
		alertentity blow-up
	}

////////////////////////////////////////////////////////////////

	
	trigger bombing2						// Second plain attack
	{
		wait 1000							// Main Counter/Timer for Second plain attack
		trigger m109_nr2 go
		trigger m109_nr2_bomb drop			// Start for bomb drop
	}


////////////////////////////////////////////////////////////////

	
	trigger death_player
	{
		trigger player lockon
		alertentity halt1
		wait 200
		alertentity shoot
		wait 1000
		trigger player die
	}

	trigger die
	{
		alertentity pipec1
		missionfailed
		sethealth 0
	}

	trigger actionpara
	{
		alertentity cargo_flyby
		trigger parachute1 go
		trigger parachute2 go
		trigger parachute3 go
		trigger parachute4 go
		alertentity attack2
		trigger player musicassault
	}

	trigger snipers
	{
		alertentity sniper1
		alertentity sniper2
	}

	trigger alert_opel
	{
		trigger opel start
		alertentity alert_static4
		wait 3000
		alertentity partisan_final
		alertentity partisan_final2
		trigger player musicmission
	}

	trigger final
	{
		trigger opel start2
	}

/////////////////////////end map////////////////////////////////
	trigger endmap
	{
		changelevel
		wait 9000
		endgame
	}
}

bj1
{
	attributes
	{
		walking_speed 180
		alertness 0.0
		tactical 0.0
		camper 0.0
		inner_detection_radius 256
		hearing_scale_not_pvs 0.0
		hearing_scale 0.0
		fov 60
	}
	
	spawn
	{
		noattack 999999
		nosight 999999
		knockback off
		headlook off
		takeweapon all
		giveweapon weapon_thompson
		selectweapon weapon_thompson
		trigger bj1 go
	}
	
	trigger talk1
	{
		playsound sound/aaw5/whats_going_on.wav
		wait 4000
		trigger siergiej3 talk2
	}
	
	trigger talk2
	{
		playsound sound/aaw5/get_out_here.wav
		wait 3000
		trigger player attack
		wait 2000
		trigger siergiej3 alert
	}	
	
	trigger go
	{
		explicit_routing on
		walktomarker bj_1
		trigger siergiej3 talk1
		walktomarker bj_2
		facetargetangles bj_2
		trigger bj1 talk1
	}
}

siergiej						// This guy gives me pain in the ....
								// He walk and do everything he wants
								// :-( and gets in the way all the time. buuuuuuuuuuuu
								// I think I was debugging him in the engine 50 times at least.
{
	attributes
	{
		// camper 0.1
		running_speed 300		// he is so slow........  :-(	// 300 is the max? 1000 do not help !
		starting_health	100
		tactical 0.3
		alertness 0.0
		fov 360
		hearing_scale 0.0
		attack_crouch 0.9
		attack_skill 0.8
		aim_accuracy 0.7
		aim_skill 0.6
		agression 0.0
		inner_detection_radius 0.0
	}

	spawn
	{
		nosight 999999
		// noattack 999999
		statetype relaxed
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		setammo ammo_9mm 999
		trigger siergiej walk
	}
	
	trigger walk
	{
		wait 3000
		playsound sound/aaw5/letsgo.wav
		walktomarker siergiej_pos1
		facetargetangles siergiej_pos1
		statetype alert
	}

	trigger walk2
	{
		walktomarker s_fire1
		facetargetangles s_fire2
		walktomarker s_fire2
		walktomarker s_fire3
		facetargetangles s_fire3
		runtomarker to_partisans_1 nostop
		runtomarker to_partisans_2 nostop
		runtomarker to_partisans_3 nostop
		runtomarker to_partisans_4 nostop
		runtomarker to_partisans_5 nostop
		runtomarker to_partisans_6 nostop
		runtomarker to_partisans_7 nostop
		runtomarker to_partisans_8 nostop
		runtomarker to_partisans_9 nostop
		runtomarker to_partisans_10 nostop
		facetargetangles to_partisans_10
		walktomarker siergiej_pos2
		resetscript
		statetype alert
	}

	trigger go
	{
		explicit_routing on
		runtomarker camp1_partisan2_marker1 nostop
		runtomarker camp1_partisan4_patrol3
		playsound villp4_7
		wait 2500
		playsound sound/aaw5/guard.wav
	}
		

    	trigger focus_on_player
    	{
	    	followcast player
    	}

    	trigger siergiej_will_follow2
	{
		followcast player
		avoid
	}

   	trigger resetsiergiej
   	{
		resetscript
		statetype alert
		wait forever
	}

	
	trigger relax
	{
		// noattack 999999
		statetype relaxed
	}

	blocked player
	{
		pushaway player
	}

	death player				// Death caused by player
	{
		missionfailed 8 10		// 8 - seconds of sreen fade-out to mission failed
								// 10 - nr. of mission fail info in "strings.txt"
	}

	death						// Death caused by enemy
	{
		missionfailed 10 11 	// Survival of Siergiej is essential to continuances of your mission.
								// He must survive
	}
}

siergiej2						// This guy gives me pain in the ....
{
	attributes
	{
		// camper 0.1
		running_speed 300
		starting_health	50
		tactical 0
		fov 360
		attack_crouch 0
		attack_skill 0
		aim_accuracy 0
		aim_skill 0
		agression 0.0
		hearing_scale 0.0
		alertness 0.0
		inner_detection_radius 0.0
	}

	spawn
	{
		nosight 999999
		noattack 999999
		statetype relaxed
		takeweapon all
		trigger siergiej2 dialog
	}

    	trigger dialog 						//start game
    	{
		wait 3000
		walktomarker s_fire0
		facetargetangles s_fire0
		playsound sound/aaw5/n_help.wav				//hey, we need your help!
		wait 3000
		trigger player lockoff
		playsound sound/aaw5/rescued.wav
		walktomarker s_fire1
		wait 1000
		facetargetangles s_fire2
		walktomarker s_fire2
		wait 1000
	    	alertentity kill_table_weapon
	    	giveweapon weapon_mp40
	    	setammo ammo_9mm 999
	    	selectweapon weapon_mp40
		playsound sound/aaw5/letsgo2.wav		//let's go
	    	facetargetangles s_fire3
	    	walktomarker s_fire3
	    	wait forever 0 player
	}

	trigger siergiej2_follow_me
	{
		alertentity kill_table_weapon
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		setammo ammo_9mm 999
		trigger siergiej2 focus_on_player
		wait 8000
		noavoid
		runtomarker to_partisans_1 nostop
		trigger siergiej walk2
		runtomarker to_partisans_2 nostop
		runtomarker to_partisans_3 nostop
		runtomarker to_partisans_4 nostop
		runtomarker to_partisans_5 nostop
		runtomarker to_partisans_6 nostop
		runtomarker to_partisans_7 nostop
		godmode on
		runtomarker to_partisans_8 nostop
		trigger camp1_partisan1 reset
		godmode off
		wait 3000
		facetargetangles to_partisans_9
		runtomarker to_partisans_9 nostop
		runtomarker to_partisans_10 nostop
		trigger camp1_partisan2 go_platform
		wait 500
		runtomarker to_partisans_11
		facetargetangles to_partisans_11
		playsound villp4_1
		trigger siergiej2 resetsiergiej2
	}

	trigger focus_on_player
    	{
	    	followcast player
    	}

    	trigger siergiej2_will_follow2
	{
		followcast player
		avoid
	}

   	trigger resetsiergiej2
   	{
		resetscript
		statetype relaxed
	}

	trigger attack
	{
		explicit_routing on
		runtomarker to_partisans_12
		facetargetangles to_partisans_12	
		statetype alert
	}

	trigger relax
	{
		// noattack 999999
		statetype relaxed
	}

	blocked player
	{
		pushaway player
	}

	death player				// Death caused by player
	{
		missionfailed 8 10		// 8 - seconds of sreen fade-out to mission failed
								// 10 - nr. of mission fail info in "strings.txt"
	}
	
	death
	{
		trigger camp1_partisan1 run
		trigger siergiej go
	}
}

