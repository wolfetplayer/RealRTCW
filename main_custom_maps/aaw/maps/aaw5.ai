camp1_partisan4 // patroling guy
{
	attributes
	{

		// camper 0.1
		running_speed 300
		starting_health	50
		tactical 0.0
		fov 360
		attack_crouch 0.9
		attack_skill 0.8
		aim_accuracy 0.9
		aim_skill 0.8
		agression 0.5
		inner_detection_radius 5000
		hearing_scale 0.8
		alertness 32000

	}

	spawn
	{
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 500
		selectweapon weapon_mp40
		statetype relaxed
	}

	trigger patrol
	{
		noavoid
		walktomarker camp1_partisan4_patrol1 nostop
		walktomarker camp1_partisan4_patrol2 nostop
		walktomarker camp1_partisan4_patrol3 nostop
		facetargetangles camp1_partisan4_patrol2
		wait 10000
		walktomarker camp1_partisan4_patrol2 nostop
		walktomarker camp1_partisan4_patrol1 nostop
		facetargetangles camp1_partisan4_patrol2
		wait 5000
		trigger camp1_partisan4 patrol //restart
	}

	trigger alert
	{
		playsound sound/aaw5/hearsomething2.wav
		statetype alert
		trigger camp1_partisan4 patrol
	}

	enemysight
	{
	}

	blocked player
	{
		pushaway player
	}

	death player				// Death caused by player
	{
		missionfailed 7 13		// 7 - seconds of sreen fade-out to mission failed
								// 13 - nr. of mission fail info in "strings.txt"
								// -------> "Mission Failed\nYou killed a fellow partisan"
	}
}

