// Mover for first M109 bombing plain ///////////////////////////////////////////////////////////////

m109													// Script mover for M109 bombing plain
{
	spawn
	{
		playsound sound\se_bunker\nib_plane.wav looping 
		gotomarker m109_0 10000	
		faceangles 0 180 0 gototime
	}

	trigger go
	{
		gotomarker m109_1 1000
		faceangles 0 180 0 gototime
		gotomarker bomb_spot_0 1000
		faceangles 0 180 0 gototime
		trigger m109_bomb drop
		gotomarker m109_2 1000
		faceangles 0 180 0 gototime
		gotomarker m109_3 1000
		faceangles 0 180 0 gototime
		gotomarker m109_4 1000
		faceangles 0 180 0 gototime
		wait 100
		alertentity kill_m109
	}
}

m109_bomb												// Script mover for dropping the bomb
{
	spawn
	{
	}

	trigger drop
	{
		gotomarker bomb_spot_0 15000
		faceangles 0 0 0 gototime
		playsound sound\world\boomin2.wav
		gotomarker bomb_spot_1 800
		faceangles -60 0 180 gototime
		alertentity remove_bomb
		alertentity explo1_starting
	}
}

