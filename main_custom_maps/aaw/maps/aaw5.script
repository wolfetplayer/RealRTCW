fire_tree_and_ammo										// [Appear] mover for tree fire and ammo fire
{
	spawn
	{
	}

	trigger go

	{
		gotomarker fire_tree_and_ammo_path1 10000
		alertentity tree_fire_smoke
		alertentity tree_fire_sound
		alertentity tree_fire_dlight
		trigger tree fall
	}
}

tree													 // mover for falling tree
{
	spawn
	{
	}

	trigger fall
	{
		wait 6000										//TimeMer
		alertentity killtreesmoke
		alertentity kill_tree_dlight
		alertentity tree_creak2							// sound of falling tree 2
		gotomarker tree_path1 40
		faceangles 0 0 45 gototime
		alertentity tree_creak1							// sound of falling tree 1
		trigger mound start
		gotomarker tree_path2 150
		faceangles 0 0 90 gototime
		alertentity tree_impact_sound
		alertentity tree_dust
		alertentity give_new_tree_smoke
		wait 30000
		alertentity remove_small_smoke
	}
}


