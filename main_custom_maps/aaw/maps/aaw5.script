gate
{
	spawn
	{
	}

	trigger toggle
	{
		trigger gate open
		wait 10
		trigger gate close
	}

	trigger open
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		wait 500
		playsound sound/scenaric/rocket/electric_door_start.wav
        	wait 700
         	playsound sound/scenaric/rocket/electric_door_loop.wav looping
		gotomarker g2 20
		alertentity activate_door_02
		faceangles 270 0 0 gototime
	}

	trigger close
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		wait 500
		playsound sound/scenaric/rocket/electric_door_start.wav
        	wait 700
         	playsound sound/scenaric/rocket/electric_door_loop.wav looping
		gotomarker g1 25
		alertentity activate_door_02_02
		faceangles 0 0 0 gototime
	}
	
	trigger yellow_loop
	{
		alertentity l1_yellow
		accum 1 bitreset 1
		wait 1000
		alertentity l1_yellow
		accum 1 bitset 1 
		wait 500
		trigger gate yellow_loop
	}

	trigger stop_yellow
	{
		resetscript
		accum 1 abort_if_bitset 0
		alertentity l1_yellow
		stopsound
		playsound sound/scenaric/rocket/electric_door_end.wav
	}
}

counter1
{
	spawn
	{
		accum 0 set 0	
	}

	trigger counter
	{
		accum 1 inc 1
		accum 1 abort_if_not_equal 2
		trigger player objective1
		alertentity remove_team1
		trigger player actionpara
	}

	trigger counter2
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 2
		alertentity final_action
		alertentity end
	}	
}

