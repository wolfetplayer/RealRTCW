
//AI Scripting
//Map : Arcot
//last edited by arcot 24
//25.05.2008
//11:02


player
{
	spawn
	{
		accum 1 set 0
		objectivesneeded 3
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1000 // music fades to 0% in 1 second (1000mSec.)
		mu_queue sound/music/m_drums
		startcam cas1
		wait 20000
		stopcam cas1

		applyloadout arcot
		cvar g_level_was_selected 0

		wait 2000
		alertentity time
		wait 500
		alertentity tik_tak
	}

	trigger action1
	{
		alertentity nazi1
		alertentity nazi2
		alertentity bibo
		alertentity nazi4
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
	}

	trigger action2
	{
		alertentity nazi13
		alertentity nazis
		wait 2000
		startcam ring_1
		wait 2000
		alertentity ring
		wait 4000
		alertentity ring
		wait 4000
		startcam ring_3
		alertentity ring
		wait 1000
		stopcam ring_3
		alertentity ring
		wait 2000
		trigger nazi13 go
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17

		savecheckpoint
	}

	trigger action3
	{
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27
		alertentity nazi28
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
		alertentity vishka
		trigger nazi25 go
		wait 1000
		alertentity dead
		wait 2000
		mu_fade 0 500
		mu_queue sound/music/m_assault
		wait 100
		startcam alarm
		alertentity radio
		wait 3000
		trigger me109no1 cycle1
		trigger me109no2 cycle2
		alertentity me109sound
		wait 7000
		startcam alarm2
		wait 1000
		alertentity enterkeep2
		alertentity enterkeep3
		startcam alarm3
		wait 800
		alertentity meh
		objectivemet 1

		savecheckpoint
	}

	trigger action4
	{
		alertentity nazi18
		alertentity enterkeep
 	}

	trigger fighters
	{
		alertentity radio
	}

	trigger action6
	{
		objectivemet 2
		wait 1000
		alertentity dead

		savecheckpoint
	}

	trigger attack
	{
		alertentity nazi22
		alertentity nazi23
	}

	trigger obzh
	{
		objectivemet 3
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel arcot_2 persistent
	}
}

nazi1
{
	attributes
	{
		fov 1024
	}

	spawn
	{
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
		trigger nazi1 go
	}

	trigger go
	{
		walktomarker d1
		walktomarker d2
		walktomarker bk9
		walktomarker bk11
		wait 1000
		trigger nazi1 smoking
	}

	trigger smoking
	{
               cigarette on
               playanim smoking both
               cigarette off
               wait 1000
               playsound Cough2
               playanim coughing_2h both
               wait 20000
               playanim butt_scratch_2h torso
               wait 50000
               trigger nazi1 go
        }


	trigger blocking3
	{
		statetype alert
		clearanim
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
		resetscript
		attack
	}

	statechange relaxed alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger nazi1 quickdraw
	}

	statechange relaxed combat
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger nazi1 quickdraw
	}

	statechange query alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger nazi1 quickdraw
	}

	statechange query combat
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger nazi1 quickdraw
	}

	bulletimpact
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		statetype alert
		trigger nazi1 quickdraw
	}

	inspectsoundstart
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		statetype alert
		trigger nazi1 quickdraw
	}

	trigger quickdraw
	{
		playsound Blank
		clearanim
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
		wait 50 player
		resetscript
	}

	trigger alert3 // called by others
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		playsound Blank
		statetype alert
		clearanim
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
		resetscript
		wait 100 player
	}

        enemysight
	{
                playsound sound\scenaric\run\1.wav
	}

	death
	{
		mu_fade 0 500
                mu_queue sound/music/m_moving
		trigger nazi3 go2
	}
}

