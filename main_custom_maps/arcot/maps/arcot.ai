                wait 5500
                playsound off_check_again
                wait 2000
                walktomarker cop1
                playsound officer1_mmm1
                accum 0 abort_if_not_equal 0
		accum 1 abort_if_not_equal 0
	        playanim looking_over_table both

	}

	statechange relaxed alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger vill quickdraw
	}

	statechange relaxed combat
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger vill quickdraw
	}

	statechange query alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger vill quickdraw
