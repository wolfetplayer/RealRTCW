		runtomarker nz2
		alertentity activatealarm1
		playsound Blank
		clearanim
		setammo ammo_grenades 0
		takeweapon weapon_mp40
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		wait 50 player
		resetscript
	}

	enemysight
	{
		statetype alert
		wait 1000
		wait forever 0
	}
}

