//
//AI Scripting
//Map: Bunker
//Last edited by: Arcot 24 (03.06.2008), Krot (9.10.2008)



player
{
	spawn
	{
		cvar g_episode 2
		objectivesneeded 4
		abort_if_loadgame
		mu_start sound/music/l_briefing_3
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout bunker
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1500
		mu_queue sound/music/m_drums
		giveweapon weapon_sten
		selectweapon weapon_sten
		alertentity pat1
		alertentity pat2
		trigger doska swingloop
		wait 1000
		alertentity time
		wait 500
		alertentity tik_tak
		trigger player action1
	}

	trigger action1
	{
		alertentity breakalarm
		alertentity sava3
		wait 15000
		alertentity sava3
		wait 25000
		alertentity ptica
		wait 5000
		alertentity ptica
		wait 8500
		alertentity sava3
		wait 16000
		alertentity ptica
		wait 7000
		alertentity sava3
		wait 10000
		trigger player action1
	}

	trigger action2
	{
		mu_fade 0 1500
		mu_queue sound/music/m_situation
		alertentity mechanic3
		alertentity bunker1
		alertentity bunker2
		alertentity bunker3
		alertentity bunker4

		savecheckpoint

	}

	trigger action3
	{
		alertentity park
		alertentity georg
		alertentity nazi10
		alertentity nazi11
	}

	trigger action4
	{
		achievement_parkour
		foundsecret
	}

	trigger action5
	{
		foundsecret
	}

	trigger action6
	{
		alertentity hiperon1
		alertentity hiperon2
		alertentity trans_1
		alertentity trans_2

		savecheckpoint
	}

	trigger action7
	{
		alertentity nazi6
		alertentity nazi7
	}

	trigger action8
	{
		foundsecret
	}

	trigger action9
	{
		mu_fade 0 1500
		mu_queue sound/music/m_assault
		alertentity trooper8
		alertentity trooper6
		wait 1000
		trigger parachute1 go
		wait 500
		trigger camera motor
		alertentity cargo
		trigger parachute2 go
		wait 500
		trigger parachute3 go
		wait 500
		trigger parachute4 go
		wait 500
		trigger parachute5 go
		alertentity start_invis_action_2
		objectivemet 4

		savecheckpoint
	}

	trigger action10
	{
		mu_fade 0 1500
		mu_queue sound/music/m_mission
	}

	trigger obj1
	{
		objectivemet 1
	}

	trigger obj2
	{
		objectivemet 2
		mu_fade 0 1500
		mu_queue sound/music/m_grave2
	}

	trigger obj3
	{
		alertentity r
		alertentity l
		objectivemet 3
	}

	trigger elevator_dont_work
	{
		alertentity elevator_no_func
	}


	trigger lift_down
	{
		trigger lift move
	}

	trigger lift_up
	{
		trigger lift move2
	}

	trigger need_key
	{
		alertentity need_keys
	}

	trigger tok
	{
		trigger handle turnon
	}



	trigger endmap
	{
		changelevel run persistent
	}
}
chas1
{
	attributes
	{
		attack_crouch 0.5
		aggression 1.0
		tactical 2.0
		pain_threshhold_scale 2.0
		camper 1.0
		inner_detection_radius 1024
		fov 360
	}

	spawn
	{
		takeweapon weapon_mp40
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
		trigger chas1 go
	}

	trigger go
	{
		walktomarker ch1
		walktomarker ch2
		walktomarker ch3
		facetargetangles ch3
		wait 1000
		trigger chas1 dialog1
	}

	trigger dialog1
	{
		playsound sound\scenaric\village1\axis0_bathed_in_2_weeks.wav
		wait 5500
		trigger chas2 dialog1
		wait 4000
		trigger chas1 go2
	}

	trigger go2
	{
		walktomarker ch4
		walktomarker ch5
		walktomarker ch10
		walktomarker ch0
		facetargetangles ch0
		wait 1000
		trigger chas1 dialog2
	}

	trigger dialog2
	{
		playsound sound\scenaric\village1\axis0_bathed_in_2_weeks.wav
		wait 5500
		trigger georg3 dialog
		wait 3000
		cigarette on
		playanim smoking both
		cigarette off
		wait 2000
		trigger chas1 go3
	}

	trigger go3
	{
		walktomarker ch0_2
		walktomarker ch14
		facetargetangles ch14
		wait 1000
		playsound sound\scenaric\village1\axis0_bathed_in_2_weeks.wav
		wait 5500
		trigger georg dialog
		wait 5000
		trigger chas1 kuri
	}

	trigger kuri
	{
		wait 200
		cigarette on
		playanim smoking both
		cigarette off
		wait 5000
		playanim crotch_grab_2h both
		wait 4000
		playsound Cough2
		playanim coughing_2h both
		wait 5000
		playanim crotch_grab_2h both
		wait 7000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
	}

	enemysight
	{
		playsound sound\scenaric\run\2.wav
		resetscript
		statetype alert
	}

	pain 100
	{
		attrib aggression 0.5
		attrib camper 0.5
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
		alertentity arcot1
	}
}

