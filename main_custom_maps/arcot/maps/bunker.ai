trooper1
{
	attributes
	{
		idle_crouch 0.0
		attack_crouch 0.0
	}

	spawn
	{
		knockback off
		noavoid
		noattack 999999 // BUG FIX!!!!
		trigger trooper1 animloop
	}

	trigger animloop
	{
		playanim parachute both forever
	}

	trigger go
	{
		attack
		parachute off
		accum 1 bitset 4
		explicit_routing on
		sight
		clearanim
		resetscript
		avoid
		knockback on
		statetype alert
		explicit_routing off
		movetype run
		playsound sound\scenaric\run\6.wav
		runtomarker tr_1 nostop
		runtomarker hp2_2 nostop
		statetype alert
		wait forever 0
	}

	enemysight
	{
		playsound sound\scenaric\run\6.wav
	}

	avoiddanger player
	{
		denyactivate
	}

	statechange alert combat
	{
		accum 1 abort_if_not_bitset 2
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpactsound
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}
}


