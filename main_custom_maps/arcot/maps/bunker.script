camera
{
	spawn
	{
	}

	trigger motor
	{
		startcam par1
		wait 6000
		startcam par2
		wait 5000
		startcam par3
                wait 5000
                startcam bunker_2
                wait 3000
		startcam bunker_3
	}
}

dialog
{
	spawn
	{
	}

	trigger hotel_conversation
	{
		trigger nazi6 conversation1		// ah this is some tasty sory broton..
		wait 4300
		trigger nazi7 conversation1
		wait 2700
		trigger nazi6 conversation2
		wait 1700
		trigger nazi7 conversation2
		wait 3200
		trigger nazi6 conversation3
		wait 2800				
	}

	trigger bazar3
	{
		trigger dialog bazar1
	}

        trigger bazar2

        {
		playsound sound\scenaric\general\misc_always.wav
        }
 }

doska
{
	spawn
	{
		wait 5
		trigger doska swingloop
	}

	trigger swingloop
	{
		faceangles 0 0 2 125
		faceangles 0 0 4 150
		faceangles 0 0 6 175
		faceangles 0 0 8 200
		faceangles 0 0 10 250
		faceangles 0 0 8 200
		faceangles 0 0 6 175
		faceangles 0 0 4 150
		faceangles 0 0 2 125
		faceangles 0 0 0 100
		faceangles 0 0 -2 125
		faceangles 0 0 -4 150
		faceangles 0 0 -6 175
		faceangles 0 0 -8 200
		faceangles 0 0 -10 250
		faceangles 0 0 -8 200
		faceangles 0 0 -6 175
		faceangles 0 0 -4 150
		faceangles 0 0 -2 125
		faceangles 0 0 0 100
		trigger doska swingloop
	}

	death
	{
		alertentity kill_doska
		alertentity doska_ex
	}
}

lift
{
	spawn
	{
		gotomarker 1 100
		faceangles 0 0 0 gototime
	}

	trigger move
	{
		alertentity l
		alertentity r
		alertentity red
		alertentity 2_green
		trigger lamp yellow_loop
		wait 2000
		playsound sound/scenaric/tram/tram_move.wav looping
		alertentity green
		gotomarker 2 50
		faceangles 0 0 0 gototime
                gotomarker 3 50
		faceangles 0 0 0 gototime
                gotomarker 4 50
		faceangles 0 0 0 gototime
                gotomarker 5 50
		faceangles 0 0 0 gototime
		trigger lamp stop_yellow
		alertentity 2_red
                stopsound
                playsound sound/scenaric/tram/tram_stop.wav
		wait 1000
		alertentity 2_l
		alertentity 2_r
	}

	trigger move2
	{
		alertentity 2_l
		alertentity 2_r
		alertentity 2_red
		trigger lamp yellow_loop
		wait 2000
		playsound sound/scenaric/tram/tram_move.wav looping
		alertentity 2_green
		alertentity green
		gotomarker 5 50
		faceangles 0 0 0 gototime
                gotomarker 4 50
		faceangles 0 0 0 gototime
                gotomarker 3 50
		faceangles 0 0 0 gototime
                gotomarker 2 50
		faceangles 0 0 0 gototime
		gotomarker 2 50
		faceangles 0 0 0 gototime
		trigger lamp stop_yellow
		alertentity red
                stopsound
                playsound sound/scenaric/tram/tram_stop.wav
		wait 1000
		alertentity l
		alertentity r
	}


}

lamp
{
	spawn
	{
	}

	trigger yellow_loop
	{
		alertentity yellow
		accum 1 bitreset 0
		wait 500
		alertentity yellow
		accum 1 bitset 0
		wait 500
		trigger lamp yellow_loop
	}

	trigger stop_yellow
	{
		resetscript
		accum 1 abort_if_bitset 0
		alertentity yellow
	}

	trigger red_loop
	{
		alertentity alarm_on_off
		accum 1 bitreset 0
		wait 50
		alertentity alarm_on_off
		accum 1 bitset 0
		wait 50
		trigger lamp red_loop
	}

	trigger stop_red
	{
		resetscript
		accum 1 abort_if_bitset 0
		alertentity alarm_on_off
	}

}






