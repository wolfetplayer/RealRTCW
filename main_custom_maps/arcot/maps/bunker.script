handle
{
	spawn
	{
	}

	trigger turnon
	{
		playsound sound/movers/switches/butn2.wav
		faceangles 180 0 0 500
                wait 2000
                faceangles 0 0 0 500
	}

	trigger on_off_1
	{
		alertentity lamp3
		wait 300
		alertentity lamp3
		trigger handle on_off
	}

	trigger on_off_2
	{
		alertentity lamp4
		wait 500
		alertentity lamp4
		trigger handle on_off
	}
		
}

door
{
	spawn
	{
	}

	trigger open
	{
		playsound sound\movers\doors\door10_open.wav
		faceangles 0 270 0 1000
                wait 15000
                trigger door close
	}

	trigger close
       	{
                playsound sound\movers\doors\door10_open.wav
		faceangles 0 0 0 1000
       	}

}

parachute1
{
	spawn
	{
		accum 0 bitreset 0	// Used incase the parachute deflates,
	}

	trigger go
	{
	        alertentity trooper1
	        alertentity killstatic1
		playanim 1 74 looping forever
		gotomarker p1spot15 150 wait
		gotomarker p1spot16 150 deccel wait
		faceangles 0 26 0 500
	        trigger trooper1 go
		playanim 53 180 2000
		wait 100
		trigger parachute1 sink
	}

	trigger sink
	{
		wait 10000
		gotomarker p1spot17 2 wait
	        wait 5
		alertentity killp1
	}
}

