//
// AI Scripting
// Map: Road to Station
// Last edited by: Arcot 24
// 23.12.2008

player
{
	spawn
	{
		objectivesneeded 1
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/m_stealth
		wait 2000
		alertentity time
		wait 500
		alertentity tik_tak
		wait 4000
		alertentity km
	}

        trigger stop
        {
	        lockplayer on
        }

        trigger action1
	{
		alertentity nazi1
		alertentity nazi2
		alertentity nazi3
		alertentity nazi4
                trigger t2body pov
                trigger box pov
                trigger box2 pov
	}

	trigger action2
	{
		alertentity zvuk3
		wait 3000
		wait 3000
		alertentity kuku
		trigger me go
                trigger me2 go
                wait 12000
                alertentity nazi5
                alertentity nazi6
                alertentity nazi7
                alertentity nazi8
		wait 500
                startcam rts_1
		wait 13000
		alertentity driver
		wait 8000
		alertentity wait

		savecheckpoint
	}

	trigger action3
	{
		objectivemet 1
                alertentity kill_nazi6
		alertentity nazi9
		alertentity kill_trigger_action6
		alertentity off_ai_sight
		trigger player stop
		wait 1000
                trigger nazi7 visoff
                trigger nazi5 visoff
		wait 2000
		alertentity remember

		savecheckpoint
	}

	trigger action4
	{
                missionfailed 6 5
	}

        trigger action5
        {
		alertentity nazi10
		alertentity nazi11
                trigger nazi10 visoff
                trigger nazi11 visoff
        }

	trigger endmap
	{
		changelevel station persistent
	}

        trigger failed
        {
                wait 1000
                missionfailed 6 10
        }
}

nazi1
{
	attributes
	{
		attack_crouch 10
		aggression 10
		hearing_scale 10
		inner_detection_radius 512
                tactical 10
	}

	spawn
	{
		setammo ammo_grenades 0
		takeweapon weapon_mp40
		giveweapon weapon_mauserrifle
		setammo 7.92mm 999
		selectweapon weapon_mauserrifle
    	        trigger nazi1 go
	}

	trigger go
	{
		walktomarker l4_2 nostop
		walktomarker l3_3 nostop
		walktomarker l1_3 nostop
		walktomarker l2_4 nostop
	}

        enemysight
        {
                resetscript
                statetype alert
        }
}

