                walktomarker for2
		walktomarker s1_4
		trigger sklad1 run
	}

	trigger alert
	{
		resetscript
		statetype alert
	}


	statechange relaxed alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		clearanim
		trigger sklad1 alert
	}

	statechange relaxed combat
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		clearanim
		trigger sklad1 alert
	}

	statechange query alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		clearanim
		trigger sklad1 alert
