//
//AI Scripting
//Map: station
//Last edited by: arcot 24
//

player
{
	spawn
	{
		objectivesneeded 2
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout station
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1500
		mu_queue sound/music/m_situation
		giveweapon weapon_sten
	        selectweapon weapon_sten
	        setammo ammo_9mm 120
		alertentity chas2
		wait 2000
		alertentity tr_01
	}

	trigger action1
	{
		alertentity musa3
		alertentity musa4
		alertentity musa5
		alertentity bibo1
		alertentity bibo2
		alertentity bibo3
		alertentity bibo4
		alertentity bibo5
	}

	trigger action2
	{
		alertentity nazi1
		alertentity nazi2
		alertentity nazi3
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6

		savecheckpoint
	}

	trigger action3
	{
		alertentity psih
		alertentity aleks
		alertentity art6
		alertentity krot3
		alertentity krot4
		alertentity of2
		alertentity krot5
		alertentity krot6
		alertentity poezd1
		alertentity art5
	}

	trigger action4
	{
                alertentity art1
		alertentity art2
		alertentity art3
		alertentity art4
		alertentity opendoor2
		alertentity pod1
		alertentity pod2
		alertentity pod3
		alertentity pod4
		alertentity muslim
		alertentity of1
		mu_fade 0 1500
		mu_queue sound/music/m_moving

		savecheckpoint
	}

	trigger action5
	{
		alertentity zaur1
		alertentity zaur2
		alertentity zaur3
	}

	trigger zad1
	{
		objectivemet 1
		alertentity opendoor1
		alertentity waketrig
		alertentity wolf_4
		alertentity wolf_5
		alertentity wolf_6
		alertentity wolf_7
		alertentity krot7
		alertentity trigger_action4
		mu_fade 0 1500
		mu_queue sound/music/m_grave

		savecheckpoint
	}

	trigger zad2
	{
		mu_fade 0 1500
		mu_queue sound/music/m_mission
		objectivemet 2
		alertentity wolf_1
		alertentity wolf_2
		alertentity wolf_3
		alertentity action_final
	}
	
	trigger camera
	{
		startcam station1
		mu_fade 0 1500
		mu_queue sound/music/m_mission
	}

	trigger trap
	{
		alertentity poezd2
	}

	trigger secret1
	{
		foundsecret
	}

	trigger metalbox_down
	{
		trigger metalbox begin2
	}

	trigger lockon
	{
		lockplayer on
	}

	trigger escape
	{
		trigger train_escape start
	}
	
	trigger endmap
	{
		achievement_arkot
		changelevel scene nostats
	}
}

