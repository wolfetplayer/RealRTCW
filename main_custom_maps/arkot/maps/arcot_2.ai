mechanic2
{
	attributes
	{
		attack_crouch 9.90
		fov 120
		inner_detection_radius 384
	}

	spawn
	{
		accum 0 set 0 // 1 = alerted
		accum 1 set 0 // 1 = others sighted player first
		setammo ammo_grenades 0
		takeweapon weapon_mp40
		wait 100
		movetype crouch
		trigger mechanic2 talk
	}

	trigger working1
	{
		accum 0 abort_if_not_equal 0
		playanim device both
		trigger mechanic2 working1 forever
	}

	trigger talk
	{
		playsound sound\scenaric\dam\m1_verdammt_leak.wav
		trigger mechanic2 working1
	}

	statechange relaxed alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger mechanic2 alert1
	}

	statechange query alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger mechanic2 alert1
	}

	statechange relaxed combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger mechanic2 alert1
	}

	statechange query combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger mechanic2 alert1
	}

	bulletimpact
	{
		statetype alert
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger mechanic2 alert1
	}

	inspectsoundstart
	{
		statetype alert
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger mechanic2 alert1
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger mechanic2 alert1
	}

	inspectfriendlycombatstart
	{
		deny
	}

	trigger alert1
	{
		clearanim
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		wait 50 player
		wait 1000
	}

	trigger sighted1 // called by other ai's
	{
		accum 1 set 1
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		clearanim
		statetype alert
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		wait 50 player
		wait 1000
	}

	enemysight
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
	}

	death
	{
		accum 1 set 1
		trigger dead killer
	}
}

