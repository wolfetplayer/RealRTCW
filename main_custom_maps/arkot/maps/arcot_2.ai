		trigger sexy_3 smoking
	}

	trigger smoking
	{
		cigarette on
		playanim smoking both
		cigarette off
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		trigger sexy_3 smoking
	}
	
	enemysight
	{
		resetscript
		statetype alert
	}
}

