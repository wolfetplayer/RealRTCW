		playsound sound\scenaric\escape1\axis12_coded_relax.wav
		wait 3000
		playsound sound\scenaric\escape1\axis12_priority_relax.wav
		wait 5000
		wait 1500
		walktomarker les1
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	death
	{
	}

	enemysight
	{
	}
}


