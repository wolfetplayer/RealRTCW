player
{
	spawn
	{
		cvar g_episode 1
		objectivesneeded 2
		abort_if_loadgame
		mu_start sound/music/l_briefing_2

	}

	playerstart
	{
		mu_fade 0 1000 // music fades to 0% in 1 second (1000mSec.)
		mu_queue sound/music/m_drums
		alertentity post1
		alertentity post2
		alertentity of3_kill
		trigger orel2 on_off
		trigger table1 motor
		trigger gus move
		wait 40000
		trigger electrik go
	}

	trigger action1
	{
		alertentity arcot1
		alertentity arcot2
		alertentity arcot3
	}

	trigger action2
	{
		trigger t2body begin
	}

	trigger action3
	{
		mu_fade 0 1500
		mu_queue sound/music/m_alarm
		alertentity ssunter1
		alertentity ssunter2
		alertentity sszoldat1
		alertentity sszoldat2
		alertentity of2

		savecheckpoint
	}

	trigger action4
	{
		alertentity nazi3
		alertentity nazi4
		alertentity trev
	}

	trigger action5
	{
		alertentity sexy_1
		alertentity sexy_2
		alertentity sexy_3
		alertentity sexy_4
		alertentity sszoldat3
		alertentity ssunter3
		alertentity tablekick

		savecheckpoint
	}

	trigger action6
	{
		mu_fade 0 1000
		mu_queue sound/music/m_grave
	}

	trigger action7
	{
		mu_fade 0 1500
		mu_queue sound/music/m_tension
		alertentity mechanic2
		alertentity opendoor

		savecheckpoint
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger changemusic
	{
		mu_fade 0 1000
		mu_queue sound/music/m_moving
	}

	trigger destroy
	{
		alertentity wakedoor
	}

	trigger krannik_close
	{
		trigger handcrank close
	}

	trigger dos
	{
		trigger shelf fall1
		trigger barrell1 fall1
		trigger barrell2 fall1
		trigger barrell3 fall1
	}

	trigger zad1
	{
		alertentity sexy_5
		alertentity sexy_6
		alertentity sexy_7
		alertentity sszoldat4
		alertentity opensafe
		wait 3000
		mu_fade 0 1000
		mu_queue sound/music/m_mission
	}

	trigger zad2
	{
		objectivemet 2
	}

	trigger zad3
	{
		objectivemet 1
	}

	trigger killdoor
	{
		wait 300
		trigger tablekick kick_table
	}

	trigger orelstart
	{
		trigger orel move
		trigger orel2 move
	}
	
trigger endmap
	{
		changelevel bunker persistent
	}
}

tablekick
{
	attributes
	{
		tactical 9.0
		alertness 2048
		fov 60
		aggression 0.5
	}

	spawn
	{
		giveweapon weapon_mp40
		setammo ammo_9mm 70
		setclip weapon_mp40 32
		selectweapon weapon_mp40
		statetype alert
	}

	trigger kick_table
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1
		noattack 2000
		runtomarker n3spot2
		facetargetangles n3spot2
		trigger table1 flip_over
		playanim kick both
		resetscript
		runtomarker n3spot1
		attack
		alertentity killscript
		wait forever 0
	}

	avoiddanger grenade
	{
		clearanim
		resetscript
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_bitset 1
	}

	bulletimpact
	{
		deny
		accum 0 abort_if_bitset 1
	}

	death
	{
		trigger dead killer
		alertentity killscript
	}

	enemysight
	{
		accum 0 abort_if_bitset 1
	}
}

of3_kill
{
	attributes
	{
		tactical 9.0
		alertness 2048
		fov 60
		aggression 0.5
