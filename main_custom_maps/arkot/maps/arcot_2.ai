electrik
{
	attributes
	{
		attack_crouch 9.90
		fov 120
		inner_detection_radius 384
	}

	spawn
	{
		setammo ammo_grenades 0
		takeweapon weapon_mp40
		wait 100
		movetype crouch
		trigger electrik working1
	}

	trigger working1
	{
		playanim device both forever
	}

	trigger go
	{
		clearanim
		runtomarker les1
	}

	statechange relaxed alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger electrik alert1
	}

	statechange query alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger electrik alert1
	}

	statechange relaxed combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger electrik alert1
	}

	statechange query combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger electrik alert1
	}

	bulletimpact
	{
		statetype alert
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger electrik alert1
	}

	inspectsoundstart
	{
		statetype alert
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger electrik alert1
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger electrik alert1
	}

	inspectfriendlycombatstart
	{
		deny
	}

	trigger alert1
	{
		clearanim
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		wait 50 player
		wait 1000
	}

	trigger sighted1
	{
		accum 1 set 1
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		clearanim
		statetype alert
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		wait 50 player
		wait 1000
	}

	enemysight
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
	}

	death
	{
		accum 1 set 1
	}
}

