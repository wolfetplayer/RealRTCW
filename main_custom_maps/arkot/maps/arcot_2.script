table1
{
	spawn
	{
		accum 0 bitreset 0	// ON/OFF, checks to see how far the table is from flipping.
	}

	trigger flip_over
	{
		wait 700
		accum 0 bitset 0
		alertentity table_push
		alertentity kill_table_trig
		gotomarker table1_spot1 20
		faceangles -45 -2 0 gototime
		faceangles -90 -3 0 60
		faceangles -87 -4 0 100
		faceangles -90 -5 0 100
		alertentity table_push_kill
	}

	trigger play_snd
	{
		playsound ass_table_fall
	}

	trigger user_flip_over
	{
		accum 0 bitset 0
		alertentity kill_table_trig
		gotomarker table1_spot1 20
		faceangles -45 -2 0 gototime
		faceangles -90 -3 0 60
		faceangles -87 -4 0 100
		faceangles -90 -5 0 100
	}

	trigger stop_flip
	{
		accum 0 abort_if_bitset 0
		resetscript
	}

	trigger motor
	{
		startcam arcot_2_1
		wait 3000
		startcam arcot_2_2
		wait 10000
		startcam arcot_2_3
		wait 10000
		startcam arcot_2_4
		wait 6000
		startcam arcot_2_5
		wait 4000
		startcam arcot_2_6
		wait 3000
		trigger post3 dialog
		wait 500
		alertentity of_kill
		wait 3000
		alertentity breakalarm
		wait 2000
		alertentity time
		alertentity kill_electrik
		wait 500
		alertentity tik_tak
		alertentity kill_gus

	}


}

orel
{
	spawn
	{
		accum 0 set 0
		wait 200
	}

	trigger move
	{
		alertentity tr_01
		accum 0 set 0
		faceangles 0 360 0 1
		gotomarker orel_start 164 wait
		gotomarker orel_start_2 164
		faceangles 0 360 0 1
		gotomarker orel_end 164
	}
}

orel2
{
	spawn
	{
		accum 0 set 0
		wait 200
	}

	trigger move
	{
		accum 0 set 0
		faceangles 0 360 0 1
		gotomarker orel2_start 164 
		gotomarker orel2_2 164
		faceangles 0 360 0 1
		alertentity tr_01
		gotomarker orel2_end 164
		
	}
	
	trigger on_off
	{
		alertentity lights_on_off
		wait 500
		alertentity lights_on_off
		wait 200
		alertentity lights_on_off
		wait 480
		alertentity lights_on_off
		wait 380
		alertentity lights_on_off
		wait 230
		trigger orel2 on_off
	}
}

