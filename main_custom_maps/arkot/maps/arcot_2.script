t2body
{
	spawn
	{
		accum 0 set 0
		wait 1000
		gotomarker spot1 100
		faceangles 0 270 0 gototime
	}



	trigger begin
	{
		wait 1000
		playsound sound/world/shift_01.wav looping
		trigger wb3 begin
		trigger wl3 begin
		trigger wr3 begin
		gotomarker spot1 250
		faceangles 0 270 0 gototime
		gotomarker spot2 250
		faceangles 0 270 0 gototime
		gotomarker spot3 250
		faceangles 0 270 0 gototime
		trigger wb3 stop2
		trigger wl3 stop2
		trigger wr3 stop2
                stopsound
	}

	trigger killer_2
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 4
		alertentity trigger_action6_on
		mu_fade 0 1000
                mu_queue sound/music/m_mission
	}
}

wb3
{
	spawn
	{
		wait 1000
		attachtotag t2body tag_q3
	}

	trigger begin
	{
		playsound sound/world/shift_01.wav looping
		wait 5
		playanim 0 20 looping forever
	}

	trigger stop2
	{
		wait 1000
		playsound sound/world/idle_01.wav looping
		playanim 0 20 10000
	}
}

