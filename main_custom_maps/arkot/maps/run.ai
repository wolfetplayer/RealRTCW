	}

	trigger blocking3
	{
		accum 1 set 1
		statetype alert
		clearanim
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		resetscript
		attack
		wait 8000 0
	}

	statechange relaxed alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger radist_1 quickdraw
	}

	statechange relaxed combat
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger radist_1 quickdraw
	}

	statechange query alert
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger radist_1 quickdraw
	}

	statechange query combat
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		trigger radist_1 quickdraw
	}

	bulletimpact
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		statetype alert
		trigger radist_1 quickdraw
	}

	inspectsoundstart
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		statetype alert
		trigger radist_1 quickdraw
	}

	trigger quickdraw
	{
		playsound Blank
		clearanim
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		wait 50 player
		resetscript
	}

	trigger alert3 // called by others
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		playsound Blank
		statetype alert
		clearanim
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		resetscript
		wait 100 player
	}

        enemysight
	{
