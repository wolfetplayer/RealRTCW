// AI scripting
// Map RuN
// Last edited by arcot 24
// 19.05.2008



player
{
	spawn
	{
		cvar g_episode 4
		objectivesneeded 2
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1500
		mu_queue sound\music\m_drums
		giveinventory key_binocs
		trigger zvuk_1 begin
		wait 2000
		alertentity time
		wait 500
		alertentity tik_tak
	}

	trigger action1
	{
		alertentity most_1
		alertentity most_2
	}


	trigger action2
	{
		trigger balka go
		alertentity derevo_snaiper
	}

	trigger action3
	{
		alertentity nazi2
		alertentity nazi3
		alertentity nazi4
		alertentity nazi5

		savecheckpoint
	}

	trigger action4
	{
		alertentity nazi8
		alertentity nazi9
		alertentity nazi30
		alertentity nazi31
		alertentity nazi32
		alertentity nazi33
		alertentity radist_1
		alertentity house_sniper
		alertentity of1
		alertentity of2
	}

	trigger action5
	{
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		alertentity nazi21

		savecheckpoint
	}

	trigger action6
	{
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi26a
		alertentity nazi27
		alertentity nazi28
		alertentity nazi29
		alertentity nazi30

		savecheckpoint
	}

	trigger action7
	{
		mu_fade 0 1500
		mu_queue sound\music\m_drums
	}

	trigger action8
	{
		alertentity zvonok
		wait 5000
		alertentity zvonok
		wait 5000
		alertentity zvonok
		wait 5000
		alertentity zvonok
	}

	trigger action9
	{
		alertentity moto
		wait 10000
		trigger player changemusic_2
	}

	trigger action10
	{
		alertentity poezd_sound
		trigger poezd go
		alertentity kill_trigger_2
	}

	trigger action11
	{
		alertentity poezd_sound
		trigger poezd go
		alertentity kill_trigger_1

		savecheckpoint
	}

	trigger action12
	{
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
	}

	trigger destroy_radio
	{
		objectivemet 1
	}
	
	trigger objective_2
	{
		objectivemet 2
	}

	trigger veter
	{
		alertentity wind
		wait 2000
		trigger player veter
	}

	trigger sava_1
	{

		wait 25000
		alertentity sava
		wait 35000
		alertentity sava
		wait 50000
		alertentity sava
		wait 40000
		trigger player sava_1
	}

	trigger sava_2
	{
		alertentity night
		wait 13000
		trigger player sava_2
	}

	trigger changemusic_1
	{
		mu_fade 0 1000
		mu_queue sound/music/m_moving
	}

	trigger changemusic_2
	{
		mu_fade 0 1000
		mu_queue sound/music/m_action
	}

	trigger endmap
	{
		changelevel rts persistent
	}
}

// oficerss ================================================================

of1
{
	attributes
	{
		idle_crouch 0.0
		attack_crouch 0.0
		hearing_scale 0.2
		fov 360
	}

	spawn
	{
		accum 0 set 0
		accum 1 set 0
		setammo ammo_grenades 0
		takeweapon weapon_mp40
	}

	enemysight player
	{
		resetscript
	}

	statechange relaxed alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger of1 active1
	}

	statechange relaxed combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger of1 active1
	}

	statechange query alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger of1 active1
	}

	statechange query combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger of1 active1
	}

	bulletimpact
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		statetype alert
		trigger of1 active1
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		statetype alert
		trigger of1 active1
	}

	enemysight
	{
	}

	inspectfriendlycombatstart
	{
		deny
	}

	trigger statue1
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound Blank
		clearanim
		statetype alert
		playsound MiscWhatsThat
		trigger of1 active1
	}

	trigger awaken1
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		statetype alert
		trigger of1 active1
	}

	trigger active1
	{
		clearanim
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

	death
	{
		trigger checker death
	}
}

