most_1
{
	attributes
	{
		alertness 1152
		inner_detection_radius 2048
		fov 1024
		aggression 0.9
		tactical 0.9
		attack_crouch 0.9
                hearing_scale 0.9
	}

	spawn
	{
		accum 0 set 0 // 1 = alerted
		setammo grenades 0
		giveweapon weapon_mp40
		setammo ammo_45cal 999
		selectweapon weapon_mp40
		trigger most_1 go
	}

	trigger go
	{
		walktomarker most_1_1
		wait 300
		walktomarker most_1_2
		trigger most_1 go
	}

	trigger dialog
	{
		playsound sound\scenaric\run\1.wav
		wait 7000
		playsound sound\scenaric\run\2.wav
		wait 4500
		playsound sound\scenaric\run\3.wav
		wait 3000
		playsound sound\scenaric\run\4.wav
		wait 6000
		playsound sound\scenaric\run\5.wav
		wait 4500
		trigger most_1 dialog
	}


	statechange relaxed query
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		statetype alert
	}

	statechange relaxed alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
	}

	statechange relaxed combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
	}

	bulletimpact
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
	}

	inspectfriendlycombatstart
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
	}

	trigger awaken4 // called by other ai's
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
	}

	enemysight
	{
		trigger most_1 dialog
		accum 0 abort_if_not_equal 1
	}

	death
	{
		trigger checker death
	}
}

