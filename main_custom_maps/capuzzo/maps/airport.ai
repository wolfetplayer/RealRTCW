nazi_k5
{
	attributes
	{
		aggression 0.3
		hearing_scale 1
		fov 300
		camper 0.9
		tactical 0.9
	}

	spawn
	{
		//nosight 99999999

		setammo ammo_grenades 0

		knockback off
		statetype alert

		//Randomness

		accum 0 random 5	//0=Attack 1=crouchtocast 2=behind_door 3=behind_stairs 4=inspect

		trigger nazi_k5 attack
		trigger nazi_k5 crouchtocast
		trigger nazi_k5 behind_door
		trigger nazi_k5 behind_stairs
		trigger nazi_k5 inspect
	}

	trigger attack
	{
		accum 0 abort_if_not_equal 0

		attack player
	}

	trigger crouchtocast
	{
		accum 0 abort_if_not_equal 1

		avoid player
		crouchtocast player firetarget
	}

	trigger behind_door
	{
		accum 0 abort_if_not_equal 2
		
		gotomarker m_k5_door
		facetargetangles m_k5_door

		attack player
	}

	trigger behind_stairs
	{
		accum 0 abort_if_not_equal 3
		
		runtomarker m_k5_stairs nostop
		facetargetangles m_k5_stairs
	}

	trigger inspect
	{
		accum 0 abort_if_not_equal 4
		
		runtomarker m_k5_stairs nostop
		facetargetangles m_k5_stairs

		attack player
	}


	enemysight
	{
		resetscript
	}

	//
		//Following events are denied ONLY to get the bot to go and stay behind_stairs (3)
	//	

	inspectsoundstart
	{
		accum 0 abort_if_not_equal 3

		deny
	}

	inspectbodystart
	{
		accum 0 abort_if_not_equal 3

		deny
	}

	inspectfriendlycombatstart
	{
		accum 0 abort_if_not_equal 3

		deny
	}

	bulletimpact
	{
		accum 0 abort_if_not_equal 3

		deny
	}

	death
	{
		trigger player deathcounter
		trigger player cmd_house_deathcounter
	}
}

