	}

	spawn
	{
		//nosight 99999999

		setammo ammo_grenades 0

		knockback off
		statetype alert

		//Randomness

		accum 0 random 3	//0=Attack 1=Runtocast 2=blank (bot chooses)

		trigger nazi_k3 attack
		trigger nazi_k3 runtocast

	}
		
	trigger attack
	{
		accum 0 abort_if_not_equal 0		

		attack player
	}

	trigger runtocast
	{
		accum 0 abort_if_not_equal 1

		wait 500 1024

		runtocast player firetarget
	}

	trigger coming_inside
	{
		//Sometimes bot doesn't go inspect and it takes ages for bot to see the player

		accum 0 abort_if_not_equal 2

		attack player
	}

