////////////////////////////////////////////
////////////////Road patrol////////////////
//////////////////////////////////////////

nazi_r1
{
	attributes
	{
		aggression 0.9
		hearing_scale 0.0
		running_speed 290
	}

	spawn
	{
		//nosight 99999999999

		accum 0 set 0	//Should I inspect? 0=no 1=yes

		setammo ammo_grenades 0
		takeweapon weapon_mp40

		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
	}

	trigger kill_the_american
	{
		noavoid
		statetype alert

		knockback off

		wait 100

		runtomarker m_r1_1 nostop
		runtomarker m_r1_2 nostop
		runtomarker m_r1_3 nostop
		runtomarker m_r1_4 nostop
		runtomarker m_r1_5 nostop
		runtomarker m_r1_6 nostop

		attrib hearing_scale 0.5
		accum 0 set 1

		facetargetangles m_r1_6

		wait 450 0

		crouchtomarker m_r1_7 nostop

		headlook off

		wait 8500 0

		runtomarker m_r1_7 nostop
		runtomarker m_r1_8 nostop
		runtomarker m_r1_9 nostop
		runtomarker m_r1_10 nostop
		runtomarker m_r1_11 nostop

		wait forever 100
	}

	enemysight
	{

		resetscript
	}

	bulletimpact
	{
		accum 0 abort_if_not_equal 0

		deny
	}

	inspectfriendlycombatstart
	{
		accum 0 abort_if_not_equal 0

		deny
	}

	inspectbodystart
	{
		deny
	}

	death
	{
		trigger player deathcounter
		trigger player valley_deathcounter
	}
}

nazi_r2
{
	attributes
	{
		aggression 0.9
		hearing_scale 0.0
		running_speed 300
	}

	spawn
	{
		//nosight 99999999999

		accum 0 set 0	//Should I inspect? 		0=no 1=yes
		accum 1 set 0	//Ignore enemysight? 		0=no 1 yes
		accum 2	set 0	//Have I seen the enemy?	0=no 1 yes

		setammo ammo_grenades 0
		takeweapon weapon_mp40

		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
	}

	trigger kill_the_american
	{
		noavoid
		statetype alert

		knockback off

		runtomarker m_r2_1 nostop
		runtomarker m_r2_2 nostop
		runtomarker m_r2_3 nostop
		runtomarker m_r2_4 nostop
		runtomarker m_r2_5 nostop

		attrib hearing_scale 0.5
		accum 0 set 1

		crouchtomarker m_r2_6 nostop

		movetype run

		runtomarker m_r2_7 nostop
		runtomarker m_r2_8 nostop
		runtomarker m_r2_9 nostop
		wait 250 20
		runtomarker m_r2_10 nostop

		runtomarker m_r2_11 nostop
		runtomarker m_r2_12 nostop
		runtomarker m_r2_13 nostop
		runtomarker m_r2_14 nostop
		runtomarker m_r2_15 nostop

		//Follow the path of v6 to the mg

		runtomarker m_v6_1 nostop
		runtomarker m_v6_2 nostop
		runtomarker m_v6_mg nostop

		accum 0 set 0
		accum 1 set 1

		mount start_mg

		alertentity nazi_r2_mg_trigger
		alertentity nazi_r2_back_up_mg_trigger
	}

	trigger releasegun
	{
		//This can't happen before the bot has mounted the mg and seen the player!

		accum 2 abort_if_equal 0

		unmount
		resetscript

		accum 0 set 1
	}

	trigger hey_dont_go
	{
		//Backup trigger for mg, because it is possible to sneak past the mg..

		accum 2 abort_if_equal 1

		accum 0 set 1
		accum 1 set 0

		unmount

		wait 100

		//Go to the damn player who is trying to escape.. This command will be forgotten when the bot sees player.

		runtocast player firetarget

	}

	enemysight
	{
		accum 2 set 1

		accum 1 abort_if_equal 1

		resetscript
	}

	bulletimpact
	{
		accum 0 abort_if_equal 1

		deny
	}

	inspectfriendlycombatstart
	{
		accum 0 abort_if_equal 1

		deny
	}

	inspectbodystart
	{
		deny
	}

	forced_mg42_unmount
	{
		deny
	}

	death
	{
		trigger player deathcounter
		trigger player valley_deathcounter
	}
}

