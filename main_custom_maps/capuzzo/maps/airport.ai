//-------------------MG42 bot-----------------------

nazi_v5
{
	attributes
	{
	}

	spawn
	{
		//nosight 99999999

		knockback off
		statetype alert

		wait 100

		mount start_mg
	}

	forced_mg42_unmount
	{
		deny
	}


	trigger releasegun
	{
		unmount
		wait 100 player

		resetscript
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}

	enemysight
	{
		trigger nazi_v6 get_into_position
	}

	death
	{
		trigger player deathcounter
		trigger player valley_deathcounter
		trigger nazi_v6 mg_guy_dead
	}
}


nazi_v6
{
	attributes
	{
		aggression 0.8
		hearing_scale 0.0
	}

	spawn
	{
		accum 0 set 0		//Player has not gone past the trigger

		//nosight 99999999
		noavoid
	}

	trigger get_into_position
	{
		walktomarker m_v6_1
		walktomarker m_v6_2
		crouchtomarker m_v6_3
		wait forever 0
	}


	trigger mg_guy_dead
	{
		accum 0 abort_if_not_equal 0	//Has player gone past the trigger?

		resetscript

		runtomarker m_v6_mg

		movetype run

		knockback off

		mount start_mg
	}

	trigger releasegun
	{
		accum 0 set 1		//Player has gone past the trigger

		unmount
		resetscript
	}

	forced_mg42_unmount
	{
		deny
	}

	death
	{
		trigger player deathcounter
		trigger player valley_deathcounter
	}
}

