////////////////////////////////////////////
/////////////////Cave bots/////////////////
//////////////////////////////////////////

nazi_c1
{
	attributes
	{
		aggression 0.6
		inner_detection_radius 2048
		hearing_scale 1.0
		walking_speed 180
	}

	spawn
	{
		accum 0 set 0		//Has bot detected player? 0=no 1=yes

		setammo ammo_grenades 0
		knockback off
	}

	trigger going_out
	{
		accum 0 abort_if_not_equal 0

		statetype alert

		walktomarker m_c1_1 nostop
		walktomarker m_c1_2 nostop

		facetargetangles m_c1_2

		walktomarker m_c1n2_1 nostop
		walktomarker m_c1n2_2 nostop
		walktomarker m_c1n2_3 nostop

		headlook on

		wait 10000

		headlook off

		walktocast player firetarget
	}

	enemysight
	{
		resetscript

		accum 0 set 1
	}

	bulletimpact
	{
		deny

		accum 0 abort_if_not_equal 0

		resetscript

		accum 0 set 1

		runtocast player firetarget	
	}

	death
	{
		trigger player deathcounter
	}
}

