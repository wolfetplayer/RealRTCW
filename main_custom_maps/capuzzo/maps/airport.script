cmd_door
{

	spawn
	{
		//Who wants to spawn?
	}

	death
	{
		trigger player cmd_door_breached
	}
}

italy_flag
{
	spawn
	{
		wait 200
		playanim 1 191 looping forever rate 38
	}
}