nazi_c6
{
	attributes
	{
		aggression 0.2
		inner_detection_radius 1024
		hearing_scale 1.6
		walking_speed 150
	}

	spawn
	{
		setammo ammo_grenades 0
		takeweapon weapon_mp40

		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
	}

	trigger march_loop
	{
		wait 250
		walktomarker m_c6_2
		wait 250
		walktomarker m_c6_1

		trigger nazi_c6 march_loop
	}

	statechange relaxed alert
	{
		resetscript
		wait 5 player
	}

	statechange relaxed combat
	{
		resetscript
		wait 5 player
	}

	statechange query alert
	{
		resetscript
		wait 5 player
	}

	statechange query combat
	{
		resetscript
		wait 5 player
	}

	enemysight
	{
		resetscript
	}

	death
	{
		trigger player city_deathcount
	}	
}

