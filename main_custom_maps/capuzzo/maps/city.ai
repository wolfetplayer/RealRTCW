//---------------Button house bots------------------

nazi_c13
{
	attributes
	{
		aggression 0.1
		camper 0.6
		hearing_scale 0.0
		inner_detection_radius 32
	}

	trigger open_door
	{
		explicit_routing off

		wait 2500

		trigger player play_alarm

		//Unlock the button house's door
		alertentity button_door_relay

		gotomarker m_c13_2 nostop

		explicit_routing on
	}

	death
	{
		trigger player city_deathcount2
	}
}

