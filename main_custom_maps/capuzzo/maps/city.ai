//-------------------MG42 bot-----------------------

nazi_c8
{
	attributes
	{
	}

	forced_mg42_unmount
	{
		deny
	}

	trigger mount
	{
		knockback off
		statetype alert

		wait 100

		mount city_mg
	}

	trigger releasegun
	{
		unmount
		wait 100 player

