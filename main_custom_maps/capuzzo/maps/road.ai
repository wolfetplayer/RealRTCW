////////////////////////////////////////////
/////////////////MG bots/////////////////
//////////////////////////////////////////

nazi_mg_d
{
	attributes
	{
	}

	spawn
	{
		accum 0 set 0	//Gun not released

		knockback off
		statetype alert

		wait 250
		mount road_mg
	}

	trigger fire_truck
	{
		fireattarget truck_fw
	}

	trigger stop_fire
	{
		resetscript
	}

	forced_mg42_unmount
	{
		deny
	}

	trigger releasegun
	{
		accum 0 set 1	//Gun released!

		unmount
		wait 100 player

		resetscript
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}

	death
	{
		accum 0 abort_if_not_equal 0

		trigger nazi_d1 mg_guy_dead
	}
}
