//The key is bot placement and attributes.

player
{
	spawn
	{


		objectivesneeded 1

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1000 					//% time
		mu_queue sound/music/m_mission

		#if g_level_was_selected >= 1
		applyloadout road
		#endif
		cvar g_level_was_selected 0
		

	//About the Ammo & Guns left from city for realistic testing.. 
/*
	
*/

		cvar cg_particleDist 2048		//Smoke distance set to higher

		trigger player cam_1


	}

	trigger cam_1
	{
		startcam road_1
	}

	trigger fire
	{
		trigger nazi_mg_d fire_truck
		
		wait 300
		trigger player play_alarm
		wait 200

		trigger nazi_d1 fire_truck

		wait 250

		trigger nazi_d2 fire_truck
		wait 100
		trigger nazi_d3 fire_truck
		trigger nazi_d4 fire_truck
		wait 250
		trigger nazi_d5 fire_truck
		wait 1000
		trigger nazi_d6 fire_truck
	}

	trigger truck_finished
	{
		trigger player play_attack1

		wait 250

		alertentity nazi_r1
		alertentity nazi_r2
		alertentity nazi_r3
		alertentity nazi_r4
		alertentity nazi_r5

		trigger nazi_d1 wait
		trigger nazi_d2 wait
		trigger nazi_d3 wait
		trigger nazi_d4 wait
		trigger nazi_d5 wait
		trigger nazi_d6 wait

		wait 100
		trigger nazi_r3 go
		wait 100
		trigger nazi_r2 go
		//wait 250
		//trigger nazi_r1 go

		//The trigger bugs the mg mounting, kinda workaround
		wait 500
		alertentity uphill_trigger
	}

	trigger up_the_hill
	{
		trigger nazi_mg_d releasegun
		trigger nazi_d1 releasegun
		alertentity nazi_d_in

		wait 1000

		trigger nazi_d2 reset
		trigger nazi_d3 reset

		wait 1000

		alertentity nazi_d_out

		trigger nazi_d4 reset

		wait 500

		trigger nazi_d5 reset
		trigger nazi_d6 reset

		wait 1000

		trigger nazi_d_out go_out

	}

	trigger tools_taken
	{
		alertentity truck_trigger
		trigger player play_mission
	}

	trigger truck_fixed
	{
		//alertentity fade_screen_r
		trigger truck_sound fix

		startcam road_fade

		wait 100

		trigger truck_sound fixed

		wait 5000

		trigger truck_sound start_and_idle

		objectivemet 1

		alertentity end_trigger
	}

	trigger truck_fix_sound
	{
		//wait 500
		alertentity truck_fix_sound
	}

	//MUSIC


	trigger play_mission
	{
		mu_fade 0 2500
		mu_queue sound/music/m_mission
	}

	trigger play_attack1
	{
		mu_fade 0 1000
		mu_queue sound/music/m_moving
	}

	trigger play_attack2
	{
		mu_fade 0 1500
		mu_queue sound/music/m_situation
	}

	trigger play_relaxed
	{
		mu_fade 0 2500
		mu_queue sound/music/m_stealth
	}

	trigger play_alarm
	{
		mu_fade 0 500
		mu_queue sound/music/m_action
	}

	trigger endmap
	{
		achievement_capuzzo
		changelevel
		wait 9000
		endgame
	}
}

