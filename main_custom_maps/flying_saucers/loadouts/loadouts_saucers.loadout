loadout fstmis
{
		setarmor 100
		giveinventory key_binocs

		giveweapon weapon_knife
		giveweapon weapon_tt33
		giveweapon weapon_tt33

		setammo ammo_ttammo full

		setclip weapon_tt33 full
		setclip weapon_dualtt33 full

		selectweapon weapon_tt33
}

loadout secmis
{
		setarmor 100
		giveinventory key_binocs

		giveweapon weapon_knife
		giveweapon weapon_tt33
		giveweapon weapon_tt33
		giveweapon weapon_silencer
		giveweapon weapon_ppsh

		setammo ammo_ttammo full
		setammo ammo_9mm 120
		setammo ammo_grenades_american 2

		setclip weapon_tt33 full
		setclip weapon_dualtt33 full
		setclip weapon_silencer full
		setclip weapon_ppsh full

		#if g_dlc1 == 1
		giveweapon weapon_auto5
		setammo ammo_m97ammo 40
		setclip weapon_auto5 full
		#endif

		selectweapon weapon_ppsh
}

