//
//AI Scripting
//Map: darkles
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 bitreset 0 //camera1
		accum 0 bitreset 1
		accum 0 bitreset 2 //camera2

//		accum 1 set 0 //dwa ishoda: 0 - net zasadi, 1 - zasada esty

		objectivesneeded 1

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
		trigger player zaks
		notarget on
	}

	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/m_tension.wav

		applyloadout darkles
		cvar g_level_was_selected 0

		trigger counter1 camerago
		trigger player cine1_cam0
	}

	trigger cine1_cam0
	{
		startcam dles_1
	}

	trigger cine1_cam1
	{
		startcam dles_2
	}

	trigger cine1_cam2
	{
		startcam dles_3
	}

	trigger cine1_cam3
	{
		startcam dles_4
	}

	trigger cine2_cam1
	{
		startcam dles_5
	}

	trigger camerainterrupt //like as toggle
	{
		stopcam

		trigger counter1 cine2_cleanup
		wait 5
		accum 0 abort_if_bitset 0
		trigger counter1 cine1_cleanup
		accum 0 bitset 0
	}

	trigger vorotaopen
	{
		accum 1 abort_if_not_equal 0

		trigger counter1 dobro
		wait 900
		trigger player cine2_cam1
		trigger transport3 go1
		wait 11000
		trigger counter1 cine2_cleanup

	}

	trigger shlag_up
	{
		trigger shlagbaum open
	}

	trigger notarget_off
	{
		notarget off
	}

	trigger action2
	{
		trigger transport go1
	}

	trigger action3
	{
		alertentity nem5
		alertentity nem6
		alertentity nem7
		alertentity nem8
		alertentity nem9
		alertentity nem10
		alertentity nem11
		alertentity nem12

		savecheckpoint
	}

	trigger action4
	{
		alertentity nem13
		alertentity nem14
		alertentity nem15
	}

	trigger action5
	{
		alertentity nem16
		alertentity nem17
		alertentity nem18

		alertentity nem22
		alertentity nem23
		alertentity nem24
	}

	trigger action6
	{
		alertentity nem19
		alertentity nem20
		alertentity nem21
		alertentity pulemetchik1

		alertentity nem25
		alertentity nem26
		alertentity nem27

		alertentity sniper1
		alertentity sniper2

		savecheckpoint
	}

	trigger action7
	{
		alertentity nem28
		alertentity nem29
		alertentity pulemetchik2
	}

	trigger action8
	{
		alertentity nem30

		alertentity nem31
		alertentity nem32

		accum 1 random 2
		trigger player subaction8
		wait 5
	}

	trigger subaction8
	{
		accum 1 abort_if_not_equal 1

		alertentity deltran3

		trigger transport4 go2

//		alertentity t604 // vorota open

		alertentity nem40_b
		alertentity nem41_b
		alertentity nem42_b
		alertentity nem43_b
		alertentity nem44_b
	}

	trigger action9
	{
		alertentity nem33
		alertentity nem34
		alertentity nem35
		alertentity nem36
		alertentity nem37
		alertentity nem38
		alertentity nem39
		alertentity pulemetchik3
		trigger nem31 talk

		savecheckpoint
	}

	trigger action10
	{
		objectivemet 1
	}

	trigger opentr
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1

		alertentity opentr
		alertentity opentel
	}

	trigger opentel
	{
		alertentity opentr
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger secret3
	{
		foundsecret
	}

	trigger secret4
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel les persistent
	}
}

rus1
{
	attributes
	{
		starting_health 70
		aim_accuracy 0.9
		tactical 1.0
		aggression 1.0
		inner_detection_radius 1600
		alertness 16000
		running_speed 320
		fov 360
		hearing_scale 8.0
	}

	spawn
	{
		accum 0 bitreset 0
		accum 1 set 0
		accum 2 set 0
		accum 3 set 0

		giveweapon weapon_ppsh
		setammo ammo_ttammo 999
		setclip weapon_ppsh 71
		selectweapon weapon_ppsh

//		statetype alert
		trigger rus1 go1	
	}

	trigger go1
	{
		wait 600
		runtomarker r1_p1 nostop
		runtomarker r1_p2 nostop
		runtomarker r1_p3 nostop
		runtomarker r1_p4 nostop
		runtomarker r1_p5
		runtomarker r1_p6

		trigger haunebu2 go1
	}

	trigger shootufo
	{
		fireattarget shootufo1 200
		wait 5
		fireattarget shootufo2 200
		wait 5
		fireattarget shootufo3 200
		wait 5
		fireattarget shootufo4 200
		wait 5
		fireattarget shootufo5 200

		runtomarker r1_p7
	}

	enemysight
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
	}	

	death
	{
		trigger transport trredlt
		accum 0 abort_if_not_bitset 20
	}
}

