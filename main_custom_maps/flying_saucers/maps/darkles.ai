pulemetchik1
{
	attributes
	{
		starting_health 70
		fov 300
		AGGRESSION 1.0
		alertness 20000
		aim_accuracy 0.5
		camper 1.0
		tactical 0.8
		attack_skill 0.5
		yaw_speed 300
	}

	spawn
	{
		accum 0 set 0
		accum 1 set 0 // smerty
		accum 2 bitreset 0
		mount mg42_1

		setammo ammo_grenades 0
	}

	trigger stopmg42
	{
		accum 0 abort_if_not_equal 0
		unmount
		accum 0 bitset 1
	}

	trigger shoot_tr
	{
		fireattarget shoot_tr1 200
		wait 50
		fireattarget shoot_tr2 200
		wait 50
		fireattarget shoot_tr3 200
		wait 50
		fireattarget shoot_tr4 200
		wait 50
		fireattarget shoot_tr5 200
		wait 50
		fireattarget shoot_tr6 200
	}

	pain 25
	{
		trigger pulemetchik1 stopmg42
	}

	bulletimpact
	{
		trigger pulemetchik1 atack
	}

	inspectsoundstart
	{
		trigger pulemetchik1 atack
	}

	inspectsoundend
	{
		trigger pulemetchik1 atack
	}

	inspectbodystart
	{
		trigger pulemetchik1 atack
	}

	inspectbodyend
	{
		trigger pulemetchik1 atack
	}

	death
	{
		accum 1 abort_if_not_bitset 20
	}

	trigger atack
	{
		accum 2 abort_if_bitset 0
//		resetscript
		attack player
		accum 2 bitset 0
	}

	enemysight
	{
		accum 1 bitset 20
//		resetscript
		trigger pulemetchik1 atack
	}
}

