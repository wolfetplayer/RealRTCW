nem31
{
	attributes
	{
		attack_crouch 0.0
		fov 120
		alertness 1024
	}

	spawn
	{
		accum 0 bitreset 0

		setammo ammo_grenades 0
		takeweapon weapon_mp40
		giveweapon weapon_mp40
		selectweapon weapon_mp40
	}

	trigger talk
	{
		accum 0 abort_if_bitset 0
		wait 3000
		trigger nem31 training
		wait 2000
		trigger nem31 better
		wait 1600
		trigger nem32 yaya
	}

	trigger training
	{
		accum 0 abort_if_bitset 0
		playsound ForestNazi11_2
	}

	trigger better
	{
		accum 0 abort_if_bitset 0
		playsound ForestNazi15_4
	}

	statechange relaxed combat
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		trigger nem31 alarm
	}

	statechange query combat
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		trigger nem31 alarm
	}

	statechange alert combat
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		trigger nem31 alarm
	}

	inspectfriendlycombatstart
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		trigger nem31 alarm
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		trigger nem31 alarm
	}

	trigger alarm
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0

		clearanim
		playsound Blank
		attrib alertness 4150
		statetype alert
		resetscript
		wait 200 0 player
		wait forever 0
	}

	death
	{
		playsound Blank
	}
}

