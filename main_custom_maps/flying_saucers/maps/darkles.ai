		resetscript
		wait 200 0 player
		wait forever 0
	}

	death
	{
		playsound Blank
	}
}

nem33
{
	attributes
	{
		attack_crouch 0.0
		alertness 2048
		inner_detection_radius 6400

	}

	spawn
	{
		accum 0 bitset 0 // 1 = sighted player

		setammo ammo_grenades 0
		takeweapon weapon_mp40
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
		trigger nem33 look
	}

	trigger look
	{
		accum 0 abort_if_not_bitset 0

		resetscript
		wait 500
		zoom on
		attrib alertness 3400
		playanim binocular both
		playanim binocular both
		playanim binocular both
		playanim binocular both
		attrib alertness 3048
		zoom off
		wait 3500
		trigger nem33 look
	}

	statechange relaxed combat
	{
		trigger nem33 alarm
	}

	statechange query combat
	{
		trigger nem33 alarm
	}

	statechange alert combat
	{
		trigger nem33 alarm
	}

	inspectfriendlycombatstart
	{
		trigger nem33 alarm
	}

	inspectbodystart
	{
		trigger nem33 alarm
	}

	trigger alarm
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0

		clearanim
		zoom off
		attrib alertness 4150
		statetype alert
		resetscript
		wait 200 0 player
		wait forever 0
	}

	death
	{
		alertentity tower1death1
	}
}

