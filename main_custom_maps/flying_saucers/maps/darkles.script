haunebu2
{
	spawn
	{
	}

	trigger go1
	{
		playsound sound/world/dam_turbine.wav looping
		wait 5

		faceangles -10 150 10 gototime
		gotomarker ha2_p1 300

		faceangles -20 180 10 gototime
		gotomarker ha2_p2 350

		faceangles -25 200 10 gototime
		gotomarker ha2_p3 400

		trigger rus1 shootufo

		faceangles -30 220 15 gototime
		gotomarker ha2_p4 350

		faceangles -35 240 15 gototime
		gotomarker ha2_p5 400

		faceangles -30 250 20 gototime
		gotomarker ha2_p6 350

		faceangles -30 270 15 gototime
		gotomarker ha2_p7 400

		faceangles -30 285 15 gototime
		gotomarker ha2_p8 350

		faceangles -25 300 25 gototime
		gotomarker ha2_p9 400

		faceangles -15 320 15 gototime
		gotomarker ha2_p10 350

		faceangles -10 340 10 gototime
		gotomarker ha2_p11 400

		faceangles 0 360 0 gototime
		gotomarker ha2_p12 400
//		faceangles 0 460 0 gototime

		faceangles -10 280 0 gototime
		gotomarker ha2_p13 700
//		faceangles 0 460 0 gototime

		playsound sound/scenaric/general/blank.wav looping

		alertentity killufo
	}
}

counter1
{
	spawn
	{
		accum 0 bitset 0
		accum 0 bitset 1
	}

	trigger camerago
	{
		wait 12000
		trigger player cine1_cam1
		wait 12000
		trigger player cine1_cam2

		trigger haunebu2 go1 

		wait 12000
		trigger player cine1_cam3
		alertentity rus1b
		alertentity rus2b
		alertentity rus3b
		alertentity nem1
		alertentity nem2

		wait 12000

		trigger counter1 cine1_cleanup
	}

	trigger cine1_cleanup
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0

		resetscript

		alertentity perskill
		alertentity perskill2
		alertentity killufo

		trigger transport go1
		trigger player notarget_off
	}

	trigger dobro
	{
		accum 0 bitreset 1
	}

	trigger cine2_cleanup
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1

		resetscript

		trigger player camerainterrupt2
		trigger transport4 go1
		alertentity deltran3 //unichtozhaet transport3

		alertentity nem40_a
		alertentity nem41_a
		alertentity nem42_a
		alertentity nem43_a
		alertentity nem44_a
	}

	trigger killorno
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
	}
}

transport
{
	spawn
	{
		accum 0 set 0
	
		wait 5
		faceangles 0 180 0 5
	}

	trigger trredlt
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 2
		alertentity deltel
	}

	trigger go1
	{
		accum 0 abort_if_equal 2

		alertentity perskill2
		alertentity perskill3

		wait 1500

		alertentity nem3
		alertentity nem4
		alertentity nem5
		alertentity nem6

		alertentity tryaska1

		trigger per_kol begin
		trigger zad_kol begin

		gotomarker t1_1 200
		faceangles 0 180 0 gototime

		gotomarker t1_2 200
		faceangles 0 210 0 gototime

		faceangles 1 225 0 gototime
