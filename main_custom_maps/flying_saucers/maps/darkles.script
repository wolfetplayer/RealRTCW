per_kol
{
	spawn
	{
		accum 0 set 0

		wait 5
		attachtotag transport tag_wfront
		faceangles 0 0 0 50
	}

	trigger begin
	{
		trigger zad_kol begin2
		playsound sound/world/shift_01.wav looping
	}

	trigger begin2
	{
		accum 0 abort_if_not_equal 0
		faceangles 90 0 0 200
		faceangles 180 0 0 200
		faceangles 270 0 0 200
		faceangles 0 0 0 200
		trigger per_kol begin2
	}

	trigger stop
	{
		accum 0 set 1
		wait 1000
		playsound sound/world/idle_01.wav looping
	}
}

