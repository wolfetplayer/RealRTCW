		faceangles 0 330 0 gototime
		gotomarker t1_8 300

		faceangles 0 360 0 gototime
		gotomarker t1_9 300

		gotomarker t1_10 290
		faceangles 0 360 0 gototime

		faceangles 0 360 0 gototime
               	gotomarker t1_11 300
		faceangles 0 360 0 gototime

		gotomarker t1_12 300
		faceangles 0 370 0 gototime

		gotomarker t1_13 300
		faceangles 0 375 0 gototime

		faceangles 0 370 0 gototime
		gotomarker t1_14 300
		faceangles 0 370 0 gototime

		faceangles 0 360 0 gototime
		gotomarker t1_15 300
		faceangles 0 360 0 gototime

		gotomarker t1_16 300
		faceangles 0 360 0 gototime

