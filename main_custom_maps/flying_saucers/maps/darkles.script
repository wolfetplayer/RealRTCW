shlagbaum
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		faceangles 0 0 -60 1
		wait 750
		faceangles 0 0 0 1 
		wait 750
		accum 0 set 0
	}
}


transport3
{
	spawn
	{
		accum 0 set 0
	
		wait 5
		faceangles 0 90 0 5
		gotomarker tr3_p1 99999
	}

	trigger go1
	{
		accum 0 abort_if_equal 2

		trigger per_kol3 begin
		trigger zad_kol3 begin

		gotomarker tr3_p1 800
		faceangles 0 90 0 gototime

		gotomarker tr3_p2 800
		faceangles 0 80 0 gototime

		faceangles 1 50 0 gototime
		gotomarker tr3_p3 700

		faceangles 1 45 0 gototime
		gotomarker tr3_p4 700

		faceangles 0 45 0 gototime
		gotomarker tr3_p5 600

		faceangles 0 45 0 gototime
		gotomarker tr3_p6 500
		faceangles 0 50 0 gototime

		faceangles 0 60 0 gototime
		gotomarker tr3_p7 400

		faceangles 0 90 0 gototime
		gotomarker tr3_p8 300

		faceangles 0 90 0 gototime
		gotomarker tr3_p9 300

		gotomarker tr3_p10 300
		faceangles 0 105 0 gototime
		trigger transport3 sound

		faceangles 0 110 0 gototime
               	gotomarker tr3_p11 150
		faceangles 0 110 0 gototime

		gotomarker tr3_p12 200
		faceangles 0 115 0 gototime

		trigger zad_kol3 stop
		trigger per_kol3 stop
	}

	trigger sound
	{
		playsound sound/world/truck_brakesqueal.wav
	}
}

