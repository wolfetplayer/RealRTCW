//
//AI Scripting
//Map: dep_castle
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 set 0 //smerti 1
		accum 1 bitreset 0
		accum 2 set 0 //smerti 2
		objectivesneeded 3

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
		trigger player zaks
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout dep_castle
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1500
		mu_queue sound/music/m_tension.wav
		trigger gear go0

	}

	trigger action1
	{
		trigger gear go0

		alertentity nem4
		alertentity nem5
		alertentity nem6
	}

	trigger action2
	{
		alertentity nem8
		alertentity nem13
		alertentity nem14
		alertentity nem15

		savecheckpoint
	}

	trigger action3
	{
		alertentity nem7
		alertentity nem9
		alertentity nem10
		alertentity nem11
	}

	trigger action4
	{
		trigger nem10 go1
		trigger nem11 go1
		alertentity nem12

	}

	trigger action5
	{
		alertentity officer1
	}

	trigger action6
	{
		alertentity nem16
		alertentity nem17

		alertentity nem18
		alertentity nem19
		alertentity nem20

		alertentity nem21

		savecheckpoint
	}

	trigger action7
	{
		alertentity nem22
		alertentity nem23
	}

	trigger action8
	{
		alertentity parashutist1
		alertentity parashutist2
		alertentity parashutist3
		alertentity parashutist4
		alertentity parashutist5

		savecheckpoint
	}

	trigger action9
	{
		alertentity parashutist7
	}

	trigger action10
	{
		trigger nem28 go1
		trigger nem29 go1
		trigger nem30 go1
	}

	trigger action11
	{
		alertentity nem24
		alertentity nem25
		alertentity officer2

		savecheckpoint
	}

	trigger action12
	{
		alertentity nem26
		alertentity nem27
	}

	trigger action13
	{
		alertentity vpusti_radosty
		alertentity nem31 //mehanik
		alertentity parashutist6
	}

	trigger action14
	{
		alertentity nem32
		alertentity nem33
		alertentity nem34
	}

	trigger action15
	{
		alertentity nem35
		alertentity nem36
		alertentity nem37
		alertentity radist

		alertentity nem38
		alertentity nem39
		alertentity nem40
		alertentity nem41
		alertentity nem42
		alertentity nem43
		alertentity nem44

		savecheckpoint
	}

	trigger wake_radio
	{
		accum 1 abort_if_bitset 0
		missionfailed 6 10
	}

	trigger radioposil
	{
		accum 1 abort_if_bitset 0
		alertentity zvukradio
		trigger gear opengear //zapros otkrity devery

		wait 800

		accum 1 bitset 0
		objectivemet 2
		wait 2000
		alertentity zvukradio
	}

	trigger stop_idiotism
	{
		alertentity nem28
		alertentity nem29
		alertentity nem30

		trigger parashutist4 go2
		trigger parashutist5 go2
	}

	trigger activate_gear
	{
		trigger kletka open
		wait 1000
		trigger player taxi
	}

	trigger taxi
	{
		trigger transport goto1
		trigger player cine1_cam0
		wait 2000
		trigger player cine1_cam1
		wait 500
		trigger player cine1_cam2
		wait 500
		trigger player cine1_cam3
		wait 8200
		alertentity par1
		alertentity startend
	}

	trigger talk
	{
		trigger par1 goto
	}

	trigger check_deaths1
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 2

		trigger gear opengear //zapros otkrity devery
		objectivemet 1
	}

	trigger check_deaths2
	{
		accum 2 inc 1
		accum 2 abort_if_not_equal 2
		alertentity dobroradio
	}

	trigger lockplayer
	{
		lockplayer on
	}

	trigger stenago
	{
		trigger fakel toggle
	}

	trigger music_change1
	{
		mu_fade 0 2000
		mu_queue sound/music/m_moving.wav
	}

	trigger alarmon
	{
		alertentity trevoga
	}

	trigger cine1_cam0
	{
		startcam dep_cas_1
	}

	trigger cine1_cam1
	{
		startcam dep_cas_2
	}

	trigger cine1_cam2
	{
		startcam dep_cas_3
	}

	trigger cine1_cam3
	{
		objectivemet 3
		startcam dep_cas_4
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger endmap
	{
		alertentity kill_par1
		trigger player lockplayer
		trigger transport goto2
	}

	trigger theend
	{
		changelevel darkles
	}
}

nem1				
{
	attributes
	{
	}

	spawn
	{
		accum 0 bitreset 0
//		accum 1 set 0
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
		giveweapon weapon_mp40
		setammo ammo_9mm 1000
		selectweapon weapon_mp40
	}

	enemysight
	{
		accum 0 bitset 0
		playsound MiscKillHim
		alertentity nem3
		clearanim
		trigger nem1 choose_tactic
	}
	
	trigger choose_tactic
	{
		accum 1 random 3
		wait 5
		trigger nem1 tactic1
		wait 5
		trigger nem1 tactic2
		wait 5
		trigger nem1 tactic3
	}

	trigger tactic1			// total camper
	{
		accum 1 abort_if_not_equal 0
		resetscript
		attrib camper 1.0
		attrib aggression 0.1
		wait 3000 player
	}

	trigger tactic2			// Super aggressive
	{
		accum 1 abort_if_not_equal 1
		resetscript
		attrib camper 0.1
		attrib aggression 1.0
	}

	trigger tactic3			// medium
	{
		accum 1 abort_if_not_equal 2
		resetscript
		attrib camper 0.6
		attrib aggression 0.7
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}	

	death
	{
		accum 0 abort_if_not_bitset 0
	}
}

