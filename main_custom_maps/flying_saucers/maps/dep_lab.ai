//
//AI Scripting
//Map: dep_lab
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 bitreset 0 //reshotka
		accum 0 bitset 1 //
		accum 1 set 0 //schetchik smertey
//		accum 2 bitreset 0
		accum 2 bitreset 1
		accum 2 bitreset 2

		objectivesneeded 1
		abort_if_loadgame
		selectweapon weapon_mp44
		setclip weapon_mp44 30
		mu_start sound/music/l_briefing_1.wav 1000
	}


	playerstart 
	{
		#if g_level_was_selected >= 1
		applyloadout dep_lab
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 2000
		mu_queue sound/music/x_tension.wav

		trigger counter1 cinematic1
		trigger player cine1_cam0
		selectweapon weapon_mp44
		setclip weapon_mp44 30
	}

	trigger cine1_cam0
	{
		startcamblack dep_lab_1

		trigger trainglav go1
		trigger trainzad go1
		trigger train1 go1
		trigger train2 go1
		trigger train3 go1
		trigger train4 go1
	}

	trigger cine1_cam1
	{
		startcam dep_lab_2
	}

	trigger cine1_cam2
	{
		trigger rus1 begom1
		startcam dep_lab_3
	}

	trigger camerainterrupt
	{
		stopcam
		accum 1 set 1
		trigger counter1 cine1_cleanup
	}

	trigger music_change1
	{
		mu_fade 0 2000
		mu_queue sound/music/x_tension.wav
	}

	trigger music_change2
	{
		mu_fade 0 2000
		mu_queue sound/music/x_action.wav
	}

	trigger music_change3
	{
		mu_fade 0 2000
		mu_queue sound/music/x_military.wav
	}

	trigger music_change4
	{
		mu_fade 0 2000
		mu_queue sound/music/x_atmos.wav
	}

	trigger action1
	{
		trigger podyomnik toggle
		alertentity kickrus
	}

	trigger action2
	{
		alertentity nem5
		alertentity nem6
		alertentity medic
		alertentity scientist1
		alertentity scientist2
	}

	trigger action3
	{
		alertentity nem7
		alertentity nem8
		alertentity nem9

		savecheckpoint
	}

	trigger action4
	{
		alertentity nem14
		alertentity nem15
		alertentity nem16

		alertentity scientist5
		alertentity scientist6
		alertentity scientist7
	}

	trigger action5
	{
		alertentity nem17
		alertentity nem18
		alertentity nem19
		alertentity nem20

		savecheckpoint
	}

	trigger docshere
	{
		objectivemet 1
	}

	trigger action6
	{
		alertentity nem21
		alertentity nem22
		alertentity nem23
	}

	trigger action7
	{
		alertentity loper2
		alertentity loper3
	}

	trigger action8
	{
		wait 3000
		alertentity loper4
		trigger mehanik2 go

		savecheckpoint
	}

	trigger cvet_per
	{
		trigger player cvet_per2

		accum 2 abort_if_not_bitset 1

		accum 2 abort_if_bitset 2 //proverka edinolichiya
		accum 2 bitset 2

		wait 500
		alertentity cvet_zel
		wait 1500
		alertentity cvet_zel
		alertentity cvet_open
		trigger counter1 ss3

		accum 2 bitreset 2
	}

	trigger cvet_per2
	{
		accum 2 abort_if_bitset 1

		accum 2 abort_if_bitset 2 //proverka edinolichiya
		accum 2 bitset 2

		wait 500
		alertentity cvet_kras
		wait 1500
		alertentity cvet_kras

		accum 2 bitreset 2
	}

	trigger cvet_kluch
	{
		accum 2 abort_if_bitset 1
		accum 2 bitset 1
		alertentity delkluch
	}

	trigger podem
	{
		trigger podyomnik toggle
	}

	trigger openresh
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		trigger reshotka go
		wait 300
		alertentity openreshotka
	}

	trigger lampago
	{
		trigger lampa go
		trigger counter1 friend_or_enemy
	}

	trigger battle1
	{
		trigger platforma go
		alertentity ss2
		trigger player music_change2
	}

	trigger toggle_down
	{
		trigger knopka1 on
	}

	trigger toggle_up
	{
		trigger knopka2 on
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel karyer persistent
	}
}

rus1
{
	attributes
	{
		starting_health 75
		aim_accuracy 1.0
		tactical 1.0
		aggression 1.0
		inner_detection_radius 6400
		alertness 2300	
	}

	spawn
	{
		takeweapon weapon_mp44
		giveweapon weapon_mp44
		setammo ammo_44ammo 999
		selectweapon weapon_mp44
		godmode on
		statetype alert
	}

	trigger begom1
	{
		wait 200
		runtomarker r1_p1
		runtomarker r1_p2
//		trigger player kick
	}

	enemysight
	{
//		clearanim
	}

	inspectsoundstart
	{
//		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
//		clearanim
	}

	inspectbodyend
	{
	}	

	death
	{
	}
}

nem1
{
	attributes
	{
		fov 110
		inner_detection_radius 6400
	}

	spawn
	{
		accum 0 set 0 // 1 = alerted
		wait 100

		takeweapon weapon_mp44
		giveweapon weapon_mp44
		setammo ammo_44ammo 999
		selectweapon weapon_mp44

		trigger nem1 goto
	}

	trigger goto
	{
		walktomarker n1_p1
		wait 200
		statetype alert
		runtomarker n1_p2
	}

	trigger alarm
	{
		accum 0 abort_if_not_equal 0
		resetscript
		attack player
		accum 0 set 1
	}

	pain 99
	{
		trigger nem1 alarm
	}

	bulletimpact
	{
		trigger nem1 alarm
	}

	inspectsoundstart
	{
		trigger nem1 alarm
	}

	inspectsoundend
	{
		trigger nem1 alarm
	}

	inspectbodystart
	{
		trigger nem1 alarm
	}

	inspectbodyend
	{
		trigger nem1 alarm
	}

	attacksound
	{
		trigger nem1 alarm
	}

	inspectfriendlycombatstart
	{
		trigger nem1 alarm
	}
}

