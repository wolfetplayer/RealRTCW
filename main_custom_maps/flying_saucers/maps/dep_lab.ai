medic
{
	attributes
	{
		hearing_scale 0.0
	}

	spawn
	{
		accum 1 set 0

		accum 0 bitreset 0
		accum 0 bitreset 1

		wait forever 0 player
	}

	trigger fear0
	{
		accum 1 random 4
		wait 5
		trigger medic fear1
		wait 5
		trigger medic fear2
		playanim don't_kill_me both forever player
		wait 500
	}

	trigger fear1
	{
		accum 1 abort_if_not_equal 0

		playsound rocket_sci_misc_fear2
		wait 500
		playanim don't_kill_me both forever player
	}

	trigger fear2
	{
		accum 1 abort_if_not_equal 1

		playsound rocket_sci_fear3
		wait 500
		playanim don't_kill_me both forever player
	}

	trigger wait_loop
	{
		playanim don't_kill_me both forever player
		trigger medic wait_loop
	}

	activate player
	{
		denyactivate
	}

	trigger scaredloop
	{
		nosight 99999
		playanim don't_kill_me both forever player
		trigger medic scaredloop
	}

	bulletimpactsound
	{
		trigger medic fear0
	}

	inspectsoundstart
	{
		deny
	}

	bulletimpact
	{
		trigger medic fear0
	}

	inspectbodystart
	{
		deny
	}

	death
	{
		trigger counter1 he_is_enemy
		playsound blank

		playsound sound/player/infantryss/death/death_forward.wav
		wait 2000
		resetscript
	}

	statechange relaxed combat
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1

		playsound rocket_sci0_dont_shoot
		playanim don't_kill_me both
		trigger medic wait_loop
	}
}


