counter1
{
	spawn
	{
		accum 0 bitreset 0
		accum 0 bitreset 1 //ss1
		accum 0 bitreset 2 //ss2
		accum 0 bitreset 3 //ss3
		accum 0 bitreset 4 //enemy or friend?
	}

	trigger cinematic1
	{
		wait 7400
		trigger player cine1_cam1
		wait 7000
		trigger player cine1_cam2
		alertentity rus1
	}

	trigger cine1_cleanup
	{
		resetscript

		trigger trainglav go2
		trigger trainzad go2
		trigger train1 go2
		trigger train2 go2
		trigger train3 go2
		trigger train4 go2

	}

	trigger cinematic2
	{
		trigger player endcamera1
		wait 1000
		trigger player endcamera2
		wait 2500
		trigger player exitmap
	}

	trigger reshotkago
	{
		wait 1000
		alertentity openreshotka
	}

	trigger ss1
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1

		trigger player music_change4
		alertentity openeldoor1
		alertentity nem3
		alertentity nem4
	}

	trigger ss2
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2

		trigger player music_change4
		alertentity openeldoor2

		alertentity nem10
		alertentity nem11
		alertentity nem12

		alertentity mehanik1
		alertentity mehanik2

		alertentity officer1
		alertentity scientist3
	}

	trigger ss3
	{
		accum 0 abort_if_bitset 3
		accum 0 bitset 3

		trigger player music_change2

		alertentity scientist4
		alertentity nem13
		alertentity ss3
	}

	trigger he_is_enemy
	{
		accum 0 bitset 4
	}

	trigger friend_or_enemy
	{
		trigger counter1 enemy
		wait 5
		trigger counter1 friend
	}

	trigger friend
	{
		accum 0 abort_if_bitset 4

		alertentity loper1_a
	}

	trigger enemy
	{
		accum 0 abort_if_not_bitset 4

		alertentity loper1_e
	}

}

trainglav
{
	spawn
	{
		accum 0 set 0 //proverka povrezhdeniya dveri

		gotomarker tr1_p1 99999
		faceangles 0 -90 0 gototime
	}

	trigger go1
	{
		trigger trainglav goloop

		gotomarker tr1_p1 99999
		faceangles 0 -90 0 gototime
		wait 7500

		gotomarker tr1_p2 400
		faceangles 0 -70 0 gototime

		gotomarker tr1_p3 400
		faceangles 0 -20 0 gototime

		gotomarker tr1_p4 400
		faceangles 0 0 0 gototime

		gotomarker tr1_p5 400
		faceangles 0 0 0 gototime

		alertentity demdoor
		accum 0 set 1
	}

	trigger go2
	{
		gotomarker tr1_p5 99999
		faceangles 0 0 0 gototime

		accum 0 abort_if_not_equal 0
		alertentity demdoor2
	}

	trigger goloop
	{
		playsound sound/world/radarcloseambient.wav looping
	}
}
