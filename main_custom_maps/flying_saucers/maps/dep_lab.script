richag1a
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger toggle
	{
		trigger richag1a open
		wait 5
		trigger richag1a close
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound sound/movers/switches/switch.wav
		faceangles 0 0 -180 800
	}

	trigger close
	{
		accum 0 abort_if_not_equal 1
		accum 0 set 0
		playsound sound/movers/switches/switch.wav
		faceangles 0 0 0 800
	}
}

richag1b
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger toggle
	{
		trigger richag1b open
		wait 5
		trigger richag1b close
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound sound/movers/switches/switch.wav
		faceangles 0 0 180 800
	}

	trigger close
	{
		accum 0 abort_if_not_equal 1
		accum 0 set 0
		playsound sound/movers/switches/switch.wav
		faceangles 0 0 0 800
	}
}

podyomnik
{
	spawn
	{
		accum 0 set 1 //  0 = down  1 = up
	}

	trigger toggle
	{
		trigger podyomnik down
		wait 5
		trigger podyomnik up
	}

	trigger up
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 2
		playsound sound/movers/elevators/elev1_start.wav

		trigger knopka on

		gotomarker po_down2 40
		faceangles 0 0 0 gototime

		gotomarker po_up2 80
		faceangles 0 0 0 gototime

		gotomarker po_up 35
		faceangles 0 0 0 gototime

		trigger knopka off
		playsound sound/movers/elevators/elev1_end.wav

		accum 0 set 1
	}

	trigger down
	{
		accum 0 abort_if_not_equal 1
		accum 0 set 2
		playsound sound/movers/elevators/elev1_start.wav

		trigger knopka on

		gotomarker po_up2 40
		faceangles 0 0 0 gototime

		gotomarker po_down2 80
		faceangles 0 0 0 gototime
		gotomarker po_down 35
		faceangles 0 0 0 gototime

		trigger knopka off
		playsound sound/movers/elevators/elev1_end.wav

		accum 0 set 0
	}
}

knopka
{
	spawn
	{
	}

	trigger on
	{
		playsound sound/movers/switches/switch.wav
		gotomarker kn_on 20

	}

	trigger off
	{
		gotomarker kn_off 20
	}
}

reshotka
{
	spawn
	{
	}

	trigger go
	{
		trigger counter1 reshotkago
		gotomarker resh_p1 40
		faceangles 0 0 0 gototime

		playsound sound/movers/doors/door2_close.wav

		gotomarker resh_p2 75
		faceangles 0 60 0 gototime

	}
}

lampa
{
	spawn
	{
	}

	trigger go
	{
		faceangles 130 30 0 900

		faceangles 70 30 0 900 wait

		faceangles 80 20 0 500 gototime

		gotomarker lam_p2 300

		alertentity slomreshka

		faceangles 90 10 0 500 gototime
		gotomarker lam_p2 300


//		playsound sound/movers/doors/door2_close.wav
	}
}

platforma
{
	spawn
	{
	}

	trigger go
	{
		playsound sound/movers/doors/door3_loopo.wav
		gotomarker pl_p1 70 gototime
		wait 5
		resetscript
		playsound sound/movers/doors/door3_endo.wav
		wait 200
		trigger ss2 go
	}
}

lift
{

	spawn
	{
		accum 0 bitreset 0
	}

	trigger toggle
	{
		alertentity closepath

		trigger lift up
		wait 5
		trigger lift down
	}

	trigger soundloop
	{
		playsound sound/movers/elevators/elev1_loop.wav looping
	}

	trigger down
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		wait 5
		playsound sound/movers/elevators/elev1_start.wav
		trigger lift soundloop
		gotomarker lift_p2 50 wait
		gotomarker lift_p1 50 deccel wait
		stopsound
		playsound sound/movers/elevators/elev1_end.wav
		trigger knopka2 off
		trigger knopka1 off
	}

	trigger up
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		wait 5
		playsound sound/movers/elevators/elev1_start.wav
		trigger lift soundloop
		gotomarker lift_p3 50 wait
		gotomarker lift_p4 50 deccel wait
		stopsound
		playsound sound/movers/elevators/elev1_end.wav
		trigger knopka2 off
		trigger knopka1 off
	}
}

knopka1
{
	spawn
	{
		accum 0 bitset 0
		wait 5
		gotomarker kn1_p1 10 wait
	}

	trigger on
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		playsound basein_switch
		gotomarker kn1_p2 10 wait
		trigger lift toggle
	}

	trigger off
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		playsound basein_switch
		gotomarker kn1_p1 10 wait
	}
}

