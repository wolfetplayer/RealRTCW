helga_zombie	// reincarnation of helga
{
	attributes
	{
		pain_threshold_scale 50
		starting_health 1000
		aggression 1.0
		fov 360
	}

	spawn
	{
		accum 0 set 0 // 1 = helga has broken gate
		accum 1 set 0 // 1 = fired fakedeath
		accum 2 set 0 // 1 = gate blown
		statetype alert
		nosight 999999
		godmode on
		trigger helga_zombie goto
	}

	trigger goto
	{
		runtomarker hz_p1 nostop
		runtomarker hz_p2 nostop
		gotomarker hz_p3
		gotomarker hz_p4
		facetargetangles hz_p4
		playsound sound/beast/skull_shriek2.wav
		knockback off
		playanim attack1 both
		gotomarker hz_p5
		gotomarker hz_p6
		trigger stena1 go
		godmode off

		trigger counter1 pugalo

		playanim death_1 both
		sethealth 0
	}

	trigger vsay
	{
		playsound sound/beast/beast_death1.wav
	}

	enemysight
	{
		nosight 999999
	}

	death
	{

	}
}
