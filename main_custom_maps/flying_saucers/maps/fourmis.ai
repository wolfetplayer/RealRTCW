//
//AI Scripting
//Map: fourmis
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 set 0
		accum 1 set 0
		accum 2 set 0
		accum 3 bitreset 0
		objectivesneeded 1

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
//		trigger player zaks
		trigger counter1 cinematic1

		mu_fade 0 1500
		mu_queue sound/music/c_military.wav
	}

	trigger cine1_cam0
	{
		startcamblack fourmis_1
	}

	trigger cine1_cam1
	{
		startcam fourmis_2
	}

	trigger camerainterrupt
	{
		stopcam
		trigger counter1 cine1_cleanup
	}

	trigger action1
	{
		alertentity warzombie1
	}

	trigger zom2action
	{
		accum 3 abort_if_bitset 0
		accum 3 bitset 0
		mu_play sound/music/s_longout
		mu_fade 0 8000
		alertentity zom2actiongo
		wait 500
		alertentity zombie2_a
		wait 400
		alertentity zombie2_b
		wait 500
		alertentity warzombie2_b
		wait 300
		alertentity warzombie2_a

		savecheckpoint
	}

	trigger pugalka
	{
		alertentity pugalka_go
		alertentity helga_zombie
//		lockplayer on
	}

	trigger pugalkaoff
	{
		alertentity kill_helga
//		lockplayer off
	}

	trigger action2
	{
		alertentity zombie3_a
		alertentity zombie3_b
	}

	trigger action3
	{
		alertentity warzombie3_a
		alertentity warzombie3_b

		savecheckpoint
	}

	trigger elite1action
	{
		alertentity elite2
		alertentity elite3
		alertentity elite4
		alertentity elite5

		trigger elite4 goto
		trigger elite5 goto
	}

	trigger action5
	{
		alertentity zombie5_a
		alertentity zombie5_b
		alertentity warzombie5_a
		alertentity warzombie5_b
		alertentity nem4
		alertentity nem5
		alertentity nem6
		alertentity elite1

		savecheckpoint
	}

	trigger zom6action
	{
		mu_play sound/music/s_longout.wav
		mu_fade 0 8000
		alertentity zom6actiongo
		wait 100
		alertentity zombie6_a
		wait 100
		alertentity zombie6_b
	}

	trigger zom7action
	{
		trigger noshka go

		alertentity zom7actiongo
		mu_play sound/music/s_bighits.wav
		mu_fade 0 8000

		wait 1300
		alertentity zombie7_a
		alertentity zom7actiongo_a

		wait 300
		alertentity zombie7_c
		alertentity zom7actiongo_c

		wait 300
		alertentity zombie7_b
		alertentity zom7actiongo_b

		wait 300
		alertentity zombie7_d
		alertentity zom7actiongo_d

		savecheckpoint
	}

	trigger action8
	{
		alertentity warzombie8_a
		alertentity warzombie8_b
		alertentity nem7
	}

	trigger action9
	{
		alertentity zom9actiongo
		alertentity warzombie9

		trigger duh1 go
	}

	trigger action10
	{
		alertentity zombie10_a
		alertentity zombie10_b
	}

	trigger action11
	{
		alertentity zombie11
	}

	trigger action12
	{
		alertentity closepanel

		alertentity zombie12_a
		wait 200
		alertentity zombie12_b

		wait 3000
		alertentity zomwar_getup10
		alertentity warzombie10_a
		alertentity warzombie10_b

		savecheckpoint
	}

	trigger action13
	{
		alertentity warzombie11_a
		alertentity warzombie11_b

		alertentity zombie13_a
		alertentity zombie13_b

		trigger counter2 toggle_pesochek

		wait 2000
		trigger pinok go
	}

	trigger action14
	{
		alertentity zombie14
		alertentity vilaziy
		alertentity closeresh

		savecheckpoint
	}

	trigger padenie
	{
		trigger verevka1 go
		trigger verevka2 go
		trigger stupeni1 go
		trigger stupeni2 go
	}

	trigger stenknop
	{
		trigger counter1 check_deaths3
	}

	trigger cine1_cam0
	{
		startcamblack fourmis_1
	}

	trigger cine1_cam1
	{
		startcamblack fourmis_2
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		achievement_lion
		foundsecret
	}

	trigger secret3
	{
		foundsecret
	}

	trigger mission1
	{
		objectivemet 1
	}

	trigger endmap
	{
		changelevel dep_castle persistent
	}
}

zombie1 //ogneniy
{
	attributes
	{
		fov 240
		starting_health 500
		aggression 1.0
		attrib hearing_scale 0.0
	}
	spawn
	{
		trigger zombie1 goto1
	}

	trigger goto1
	{
		takeweapon monsterattack2
		giveweapon monsterattack1
		alertentity flame1_bust
		trigger zombie1 goto2
	}

	trigger goto2
	{
		runtomarker zom1_p1
		alertentity ogonek
		alertentity stoyatynameste
		resetscript
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	death
	{
	}

	enemysight
	{
	}
}

