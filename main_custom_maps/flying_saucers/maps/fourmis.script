duh1
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger go
	{
		faceangles 0 225 0 gototime
		gotomarker duh1_p0 99999

		faceangles 0 1355 0 gototime
		gotomarker duh1_p1 100

		faceangles 0 160 0 gototime
		gotomarker duh1_p2 150

		faceangles 0 135 0 gototime
		gotomarker duh1_p3 100

		faceangles 0 120 0 gototime
		gotomarker duh1_p4 100

		faceangles 0 135 0 gototime
		gotomarker duh1_p5 100

		faceangles 0 170 0 gototime
		gotomarker duh1_p6 100

		faceangles 0 180 0 gototime
		gotomarker duh1_p7 100

		faceangles 0 110 0 gototime
		gotomarker duh1_p8 100

		trigger duh1 go
	}

	trigger loop
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound sound/beast/skull_shriek2.wav
	}
}

