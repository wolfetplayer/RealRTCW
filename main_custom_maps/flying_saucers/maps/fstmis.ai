//
//AI Scripting
//Map: fstmis (hard)
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 set 0 // zombie
		accum 0 bitreset 2

		accum 1 set 0 // schetchik trupov 1 i 2
		accum 2 set 0 // schetchik trupov zombey

		objectivesneeded 2

		abort_if_loadgame
		mu_start sound/music/l_briefing_1.wav 1000
	}


	playerstart 
	{
		mu_fade 0 2000
		mu_queue sound/music/m_drums.wav

		applyloadout fstmis
		cvar g_level_was_selected 0
	}

	trigger sobitie1
	{
		alertentity nem3
		alertentity nem4
		alertentity nem5
		alertentity dimok
	}

	trigger sobitie2
	{
		alertentity nem6
		alertentity nem7
		alertentity nem8
		alertentity fem1
	}

	trigger sobitie3
	{
		trigger transport goto1

		alertentity nem13
		alertentity nem14
		alertentity nem15
		alertentity nem16

		savecheckpoint
	}

	trigger sobitie4
	{
		alertentity nem19
		alertentity nem20
		alertentity nem21
	}

	trigger sobitie5
	{
		alertentity nem22
		alertentity nem23
	}

	trigger sobitie6
	{
		alertentity nem24
		alertentity nem25

		savecheckpoint
	}

	trigger sobitie7
	{
		alertentity fem2
		alertentity nem26
		alertentity nem27
		alertentity nem28
	}

	trigger sobitie8
	{
		alertentity par1
		alertentity nem29
		alertentity nem30
		alertentity nem31

		savecheckpoint
	}

	trigger sobitie9
	{
		objectivemet 2

		alertentity zombie3

		trigger kalitka1_a toggle
		trigger kalitka1_b toggle
		trigger kalitka2_a toggle
		trigger kalitka2_b toggle

		savecheckpoint
	}

	trigger sobitie10
	{

		accum 1 bitreset 2
		trigger soundsex stop2
		trigger zombie3 goto
		trigger kalitka1_a toggle
		trigger kalitka1_b toggle
		trigger kalitka2_a toggle
		trigger kalitka2_b toggle

		alertentity zhzhot_palchik
		alertentity close_kalitka1
		trigger player music_change1
	}

	trigger music_change1
	{
		mu_fade 0 2000
		mu_queue sound/music/c_atmos.wav
	}

	trigger music_change2
	{
		mu_play sound/music/s_bighits.wav
		mu_queue sound/music/c_chant.wav
	}

	trigger music_change3
	{
		mu_fade 0 2000
		mu_queue sound/music/m_mission.wav
	}

	trigger area1
	{
		accum 1 inc 1
		accum 1 abort_if_not_equal 8

		alertentity nem9
		alertentity nem10
		alertentity nem11
		alertentity nem12

		alertentity nem17
		alertentity nem18

		alertentity perehod1

		savecheckpoint
	}

	trigger area2
	{
		accum 1 inc 1
		accum 1 abort_if_not_equal 18

		alertentity perehod2
	}

	trigger zombies
	{
		accum 0 random 2
		wait 5
		trigger player zom1
		wait 5
		trigger player zom2
		mu_play sound/music/s_highramp.wav
		mu_queue sound/music/m_drums.wav
	}

	trigger zom1 //variant1 zombies
	{
		accum 0 abort_if_not_equal 0
		alertentity zombie1
	}

	trigger zom2 //variant2 zombies
	{
		accum 0 abort_if_not_equal 1
		alertentity zombie2
	}

	trigger killzombie
	{
		alertentity killzombie
	}

	trigger veshalka
	{
		trigger shkaf begin
		trigger shkaf begin2
	}

	trigger kluch
	{
		alertentity turyma2
	}

	trigger turyma
	{
		alertentity kluch2
		trigger par1 goto
	}

	trigger par_call
	{
		trigger par1 goto2
	}

	trigger par_ushel
	{
		trigger par1 goto3
	}

	trigger wake_up //prosto zombiki v bolyshom kol-ve
	{
		wait 5000

		trigger player music_change2
		alertentity wake_up1
		alertentity zombie5
		alertentity zombie7
		alertentity zombie10
		wait 2000
		alertentity wake_up2
		alertentity zombie4
		alertentity zombie8
		wait 2000
		alertentity wake_up3
		alertentity zombie6
		alertentity zombie9

		savecheckpoint
	}

	trigger wake_up2 //ognezombi
	{
		accum 2 inc 1
		accum 2 abort_if_not_equal 7

		alertentity zhzhot_palchik

		wait 5000

		trigger player music_change2
		alertentity zombie11
		alertentity zombie12
		alertentity zombie13
		alertentity zombie14

		savecheckpoint
	}

	trigger wake_up3 //vikingi
	{
		accum 2 inc 1
		accum 2 abort_if_not_equal 11

		alertentity zhzhot_palchik

		wait 2000

		trigger player music_change2
		alertentity stenproshib
		alertentity warzombie1
		alertentity warzombie2
		wait 100
		trigger warzombie1 go
		trigger warzombie2 go
	}

	trigger opendoorplz //otkrivaet kalitku v konce
	{
		accum 2 inc 1
		accum 2 abort_if_not_equal 13

		wait 500

		trigger kalitka1_a toggle
		trigger kalitka1_b toggle
		trigger kalitka2_a toggle
		trigger kalitka2_b toggle

		trigger player music_change3

		alertentity zapuskkonec

		alertentity opensecretroom
		alertentity nem32
		alertentity nem33
		alertentity nem34
		alertentity nem35
		alertentity nem36

		savecheckpoint
	}

	trigger player_lockon
	{
		lockplayer on
	}

	trigger player_lockoff
	{
		lockplayer off
	}

	trigger cine1_cam0
	{
		startcamblack fstmis_1
	}

	trigger cine1_cam1
	{
		startcam fstmis_2
	}

	trigger cine1_cam2
	{
		startcam fstmis_3
	}

	trigger cine1_cam3
	{
		startcam fstmis_4
	}

	trigger camerainterrupt
	{
		accum 0 abort_if_bitset 2
		stopcam
		trigger soundsex cine1_cleanup
		accum 0 bitset 2
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger secret3
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel secmis persistent
	}
}


nem1				
{
	attributes
	{
		tactical 0.6
		aggression 0.7
		camper 1.0
		alertness 2300
		attack_crouch 1.0
	}

	spawn
	{
		accum 0 bitreset 0
		accum 1 set 0

		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger

		statetype alert
		trigger nem1 go	
	}

	trigger go
	{
		runtomarker n1_p0 nostop
		runtomarker n1_p1 nostop
		runtomarker n1_p2 nostop
		runtomarker n1_p3 nostop
		runtomarker n1_p4 nostop
		runtomarker n1_p5 nostop
		runtomarker n1_p6 nostop
		runtomarker n1_p7 nostop
		runtomarker n1_p8
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

	enemysight
	{
		accum 0 bitset 20
		resetscript
		trigger nem1 choose_tactic
	}
	
	trigger choose_tactic
	{
		accum 1 random 3
		wait 5
		trigger nem1 tactic1
		wait 5
		trigger nem1 tactic2
		wait 5
		trigger nem1 tactic3
	}

	trigger tactic1			// total camper
	{
		accum 1 abort_if_not_equal 0
		resetscript
		attrib camper 1.0
		attrib aggression 0.1
		wait 3000 player
	}

	trigger tactic2			// Super aggressive
	{
		accum 1 abort_if_not_equal 1
		resetscript
		attrib camper 0.1
		attrib aggression 1.0
	}

	trigger tactic3			// medium
	{
		accum 1 abort_if_not_equal 2
		resetscript
		attrib camper 0.6
		attrib aggression 0.7
	}

	inspectsoundstart
	{
		resetscript
	}

	inspectsoundend
	{
		resetscript
	}

	inspectbodystart
	{
		resetscript
	}

	inspectbodyend
	{
		resetscript
	}	

	death
	{
		trigger player area1
		accum 0 abort_if_not_bitset 20
	}
}

nem2				
{
	attributes
	{
		tactical 1.0
		aggression 0.6
		camper 0.3
		alertness 1900
		attack_crouch 0.1
	}

	spawn
	{
		accum 0 bitreset 0
		accum 1 set 0

		statetype alert
		trigger nem2 go1	
	}

	trigger go1
	{
		runtomarker n2_p0 nostop
		runtomarker n2_p1 nostop
		runtomarker n2_p2 nostop
		runtomarker n2_p3 nostop
		runtomarker n2_p4 nostop
		runtomarker n2_p5 nostop
		runtomarker n2_p6 nostop
		runtomarker n2_p7 nostop
		runtomarker n2_p8
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
		giveweapon weapon_mp40
		setammo ammo_9mm 1000
		selectweapon weapon_mp40
	}

	enemysight
	{
		accum 0 bitset 20
		playsound MiscKillHim
		attack player
		resetscript
		trigger nem2 choose_tactic
	}
	
	trigger choose_tactic
	{
		accum 1 random 3
		wait 5
		trigger nem2 tactic1
		wait 5
		trigger nem2 tactic2
		wait 5
		trigger nem2 tactic3
	}

	trigger tactic1			// total camper
	{
		accum 1 abort_if_not_equal 0
		resetscript
		attrib camper 1.0
		attrib aggression 0.1
		wait 3000 player
	}

	trigger tactic2			// Super aggressive
	{
		accum 1 abort_if_not_equal 1
		resetscript
		attrib camper 0.1
		attrib aggression 1.0
	}

	trigger tactic3			// medium
	{
		accum 1 abort_if_not_equal 2
		resetscript
		attrib camper 0.6
		attrib aggression 0.7
	}

	inspectsoundstart
	{
		resetscript
		trigger nem2 tactic2
	}

	inspectsoundend
	{
		resetscript
		trigger nem2 tactic2

	}

	inspectbodystart
	{
		resetscript
		trigger nem2 tactic2
	}

	inspectbodyend
	{
	}	

	death
	{
		trigger player area1
		accum 0 abort_if_not_bitset 20
	}
}

nem3
{
	attributes
	{
		camper 0.9
		fov 110
	}

	spawn
	{
		accum 0 bitset 0 // ACHTUNG!!!

		giveweapon weapon_mauserrifle
		setammo ammo_792mm 500
		selectweapon weapon_mauserrifle

		wait 100
		trigger nem3 goto
	}

	trigger goto
	{
		accum 0 abort_if_not_bitset 0

		walktomarker n3_p1
		facetargetangles n3_p1
		wait 1500
		walktomarker n3_p2
		facetargetangles n3_p2
		wait 1500
		walktomarker n3_p3
		trigger nem3 goto
	}

	trigger alarm
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0

		runtomarker n3_p1
		trigger nem4 alarm
		trigger nem5 alarm
		resetscript
		statetype alert
		attack player
	}

	bulletimpact
	{
		trigger nem3 alarm
	}

	inspectsoundstart
	{
		trigger nem3 alarm
	}

	inspectsoundend
	{
		trigger nem3 alarm
	}

	inspectbodystart
	{
		trigger nem3 alarm
	}

	inspectbodyend
	{
		trigger nem3 alarm
	}

	attacksound
	{
		trigger nem3 alarm
	}

	inspectfriendlycombatstart
	{
		trigger nem3 alarm
	}

	death
	{
		trigger player area1
	}
}

