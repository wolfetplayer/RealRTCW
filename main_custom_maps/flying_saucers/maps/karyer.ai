		tactical 1.0
		attack_skill 1.0
		fov 360
	}

	spawn
	{
		nosight 99999
		wait 5
		knockback off
		takeweapon all
		giveweapon weapon_tesla
		setammo ammo_cell 999
		selectweapon weapon_tesla
		trigger super1 playdead_loop
	}

	avoiddanger player
	{
		denyactivate
	}

	trigger playdead_loop
	{	
		nosight 999999
//		playsound boss2_breathe
//		playanim come_alive both
		explicit_routing on
		walktomarker sr1_p1
		facetargetangles sr1_p1
		walktomarker sr1_p2
		statetype alert
		explicit_routing off
		noattack 400
		playsound boss2_breathe
		playanim come_alive both
		wait 1000
		sight
		resetscript
	}

	trigger stopdream
	{	
		sight
		resetscript
		selectweapon weapon_tesla
	}

	trigger lov1
	{
		trigger super1 use_rocket
		sight
		fireattarget lov1 200
		wait 500
		trigger super1 use_tesla
		resetscript
	}

	trigger lov2
	{
		trigger super1 use_rocket
		sight
		fireattarget lov2 200
		wait 500
		trigger super1 use_tesla
		resetscript
	}

