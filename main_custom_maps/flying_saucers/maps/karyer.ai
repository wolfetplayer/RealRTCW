player
{
	spawn
	{
		accum 0 bitset 0 //poluchi granatu
		accum 0 bitset 1
		accum 0 bitreset 2
		accum 0 bitreset 3 //dvery_kuzova
		accum 1 set 0 //pereproverka zadaniy

		objectivesneeded 2
		abort_if_loadgame
		mu_start sound/music/l_briefing_1.wav 1000
	}

	playerstart 
	{
		mu_fade 0 2000
		mu_queue sound/music/m_drums.wav

		alertentity openandclose
		trigger stvorka1l open
		trigger stvorka1p open
		trigger stvorka2l open
		trigger stvorka2p open
		trigger stvorka3l open
		trigger stvorka3p open

		trigger counter1 cinematic1

		alertentity struyaognya
		trigger katki1 startposition1
		trigger katki2 startposition1
		trigger zhdplatforma startposition1
	}

	trigger cine1_cam0
	{
		startcamblack karyer_1
	}

	trigger cine1_cam1
	{
		startcam karyer_2
	}

	trigger cine1_cam2
	{
		startcam karyer_3
	}

	trigger cine1_cam3
	{
		objectivemet 2
		startcam karyer_4
	}

	trigger cine1_cam4
	{
		startcam karyer_5
		notarget on
		wait 2000
		notarget off
		trigger counter1 cinematic3
	}

	trigger camerainterrupt
	{
		accum 0 abort_if_not_bitset 1

		stopcam
		trigger counter1 cine_toggle
	}

	trigger music_change1
	{
		mu_fade 0 2000
		mu_queue sound/music/m_action.wav
	}

	trigger music_change2
	{
		mu_fade 0 2000
		mu_queue sound/music/x_action.wav
	}

	trigger music_change3
	{
		mu_fade 0 2000
		mu_queue sound/music/m_mission.wav
	}

	trigger music_change4
	{
		mu_fade 0 2000
		mu_queue sound/music/m_assault.wav
	}

	trigger lovushka1
	{
		trigger super1 lov1
	}

	trigger lovushka2
	{
		trigger super1 lov2
	}

	trigger action1
	{
		trigger player music_change1
		alertentity nem1
		alertentity nem2
		alertentity nem3
		alertentity nem4
		alertentity nem5
	}

	trigger action2
	{
		alertentity trooper1
		alertentity trooper2
		alertentity trooper3
		alertentity nem6
		alertentity nem7
		alertentity nem8
		alertentity mehanik1

		savecheckpoint
	}

	trigger action3
	{
		alertentity trooper4
		alertentity trooper5
		alertentity trooper6
		alertentity opendoor1

		alertentity opendoor4

		alertentity nem9
		alertentity nem10
	}

	trigger action4
	{
		alertentity nem11
		alertentity nem12
	}

	trigger action5
	{
		alertentity nem13
		alertentity nem14

		savecheckpoint
	}

	trigger action6
	{
		alertentity nem15
		alertentity nem16
	}

	trigger action7
	{
		alertentity trooper7
		alertentity nem17
		alertentity nem18
		alertentity nem19
		alertentity opendoornaverhublin

		savecheckpoint
	}

	trigger action8
	{
		alertentity nem20
		alertentity nem21
	}

	trigger action9
	{
		alertentity nem22
		alertentity nem23
		alertentity nem24
		alertentity mehanik2
	}

	trigger action10
	{
		alertentity nem25
		alertentity nem26
		alertentity nem27
	}

	trigger action11
	{
		alertentity trooper8
		alertentity trooper9
		alertentity nem28
		alertentity opendoor2

		savecheckpoint
	}

	trigger action14
	{
		accum 0 bitreset 1

		alertentity opendoor3

		alertentity nem34
		alertentity mehanik3
	}

	trigger action15
	{
		alertentity nem35
		alertentity mehanik4
		alertentity officerss1
		alertentity officerss2

		savecheckpoint
	}

	trigger shootgranades
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		alertentity shootergranades
		wait 5000
		accum 0 bitset 0
	}

	trigger polol
	{
		alertentity opendoor4

		alertentity puskraketi

		alertentity ss1

		trigger ss1 go
	}

	trigger battle
	{
		alertentity super1
		alertentity opendoor2
		trigger counter1 cinematic2
		trigger player music_change4
	}

	trigger og1_go
	{
		objectivemet 1

		trigger counter1 zhara

		savecheckpoint
	}

	trigger og1_go2
	{
		accum 1 inc 1
		accum 1 abort_if_not_equal 7

		wait 2000

		trigger player music_change3

		trigger counter1 cinematic3
	}

	trigger toggle_up
	{
		trigger knopka1 on
	}

	trigger toggle_down
	{
		trigger knopka2 on
	}

	trigger uselocker1
	{
		trigger locker1 toggle
	}

	trigger open_kuzov
	{
		accum 0 abort_if_bitset 3
		accum 0 bitset 3
		trigger dvery_kuzova open
	}

	trigger zarabotaloblin
	{
		accum 0 bitset 2
	}

	trigger opensecretdoor
	{
		accum 0 abort_if_not_bitset 2
		accum 0 bitreset 2
		alertentity opensecretdoors
		alertentity nem36
		alertentity loper1
		alertentity mehanik5
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
		alertentity openlyuk
		wait 1000
		trigger loper1 go
	}

	trigger endmap
	{
		achievement_saucers
		changelevel antarktida persistent
	}
}

