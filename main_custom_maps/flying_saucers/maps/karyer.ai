nem12
{
	attributes
	{
		fov 110
		inner_detection_radius 6400
	}

	spawn
	{
		accum 0 bitset 0

		takeweapon weapon_mp40
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40

		statetype alert
		trigger nem12 goto
	}

	trigger goto
	{
		runtomarker n12_p1
		facetargetangles n12_p1
	}

	trigger alarm
	{
		accum 0 abort_if_not_bitset 0
		resetscript

		takeweapon weapon_mp40
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40

		attack player
		accum 0 bitreset 0
	}

	pain 15
	{
		runtomarker n12_p1
		facetargetangles n12_p1
		wait forever 0
	}

	enemysight player
	{
		runtomarker n12_p1
		facetargetangles n12_p1

		wait forever 0 player
	}

	bulletimpact
	{
		trigger nem12 alarm
	}

	inspectsoundstart
	{
		trigger nem12 alarm
	}

	inspectsoundend
	{
		trigger nem12 alarm
	}

	inspectbodystart
	{
		trigger nem12 alarm
	}

	inspectbodyend
	{
		trigger nem12 alarm
	}

	attacksound
	{
		trigger nem12 alarm
	}

	inspectfriendlycombatstart
	{
		trigger nem12 alarm
	}
}

