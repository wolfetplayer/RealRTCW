	{
		resetscript
	}

	trigger reset
	{
		resetscript
		walktomarker sr1_p1
		facetargetangles sr1_p1
		statetype alert
		explicit_routing off
		noattack 400
		sight
	}

	trigger use_tesla
	{
		sight
		takeweapon all
