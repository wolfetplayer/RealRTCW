lift
{

	spawn
	{
		accum 0 bitreset 0
		alertentity closepath
	}

	trigger toggle
	{
		alertentity closepath

		trigger lift up
		wait 5
		trigger lift down
	}

	trigger soundloop
	{
		playsound sound/movers/elevators/elev1_loop.wav looping
	}

	trigger down
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		wait 5
		playsound sound/movers/elevators/elev1_start.wav
		trigger lift soundloop
		gotomarker el_p2 50 wait
		gotomarker el_p1 50 deccel wait
		stopsound
		playsound sound/movers/elevators/elev1_end.wav
		trigger knopka2 off
		trigger knopka1 off
	}

	trigger up
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		wait 5
		playsound sound/movers/elevators/elev1_start.wav
		trigger lift soundloop
		gotomarker el_p3 50 wait
		gotomarker el_p4 50 deccel wait
		stopsound
		playsound sound/movers/elevators/elev1_end.wav
		trigger knopka2 off
		trigger knopka1 off
	}
}

knopka1
{
	spawn
	{
		accum 0 bitset 0
		wait 5
		gotomarker kn1_p1 10 wait
	}

	trigger on
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		playsound basein_switch
		gotomarker kn1_p2 10 wait
		trigger lift toggle
	}

	trigger off
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		playsound basein_switch
		gotomarker kn1_p1 10 wait
	}
}

knopka2
{
