counter1
{
	spawn
	{
		accum 0 set 0 //kamera
		accum 1 bitset 0 //kill_scenu
		accum 2 set 0 //check_deaths+vzriv
		accum 3 set 0 //check_deaths 1,2
	}

	trigger cinematic1
	{
		trigger player cine1_cam0
		wait 2000
		trigger counter1 stvorki_close
		wait 18000
		alertentity openandclose

		accum 0 set 1

		wait 1000
		accum 1 abort_if_not_bitset 0
		accum 1 bitreset 0
		alertentity nem0
		alertentity kill_scenu
	}

	trigger cinematic2
	{
		accum 0 set 2
		trigger player cine1_cam1
		wait 15000
	}

	trigger cinematic3
	{
		accum 2 inc 1
		accum 2 abort_if_not_equal 2

		trigger katki1 startposition2
		trigger katki2 startposition2
		trigger zhdplatforma startposition2

		trigger ufo_body startposition1
		trigger ufo_loposti startposition1
		trigger voditely startposition1

		trigger player cine1_cam2
		wait 8000

		alertentity struyaognya
		trigger ufo_body startposition2
		trigger ufo_loposti startposition2
		trigger voditely startposition2

		trigger player cine1_cam3
		wait 10000

		trigger player endmap
	}

	trigger cine_toggle
	{
		trigger counter1 cine1_cleanup1
		wait 5
		trigger counter1 cine1_cleanup2
	}

	trigger cine1_cleanup1
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		resetscript
		alertentity openandclose

		trigger stvorka1l fast_close
		trigger stvorka1p fast_close
		trigger stvorka2l fast_close
		trigger stvorka2p fast_close
		trigger stvorka3l fast_close
		trigger stvorka3p fast_close

		accum 1 abort_if_not_bitset 0
		accum 1 bitreset 0
		wait 400
		alertentity nem0
		alertentity kill_scenu
	}

	trigger cine1_cleanup2
	{
		accum 0 abort_if_not_equal 2
		accum 0 set 1
		trigger super1 reset
		resetscript
	}

	trigger stvorki_close
	{
		trigger stvorka1l close
		trigger stvorka1p close
		trigger stvorka2l close
		trigger stvorka2p close
		trigger stvorka3l close
		trigger stvorka3p close
	}

	trigger action12
	{
		alertentity trooper10
		alertentity trooper11

		alertentity nem29
		alertentity nem30

		alertentity opendoor2
	}

	trigger check_deaths1
	{
		accum 3 inc 1
		accum 3 abort_if_not_equal 4

		trigger counter1 action13
	}

	trigger action13
	{
		alertentity trooper12
		alertentity trooper13

		alertentity nem31
		alertentity nem32

		alertentity opendoor5
	}

	trigger check_deaths2
	{
		accum 3 inc 1
		accum 3 abort_if_not_equal 8

		alertentity opendoor3
		alertentity nem33
	}

	trigger zhara
	{
		trigger player cine1_cam4

		trigger ogony1 go
		wait 500
		trigger ogony2 go
		wait 200
		trigger ogony3 go
	}


}

stvorka1l
{
	spawn
	{
	}

	trigger open
	{
		faceangles 0 0 0 gototime
        	gotomarker st1l_open 99999
	}

	trigger close
	{
        	gotomarker st1l_close 50
	}

	trigger fast_close
	{
		resetscript
        	gotomarker st1l_close 99999
	}
}

