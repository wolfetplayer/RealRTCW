ufo_loposti
{
	spawn
	{
		accum 0 set 0
	}

	trigger startposition1
	{
		attachtotag ufo_body tag_floor
	}

	trigger startposition2
	{
		faceangles 0 90 0 1500
		faceangles 0 180 0 1250
		faceangles 0 270 0 900
		faceangles 0 360 0 600
		trigger ufo_loposti startposition2
	}

	trigger startposition3
	{
		accum 0 inc 1
		faceangles 0 90 0 400
		faceangles 0 180 0 400
		faceangles 0 270 0 400
		faceangles 0 360 0 400
		trigger ufo_loposti startposition4
		wait 5
		trigger ufo_loposti startposition3
	}

	trigger startposition4
	{
		accum 0 abort_if_less_than 3
		faceangles 0 90 0 100
		faceangles 0 180 0 100
		faceangles 0 270 0 100
		faceangles 0 360 0 100
		trigger ufo_loposti startposition4
	}
}

