//
//AI Scripting
//Map: les
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 bitreset 0 // foto
		accum 0 bitreset 1 // kuzov
		accum 0 bitreset 2 // action5

		objectivesneeded 1

		abort_if_loadgame
		mu_start sound/music/l_briefing_1.wav
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout les
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1500
		mu_queue sound/music/m_stealth.wav

		trigger gramophone rotationg
	}

	trigger action1
	{
		alertentity nem1
		alertentity nem2
		alertentity nem3
		alertentity nem4
		alertentity nem5

		alertentity nem6
	}

	trigger action2
	{
		alertentity nem7
		alertentity nem8
		alertentity nem9
		alertentity nem10
		alertentity dimok

		savecheckpoint
	}

	trigger action3
	{
		trigger stvorka1 open
		trigger stvorka2 open
		alertentity nem11
		alertentity nem12
		alertentity nem13
		alertentity nem14
		alertentity nem15
		alertentity nem16
		alertentity nem17
		alertentity nem18
		alertentity nem19
		alertentity nem20
		alertentity nem21
		alertentity nem22
		alertentity nem23
		alertentity elite1
		alertentity fem1
	}

	trigger action4
	{
		alertentity nem24
		alertentity nem25
		alertentity nem26
		alertentity nem27
		alertentity nem28
		alertentity nem29
		alertentity nem30

		alertentity nem31
		alertentity nem32

		savecheckpoint
	}

	trigger action5
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2

		alertentity nem33
		alertentity nem34
		alertentity nem35
		alertentity nem36
		alertentity nem37
		alertentity nem38
		alertentity nem39
		alertentity nem40
		alertentity nem41
		alertentity nem42
		alertentity nem43

		alertentity officerss1
		alertentity medic

		savecheckpoint
	}

	trigger hate_hitler
	{
		accum 0 abort_if_bitset 0
		accum 0 bitset 0
		trigger photo down
	}

	trigger open_kuzov
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1
		trigger dvery_kuzova open
	}

	trigger vorota_dem
	{
		trigger player action5
		trigger vorota1 open
		trigger vorota2 open
	}

	trigger uselocker1
	{
		trigger locker1 toggle
	}

	trigger playmusic
	{
		trigger gramophone play
	}

	trigger nashel
	{
		objectivemet 1
	}

	trigger secret1
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel railhead persistent
	}
}

nem1
{
	attributes
	{
		fov 300
		AGGRESSION 1.0
		alertness 20000
		tactical 1.0
		yaw_speed 300
		attack_crouch 1.0
	}

	spawn
	{
		accum 0 bitreset 0
	}

	trigger alarm
	{
		accum 0 abort_if_bitset 0
		resetscript
		attack player
		accum 0 bitset 0
	}

	bulletimpact
	{
		trigger nem1 alarm
	}

	inspectsoundstart
	{
		trigger nem1 alarm
	}

	inspectsoundend
	{
		trigger nem1 alarm
	}

	inspectbodystart
	{
		trigger nem1 alarm
	}

	inspectbodyend
	{
		trigger nem1 alarm
	}

	attacksound
	{
		trigger nem1 alarm
	}

	inspectfriendlycombatstart
	{
		trigger nem1 alarm
	}

	enemysight
	{
		trigger nem1 alarm
	}
}

