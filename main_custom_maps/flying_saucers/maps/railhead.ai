nem1
{
	attributes
	{
		fov 110
		inner_detection_radius 1024
	}

	spawn
	{
		accum 0 bitset 0
		accum 0 bitset 1 // alarmbox
		wait 100
		trigger nem1 goto
	}

	trigger goto
	{
		accum 0 abort_if_not_bitset 0

		playanim talking_2h both
		trigger nem1 goto
	}

	trigger alarm
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0

		resetscript
		trigger nem1 alarmbox
		attack player
	}

	trigger alarm2
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		accum 0 bitreset 1

		statetype alert

		trigger nem1 alarm
	}

	trigger alarmbox
	{
		accum 0 abort_if_not_bitset 1
		accum 0 bitreset 1

		runtomarker sir1_p1
		facetargetangles sir1_p1
		wait 100
		playanim switch_alarm both
		alertentity activatealarm1
	}

	pain 99
	{
		trigger nem1 alarm
	}

	bulletimpact
	{
		trigger nem1 alarm
	}

	inspectsoundstart
	{
		trigger nem1 alarm
	}

	inspectsoundend
	{
		trigger nem1 alarm
	}

	inspectbodystart
	{
		trigger nem1 alarm
	}

	inspectbodyend
	{
		trigger nem1 alarm
	}

	attacksound
	{
		trigger nem1 alarm
	}

	inspectfriendlycombatstart
	{
		trigger nem1 alarm
	}
}

