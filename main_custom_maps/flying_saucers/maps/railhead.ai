	}

//////////////ACTIONS//////////////

	trigger action1
	{
		alertentity nem3
		alertentity nem4

		accum 1 abort_if_bitset 0
		trigger nem3 alarm2
		trigger nem4 alarm2
	}

	trigger action2
	{
		alertentity nem5
		alertentity nem6
		alertentity nem7
		alertentity nem8
		alertentity nem9
		alertentity officer1

		accum 1 abort_if_bitset 0
		trigger nem5 alarm2
		trigger nem6 alarm2
		trigger nem7 alarm2
		trigger nem8 alarm2
		trigger nem9 alarm2
		trigger officer1 alarm
	}

	trigger action3
	{
		alertentity ucheniy1
		alertentity ucheniy2
		alertentity ucheniy3
		alertentity ucheniy4

		accum 1 abort_if_bitset 0
		trigger ucheniy1 alarm
		trigger ucheniy2 alarm2
		trigger ucheniy3 alarm
		trigger ucheniy4 alarm

		savecheckpoint
	}

	trigger action4
	{
		trigger player music_change1

		trigger counter1 alarmon

		alertentity nem10
		alertentity nem11
		alertentity nem12
		alertentity nem13

		alertentity nem14
		alertentity nem15

		alertentity openaction5
