	{
		alertentity nem16
		alertentity nem17

		alertentity nem18
		alertentity nem19
		alertentity nem20

		savecheckpoint
	}

	trigger action6
	{
		alertentity nem21

		alertentity nem22
		alertentity nem23

		alertentity nem24
		alertentity ucheniy5
		alertentity ucheniy6
	}

	trigger action7
	{
		alertentity nem25
		alertentity nem26

		alertentity officer2
	}

	trigger action8
	{
		alertentity nem27
		alertentity nem28
		alertentity nem29
		alertentity nem30

		alertentity mehanik3

		savecheckpoint
	}

	trigger action9
	{
		alertentity openaction9
		alertentity nem31
		alertentity nem32
		alertentity nem33
	}

	trigger action10
	{
		alertentity nem34
		alertentity nem35
		alertentity nem36

		alertentity nem37
		alertentity nem38

		trigger e2upbtn toggle

		trigger telbody go1
	}

	trigger action11
	{
		accum 0 abort_if_bitset 7
		accum 0 bitset 7

		trigger telbody go2
	}

	trigger action12
	{
		alertentity nem39
		alertentity nem40
		alertentity nem41
		alertentity nem42

		savecheckpoint
	}

	trigger action13
	{
		alertentity nem43
		alertentity nem44
		alertentity nem45

		alertentity shootergranades
		wait 5000
		alertentity shootergranades
		wait 5000
	}

	trigger action14
	{
		alertentity nem46
		alertentity nem47

		alertentity pricep

		objectivemet 1

		savecheckpoint
	}

	trigger vorota_toggle //vorota v metro
	{
		trigger knopka1 toggle
	}

	trigger gass
	{
		accum 0 abort_if_not_bitset 8
		accum 0 bitreset 8

		trigger ventel open

		accum 0 bitreset 1
		trigger e1upbtn toggle
	}

	trigger stv2
	{
		trigger stvorka toggle
	}

	trigger povorot
	{
		accum 0 abort_if_not_bitset 6
		trigger ruly open
//		alertentity stopfire // if not worked garilko1
		wait 500
		alertentity garilko1
		accum 0 bitreset 6
	}

