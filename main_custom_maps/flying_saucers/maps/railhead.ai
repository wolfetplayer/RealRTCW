	}

	trigger secret1
	{
		foundsecret
	}

	trigger endcamera1
	{
		startcam railh_3
	}

	trigger clearcam
	{
		stopcam
	}

	trigger exitmap
	{
		changelevel dep_lab persistent
	}

	trigger endmap
	{
		trigger counter1 cinematic2
		alertentity rus2
//		alertentity kickrus2

		mu_fade 0 2000

		alertentity netsteni
		trigger trainglav go1
		trigger trainzad go1
		trigger train1 go1
		trigger train2 go1
		trigger train3 go1
		trigger train4 go1
	}
}

rus1
{
	attributes
	{
		starting_health 75
		aim_accuracy 1.0
		tactical 1.0
		aggression 1.0
		inner_detection_radius 200
		alertness 2300	
	}

	spawn
	{
		giveweapon weapon_mp40
		setammo ammo_45cal 999
		setclip weapon_mp40 32
		selectweapon weapon_mp40

		statetype alert
		trigger rus1 begom1
	}

	trigger begom1
	{
		wait 1000
		runtomarker r1_p1
		runtomarker r1_p2
		facetargetangles r1_p2
		setclip weapon_mp40 0
		setammo ammo_9mm 50
		wait 100
		trigger counter1 kick
	}

	enemysight
	{
		clearanim
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
		clearanim
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
		clearanim
	}	

	death
	{
		playsound blank
	}
}

