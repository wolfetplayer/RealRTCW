vorota
{
	spawn
	{
	}

	trigger up
	{
		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker vorotavverh 10 wait
		stopsound
		playsound sound/movers/doors/door3_endo.wav
		trigger knopka1 odin
	}

	trigger fup
	{
		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker vorotavverh 1000 wait
		stopsound
		playsound sound/movers/doors/door3_endo.wav
		trigger knopka1 odin
	}

	trigger down
	{
		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker vorotavniz 10 wait
		stopsound
		playsound sound/movers/doors/door3_endo.wav
		trigger knopka1 noly
	}
}

knopka1
{
	spawn
	{
		accum 0 set 0
	}

	trigger toggle
	{
		trigger knopka1 up
		wait 5
		trigger knopka1 down
	}

	trigger noly
	{
		accum 0 set 0
		gotomarker kn2 10 wait
	}

	trigger odin
	{
		accum 0 set 1
		gotomarker kn2 10 wait
	}

	trigger up
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 3
		trigger vorota up
		playsound sound/movers/switches/switch.wav
		gotomarker kn1 10 wait
	}

	trigger down
	{
		accum 0 abort_if_not_equal 1
		accum 0 set 3
		trigger vorota down
		playsound sound/movers/switches/switch.wav
		gotomarker kn1 10 wait
	}

	trigger fast
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 3
		trigger vorota fup
		playsound sound/movers/switches/switch.wav
		gotomarker kn1 10 wait
	}
}

fortochka1
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger toggle
	{
		trigger fortochka1 open
		wait 5
		trigger fortochka1 close
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound sound/movers/doors/door8_open.wav
		faceangles 0 0 -60 700
	}

	trigger close
	{
		accum 0 abort_if_not_equal 1
		accum 0 set 0
		playsound sound/movers/doors/door8_open.wav
		faceangles 0 0 0 700
	}
}

