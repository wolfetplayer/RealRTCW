ventel
{
	spawn
	{
		accum 0 bitset 0
		faceangles 0 90 0 1
	}

	trigger open
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0

		playsound sound/tunn/fence1.wav
		faceangles 100 90 0 100
		faceangles 200 90 0 100
		faceangles 400 90 0 100

		alertentity gasvpusk

		faceangles 600 90 0 100
		faceangles 800 90 0 100

		trigger counter1 meh
	}

	trigger close1
	{
		playsound sound/tunn/fence1.wav
		faceangles 800 90 0 300
		faceangles 600 90 0 300
		faceangles 400 90 0 300
	}

	trigger close2
	{
		faceangles 300 90 0 100
		faceangles 100 90 0 100
		faceangles 50 90 0 100

		alertentity gasvipusk
	}
}

ruly
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		playsound sound/tunn/fence1.wav
		faceangles 0 0 200 300
		faceangles 0 0 400 300
		faceangles 0 0 600 300
		faceangles 0 0 800 300
		faceangles 0 0 1000 300
	}
}

trainglav
{
	spawn
	{
	}

	trigger go1
	{
		trigger trainglav goloop

		gotomarker tr1_p1 100 wait
		faceangles 0 10 0 gototime

		gotomarker tr1_p2 200
		faceangles 0 30 0 gototime

		gotomarker tr1_p3 300
		faceangles 0 80 0 gototime

		gotomarker tr1_p4 400
		faceangles 0 90 0 gototime
	}
	trigger goloop
	{
		playsound sound/world/radarcloseambient.wav looping
	}
}
