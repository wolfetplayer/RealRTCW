stvorka
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger toggle
	{
		trigger stvorka open
		wait 15
		trigger stvorka close
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound sound/movers/doors/door3_open.wav
		gotomarker sdvig2 100 wait
		gotomarker sdvig3 50
	}

	trigger close
	{
		accum 0 abort_if_not_equal 1
		accum 0 set 0
		playsound sound/movers/doors/door3_endo.wav
		gotomarker sdvig2 100 wait
		gotomarker sdvig1 50
	}
}

telbody
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger go1
	{
		playsound sound/world/picslide.wav
		trigger telkol1 go1
		trigger telkol2 go1
		trigger telkol1 rout1
		trigger telkol2 rout1

		faceangles 0 0 0 gototime
		gotomarker tb_p0 200
//		faceangles 0 0 0 gototime
//		gotomarker tb_p1 100

		trigger telkol1 stop
		trigger telkol2 stop
	}

	trigger go2
	{
		playsound sound/world/picslide.wav
		trigger telkol1 go2
		trigger telkol2 go2
		trigger telkol1 rout2
		trigger telkol2 rout2

		faceangles 0 0 0 gototime
		gotomarker tb_p2 80

		trigger telkol1 stop
		trigger telkol2 stop
	}
}

telkol1
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger go1
