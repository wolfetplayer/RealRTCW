		gotomarker tk1_p1 100
	}

	trigger go2
	{
		playsound sound/props/throw/chairthudgrunt.wav
		gotomarker tk1_p2 80
	}

	trigger rout1
	{
		faceangles 90 0 0 gototime
		faceangles 180 0 0 gototime
		faceangles 270 0 0 gototime
		faceangles 0 0 0 gototime

		faceangles 90 0 0 gototime
		faceangles 180 0 0 gototime
		faceangles 270 0 0 gototime
