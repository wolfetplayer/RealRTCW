mechanic1
{
	attributes
	{
		tactical 1.0
		aggression 0.1
		camper 1.0
		inner_detection_radius 200
		alertness 1000
	}

	spawn
	{
		wait 5
		accum 4 set 0
		accum 5 set 0
		accum 6 set 0
		takeweapon all
		playanim clean_parts_1 both 
		trigger mechanic1 alarm_off
	}

	trigger alarm_on
	{
		clearanim
		accum 4 set 1
		statetype alert

		takeweapon weapon_luger
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger	
	}

	trigger alarm_off
	{
		wait 3000
		playanim clean_parts_1 both forever
	}

	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}

	enemysight
	{
		accum 4 set 1
		playsound blank
		clearanim
		resetscript

		takeweapon weapon_luger
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		trigger mechanic1 alarm_on
		trigger mechanic2 alarm_on
	}

	statechange relaxed alert
	{
		accum 4 set 1
		clearanim
		resetscript
		statetype alert

		takeweapon weapon_luger
		giveweapon weapon_luger
		setammo ammo_9mm 999
