nem16
{
	attributes
	{
		fov 90
		alertness 5000
		inner_detection_radius 6400
	}

	spawn
	{
		accum 0 bitset 0
		accum 1 set 0
		trigger nem16 choose_way
	}

	trigger choose_way
	{
		accum 1 random 3
		wait 5
		trigger nem16 goto1
		wait 5
		trigger nem16 goto2
		wait 5
		trigger nem16 goto3
	}

	trigger goto1
	{
		accum 0 abort_if_not_bitset 0
		accum 1 abort_if_not_equal 0
		walktomarker n16_p1
		walktomarker n16_p2
		walktomarker n16_p1
		walktomarker n16_p4
