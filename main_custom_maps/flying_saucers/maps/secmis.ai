		statetype alert

		takeweapon weapon_luger
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

	inspectsoundend
	{
		restorescript
	}

	inspectbodystart
	{
		accum 4 set 1
		clearanim
		statetype alert

		takeweapon weapon_luger
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

	inspectbodyend
	{
	}	

	death
