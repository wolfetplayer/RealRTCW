player
{
	spawn
	{
		accum 0 bitset 0 // ubili devku
		accum 0 bitset 1
		accum 1 set 0 //schetchik smertey

		objectivesneeded 2
		abort_if_loadgame
		mu_start sound/music/l_briefing_1.wav 1000
	}


	playerstart 
	{
		mu_fade 0 2000
		mu_queue sound/music/m_tension.wav
	}

	trigger music_change1
	{
		mu_fade 0 2000
		mu_queue sound/music/c_military.wav
	}

	trigger duhi
	{
		trigger devka3 goto2
		alertentity stenaop2
		wait 9800
		trigger duh1 go
		trigger duh2 go
		trigger duh3 go
		trigger duh4 go
		trigger duh5 go
		trigger duh6 go

		trigger duh1 loop
		trigger duh2 loop
		trigger duh3 loop
		trigger duh4 loop
		trigger duh5 loop
		trigger duh6 loop
	}

	trigger nextlockation
	{
		accum 1 inc 1
		accum 1 abort_if_not_equal 12
		alertentity opendoorplz2
	}

	trigger mirazh1
	{
		alertentity devka1

		trigger player cine1_cam0
	}

	trigger mirazh2
	{
		alertentity devka2
		alertentity dveryotkrity

//		trigger player cine1_cam1
	}

	trigger ubeydevku
	{
		alertentity devka3
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		alertentity devka2kill

	}

	trigger cine1_cam0
	{
		startcam secmis_1
	}

	trigger cine1_cam1
	{
		startcam secmis_2
	}

	trigger notargeton
	{
		notarget on
	}

	trigger notargetoff
	{
		notarget off
	}

	trigger action1
	{
		alertentity nem2
		alertentity nem3
	}

	trigger action2
	{
		wait 3000
		alertentity nem4
		alertentity nem5
		alertentity nem6
		alertentity opendoorplz1
		
		savecheckpoint
	}

	trigger action3
	{
		alertentity nem7
		alertentity nem8
		alertentity nem9
		alertentity mechanic1
		alertentity mechanic2
	}

	trigger teslago
	{
		accum 0 abort_if_not_bitset 1
		accum 0 bitreset 1
		trigger tahinator_body go
		trigger richag open
	}

	trigger teslagoscpec
	{
		accum 0 bitset 1
	}

	trigger actionvnizu
	{
		alertentity nem11
		alertentity nem12
	}

	trigger action4
	{
		alertentity nem10
	}

	trigger action5
	{
		alertentity mechanic3

		savecheckpoint
	}

	trigger action6
	{
		alertentity nem14
		alertentity nem15
		alertentity nem16
	}

	trigger action7
	{
		alertentity nem17
		alertentity nem18
		alertentity nem19
		alertentity nem20
		alertentity nem21
		alertentity officer2

		savecheckpoint
	}

	trigger action8
	{
		alertentity nem22
		alertentity nem23
	}

	trigger action9
	{
		alertentity nem24
		alertentity nem25
	}

	trigger action10
	{
		alertentity nem26
		alertentity nem27
		alertentity korobki
	}

	trigger action11
	{
		alertentity nem28
		alertentity nem29
		alertentity nem30

		alertentity nem31
		alertentity nem32
		alertentity nem33

		savecheckpoint

		alertentity shootergranades
	}

	trigger officer_ubit
	{
		accum 1 inc 1
		accum 1 abort_if_not_equal 14
		alertentity chtotut1
	}

	trigger takedocs
	{
		objectivemet 1
		trigger player officer_ubit

		savecheckpoint
	}

	trigger konec
	{
		objectivemet 2
		alertentity closethis
		mu_fade 0 2000
		mu_queue sound/music/c_military.wav

	}

	trigger muzika
	{
		mu_fade 0 2000
		mu_queue sound/music/m_mission.wav
	}

	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel thirdmis persistent
	}
}

nem1
{
	attributes
	{
		fov 90
		alertness 5000
		inner_detection_radius 64
	}

	spawn
	{
		accum 0 bitset 0
		wait 100
		trigger nem1 goto
	}

	trigger goto
	{
		accum 0 abort_if_not_bitset 0
		walktomarker n1_p1 nostop
		walktomarker n1_p2
		walktomarker n1_p3
		walktomarker n1_p4
		walktomarker n1_p5
		walktomarker n1_p6
		walktomarker n1_p7
		walktomarker n1_p8
		facetargetangles n1_p8
	}

	trigger alarm
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		resetscript

		statetype alert
	}

	bulletimpact
	{
		trigger nem1 alarm
	}

	inspectsoundstart
	{
		trigger nem1 alarm
	}

	inspectsoundend
	{
		trigger nem1 alarm
	}

	inspectbodystart
	{
		trigger nem1 alarm
	}

	inspectbodyend
	{
		trigger nem1 alarm
	}

	attacksound
	{
		trigger nem1 alarm
	}

	inspectfriendlycombatstart
	{
		trigger nem1 alarm
	}

	enemysight
	{
		trigger nem1 alarm
		attack player
	}

	death
	{
		trigger player nextlockation
	}
}

