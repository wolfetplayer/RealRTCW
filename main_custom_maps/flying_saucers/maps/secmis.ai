mechanic3
{
	attributes
	{
		tactical 1.0
		aggression 0.1
		camper 1.0
		inner_detection_radius 200
		alertness 1000
	}

	spawn
	{
		accum 0 bitreset 0
		accum 4 set 0
		accum 6 set 0
		takeweapon all
		trigger mechanic3 anim_loop
	}

	trigger anim_loop
	{
		accum 4 abort_if_equal 1
		playanim working_with_tools both HOLDFRAME
		trigger mechanic3 anim_loop
	}

	trigger alarm_on
	{
		accum 4 set 1
		playanim don't_kill_me both
		playsound no_info
		wait 700
		statetype alert

		takeweapon weapon_luger
		giveweapon weapon_luger
