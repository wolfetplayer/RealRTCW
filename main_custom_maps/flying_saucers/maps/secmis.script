tahinator_body
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}
	trigger go
	{
		trigger tahinator_hands clear_go
		trigger tahinator_hands loop

		faceangles 0 0 0 gototime
		gotomarker tah1_p2 30
		trigger tahinator_hands on2
		trigger tahinator_hands go2


		faceangles 0 0 0 gototime
		gotomarker tah1_p3 30
		trigger tahinator_hands on1
		trigger tahinator_hands go3
		alertentity tesla1
		alertentity tesla2

		faceangles 0 0 0 gototime
		gotomarker tah1_p2 30
		trigger tahinator_hands on1
		trigger tahinator_hands go2
		alertentity tesla1
		alertentity tesla2
		alertentity tesla3
		alertentity tesla4

		faceangles 0 0 0 gototime
		gotomarker tah1_p3 30
		trigger tahinator_hands on1
		trigger tahinator_hands go3
		alertentity tesla3
		alertentity tesla4
		alertentity tesla5
		alertentity tesla6

		faceangles 0 0 0 gototime
		gotomarker tah1_p2 30
		trigger tahinator_hands on1
		trigger tahinator_hands go2
		alertentity tesla5
		alertentity tesla6
		alertentity tesla7

		faceangles 0 0 0 gototime
		gotomarker tah1_p3 30
		trigger tahinator_hands on1
		trigger tahinator_hands go3
		alertentity tesla7
		alertentity tesla1
		alertentity tesla5

		faceangles 0 0 0 gototime
		gotomarker tah1_p2 30
//		trigger tahinator_hands on1
		trigger tahinator_hands go2
		alertentity tesla1
		alertentity tesla5
		trigger tahinator_hands on2

		faceangles 0 0 0 gototime
		gotomarker tah1_p1 30
		trigger tahinator_hands go1
	}

	trigger loop_off
	{
		wait 100
		playsound sound/world/slow_fan_02.wav
	}
}

tahinator_hands
{
	spawn
	{
		trigger tahinator_hands clear_go
	}

	trigger clear_go
	{
		accum 0 set 0 //  0 = can  1 = cant
		accum 1 set 0 //  0 = cant  6 = can
	}

	trigger go1
	{
		gotomarker tah1_p1 30
		trigger richag close
		accum 0 set 1
	}

	trigger go2
	{
		gotomarker tah1_p2 30
	}

	trigger go3
	{
		gotomarker tah1_p3 30
	}

	trigger on1
	{
		accum 0 abort_if_not_equal 0
		faceangles 0 -90 0 600
		faceangles 0 -180 0 600
		faceangles 0 -270 0 600
		faceangles 0 -360 0 600	
	}

	trigger on2
	{
		faceangles 0 -90 0 600
		faceangles 0 -180 0 600
		faceangles 0 -270 0 600
		faceangles 0 -360 0 600
		faceangles 0 -450 0 600
		faceangles 0 -540 0 600
		faceangles 0 -630 0 600
		faceangles 0 -720 0 600		
	}

	trigger loop
	{
		accum 0 abort_if_not_equal 0
		playsound sound/world/dam_turbine.wav looping
	}

	trigger spec
	{
		trigger player teslagoscpec
		trigger tahinator_hands loop_off
	}

	trigger loop_off
	{
		wait 100
		playsound sound/scenaric/village2/misc_blank.wav looping
	}
}

richag
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound sound/movers/switches/switch.wav
		faceangles 0 0 180 800
	}

	trigger close
	{
//		accum 0 abort_if_not_equal 1
		accum 0 set 0
		playsound sound/movers/switches/switch.wav
		faceangles 0 0 0 1600
		trigger tahinator_hands spec
	}
}

radios
{
	spawn
	{
	}
	trigger go
	{
		playsound sound/world/amb_radio_02.wav
	}
}