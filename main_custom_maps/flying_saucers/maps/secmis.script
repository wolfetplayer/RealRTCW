duh1
{
	spawn
	{
		accum 0 set 0 //  0 = closed  1 = open
	}

	trigger go
	{
		faceangles 0 70 0 gototime
		gotomarker duh1_p1 150

		faceangles 0 30 0 gototime
		gotomarker duh1_p2 150

		faceangles 0 -30 0 gototime
		gotomarker duh1_p3 150

		faceangles 0 -90 0 gototime
		gotomarker duh1_p4 150

		faceangles 0 -150 0 gototime
		gotomarker duh1_p5 150

		faceangles 0 -210 0 gototime
		gotomarker duh1_p6 150

		faceangles 0 -270 0 gototime
		gotomarker duh1_p7 150
	}

	trigger loop
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound sound/beast/skull_shriek2.wav
	}
}

