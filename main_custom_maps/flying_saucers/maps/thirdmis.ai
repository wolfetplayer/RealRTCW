//
//AI Scripting
//Map: thirdmis
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		accum 0 set 0
		accum 1 bitset 0
		accum 1 bitset 1
		accum 1 bitreset 2 //igli
		accum 1 bitreset 3
//		accum 2 set 0 //dwa ishoda

		objectivesneeded 1

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
		trigger player zaks
	}

	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/c_military.wav
	}

	trigger pol
	{
		accum 2 inc 1
		accum 2 abort_if_not_equal 2

		accum 1 bitset 3

		alertentity razrush

		trigger stena1 go
		mu_play sound/music/s_bighits.wav
		mu_queue sound/music/c_military.wav

		accum 1 abort_if_not_bitset 2
		accum 1 bitreset 2

		accum 1 abort_if_not_bitset 3

		alertentity nefigstoyaty
		wait 5
		alertentity igli
	}

	trigger zaks
	{
		trigger zak zakrity

		trigger stena1 go0
		trigger stena2 go0
		trigger zadvigpol opusk1
	}

	trigger igligo
	{
		accum 2 random 2

		alertentity zombie_d

		wait 5

		trigger player pol
		accum 2 abort_if_not_equal 1

		accum 1 bitset 2
		alertentity igli
	}

	trigger action2
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_military 2000
		wait 500
		alertentity zombie_a
		wait 1000
		alertentity zombie_b
		wait 250
		alertentity zombie_c

		savecheckpoint
	}

	trigger action3
	{
		accum 1 abort_if_not_bitset 3
		accum 1 bitreset 3
		alertentity door_close1

		accum 1 abort_if_not_bitset 2

		alertentity igli
	}

	trigger test1
	{
		alertentity zombie4_a
		alertentity zombie4_b
	}

	trigger boy
	{
		alertentity zombie2_a
		alertentity zombie2_b
		alertentity warzombie2_a
		alertentity warzombie2_b
		alertentity nazi1
		alertentity nazi2

		savecheckpoint
	}

	trigger action4
	{
		alertentity warzombie3_a
		alertentity warzombie3_b
	}

	trigger action5
	{
		alertentity zombie5
		alertentity zombie6
		alertentity warzombie4
		alertentity warzombie5

		alertentity nazi5
		alertentity nazi6

		savecheckpoint
	}

	trigger action6
	{
		alertentity bossik
		trigger helga_zombie oppa
	}

	trigger action7
	{
		alertentity openpanel
	}

	trigger otkrivay
	{
		trigger krishkagroba1 go
		trigger krishkagroba2 go
		wait 400
		trigger zombie4_a getup
		trigger zombie4_b getup
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_military 2000
	}

	trigger  lovushka
	{
		accum 1 abort_if_not_bitset 0
		accum 1 bitreset 0

		trigger valun move
	}

	trigger  lovushechka2
	{
		trigger valun2 movet1
	}

	trigger pampam1
	{
		alertentity warzombie8
		alertentity warzombie9
		alertentity zombie9
		alertentity zombie10

		savecheckpoint
	}

	trigger pampam3
	{
		alertentity helga_zombie
	}

	trigger pampam4
	{
		alertentity warzombie10
		alertentity warzombie11
		alertentity zombie11
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		objectivemet 1
	}

	trigger goryachie_zombi
	{
		alertentity zombie7
		alertentity zombie8

		savecheckpoint
	}

	trigger warzom6
	{
		mu_play sound/music/s_longout
		mu_fade 0 7000
		mu_queue sound/music/c_military 7000

		trigger zadvigpol choose_reaction1
	}

	trigger warzom7
	{
		mu_play sound/music/s_longout
		mu_fade 0 7000
		mu_queue sound/music/c_military 7000

		trigger zadvigpol choose_reaction2

		savecheckpoint
	}

//kolesa
	trigger fi_1
	{
		trigger koleso1 fi
	}

	trigger fi_2
	{
		trigger koleso2 fi
	}
	trigger r_1
	{
		trigger koleso1 r
	}

	trigger r_2
	{
		trigger koleso2 r
	}

	trigger n_1
	{
		trigger koleso1 n
	}

	trigger n_2
	{
		trigger koleso2 n
	}

	trigger sledptici_1
	{
		trigger koleso1 sledptici
	}

	trigger sledptici_2
	{
		trigger koleso2 sledptici
	}
//kolesa

	trigger open_grob3
	{
		accum 1 abort_if_not_bitset 1
		accum 1 bitreset 1

		trigger player secret4
		trigger krishkagroba3 go
	}

	trigger check_deaths1
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 5

		trigger grob opusk
		alertentity door_open2
		alertentity nazi3
		alertentity nazi4
	}

	trigger check_deaths2
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 9

		alertentity openpampam1
	}

	trigger check_deaths3
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 13

		alertentity openpampam2
	}

	trigger secret1
	{
		foundsecret
		accum 1 bitset 3
	}

	trigger secret2
	{
		foundsecret
	}

	trigger secret3
	{
		foundsecret
	}

	trigger secret4
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel fourmis persistent
	}
}

