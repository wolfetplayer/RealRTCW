zombie4_a
{

	attributes
	{
		fov 240
		hearing_scale 0
	}

	spawn
	{
		knockback off
		accum 0 bitreset 0
		noattack 99999
		nosight 99999
		noavoid
		godmode on
		trigger zombie4_a animloop
	}

	trigger animloop
	{
		playanim laying_back both forever
	}

	trigger getup
	{
		godmode off
		playanim getup_back both
		facetargetangles vsta
		wait 500
		alertentity coffinbust1
		playanim kick legs
		avoid
		resetscript
		sight
		attack
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	death
	{
		playsound blank
		resetscript
	}

