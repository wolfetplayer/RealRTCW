grob
{
	spawn
	{

	}

	trigger opusk
	{
		gotomarker grobmove 30
		playsound sound/movers/doors/door2_loop.wav
		wait 500
		trigger zadvigpol opusk2
	}
	trigger proverka1
	{
		trigger grob proverka
		trigger koleso1 sound
	}

	trigger proverka2
	{
		trigger grob proverka
		trigger koleso2 sound
	}

	trigger proverka
	{
		trigger otkrivately1 proverka
		trigger otkrivately2 proverka
	}
}

zadvigpol
{
	spawn
	{
		accum 0 set 0
		accum 1 set 1
	}

	trigger opusk1
	{
        	gotomarker zadvigpol1 1000
	}

	trigger opusk2
	{
        	gotomarker zadvigpol2 40 accel wait
        	gotomarker zadvigpol3 20 accel
	}

	trigger opusk2
	{
        	gotomarker zadvigpol2 40 accel wait
        	gotomarker zadvigpol3 20 accel
	}

	trigger choose_reaction1
	{
		accum 0 random 2
		wait 5
		trigger zadvigpol tactic1
		wait 5
		trigger zadvigpol tactic2
	}

	trigger choose_reaction2
	{
		accum 1 random 2
		wait 5
		trigger zadvigpol tactic3
		wait 5
		trigger zadvigpol tactic4
	}

	trigger tactic1
	{
		accum 0 abort_if_not_equal 0

		alertentity getupwarzombie6a
		alertentity warzombie6a
	}

	trigger tactic2
	{
		accum 0 abort_if_not_equal 1

		alertentity getupwarzombie6b
		alertentity warzombie6b
	}

	trigger tactic3
	{
		accum 1 abort_if_not_equal 0

		alertentity getupwarzombie7a
		alertentity warzombie7a
	}

	trigger tactic4
	{
		accum 1 abort_if_not_equal 1

		alertentity getupwarzombie7b
		alertentity warzombie7b
	}
}

valun
{
	spawn
	{
		accum 0 set 0
	}

	trigger  zvuk
	{
		accum 0 abort_if_not_equal 0
		playsound sound/scenaric/crypt2/earth_rumble.wav
	}

	trigger move
	{
	trigger valun zvuk
	alertentity spusk
	alertentity hur0
        gotomarker kam0 100
	faceangles 0 0 -90 gototime
	alertentity hur0
	trigger valun move1
