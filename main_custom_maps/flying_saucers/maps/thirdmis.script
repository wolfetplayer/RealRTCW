otkrivately1
{
	spawn
	{
		accum 0 set 0 //1 koleso
		accum 1 set 0 //2 koleso
		accum 2 bitset 0 //glav dvery
	}

	trigger proverka //glav dvery
	{
		trigger otkrivately1 openglavdvery1 //dlya otkritiya
		wait 5
		trigger otkrivately1 openglavdvery2 //dlya zakritiya
		wait 5
		trigger otkrivately1 openglavdvery3 //dlya zakritiya
	}

	trigger openglavdvery1
	{
		accum 2 abort_if_not_bitset 0

		accum 0 abort_if_not_equal 4
		accum 1 abort_if_not_equal 2

		accum 2 bitreset 0
		alertentity glavdvery
	}

	trigger openglavdvery2
	{
		accum 2 abort_if_bitset 0

		accum 0 abort_if_equal 4 //proverka na nesoblyudeniya odnogo usloviya

		accum 2 bitset 0
		alertentity glavdvery
	}

	trigger openglavdvery3
	{
		accum 2 abort_if_bitset 0

		accum 1 abort_if_equal 2 //proverka na nesoblyudeniya drugogo usloviya

		accum 2 bitset 0
		alertentity glavdvery
	}

	trigger fi1
	{
		accum 0 set 1
	}

	trigger r1
	{
		accum 0 set 2
	}

	trigger n1
	{
		accum 0 set 3
	}

	trigger sledptici1
	{
		accum 0 set 4
	}

	trigger fi2
	{
		accum 1 set 1
	}

	trigger r2
	{
		accum 1 set 2
	}

	trigger n2
	{
		accum 1 set 3
	}

	trigger sledptici2
	{
		accum 1 set 4
	}
}

otkrivately2
{
	spawn
	{
		accum 0 set 0 //1 koleso
		accum 1 set 0 //2 koleso
		accum 2 bitset 0 //glav dvery
	}

	trigger proverka //secret area
	{
		trigger otkrivately2 opensecretarea1 //dlya otkritiya
		wait 5
		trigger otkrivately2 opensecretarea2 //dlya zakritiya
		wait 5
		trigger otkrivately2 opensecretarea3 //dlya zakritiya
	}

	trigger opensecretarea1
	{
		accum 2 abort_if_not_bitset 0

		accum 0 abort_if_not_equal 1
		accum 1 abort_if_not_equal 4

		accum 2 bitreset 0
		alertentity secretarea
	}

	trigger opensecretarea2
	{
		accum 2 abort_if_bitset 0

		accum 0 abort_if_equal 1 //proverka na nesoblyudeniya odnogo usloviya

		accum 2 bitset 0
		alertentity secretarea
	}

	trigger opensecretarea3
	{
		accum 2 abort_if_bitset 0

		accum 1 abort_if_equal 4 //proverka na nesoblyudeniya drugogo usloviya

		accum 2 bitset 0
		alertentity secretarea
	}

	trigger fi1
	{
		accum 0 set 1
	}

	trigger r1
	{
		accum 0 set 2
	}

	trigger n1
	{
		accum 0 set 3
	}

	trigger sledptici1
	{
		accum 0 set 4
	}

	trigger fi2
	{
		accum 1 set 1
	}

	trigger r2
	{
		accum 1 set 2
	}

	trigger n2
	{
		accum 1 set 3
	}

	trigger sledptici2
	{
		accum 1 set 4
	}
}

