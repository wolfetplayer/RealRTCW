player
{
	spawn
	{
		cvar g_episode 78
		objectivesneeded 1		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_stealth

		// Weapons
		// Ammo
		giveweapon weapon_knife
		giveweapon weapon_luger
		giveweapon weapon_mp40
		setammo ammo_9mm 200
		setammo ammo_grenades 4

		// Items
		giveinventory key_binocs
		setarmor 100
		selectweapon weapon_mp40

		trigger t2body go1
		trigger t2body cinematic1

	}
	trigger action1
	{	
		mu_fade 0 1000
		mu_queue sound\music\c_military
		alertentity znazi4
		alertentity znazi5
		alertentity znazi6
		alertentity znazi7
		alertentity znazi8
		trigger driver talk1
	}
	trigger go
	{	
		trigger znazi1 shot
		trigger znazi2 shot
		trigger znazi3 shot
	}
	trigger cam4
	{
		startcamblack crypt01 
	}
	trigger cam1
	{
		startcam cine1
	}
	trigger dead
	{
		stopcam
	}
	trigger cam2
	{
		startcam cine2
	}

	trigger cam3
	{
		startcam cine3
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger endmap
	{
		changelevel roadtobase2 persistent 4000
	}
}
