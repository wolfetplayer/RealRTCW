zombie7
{

	attributes
	{
		fov 240
		hearing_scale 0
	}

	spawn
	{
		knockback off
		accum 0 bitreset 0
		noattack 99999
		nosight 99999
		noavoid
		godmode on
		trigger zombie7 animloop
	}

	trigger animloop
	{
		playanim laying_back both forever
	}

	trigger getup
	{
		godmode off
		playanim getup_back both
		facetargetangles z7spot1
		wait 500
		avoid
		resetscript
		sight
		attack
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	death
	{
		playsound blank
	}

	statechange alert combat
	{
		accum 0 bitset 0
		clearanim
