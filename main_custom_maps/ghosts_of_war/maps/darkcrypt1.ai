//
//AI Scripting
//Map: DarkCrypt1
//Last edited by: Jex
//

player
{
	spawn
	{
		accum 0 set 0
		accum 1 set 0
		cvar g_episode 1
		objectivesneeded 1
		suggestweapon weapon_mp40

		abort_if_loadgame
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout darkcrypt1
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1000
		mu_queue sound/music/c_military
	}
	

	trigger music2_start
	{
		mu_play sound/music/s_longout
		mu_queue sound/music/c_chant 2000
	}

	trigger music3_start
	{
		mu_start sound/music/c_atmos 2000
	}

	trigger music_stop_3000
	{
		mu_stop 3000
	}

	trigger music_stop_1000
	{
		mu_stop 1000
	}
	trigger zombyattack
	{
		alertentity zombie1
		alertentity zombie2
		alertentity zombie3
	}
	trigger zombyattack2
	{
		alertentity zombie4
		alertentity zombie5
		alertentity zombie6
	}
	trigger action1
	{
//		alertentity zombie7
//		alertentity zombie8
	}
	
	trigger action2
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		trigger zombie8 getup
		trigger zombie7 getup
	}
	trigger action3
	{
		alertentity zombie9
		alertentity zombie10
	}
	trigger action4
	{
		trigger zombie9 go
		trigger zombie10 go
	}
	trigger action5
	{
		alertentity flamer0
	}
	trigger action6
	{
		alertentity zombie13
		alertentity zombie14
		alertentity zombie15
	}
	trigger action7
	{
		alertentity zombie16
		alertentity zombie17
	}
	trigger action8
	{
		alertentity flamer1
		alertentity flamer2
	}
	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger endmap
	{
		changelevel darkcrypt2 persistent
	}

}

zombie1
{
	attributes
	{
		hearing_scale 2.0
	}

	spawn
	{
		wait 5
		runtomarker z1spot1
		gotocast player
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}
	
	death
	{
	}

	enemysight player
	{
		attack player
		resetscript
	}
}

