//
//AI Scripting
//Map: DarkCrypt2
//Last edited by: Jex
//

player
{
	spawn
	{
		accum 0 set 0
		accum 1 set 0
		cvar g_episode 1
		objectivesneeded 2
		suggestweapon weapon_mp40

		abort_if_loadgame
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/c_military
		#if g_level_was_selected >= 1
		applyloadout darkcrypt2
		#endif
		cvar g_level_was_selected 0
	}
	

	trigger start
	{
//		trigger cryptdoor open
		trigger cryptdoor1 open
	}
	trigger endattack
	{
		alertentity zombie1
		alertentity zombie2
		alertentity zombie3
		alertentity zombie4
	}
	trigger action1
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		alertentity zombie5
		alertentity zombie6
	}

	trigger action2
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		alertentity zombie7
		alertentity zombie8
		alertentity zombie9
	}
	trigger action3
	{
		mu_start sound/music/c_atmos 2000
		alertentity zombie10
		alertentity zombie11 
	}
	trigger action4
	{
		alertentity zombie12
	}
	trigger action5
	{
		alertentity zombie13
		alertentity zombie14
		alertentity zombie15
		alertentity zombie16
		alertentity zombie17
	}
	trigger action6
	{
		alertentity zombie18
		alertentity zombie19
	}
	trigger action7
	{
		alertentity zombie20
		alertentity zombie21
	}
	trigger action8
	{
		alertentity zombie22
		alertentity zombie23
		alertentity flamer0
	}
	trigger guard
	{
		alertentity helga_zombie
	}
	trigger secret1
	{
		foundsecret
	}

	trigger secret2
	{
		foundsecret
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger got_objective2
	{
		objectivemet 1
	}
	trigger endmap
	{
		changelevel statement persistent
	}

}
helga_zombie	// reincarnation of helga
{
	attributes
	{
		pain_threshold_scale 50
		aggression 1.0
		fov 360
	}

	spawn
	{
		statetype alert
		knockback off
		godmode on
		nosight 999999
		wait 100
		godmode off
		playanim attack3 both
		attrib pain_threshold_scale 10
		sight
		accum 0 set 1
		gotocast player
	}
	enemysight
	{
		resetscript
	}

	blocked player
	{
		deny
		pushaway player
	}
	death
	{
		objectivemet 2
	}
}
zombie1
{
	attributes
	{
		hearing_scale 2.0
	}

	spawn
	{
		wait 5
		runtomarker z1spot1
		gotocast player
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}
	
	death
	{
	}

	enemysight player
	{
		attack player
		resetscript
	}
}

