heinrich
{

	attributes
	{
		alertness 50000
		aggression 1.0
		camper 0.0
		tactical 0.0
		aim_skill 1.0
		fov 360
		statetype alert
	}

	spawn
	{
		nosight 99999
		knockback off
		noavoid off
		takeweapon monsterattack2
		trigger heinrich still
	}
	pain 2500
	{
		playanim laughing both
		trigger player start2
		wait 500
		clearanim
		resetscript
	}
	trigger sight_on 
	{
		sight
	}

	trigger still
	{
		playanim lift_still both
		trigger heinrich still
	}

	trigger begin
	{
		explicit_routing on
		sight
		//giveweapon monsterattack3
		gotocast player
	}

	trigger warzombiedead
	{
  		  accum 1 inc 1
  		  accum 1 abort_if_less_than 3
  		  giveweapon monsterattack2
  		  accum 1 set 0
	}

 	enemysight
	{
		resetscript
	}

	death
	{
		trigger player changelevel
	}
}

fem1
{

	attributes
	{
	}

	spawn
	{
		attack player
	}

	trigger getup
	{
		playanim get_up both
	}
		
	enemysight
	{
		attack player
		resetscript
	}
}