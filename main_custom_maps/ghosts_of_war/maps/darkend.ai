player
{

	spawn
	{
		accum 0 bitreset 0
		abort_if_loadgame
		mu_fade 0 1000
		mu_queue sound/music/c_atmos

		cvar g_episode 6
		objectivesneeded 1		
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout darkend
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1000
		mu_queue sound/music/c_chant
		trigger player action1
	}

	trigger action1
	{
		trigger heinrich begin
//		alertentity smoke1
		alertentity dark1
		alertentity dark2
		alertentity dark3
//		alertentity spirit1
//		alertentity spirit2
//		alertentity spirit3
//		alertentity spirit4
	}
	trigger start1
	{
//		alertentity smoke1
		alertentity dark1
		alertentity dark2
		alertentity dark3
	}
	trigger start2
	{
//		alertentity smoke2
		alertentity dark4
		alertentity dark5
		alertentity dark6
	}
	trigger changelevel
	{
		objectivemet 1
		wait 3500 
		changelevel
		wait 9000
		endgame
	}

	death
	{
		resetscript
	}
}

dark1
{

	attributes
	{
	}

	spawn
	{
		nosight 99999
		knockback off
		wait 5
		trigger dark1 talk1
	}
	trigger talk1
	{
		trigger dark1 go1
	}
	trigger go1
	{
		sight
		knockback on
		gotocast player
		resetscript
	}
	death
	{
		trigger heinrich warzombiedead
	}
}
