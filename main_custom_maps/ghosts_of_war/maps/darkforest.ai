//
//AI Scripting
//Map: darkforest
//Last edited by: Dan
//

player
{
	spawn
	{
		accum 0 set 0
		accum 1 set 0
		cvar g_episode 1
		objectivesneeded 2
		suggestweapon weapon_mp40

		abort_if_loadgame
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/c_military
		giveweapon weapon_knife
		giveweapon weapon_mp40
		setammo ammo_9mm 82
		selectweapon weapon_mp40
	}
	
	trigger action1
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		alertentity znazi5
		alertentity znazi6
		alertentity znazi7
	}

	trigger action2
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		alertentity zombie1 
		alertentity znazi8
	}
	trigger action3
	{
		mu_start sound/music/c_atmos 2000
		alertentity zombie2
		alertentity zombie3
		alertentity zombie4
		alertentity zombie5
	}
	trigger action4
	{
		alertentity znazi9
		alertentity znazi10
	}
	trigger action5
	{
		alertentity zombie6
		alertentity zombie7
		alertentity zombie8
		alertentity zombie9
		alertentity zombie10
		alertentity zombie11
	}
	trigger action6
	{
	}
	trigger action7
	{
	}
	trigger action8
	{
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger got_objective2
	{
		objectivemet 2
	}
	trigger endmap
	{
		changelevel darkcastle persistent
	}

}

