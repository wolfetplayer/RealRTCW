//
//AI Scripting
//Map: statement
//Last edited by: Jex
//

player
{
	spawn
	{
		accum 0 set 0
		accum 1 set 0
		cvar g_episode 1
		objectivesneeded 1
		suggestweapon weapon_mp40

		abort_if_loadgame
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/c_military
	}
	
	trigger action1
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		alertentity zombie5
		alertentity zombie6
		alertentity zombie7
		alertentity zombie8
		alertentity zombie9
	}

	trigger action2
	{
		mu_play sound/music/s_longout
		mu_fade 0 2000
		mu_queue sound/music/c_chant 2000
		alertentity zombie10
		alertentity zombie11
		alertentity zombie12
		alertentity zombie13
	}
	trigger action3
	{
		mu_start sound/music/c_atmos 2000
		alertentity zombie14
		alertentity zombie15
		alertentity zombie16
	}
	trigger action4
	{
		alertentity zombie12
	}
	trigger action5
	{
		alertentity zombie13
		alertentity zombie14
		alertentity zombie15
		alertentity zombie16
		alertentity zombie17
	}
	trigger action6
	{
		alertentity zombie18
		alertentity zombie19
	}
	trigger action7
	{
		alertentity zombie20
		alertentity zombie21
	}
	trigger action8
	{
		alertentity zombie22
		alertentity zombie23
		alertentity flamer0
	}
	trigger guard
	{
		alertentity helga_zombie
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger endmap
	{
		changelevel darkend persistent
	}

}
zombie1
{
	attributes
	{
		starting_health 150
	}

	spawn
	{
		takeweapon monsterattack2
		giveweapon monsterattack1		
		noaidamage on
		nosight 99999
		wait 500
		trigger zombie1 reset
	}

	trigger reset
	{
		godmode off
		sight
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}
		
	death
	{
	}

	enemysight
	{
		attack player
		resetscript
	}
}
