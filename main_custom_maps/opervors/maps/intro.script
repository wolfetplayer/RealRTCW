	spawn
	{		
	 
	}

	trigger cam1
	{
		trigger player camera1
	}

	trigger cam2
	{
		trigger player camera2
	}

	trigger cam3
	{
		trigger player camera3
	}

	trigger cam3b
	{
		trigger player camera3b
	}

	trigger cam4
	{
		trigger player camera4
	}

	trigger cam5
	{
		trigger player camera5
	}

	trigger cam6
	{
