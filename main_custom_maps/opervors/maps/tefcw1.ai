//
//AI Scripting
//Map: tefcw1 (for O.V.)
//Last edited by: Tef Johs
//

player
{
	spawn
	{
		objectivesneeded 2

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout tefcw1
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1500
		mu_queue sound/music/c_chant
			
		trigger player introsequence
	}

	trigger introsequence		//plays the opening overview cutscene
	{
		
		trigger director cam1
		wait 20000	
		
		mu_fade 0 1000
		mu_queue sound/music/m_mission
	}

	trigger changemusic
	{
		mu_fade 0 1000
		mu_queue sound/music/m_stealth
	}

	trigger changemusic2
	{
		mu_fade 0 1000
		mu_queue sound/music/m_mission
	}

	trigger camera1				
	{
		startcam tefcw1_cam1	//max playtime 20 sec
	}

	trigger camera2				
	{
		startcam tefcw1_cam2	//max playtime 20 sec
	}

	trigger camera3			
	{
		startcam tefcw1_cam3	//max playtime 10 sec
	}

	trigger camera4			
	{
		startcam tefcw1_cam4	//max playtime 30 sec
	}

	trigger camera5				
	{
		startcam tefcw1_cam5	//max playtime 10 sec
	}

	trigger camera6				
	{
		startcam tefcw1_cam6	//max playtime 20 sec
	}

	trigger camera7				
	{
		startcam tefcw1_cam7	//max playtime 25 sec
	}

	trigger opendoor1				
	{
		wait 300
		startcam tefcw1_opdoor1	 //max playtime 5 sec
		wait 2200
		mu_start sound/music/m_mission 500
	}

	trigger opendoor2				
	{
		wait 300
		startcam tefcw1_opdoor2	 //max playtime 5 sec
		wait 2200
	}

	trigger opendoor3				
	{
		wait 300
		startcam tefcw1_opdoor3	 //max playtime 5 sec
		wait 1200
	}

	trigger opendoor4				
	{
		wait 300
		startcam tefcw1_opdoor4	 //max playtime 5 sec
		wait 1200
	}

	trigger action1
	{
		trigger nazi2 nazi2walk
	}

	trigger action2
	{
		trigger player autosave
		trigger player changemusic
		wait 300
		trigger dialogue cin_dial
	}

	trigger action3
	{
		mu_stop 800
		alertentity beethov_92
		trigger spawner reinforce1
	}

	trigger action4
	{
		trigger spawner office_1
	}

	trigger action5
	{
		trigger dialogue office_1
	}

	trigger action6
	{
		trigger spawner crateroom
	}

	trigger action7
	{
		trigger dialogue hallway1
		wait 6500
		trigger player changemusic2
	}

	trigger action8
	{
		trigger spawner endarea
	}

	trigger autosave
	{
		savegame
 	}

	trigger secret1
	{
		foundsecret
	}
	
	trigger secret2
	{
		foundsecret
	}
	
	trigger objective1		//eliminate kommandantur (officer5)
	{
		objectivemet 1
	}

	trigger objective2		//destroy all 3 radios in comm room
	{
		objectivemet 2
	}

	trigger endmap
	{		
		changelevel tefcw2 persistent
	}

	death
	{

	}
}


nazi1
{
	attributes
	{
		fov 240
		alertness 12000
	}

	spawn
	{
		accum 0 set 0  		//checks state of patrol1
		accum 1 set 0  		//checks if dialogue is interrupted

		giveweaponfull weapon_mp40
		setammo ammo_grenades 5
		wait 100
		
		trigger nazi1 patrol1
	}

	trigger patrol1
	{
		accum 0 abort_if_not_equal 0
		walktomarker nazi1_1 nostop
		walktomarker nazi1_2 nostop
		walktomarker nazi1_3 nostop
		walktomarker nazi1_4
		facetargetangles nazi1_4 		
		
		wait 1000
		trigger officer1 startwalk1
		
		playanim being_cold both
		playsound sound/scenaric/general/misc_shiver2.wav
		wait 2000
		playanim being_cold both
		
		accum 0 set 1		
	}
	
	sight officer1
	{
		clearanim
		facetargetangles nazi1_4
		wait 500
		headlook on
		wait 5000
		headlook off			
	}
	
	trigger nazi1line1
	{
		accum 1 abort_if_not_equal 0
		playanim talking_2h torso
		playsound sound/scenaric/chateau/corp_sir.wav
		wait 1000				
	}

	trigger nazi1line2
	{
		accum 1 abort_if_not_equal 0
		playanim talking_2h torso
		playsound sound/scenaric/forest/axis8_believeso.wav
		wait 2000 							
	}

	trigger nazi1line3
	{
		accum 1 abort_if_not_equal 0
		playanim talking_2h torso
		playsound sound/scenaric/chateau/corp_jawol.wav
		wait 1000 
	}

	trigger patrol2
	{
		accum 0 abort_if_not_equal 1
		resetscript
		walktomarker nazi1_3 nostop
		walktomarker nazi1_4
		wait 1000

		trigger nazi1 patrol2	
	}	

	inspectsoundstart
	{
		deny
	}
		
	enemysight
	{
		accum 1 set 1
		wait 1000
		playsound sound/scenaric/general/misc_alarm1.wav

		trigger spawner nazialert1
		gotomarker nazi1_3
		resetscript						
	}

	death
	{
	
	}
}


officer1
{
	attributes
	{
		fov 240
		alertness 16000
	}

	spawn
	{
		accum 0 set 0	//checks start walking
		accum 1 set 0	//checks if dialogue is interrupted
		
		giveweaponfull weapon_mp40
		givearmor item_armor_head
		setammo ammo_grenades 5
		wait 100
	}

	trigger startwalk1
	{
		accum 0 abort_if_not_equal 0

		walktomarker officer_1 nostop
		walktomarker officer_2 nostop
		walktomarker officer_3 nostop
		walktomarker officer_11 
		facetargetangles officer_11
	}
	
	trigger offic1line1
	{
		accum 1 abort_if_not_equal 0
		playsound sound/scenaric/chateau/off_corporal.wav 
		wait 1500 		
	}

	trigger offic1line2
	{
		accum 1 abort_if_not_equal 0
		playsound sound/scenaric/forest/axis7_delivery.wav
		wait 1500 
	}

	trigger offic1line3
	{
		accum 1 abort_if_not_equal 0
		playsound sound/scenaric/forest/axis15_handle.wav 	
		wait 1500 		
	}

	trigger startwalk2
	{
		accum 0 abort_if_not_equal 1
		accum 1 abort_if_not_equal 0

		resetscript
		walktomarker officer_12 nostop
		walktomarker officer_3 nostop
		walktomarker officer_4 nostop
		walktomarker officer_5 nostop
		walktomarker officer_6 nostop
		walktomarker officer_7 nostop
		walktomarker officer_8 nostop
		walktomarker officer_9 nostop		
		facetargetangles officer_9
		
		wait 1000
		trigger officer1 offic1stand 
	}

	sight nazi1
	{
		walktomarker officer_11
		facetargetangles officer_11
		wait 1000
		
		accum 0 set 1
	}

	trigger offic1stand
	{
		takeweapon weapon_mp40
		giveweapon weapon_luger
		wait 500
		selectweapon weapon_luger
		wait 500

		trigger officer1 standstill				
	}

	trigger standstill
	{
		explicit_routing off
	}

	inspectsoundstart
	{
		deny
	}

	enemysight
	{
		resetscript
		accum 1 set 1
		playsound sound/scenaric/village2/gen5_alarm_alarm.wav

		trigger spawner nazialert2
		wait 3000 
		explicit_routing on				
	}

	death
	{
		
	}
}

nazi2
{
	attributes
	{
		fov 240
		alertness 16000
	}

	spawn
	{						
		accum 0 set 1

		statetype alert	

		giveweaponfull weapon_mp40
		setammo ammo_grenades 5
		wait 100
	}
	
	inspectsoundstart
	{
		deny	
	}

	trigger nazi2walk
	{	
		accum 0 abort_if_not_equal 1
	
		wait 500
		walktomarker nazi2_1 nostop
		walktomarker nazi2_2 nostop
		walktomarker nazi2_3 nostop
		walktomarker nazi2_4 
		facetargetangles nazi2_4

		wait 1500
		cigarette on
		playanim smoking torso
		wait 15000
		cigarette off

		accum 0 set 0		
	}

	enemysight
	{
		resetscript
		playsound sound/scenaric/forest/axis15_meingott.wav
		wait 1300
	}

	death
	{	
	
	}
}

nazi3
{
	attributes
	{
		running_speed 250
	}

	spawn
	{	
		accum 0 bitset 0	//checks which event comes first
					
		giveweaponfull weapon_mp40
		wait 100
		
		trigger nazi3 patrol1
	}
	
	inspectsoundstart
	{
		deny	
	}

	trigger patrol1
	{
		walktomarker nazi3_1 nostop
		walktomarker nazi3_2
		wait 2000
		trigger nazi3 patrol1
	}

	inspectfriendlycombatstart
	{
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0
		
		trigger nazi3 runtoradio
	}

	trigger runtoradio
	{	
		resetscript
		playsound sound/scenaric/general/male_ze_american.wav
		wait 2200
		trigger nazi4 checkout
		wait 100
		trigger nazi3 patrol2			
	}

	trigger patrol2
	{
		gotomarker nazi3_3 nostop
		gotomarker nazi3_4 nostop
		gotomarker nazi3_5 nostop
		gotomarker nazi3_6 nostop
		gotomarker nazi3_7 
		facetargetangles nazi3_7

		wait 1000
		trigger nazi3 reinforce
	}

	trigger reinforce
	{
		trigger spawner nazi3call
		wait 100
		resetscript
	}

	enemysight
	{	
		accum 0 abort_if_not_bitset 0
		accum 0 bitreset 0

		trigger nazi3 runtoradio
	}

	death
	{	
	
	}
}

