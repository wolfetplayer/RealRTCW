//
//AI Scripting
//Map: tefcw2 (for O.V.)
//Last edited by: Tef Johs
//

player
{
	spawn
	{
		objectivesneeded 3

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/c_chant
			
		trigger player introsequence
	}

	trigger introsequence			//plays the opening overview cutscene
	{
		
		trigger director cam1
		wait 20000
		
		trigger player changemusic			
	}

	trigger changemusic
	{
		mu_fade 0 1000
		mu_queue sound/music/l_theme
	}

	trigger changemusic2
	{
		mu_fade 0 1000
		mu_queue sound/music/m_tension
	}

	trigger changemusic3
	{
		mu_fade 0 1000
		mu_queue sound/music/m_assault
	}

	trigger camera1				
	{
		startcam tefcw2_cam1		//max playtime 20 sec
	}

	trigger camera2				
	{
		startcam tefcw2_cam2		//max playtime 10 sec
	}

	trigger opendoor1				
	{
		wait 200
		startcam tefcw2_opdoor1	 	//max playtime 5 sec
		wait 5000
	}

	trigger opendoor2				
	{
		wait 200
		startcam tefcw2_opdoor2	 	//max playtime 5 sec
		wait 1500
	}

	trigger action1
	{
		trigger nazi1 nazi1walk
	}

	trigger action2
	{
		trigger spawner nazi6789
	}

	trigger action3
	{
		trigger spawner nazi1011
	}

	trigger action4				// Inside castle doors
	{
		trigger player autosave
		wait 200
		trigger player objective1	
		wait 200
		trigger player changemusic2
		wait 100
		trigger spawner castlenazi
	}

	trigger action5
	{
		trigger spawner nazi1214
	}

	trigger action6
	{
		trigger spawner canonfodder
	}

	trigger action7
	{
		trigger spawner officers_1
	}

	trigger action8
	{
		trigger spawner office_1
	}

	trigger action9
	{
		trigger spawner office_2
	}

	trigger action10
	{
		trigger player changemusic
		wait 50
		trigger director cam2
		wait 10000
		
		trigger spawner office_3
		wait 100
	}

	trigger action11
	{
		trigger spawner office_4
		trigger player autosave
		wait 400				
		trigger dialogue dial2
	}

	trigger action12
	{
		wait 100
		trigger player changemusic3
		wait 100
		trigger spawner elites1
	}

	trigger lockgate
	{
		alertentity gateswitch			
	}

	trigger autosave
	{
		savegame
 	}

	trigger secret1
	{
		wait 300
		foundsecret
	}
	
	trigger secret2
	{
		foundsecret
	}
	
	trigger objective1			// Infiltrate perimeter
	{
		objectivemet 1
	}

	trigger objective2			// Kill kommandant Fleicher
	{
		objectivemet 2
	}

	trigger objective3			// Eliminate 6 officers inside Castle
	{
		objectivemet 3
		wait 100
		trigger player action12
	}

	trigger endmap
	{		
		changelevel tefcw3 persistent
	}

	death
	{

	}
}


nazi1
{
	attributes
	{
		walking_speed 160
		fov 240
	}

	spawn
	{
		accum 0 set 0  			//checks state of nazi1walk

		setammo ammo_grenades 5
		giveweapon weapon_mp40
		givearmor item_armor_head
		setammo ammo_9mm 150
		selectweapon weapon_mp40		
	}

	trigger nazi1walk
	{
		accum 0 abort_if_not_equal 0
		walktomarker nazi1_1 nostop
		walktomarker nazi1_2 nostop
		walktomarker nazi1_3 nostop
		walktomarker nazi1_4
		facetargetangles nazi1_4 		
		
		wait 2000
		
		playanim being_cold both
		playsound sound/scenaric/general/misc_shiver2.wav
		
		cigarette on
		playanim smoking both
		cigarette off								
	}
	
	trigger overthere
	{
		trigger spawner nazi1call
		playsound sound/scenaric/general/misc_over_there.wav
		wait 2000

		resetscript
	}
		
	enemysight
	{						
		trigger dialogue nazi1lock
		wait 100

		accum 0 set 1								
	}

	death
	{
	
	}
}

