//
//AI Scripting
//Map: tefcw3 (for O.V.)
//Last edited by: Tef Johs
//

player
{
	spawn
	{
		objectivesneeded 3

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout tefcw3
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1500
		mu_queue sound/music/c_chant
			
		trigger player introsequence
	}

	trigger introsequence			//plays the opening overview cutscene
	{
		
		trigger director cam1
		wait 20000
		
		trigger player changemusic4			
	}

	trigger changemusic1
	{
		mu_fade 0 1000
		mu_queue sound/music/m_grave
	}

	trigger changemusic2
	{
		mu_fade 0 1000
		mu_queue sound/music/x_tension
	}

	trigger changemusic3
	{
		mu_fade 0 1000
		mu_queue sound/music/m_moving
	}

	trigger changemusic4
	{
		mu_fade 0 1000
		mu_queue sound/music/m_stealth
	}

	trigger changemusic5
	{
		mu_fade 0 1000
		mu_queue sound/music/m_mission
	}

	trigger camera1				
	{
		startcam tefcw3_cam1		//max playtime 20 sec
	}

	trigger camera2				
	{
		startcam tefcw3_cam2		//max playtime 10 sec
	}

	trigger action1
	{
		trigger dialogue dial1
	}

	trigger action2
	{
		trigger spawner nazi38
		wait 100
		trigger player changemusic1
	}

	trigger action3
	{
		trigger spawner nazi918
		wait 100
		trigger player changemusic3
	}

	trigger action4
	{
		trigger spawner naziblack1
		wait 100
		trigger player autosave
	}

	trigger action5
	{
		trigger spawner doctors1
	}

	trigger action6
	{
		trigger spawner sector1
		wait 100
		trigger player changemusic1
		wait 100
		trigger player objective1
	}

	trigger action7
	{
		trigger spawner sector2
		wait 100
		trigger player objective2
	}

	trigger action8
	{
		trigger player changemusic2
		wait 50
		trigger director cam2
		wait 10000
		
		trigger player changemusic1		
	}

	trigger action9
	{
		trigger spawner exithall
		wait 100
		trigger player changemusic3
		wait 100
		trigger player autosave		
	}

	trigger action10
	{
		trigger spawner centreroom	
	}

	trigger autosave
	{
		savegame
 	}

	trigger secret1				// Hidden room underneath stairs
	{
		foundsecret
	}
	
	trigger objective1			// Gained access to Sector 1
	{
		objectivemet 1
	}

	trigger objective2			// Gained access to Sector 2
	{
		objectivemet 2
	}

	trigger objective3			// Killed 10 of 12 scientists
	{
		objectivemet 3
	}

	trigger endmap
	{		
		changelevel tefcw4 persistent
	}

	death
	{

	}
}


nazi1
{
	attributes
	{
	}

	spawn
	{
		accum 0 set 0  			//checks state of dialogue

		giveweaponfull weapon_thompson
		givearmor item_armor_head
		setammo ammo_grenades 5
	}

	trigger nazi1line1
	{
		accum 0 abort_if_not_equal 0
		playsound sound/scenaric/village1/officer1_our_own_men.wav					
	}

	trigger nazi1line2
	{
		accum 0 abort_if_not_equal 0
		playsound sound/scenaric/village1/officer1_need_drink.wav					
	}

	trigger nazi1line3
	{
		accum 0 abort_if_not_equal 0
		playsound sound/scenaric/village1/officer1_those_screams.wav					
	}
	
	inspectsoundstart
	{
		deny
	}
	
	enemysight
	{						
		wait 500
		playsound sound/scenaric/general/misc_kill_him.wav
		wait 1200
		accum 0 set 1

		resetscript							
	}

	death
	{
		accum 0 set 1
	}
}

