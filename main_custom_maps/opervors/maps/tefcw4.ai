//
//AI Scripting
//Map: tefcw4 (for O.V.)
//Last edited by: Tef Johs
//

player
{
	spawn
	{
		objectivesneeded 4

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/c_chant
			
		trigger player introsequence
	}

	trigger introsequence			//plays the opening overview cutscene
	{
		
		trigger director cam1
		wait 20000
		
		trigger player changemusic2			
	}

	trigger changemusic1
	{
		mu_fade 0 1000
		mu_queue sound/music/m_action
	}

	trigger changemusic2
	{
		mu_fade 0 1000
		mu_queue sound/music/m_drums
	}

	trigger changemusic3
	{
		mu_fade 0 1000
		mu_queue sound/music/l_theme
	}

	trigger changemusic4
	{
		mu_fade 0 1000
		mu_queue sound/music/m_situation
	}

	trigger changemusic5
	{
		mu_fade 0 1000
		mu_queue sound/music/m_mission
	}

	trigger changemusic6
	{
		mu_fade 0 500
		mu_queue sound/music/l_finale
	}

	trigger playfinale
	{
		wait 200
		trigger player changemusic6
		wait 11000
		mu_stop 1000
	}

	trigger camera1				
	{
		startcam tefcw4_cam1		// max playtime 20 sec
	}

	trigger camera2				
	{
		startcam tefcw4_cam2		// max playtime 10 sec
	}

	trigger opendoor1
	{
		startcam tefcw4_opdoor1		// max playtime 5 secs
		wait 5000
	}	

	trigger opendoor2
	{
		startcam tefcw4_opdoor2		// max playtime 5 secs
		wait 5000
	}	

	trigger opendoor3
	{
		startcam tefcw4_opdoor3		// max playtime 5 secs
		wait 5000
	}	

	trigger action1
	{
		trigger spawner nazibase3
		wait 100
		trigger dialogue dial1
	}

	trigger action2
	{
		trigger spawner nazibase1
	}

	trigger action3
	{
		trigger spawner nazibase2
		wait 100
		trigger player changemusic5
		wait 100
		trigger player autosave
	}

	trigger action4
	{
		trigger spawner nazibase4
	}

	trigger action5
	{
		trigger dialogue dial2
	}

	trigger action6
	{
		trigger spawner nazibase5
	}

	trigger action7
	{
		trigger player changemusic4
		wait 100
		trigger player autosave
	}

	trigger action8
	{
		trigger spawner nazibase6
		wait 100
		trigger director cam2
		wait 10000
	}

	trigger action9
	{
		trigger player changemusic1
	}

	trigger action10
	{
		trigger supersol_1 supersol1walk
		wait 100
		trigger supersol_2 supersol2walk
	}

	trigger autosave
	{
		savegame
 	}

	trigger secret1				// Compartment room in larger hallway
	{
		foundsecret
	}
	
	trigger objective1			// Obtained access to Soldier's Wing
	{
		objectivemet 1
	}

	trigger objective2			// Obtained access to Officer's Wing
	{
		objectivemet 2
	}

	trigger objective3			// Obtained access to Exit Hallways
	{
		objectivemet 3
	}

	trigger objective4			// Eliminated Oberst Vorsichtig
	{
		objectivemet 4
	}

	trigger endmap
	{		
		changelevel exit persistent
	}

	death
	{

	}
}


nazi1
{
	attributes
	{
	}

	spawn
	{
		accum 0 set 0  				//checks state of dialogue

		setammo ammo_grenades 5
		giveweapon weapon_thompson
		givearmor item_armor_head
		setammo ammo_45cal 50
		selectweapon weapon_thompson		
	}

	trigger nazi1line1
	{
		accum 0 abort_if_not_equal 0
		playsound sound/scenaric/village2/g1_tasty_sb.wav
		playanim talking_2h torso					
	}

	trigger nazi1line2
	{
		accum 0 abort_if_not_equal 0
		playsound sound/scenaric/village2/g1lc_haha.wav					
	}
	
	inspectsoundstart
	{
		deny
	}
	
	enemysight
	{	
		clearanim					
		wait 400
		playsound sound/scenaric/general/misc_kill_him.wav
		wait 1200
		accum 0 set 1

		resetscript							
	}

	death
	{
		accum 0 set 1
	}
}

