player
{
 spawn
  {
                accum 0 set 0
                accum 1 set 0
                accum 2 set 0
                accum 3 set 0
                accum 4 set 0
                accum 5 set 0
                accum 6 set 0
		mu_fade 0 5000
                mu_queue  sound/scenaric/miks/main_menu.wav
  }
 playerstart
  {
        mu_stop 1000
		mu_queue sound/music/level1/level1.wav
		giveweapon weapon_revolver
		setammo ammo_revolver 60
		setclip weapon_revolver 6
		selectweapon weapon_revolver
  }
  trigger vrota_set_0
  {
   accum 1 set 1
  }
  trigger vrota_set_1
  {
   accum 2 set 1
  }
  trigger start_vrota
  {
  accum 1 abort_if_equal 0
  accum 2 abort_if_equal 0
  wait 1500
  teleport player_pos1
  alertentity player2
  wait 10
  trigger player2 go
  startcam l1_5_1
  wait 7000
  trigger zasov go
  wait 8000
  startcam l1_5_2
  trigger player2 go1
  wait 2000
  trigger player endmap
  }

trigger zombi_sleep
 {
  accum 0 abort_if_equal 1

  //mu_stop 1000
  wait 1000
  teleport player_pos1
  alertentity player1
  trigger player1 go
  startcam l1_4_1
 
  //mu_queue sound/scenaric/miks/l1_war1.wav
  wait 3000
  startcam l1_4_2
  wait 3000
  alertentity kill_p1
  startcam l1_4_3
  wait 1000
  trigger z1 go1
  accum 0 set 1
  wait 4000
  teleport player_pos3
 }
  trigger go_b1
   {
    accum 3 abort_if_equal 0
    trigger b1 go1
   }
  trigger go_d3
   {
    alertentity z
    alertentity z1
    trigger d3 go
    trigger player zombi_sleep
   }
  trigger go_d5
   {
    trigger d5 go
   }
  trigger stop_d5
   {
    trigger d5 stop
   }
  trigger pes1_rotate
   {
notarget on
    trigger pes1 rotate
wait 3000
notarget off
   }
  trigger pes2_rotate
   {
    trigger pes2 rotate
   }
  trigger pedal_go
   {
    trigger pedal go
   } 

  trigger start
   {
  trigger flame start
   }
  trigger stop
   {
  trigger flame stop
   }    
  trigger most_go
   {
wait 2000
    startcam l1_1
    wait 5000
    startcam l1_2
    trigger most_1 go_up
    trigger most_2 go_up
    trigger most_3 go_up
    trigger most_4 go_up
    trigger most_5 go_up
wait 25000
    trigger most_1 go_down
    trigger most_2 go_down
    trigger most_3 go_down
    trigger most_4 go_down
    trigger most_5 go_down
  }

  trigger most_go1
   {
    trigger most_1 go_up
    trigger most_2 go_up
    trigger most_3 go_up
    trigger most_4 go_up
    trigger most_5 go_up
wait 8000
    trigger most_1 go_down
    trigger most_2 go_down
    trigger most_3 go_down
    trigger most_4 go_down
    trigger most_5 go_down
  }




  trigger anubis_on
   {
   accum 6 abort_if_equal 1
    trigger ruchka1 go1
    wait 2000
    startcam l1_3 
    wait 4000
    stopcam
   accum 6 set 1
   accum 4 inc 1
trigger player activate1
  }
  trigger hors_on
   {
   accum 5 abort_if_equal 1
    alertentity war
    alertentity war1
    trigger ruchka2 go1
    wait 2000
    startcam l1_3 
   accum 5 set 1
   accum 4 inc 1
trigger player activate1
  }





 trigger d7_down
  {
  trigger d7 go1
  }

 trigger d9_close
  {
  trigger d9 go1
  }

  trigger rot_rul1
  {
   trigger rul_1 rot
  }
  trigger rot_rul2
  {
   trigger rul_2 rot
  }
  trigger rot_rul3
  {
   trigger rul_3 rot
  }
  trigger rot_rul4
  {
