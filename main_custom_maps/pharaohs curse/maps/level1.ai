  }

  trigger rot_n_rul1
  {
   trigger n_rul_1 rot
  }
  trigger rot_n_rul2
  {
   trigger n_rul_2 rot
  }
  trigger rot_n_rul3
  {
   trigger n_rul_3 rot
  }
  trigger rot_n_rul4
  {
   trigger n_rul_4 rot
  }

trigger rot_rul_final
 {
  trigger rul_finish door_go
 wait 4000
 trigger pol go
 }
trigger n_rot_rul_final
 {
  trigger n_rul_finish door_go
 wait 4000
 trigger potolok go
 }
 trigger start_zombi7
  {
   alertentity z7
   alertentity z8
   trigger d10 go
   wait 5000
   alertentity start_kam
   wait 1000
  //mu_stop 1000
 // mu_queue sound/scenaric/miks/l1_war2.wav
   trigger z7 go1
   trigger z8 go1
  }
  trigger start_zombi6
   {
    alertentity z3
    alertentity z4
    alertentity z5
    alertentity z6
    trigger z5 go1
  //mu_stop 1000
  //mu_queue sound/scenaric/miks/l1_war2.wav
    wait 6000
    trigger z6 go1
   }
trigger t3_s1
{
     //mu_stop 2000
    // mu_queue sound/music/level1/level1.wav
     accum 3 set 1
}
trigger start_mus
{
    // mu_stop 2000
     //mu_queue sound/music/level1/level1.wav
}
trigger activate1
{
accum 4 abort_if_not_equal 2
alertentity start_active
}
trigger start_war3
{
  //mu_stop 1000
  //mu_queue sound/scenaric/miks/l1_war3.wav
}

trigger almaz
 {
  alertentity almaz_kill_action
 }
trigger stopd11
 {
    //  mu_stop 2000
    // mu_queue sound/music/level1/level1.wav
 }


	trigger endmap
	{
		changelevel level2 persistent
	}

}
