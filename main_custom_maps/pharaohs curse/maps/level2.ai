player
{
 spawn
  {
                accum 0 set 0
		mu_fade 0 5000
                mu_queue  sound/scenaric/miks/main_menu.wav
  }
 playerstart
  {
        mu_stop 1000
		mu_queue sound/music/level2/level2.wav
  }

trigger go_ruchka1
 {
  trigger ruchka1 go1
 }
trigger go_ruchka2
 {
  trigger ruchka2 go1
 }

trigger start_katarga
 {
  alertentity zombi14
  wait 5000
  trigger zombi14 go1
 }



trigger start_start
{
wait 3000
alertentity zombi1
alertentity z1
trigger zombi1 go1
alertentity zombi4
alertentity z4
trigger zombi4 go1
wait 1000
alertentity zombi2
alertentity z2
trigger zombi2 go1
alertentity zombi6
alertentity z6
trigger zombi6 go1
wait 2000
alertentity zombi5
alertentity z5
trigger zombi5 go1
wait 500
alertentity zombi3
alertentity z3
trigger zombi3 go1
wait 2000
alertentity zombi7
alertentity z7
trigger zombi7 go1
wait 800
alertentity zombi8
alertentity z8
trigger zombi8 go1
wait 300
alertentity zombi9
alertentity z9
trigger zombi9 go1
}

trigger start_cam1
{
startcam l2_1
}
trigger start_war
{
alertentity war1
alertentity war2
trigger war1 go
trigger war2 go
wait 500
alertentity war3
alertentity war4
trigger war3 go
trigger war4 go
wait 500
alertentity war5
alertentity war6
trigger war5 go
trigger war6 go
wait 500
trigger war1 go1
trigger war2 go1
trigger war3 go1
trigger war4 go1
trigger war5 go1
trigger war6 go1
wait 4000
stopcam
trigger war1 go2
trigger war2 go2
trigger war3 go2
trigger war4 go2
trigger war5 go2
trigger war6 go2
}

trigger go_zomb
 {
  wait 5000
  alertentity zombi10
  alertentity z10
  wait 1000
  alertentity zombi11
  alertentity z11
  wait 1000
  alertentity zombi12
  alertentity z12
  wait 1000
  alertentity zombi13
  alertentity z13
}


