trigger Lzombi_go
 {
  alertentity zombiL1
 }



 trigger zombi_alfa_s
  {
   alertentity zombi_alfa
   alertentity zombi_alfa1
   alertentity zombi_alfa2
   alertentity zombi_alfa3
  } 
 trigger aktivate_end
  {
  //mu_stop 1000
  //mu_queue sound/scenaric/miks/l1_war2.wav
   alertentity zombi_alfa9
   alertentity zombi_alfa5
  }

trigger death_s1
 {
  accum 0 inc 1
  accum 0 abort_if_not_equal 8
  trigger dor6_1 go
  trigger dor6_2 go
  accum 0 set 0
 }

trigger trigger_a
{
alertentity trigger_aktivate
}

trigger endmaps
 {
  lockplayer off
  changelevel level3 persistent
 }
}


//----------------------------ZOMBI------------------------------
zombi1
{
 attributes
  {
  }
 spawn
  {
   accum 0 set 0
   knockback off
   takeweapon monsterattack2
   noavoid
   godmode on
   nosight 9999999999
   trigger zombi1 go
  }
   trigger go
    {
     nosight 9999999999
     playanim alcove_1 both forever
    }
   trigger go1
    {
   godmode off
     clearanim
     playsound go1 
     playanim alcove both 
   sight
    }
 fakedeath
  {
  }
 death
  {
   accum 1 abort_if_equal 1
   trigger door1 acc 
   accum 0 set 1
  }
}
