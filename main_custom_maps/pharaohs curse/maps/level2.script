	trigger go
	{
		faceangles -15 0 0 1000
	}
	trigger go1
	{
		accum 1 abort_if_equal 1
		faceangles 15 0 0 1000
		trigger door4 go
		accum 1 set 1
	}
}


resh
{
	spawn
	{
		accum 1 set 0
	}
	trigger go
	{
		accum 1 abort_if_not_equal 1
		faceangles -100 0 0 6000
	}
	trigger acc
	{
		wait 3000
		accum 1 inc 1
		trigger resh go
	}
}
