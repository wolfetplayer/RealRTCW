d4  //дверь в гробницу
{
	spawn
	{
		trigger d4 go
	}
	trigger go
	{
		gotomarker d4_p1 700
	}
	trigger go1
	{
		playsound sound/world/moves/mov1.wav
		gotomarker d4_p2 30 wait
		alertentity d4_stop
		playsound sound/world/moves/door2_locked.wav
	}
}



st1   //нижняя половина колонны
{
	spawn
	{
	}
	trigger go
	{
		wait 5000
		playsound sound/world/stones/split3.wav
		alertentity st1_start_p_trig
		faceangles -10 0 0 600
		faceangles -20 0 0 400
		faceangles -30 0 0 300
		faceangles -40 0 0 200
		faceangles -50 0 0 100
		faceangles -60 0 0 80
		faceangles -70 0 0 60
		faceangles -80 0 0 30
		faceangles -90 0 0 10
		faceangles -120 0 0 5
		faceangles -130 0 0 3
		alertentity st1_stop_p_trig
		playsound sound/world/stones/sqish1.wav
	}
}


st2 // верняя половина колонны
{
	spawn
	{
	}
	trigger go
	{
		wait 5000
		alertentity st3_start
		trigger kamen go
		playsound sound/world/stones/split2.wav
		alertentity st2_start_p_trig
		gotomarker s2_p1 300 accel
		faceangles 90 0 0 gototime
		gotomarker s2_p2 700
		faceangles 100 0 0 gototime
		alertentity st2_stop_p_trig
		playsound sound/world/stones/sqish1.wav
	}
}


