suzu_os1  //сузуки 1
{
	spawn
	{
	}
	trigger sou_start
	{
		playsound sound/scenaric/intro/suzu_ss.wav looping
	}
	trigger sou_start
	{
		stopsound
	}

	trigger go
	{
		faceangles -90 0 0 80
		faceangles -180 0 0 80
		faceangles -270 0 0 80
		faceangles -360 0 0 80
		trigger suzu_os1 go
	}
}
