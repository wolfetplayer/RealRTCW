suzu2  //сузуки 2
{
	spawn
	{
	}
	trigger go
	{
		playsound sound/scenaric/intro/suzu_ss.wav looping
		gotomarker suzu_pos1 300 wait
		gotomarker suzu_pos2 200
		playanim 0 40 1 10
		alertentity suzu_stop
		wait 700
		stopsound
		playsound sound/scenaric/intro/stop.wav
	}
}
