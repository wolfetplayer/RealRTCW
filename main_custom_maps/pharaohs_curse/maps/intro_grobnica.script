	{
		gotomarker kolona_1_pos2 60000
		faceangles 360 360 360 gototime
	}
	trigger go
	{
		alertentity kolona_1_start
		gotomarker kolona_pos2 300
		faceangles 280 290 300 gototime
		gotomarker kolona_pos1 100
		faceangles 180 200 90 gototime
		gotomarker kolona_1_pos1 300
		faceangles 0 0 0 gototime
		playsound sound/world/stones/sqish1.wav
		alertentity kolona_1_stop
	}
}



