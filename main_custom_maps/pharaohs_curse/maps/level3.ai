player
{
	spawn
	{
		accum 0 set 0
		mu_fade 0 5000
		mu_queue  sound/scenaric/miks/main_menu.wav
	}
	playerstart
	{
		mu_stop 1000
		mu_queue sound/music/level3/level3.wav

		#if g_level_was_selected >= 1
		applyloadout mid_game
		#endif
		cvar g_level_was_selected 0
	}
	trigger scene1
	{
		alertentity zombi_alfa1
		wait 1000
		alertentity zombi_alfa2
	}
	trigger scene2
	{
		alertentity zombi_alfa3
		wait 1000
		alertentity zombi_alfa4
	}
	trigger scene3
	{
		alertentity zombi_alfa5
	}

	trigger scene4
	{
		alertentity zombi_alfa6
	}
	trigger scene5
	{
		alertentity zombi_alfa7
	}
	trigger scene6
	{
		alertentity zombi_alfa8
	}
	trigger scene7
	{
		alertentity zombi_alfa9
	}
	trigger scene8
	{
		alertentity zombi_alfa10
	}
	trigger scene9
	{
		alertentity war1
		alertentity war2
		alertentity war1_1
		alertentity war2_1
		alertentity war3
		alertentity war4
	}

	trigger scene10
	{
		trigger door1 go1
		wait 1000
		alertentity zombi_alfa11
		alertentity zombi_alfa12
		alertentity zombi_alfa13
	}

	trigger scene11
	{
		trigger door2 go1
		wait 1000
		alertentity zombi_alfa14
		alertentity zombi_alfa15
		alertentity zombi_alfa16
	}
	trigger scene12
	{
		alertentity zombi_alfa17
		alertentity zombi_alfa18
		alertentity zombi_alfa19
	}
	trigger scene13
	{
		alertentity zombi_alfa20
		alertentity zombi_alfa21
		alertentity zombi_alfa22
	}
	trigger scene14
	{
		alertentity zombi_alfa23
		alertentity zombi_alfa24
		alertentity zombi_alfa25
	}
	trigger scene15
	{
		alertentity war7
		alertentity war8
		alertentity war9
		alertentity war10
		alertentity war11
		alertentity war12
		alertentity war13
		alertentity war14
		alertentity sps_start
		trigger war7 go
		wait 300
		trigger war8 go
		wait 300
		trigger war9 go
		wait 300
		trigger war10 go
		wait 300
		trigger war11 go
		wait 300
		trigger war12 go
		wait 300
		trigger war13 go
		wait 300
		trigger war14 go
	}


	trigger scene16
	{
		trigger door3 go1
		wait 1000
		alertentity zombi_alfa26
		wait 600
		alertentity zombi_alfa30
	}




	trigger scene17
	{
		alertentity zombi_alfa32
	}
	trigger scene18
	{
		alertentity zombi_alfa33
		alertentity zombi_alfa34
		alertentity zombi_alfa35
	}
	trigger scene19
	{
		alertentity zombi2
		alertentity zombi_start2
		wait 200
		trigger zombi2 go1
	}








	trigger death_s9
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 6
		trigger door1 go
		accum 0 set 0
	}
	trigger death_s10
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 3
		accum 0 set 0
		alertentity war5
		alertentity war6
		alertentity war5_1
		alertentity war6_1

	}
	trigger death_s11
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 4
		accum 0 set 0
		trigger door2 go
	}
	trigger death_s12
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 12
		accum 0 set 0
		trigger player scene15
	}
	trigger death_s13
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 8
		accum 0 set 0
		trigger door3 go
	}

	trigger death_s14
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 6
		accum 0 set 0
		alertentity zombi1
		alertentity zombi_start1
		wait 200
		trigger zombi1 go1
	}
	trigger death_s15
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 3
		accum 0 set 0
		trigger door_ends go
	}
	trigger fineshed
	{
		lockplayer off
		changelevel level4 persistent
	}

}
