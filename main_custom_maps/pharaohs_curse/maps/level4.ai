player
{
	spawn
	{
		accum 0 set 0
		accum 1 set 0
		mu_fade 0 5000
		mu_queue  sound/scenaric/miks/main_menu.wav
	}
	playerstart
	{
		mu_stop 1000
		mu_queue sound/music/level4/level4.wav

		#if g_level_was_selected >= 1
		applyloadout mid_game
		#endif
		cvar g_level_was_selected 0
	}

	trigger scene1
	{
		alertentity war1
		alertentity war3
		alertentity war6
		alertentity war8
	}
	trigger scene2
	{
		alertentity war9
		alertentity war10
	}
	trigger scene3
	{
		trigger door3 go1
		wait 1000
		alertentity d1_explo
		alertentity war17
		alertentity war18
		alertentity war19
	}

	trigger scene4
	{
		alertentity d3_explo
		alertentity war23
		alertentity war24
		alertentity war25
	}

	trigger scene5
	{
		alertentity war29
		alertentity war30
		alertentity war31
		alertentity war32
		alertentity war33
		alertentity war34
	}
	trigger scene6
	{
		alertentity war11
		alertentity war12
		alertentity war13
		alertentity war14
		alertentity war15
		alertentity war16
	}
	trigger scene7
	{
		alertentity but1_action
		trigger door1 go
	}
	trigger scene8
	{
		trigger door1 go1
		alertentity zombi_afa1
		alertentity zombi_afa2
	}
	trigger scene10
	{
		alertentity zombi_afa4
	}
	trigger scene12
	{
		alertentity zombi_afa6
		alertentity zombi_afa8
	}
	trigger scene13
	{
