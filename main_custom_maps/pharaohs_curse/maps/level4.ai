	}
	trigger scene15
	{
		alertentity zombi_afa12
	}
	trigger scene16
	{
		trigger door4 go
		alertentity zombi_afa14
	}
	trigger scene17
	{
		alertentity zombi_afa16
	}
	trigger scene18
	{
		alertentity zombi_afa18
	}
	trigger scene19
	{
		trigger door2_1 go
		trigger door2_2 go
		trigger potolok go
	}
	trigger scene20
	{
		alertentity zombi_afa21
		alertentity zombi_afa22
	}
	trigger scene21
	{
		alertentity zombi_afa24
		alertentity zombi_afa25
		alertentity zombi_afa26
	}
	trigger scene22
	{
		alertentity zombi_afa28
	}


	trigger scene23
	{
		alertentity d_1
		alertentity zombi_afa29
	}

	trigger scene24
	{
		alertentity zombi_afa30
	}
	trigger scene25
	{
