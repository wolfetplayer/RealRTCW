	{
		alertentity war36
		alertentity war37
		alertentity war38
		alertentity war39
		alertentity war40
		alertentity war41
	}













	trigger death_s1
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 3
		alertentity d2_explo
		alertentity war20
		alertentity war21
		alertentity war22
		accum 0 set 0
	}
	trigger death_s2
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 3
		alertentity d4_explo
		alertentity war26
		alertentity war27
		alertentity war28
		accum 0 set 0
	}

	trigger death_s3
	{
		accum 1 inc 1
		accum 1 abort_if_not_equal 18
		trigger door3 go
		accum 1 set 0
	}

	trigger death_s4
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 6
		trigger door3 go
		accum 0 set 0
	}
	trigger death_s5
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 8
		trigger door4 go1
		accum 0 set 0
	}
	trigger death_s6
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 3
		trigger door4 go1
		accum 0 set 0
	}
	trigger death_s7
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 6
		alertentity d_1
		accum 0 set 0
	}
	trigger death_s8
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 9
		alertentity d_2
		accum 0 set 0
	}

	trigger death_s9
	{
		accum 0 inc 1
		accum 0 abort_if_not_equal 6
		teleport player_pos1
		alertentity player1
		trigger player1 go
		startcam l4_1
		wait 5500
		alertentity door_end_level_open
		stopcam
		startcam l4_2
		wait 9000
		changelevel level5 persistent
	}

}


