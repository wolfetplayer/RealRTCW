trigger endmap
	{

		changelevel pro11 persistent
	}

 trigger aaa
{
mu_fade 0 1500
	mu_queue sound/music/m_situation
}

trigger bbb
{
mu_fade 0 1500
	mu_queue sound/music/x_military
}

trigger ccc
{
