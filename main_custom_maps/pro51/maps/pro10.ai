player
{
  spawn
  {
  mu_start sound/music/x_military
  trigger lift start

  }
  playerstart
  {

		#if g_level_was_selected >= 1
		applyloadout pro10
		#endif
		cvar g_level_was_selected 0
  }

  trigger bum
  {
	  trigger roket start
 }

  trigger two
  {
	  trigger ruk2 start
 }
 trigger krant
 {
	 missionfailed
 }
 trigger fin
 {
	 missionfailed
 }

 trigger zap
 {
	 alertentity b1
	 wait 500
	 alertentity b2
	 wait 300
	 alertentity b3
	 wait 300
	 alertentity b4
	 wait 300
	 alertentity b5
	 wait 300
	 alertentity b6
	 wait 300
	 alertentity b7
}

trigger kadr1
{
	startcam p10x1
	wait 4500
	stopcam
}

trigger kadr2
{
	startcam p10x2
	wait 3700
	stopcam
	trigger player endmap
}
