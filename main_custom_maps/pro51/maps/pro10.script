 }

 roket
{
	spawn
	{
     gotomarker bu1 50
     faceangles 0 0 0 gototime
	}


	trigger start
	{


        trigger player kadr2
		gotomarker bu2 100
		faceangles 0 0 0 gototime
		trigger ruk2 zap
		gotomarker bu3 200
		faceangles 0 0 0 gototime


	}




}