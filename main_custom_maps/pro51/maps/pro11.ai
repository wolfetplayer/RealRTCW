        setammo ammo_9mm 999
		trigger naz2 start
	}

	trigger start
	{
	   walktomarker n2s1
	   facetargetangles n2s1
	   wait 200
	   walktomarker n2s2
	   facetargetangles n2s2
	   wait 200
	   trigger naz2 start 
    }
    
	enemysight player
	{
    resetscript
	}

	death
	{
		
	}
	
}

naz3
{
	attributes
	{
		hearing_scale 0.5
		fov 60
	}

	spawn
	{
			  giveweapon weapon_mauserrifle
	  setammo ammo_792mm 999
	  selectweapon weapon_mauserrifle
		trigger naz3 start
	}
	
	trigger action1
	{
		clearanim
        resetscript
        cigarette off
		attrib fov 360
		gotocast player
	}

	trigger start
	{
	   cigarette on
	   playanim smoking torso forever
    }
    
    enemysight player
	{
		clearanim
        resetscript
        cigarette off
	}

	death
	{
		
	}
}

