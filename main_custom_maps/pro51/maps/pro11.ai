// oficerss ===========================================

of1
{
	attributes
	{
		idle_crouch 0.0
		attack_crouch 0.5
	}

	spawn
	{
        takeweapon all
        giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		statetype alert
	}

    enemysight player
	{
		resetscript		// resume normal combat now
	}

 	death
	{


	}

}

