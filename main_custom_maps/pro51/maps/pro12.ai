player
{
  spawn
  {
  mu_start sound/music/x_military

  //giveweapon weapon_knife
  //giveweapon weapon_sten

  //giveweapon weapon_mauserrifle
  //giveweapon weapon_sniperscope
  //giveweapon weapon_mp40
  //setammo ammo_9mm 200
  //selectweapon weapon_mp40


  }
  playerstart
  {

		#if g_level_was_selected >= 1
		applyloadout pro12
		#endif
		cvar g_level_was_selected 0
  }

  trigger open
  {
	  trigger gate start
 }

  trigger two
  {
	  trigger ruk2 start
 }
 trigger krant
 {
	 missionfailed
 }
 trigger fin
 {
	 missionfailed
 }



trigger kadr1
{
	startcam p12x1
	wait 15000
	stopcam
}

trigger kadr2
{
	startcam p12x2

}
trigger kadr3
{
	startcam p12x3

}

trigger kadr4
{
	startcam p12x4

}
trigger kadr5
{
	startcam p12x5
	wait 30000
	startcam p12x5
	wait 30000
	startcam p12x5
	wait 30000
	startcam p12x5
	wait 20000
	achievement_pro51
		changelevel
		wait 9000
		endgame


}

trigger fly
{
	wait 500
	trigger ass start
}






trigger endmap
	{

		changelevel pro11 persistent
	}

