//
//AI Scripting
//Map: pro2 (forest)

//Last edited by: WolfETPlayer
//



player
{

spawn
	{


		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/l_briefing_1

		giveweapon weapon_knife
		giveweapon weapon_knife
		giveweapon weapon_knife
		
		giveweapon weapon_sten
		giveweapon weapon_revolver

		setammo ammo_9mm 72
		setammo ammo_revolver full

		setclip weapon_revolver full
		setclip weapon_sten full

		setarmor 25
		giveinventory key_binocs

		#if g_dlc1 == 1
		giveweapon weapon_delisle
		setammo ammo_45cal 120
		setclip weapon_delisle full	
	    #endif

		selectweapon weapon_sten
        trigger kino1 start
	}

//kino====================
trigger kadr1
 {
	 startcam pro2x1
 }
 trigger kadr2
 {
	 startcam pro2x2
	 trigger of1 move1
 }
 trigger kadr3
 {
	 startcam pro2x3
	 trigger naz1 move1
 }

 trigger kadr4
 {
	 startcam pro2x4
	 trigger of1 move2
     wait 5000
     stopcam
     mu_fade 0 1000
	 mu_queue sound/music/m_stealth
 }


//}
//end_kino===============

trigger action1
     {
     alertentity naz3
     alertentity naz4
     }

trigger action2
     {

     mu_fade 0 1000
	 mu_queue sound/music/s_bighits

	 startcam pro2x5


     trigger trak1 begin
     wait 11000
     mu_fade 0 1000
     mu_queue sound/music/m_stealth

     //wait 22000
     //stopcam

	 savecheckpoint

     }



 trigger skadr1
     {

	  stopcam
  }

trigger action3
     {
     alertentity naz9
     alertentity naz10
     alertentity naz11

     }
trigger action4
     {
     alertentity naz12
     alertentity naz12x
     }

 trigger action5
     {
     alertentity naz13
     alertentity naz14
     alertentity naz15
     alertentity naz14x
     alertentity naz15x

	 savecheckpoint

     }

trigger action6
     {
     alertentity naz16


     }

trigger action7
     {
     alertentity naz17
     alertentity naz18
     alertentity naz19
     alertentity naz20
     alertentity naz21
     alertentity naz22

	 savecheckpoint
     }

trigger action8
     {
     alertentity naz17x
     alertentity naz18x
     alertentity naz19x
     }

trigger action9
     {
     alertentity naz20x
     alertentity naz21x
     alertentity naz22x
     }

trigger action10
     {
     alertentity of3
     }

trigger action11
     {
     alertentity naz23
     alertentity naz24
     alertentity naz25
     alertentity naz26
     alertentity naz27
	 
	 savecheckpoint
     }
trigger action12
     {
     alertentity naz28
     alertentity naz29
     alertentity naz30
     alertentity naz31
     alertentity naz32
     alertentity of4

     }

 trigger action13
     {
	 mu_fade 0 1000
	 mu_queue sound/music/s_longout
	 startcam pro2x6
     trigger trak2 begin
     wait 15000
     mu_fade 0 1000
     mu_queue sound/music/m_situation
     //wait 22000
     //stopcam

     }

 trigger skadr2
     {
	  stopcam
  }





trigger endmap
	{
		changelevel pro3 persistent
	}


}

//post1=========================

of1
{
	attributes
	{

		idle_crouch 0.0
		attack_crouch 0.0
        fov 360


	}

	spawn
	{
		accum 0 bitreset 0

        giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

      trigger move1
      {
      playanim looking_over_table torso
      wait 5000
      clearanim
      gotomarker o1
      facetargetangles o1

      }
       trigger move2
      {
      wait 100
      playanim giving_orders torso
      playsound sound/pro2/pro2x1.wav




      }


           enemysight player
	{
		resetscript		// resume normal combat now
	}

 	death
	{


	}

	}


naz1
{
	attributes
	{

		idle_crouch 0.0
		attack_crouch 0.0
		fov 360

	}

	spawn
	{

	}

      trigger move1
      {
      gotomarker n1
      playanim nazi_salute both

      playsound sound/pro2/pro2x2.wav
      }


           enemysight player
	{
		resetscript		// resume normal combat now
	}

 	death
	{


	}

	}


naz2
