	}

      trigger post
      {
      walktomarker n2a
      wait 100
      facetargetangles n2a
      walktomarker n2b
      wait 100
      facetargetangles n2b
      wait 100
      trigger naz2 post
       }

           enemysight player
	{
		resetscript		// resume normal combat now
	}

