//trak3===========================
trak3
{
	spawn
	{
      wait 100
      gotomarker trak3x 100\\ISPR
	faceangles 0 0 0 gototime
	}


	trigger begin
	{

		playsound sound/world/shift_01.wav looping
		trigger lweel3 begin
		trigger rweel3 begin
		trigger 4well3 begin



		gotomarker tr2x 160
	      faceangles 0 0 0 gototime
	      gotomarker trak3a 160
	      faceangles 0 0 0 gototime


        playsound sound/world/idle_01.wav looping
        trigger lweel3 stop
		trigger rweel3 stop
		trigger 4well3 stop
            alertentity naz37
            alertentity naz38
            alertentity naz39
            alertentity naz40
            alertentity of6

	}
}

