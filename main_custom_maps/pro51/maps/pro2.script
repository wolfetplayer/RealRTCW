kino1
{
	spawn
	{
	}

	trigger start
	{


		trigger player kadr1
		wait 29000
		trigger player kadr2
		wait 5000
		trigger player kadr3
		wait 8000
		trigger player kadr4







}
}





trak1
{
	spawn
	{
      wait 100
      gotomarker tr1x 100\\ISPR
	faceangles 0 270 0 gototime
	}


	trigger begin
	{

		playsound sound/world/shift_01.wav looping
		trigger lweel1 begin
		trigger rweel1 begin
		trigger 4well1 begin


		gotomarker tr1a 1000
	      faceangles 0 270 0 gototime

		gotomarker tr1b 160
		faceangles 0 270 0 gototime
		gotomarker tr1c 80
		faceangles 0 270 0 gototime
        playsound sound/world/idle_01.wav looping
        trigger lweel1 stop
		trigger rweel1 stop
		trigger 4well1 stop
		trigger player skadr1
            alertentity naz5
            alertentity naz6
            alertentity naz7
            alertentity naz8
            alertentity of2

	}
}

lweel1
{

spawn
{
attachtotag trak1 tag_w1
}

trigger begin
	{

		wait 5
		playanim 0 20 looping forever

	}
trigger stop
	{

		playanim 0 10 10000
	}

}

