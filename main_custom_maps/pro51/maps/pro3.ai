//
//AI Scripting
//Map: pro3 (town)

//Last edited by: WolfETPlayer
//

player
{

spawn
	{
		abort_if_loadgame
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/m_grave
		giveinventory key_binocs
        trigger player bazar
	}
trigger bazar
{
	lockplayer on
	trigger chek start
}

trigger endbazar
{
	lockplayer off
	
		#if g_dlc1 == 0			
		giveweapon weapon_m97
		setammo ammo_m97ammo 30
        setclip weapon_m97 full
		selectweapon weapon_m97	
	    #endif	

		#if g_dlc1 == 1	
		giveweapon weapon_auto5
		setammo ammo_m97ammo 50
        setclip weapon_auto5 full
		selectweapon weapon_auto5	
	    #endif	
}



trigger action1
     {

     alertentity naz4
     }

trigger action2
     {

     alertentity naz5
     alertentity naz6
     alertentity naz7

	 savecheckpoint

     }
trigger action3
     {


     alertentity naz8
     alertentity of2


     }

trigger action4
     {

     alertentity naz9
     alertentity naz10
     alertentity naz11
     }

trigger action5
     {


     alertentity naz12
     alertentity naz13
     alertentity naz12x
     alertentity naz13x
     alertentity of3

	 savecheckpoint

     }

trigger action6
     {

     alertentity naz14
     alertentity naz15
     alertentity naz16
     alertentity naz15x
     alertentity naz16x
     alertentity naz17
     alertentity naz18

     }

 trigger action7
     {
     alertentity naz17x
     alertentity naz18x
     alertentity naz17y
     alertentity naz18y

	 savecheckpoint

     }
trigger action8
     {
     alertentity naz19


     }

trigger action9
     {
     alertentity naz20
     alertentity naz21
     alertentity naz22


     }

trigger action10
     {
     alertentity naz23
     alertentity naz24
     alertentity naz25y
     alertentity naz26y


     }

 trigger action11
     {
     alertentity naz27
     alertentity naz28
     alertentity naz29
     alertentity naz30
     alertentity of5

	 savecheckpoint


     }

 trigger action12
     {
     alertentity naz31
     alertentity naz32



     }

  trigger action13
     {
     alertentity kes1




     }

 trigger action14
     {
     trigger chek fin




     }











trigger endmap
	{
		changelevel pro4 persistent
	}


}

//kesler================================

kes
{
	attributes
	{


		walking_speed 105
		running_speed 175
		aggression 0.4
		alertness 1024
		idle_crouch 0.0
		attack_crouch 0.25
		starting_health 100
		tactical 1.0
		fov 360

	}

	spawn
	{
		//nosight 999999
		takeweapon all
		noavoid
		wait forever 0 player


		explicit_routing on



	}

	trigger  bazar1
	{
	    wait 100
	    playanim giving_orders torso
		playsound sound/pro3/kes1.wav
	}
	trigger  bazar2
	{
	    wait 100
	    playanim giving_orders torso
		playsound sound/pro3/kes2.wav
	}
	trigger  bazar3
	{
	    wait 100
		playsound sound/pro3/kes3.wav
		wait 200
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		alertentity of1
		alertentity naz1

	}
	trigger  bazar4
	{
	    wait 100
	    playanim giving_orders torso
		playsound sound/pro3/kes4.wav
	}






	death
	{
		missionfailed 6 3
	}

}

kes1
{
	attributes
	{


		walking_speed 105
		running_speed 175
		aggression 0.4
		alertness 1024
		idle_crouch 0.0
		attack_crouch 0.25
		starting_health 900
		tactical 1.0
		fov 360

	}

	spawn
	{
		//nosight 999999
        takeweapon all
		noavoid
		wait forever 0 player
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger


		explicit_routing on



	}

	trigger  bazar
	{
	    wait 100
	    playanim giving_orders torso
		playsound sound/pro3/kes5.wav
	}

	death
	{
		missionfailed 6 3
	}

}


naz1
{
	attributes
	{
	}

	spawn
	{
      giveweapon weapon_mp40
      setammo ammo_9mm 999
      gotocast player
      noavoid
	}


           enemysight player
	{
		resetscript		// resume normal combat now
	}

 	death
	{

      trigger chek kil1
	}

	}
