player
{

spawn
	{
		abort_if_loadgame
		mu_start sound/music/m_tension
	}
	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout pro4
		#endif
		cvar g_level_was_selected 0
     }
trigger tr
{
trigger truckn1 start
}
trigger vorota
{
trigger handle start
}
trigger cadr1
{
startcam xxx
wait 8000
stopcam
}
trigger endmap
	{
		changelevel pro5 persistent
	}

trigger autox
{
	trigger auto start
}

trigger piz
{
missionfailed	
}	
	
trigger fff
{
trigger auto serena
}
trigger fal
{
mu_stop 100
mu_start sound/pro4/klaxon.wav

}
	

trigger action1
{
alertentity of2

savecheckpoint
}

trigger action2
{
alertentity naz5
alertentity naz6
}

trigger action3
{
alertentity naz7
alertentity of3
alertentity naz10

savecheckpoint
}

trigger action4
{
alertentity naz8
}

trigger action5
{
alertentity naz9
alertentity naz15

savecheckpoint
}

trigger action6
{
alertentity naz11
alertentity naz12
alertentity naz13
}

trigger action7
{
alertentity naz14
}

trigger action8
{
alertentity of4

savecheckpoint
}

trigger action9
{
alertentity meh1
}

trigger action10
{
alertentity of5
alertentity naz17
trigger naz15 start3
}

trigger stop
{
	lockplayer on
}

}


//nazi=========================================================

naz1
{
	attributes
	{
		hearing_scale 0.2
		fov 90
	}

	spawn
	{
		trigger naz1 start
	}

	trigger start
	{
	   cigarette on
	   playanim smoking torso forever
    }
    
	bulletimpact
	{
		playsound blank
		clearanim
		resetscript
		cigarette off
		trigger player fff
	}

	inspectsoundstart
	{
		playsound blank
		clearanim
		resetscript
		cigarette off
        trigger player fff
	}

	inspectbodystart
	{
		playsound blank
		clearanim
		resetscript
		cigarette off
        trigger player fff
	}
	
	enemysight player
	{
		playsound blank
		clearanim
		resetscript
		cigarette off
		trigger player fff
	}

	death
	{
	}
}

