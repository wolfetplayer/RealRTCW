truckn1
{
	spawn
	{
      wait 100
      gotomarker tr1 100\\ISPR
	  faceangles 0 180 0 gototime
	}

	trigger start
	{
		playsound sound/world/shift_01.wav looping
		trigger lwheel1 begin
		trigger rwheel1 begin
		trigger 4whells1 begin

		gotomarker tr1 1000
	    faceangles 0 180 0 gototime

		gotomarker tr2 200
		faceangles 0 180 0 gototime

        gotomarker tr3 100
		faceangles 0 160 0 gototime
        gotomarker tr4 80
		faceangles 0 135 0 gototime
        gotomarker tr5 80
		faceangles 0 110 0 gototime
        gotomarker tr6 80
		faceangles 0 90 0 gototime
        gotomarker tr7 200
		faceangles 0 90 0 gototime
		
        playsound sound/world/idle_01.wav looping
      	trigger rwheel1 stop
        trigger lwheel1 stop
		trigger 4whells1 stop
	}
}

lwheel1
{
spawn
{
attachtotag truckn1 tag_w1
}

trigger begin
	{

		wait 5
		playanim 0 20 looping forever

	}
trigger stop
	{

		playanim 0 10 10000
	}

}

