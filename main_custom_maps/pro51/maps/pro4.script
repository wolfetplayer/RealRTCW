}

trigger begin
	{

		wait 5
		playanim 0 20 looping forever
	}

trigger stop
	{

		playanim 0 10 10000
	}

}


4whells1
{

spawn
{
attachtotag truckn1 tbwheels
}

trigger begin
	{

		wait 5
		playanim 0 20 looping forever


	}
trigger stop
