naz1
{
	attributes
	{
	idle_crouch 0.0
	attack_crouch 0.4
	alertness 0
	aggression 1.0
	}

	spawn
	{
      giveweapon weapon_mp40
      setammo ammo_9mm 999
	}

	trigger go
	{
    walktomarker n1
    }
    trigger start
    {
	attrib alertness 1600
    }
    enemysight player
	{
		resetscript		// resume normal combat now
	}

 	death
	{


	}

	}

