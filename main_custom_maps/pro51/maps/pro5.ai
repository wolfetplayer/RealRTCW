//
//AI Scripting
//Map: rock (camp)

//Last edited by: WolfETPlayer
//



player
{
  spawn
  {
  mu_start sound/music/m_drums
  objectivesneeded 2
  abort_if_loadgame
  trigger ctrak begin
  trigger dor1 start
  trigger dor2 start
  }
  playerstart
  {

		#if g_level_was_selected >= 1
		applyloadout pro5
		#endif
		cvar g_level_was_selected 0
  }
trigger stop
{
	lockplayer on
}

trigger start
{
	lockplayer off
}


trigger ru1go
{
trigger handel1 start
}

trigger ru2go
{
trigger ruchka2 start
}

trigger ru3go
{
trigger handel3 start
}

trigger bum
{
trigger stvol start
objectivemet 1

}

trigger plan
{
trigger dok start
objectivemet 2

}

trigger kadr2
{
	startcam p5x2
	wait 2700
	stopcam
}

trigger kadr3
{
	startcam p5x5
	wait 3500
	stopcam
}

trigger kadr1
{
	startcam p5x1
	wait 2700
	stopcam
}
trigger aaa
{
mu_fade 0 1500
	mu_queue sound/music/m_situation
}

trigger action
{
	trigger player aaa
	alertentity naz2
	alertentity naz3
	alertentity naz4
	trigger naz1 start
	alertentity naz13
	alertentity naz14
	alertentity of1
}

trigger action1
{
	alertentity naz5
	alertentity naz6
}

trigger action2
{
	alertentity naz7
	alertentity naz8
	alertentity naz9
	alertentity naz15

	savecheckpoint
}

trigger action3
{
	alertentity naz10
	alertentity naz11
	alertentity naz12
}



trigger action5
{
	alertentity naz16
	alertentity naz17
	alertentity naz18
}

trigger action6
{
	alertentity naz19
	alertentity naz20
	alertentity naz21
	alertentity naz22
}



trigger action7
{
	alertentity naz23
	alertentity naz24
	alertentity naz26
	alertentity naz27
	alertentity naz25

	savecheckpoint

}

trigger action8
{
alertentity naz28
}

trigger action9
{
	alertentity naz29
	alertentity of2
}

trigger action10
{
	alertentity naz30
	alertentity naz31
	alertentity naz32
	alertentity naz40

	savecheckpoint
}

trigger action11
{
	alertentity naz41
	alertentity naz42
}

trigger action12
{
	alertentity naz43
	alertentity naz44
	alertentity naz45
}

trigger action13
{
	alertentity of4
	alertentity naz46
	alertentity naz47
	alertentity naz48

	savecheckpoint

}



trigger endmap
	{

		changelevel pro6 persistent
	}


trigger fal
{
	missionfailed
}

 }

