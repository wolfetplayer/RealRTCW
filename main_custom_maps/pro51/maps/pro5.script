

dor1
{
	spawn
	{
	}


	trigger start
	{
		wait 50
		playsound sound/scenaric/rocket/bridge_creak1.wav looping
		faceangles 0 -90 0 10
		stopsound
	}

	trigger close
	{
		wait 50
		trigger dor2 close
		playsound sound/scenaric/rocket/bridge_creak1.wav looping
		faceangles 0 0 0 2000
		stopsound
	}
}

