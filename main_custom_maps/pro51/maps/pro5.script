vor1
{
	spawn
	{
     gotomarker v1a 50
     faceangles 0 0 0 gototime
	}


	trigger start
	{
        trigger player kadr1
        trigger vor2 start
		gotomarker v1b 20
		faceangles 0 0 0 gototime

	}


}

