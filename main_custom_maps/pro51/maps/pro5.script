ctrak
{
	spawn
	{


	}


	trigger begin
	{
        trigger player stop
		playsound sound/world/shift_01.wav looping
		wait 100
		gotomarker ct1 80
	    faceangles 0 90 0 gototime

		gotomarker ct2 80
		faceangles 0 90 0 gototime
		stopsound
		playsound sound/world/idle_01.wav looping
		wait 5000
		stopsound
		playsound sound/world/shift_01.wav looping
		gotomarker ct3 50
		faceangles 0 90 0 gototime
		trigger dor1 close
		trigger naz1 go
		gotomarker ct4 45
		faceangles 0 120 0 gototime
		gotomarker ct5 40
		faceangles 0 150 0 gototime
		gotomarker ct6 40
		faceangles 0 180 0 gototime
		gotomarker ct7 40
		faceangles 0 210 0 gototime
		gotomarker ct8 40
		faceangles 0 240 0 gototime
		gotomarker ct9 40
		faceangles 0 270 0 gototime
		stopsound
		playsound sound/world/idle_01.wav looping
		wait 2000
		stopsound
		playsound sound/world/shift_01.wav looping
		gotomarker ct10 40
		faceangles 0 270 0 gototime
		gotomarker ct11 40
		faceangles 0 270 0 gototime
		stopsound
		playsound sound/world/idle_01.wav looping
        trigger player start
        trigger player action










	}
}

