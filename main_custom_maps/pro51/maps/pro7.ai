player
{

spawn
	{
		//abort_if_loadgame
		mu_start sound/music/m_stealth

		applyloadout pro7
	}
	playerstart
	{
		cvar g_level_was_selected 0
    }

trigger action2
{
    alertentity naz9
    alertentity naz10
    
}

trigger action3
{
    alertentity naz11
    alertentity naz13
    alertentity naz14
    alertentity naz15
    alertentity naz16
    alertentity naz17
    alertentity naz18

	savecheckpoint
}

trigger action4
{
    alertentity naz19
    alertentity naz20
    alertentity naz21
    alertentity naz22
    alertentity naz23
    alertentity of2
    alertentity naz19x
    alertentity naz20x
    alertentity naz21x
    alertentity naz24x
    alertentity of2x

	savecheckpoint
}

trigger action5
{
    alertentity naz24
    alertentity naz25
    alertentity naz26
    alertentity naz27
    alertentity naz28
}

trigger action6
{
    alertentity naz29
    alertentity naz30
}

trigger action7
{
    alertentity naz31
    alertentity naz32
    alertentity naz34
    alertentity naz35

    alertentity naz35
    alertentity naz36

	savecheckpoint
}

trigger action10
{
    alertentity naz37
    alertentity naz38
    alertentity naz39
    alertentity naz40
    alertentity naz41
    alertentity of3
    alertentity of4
}
trigger endmap
	{

		changelevel pro8 persistent
	}

}

