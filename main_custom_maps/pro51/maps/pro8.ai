of1
{
	attributes
	{


	    aim_accuracy 0.5
		starting_health 50
		reaction_time 0.1
		idle_crouch 0.0
		attack_crouch 0.0
        fov 30


	}

	spawn
	{
		accum 0 bitreset 0

        giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		trigger of1 move1
	}

      trigger move1
      {
	  zoom on

      playanim binocular torso forever



      }
       trigger move2
      {
      wait 1000
      clearanim
      zoom off
      facetargetangles o1
      playanim giving_orders torso
      playsound sound/scenaric/general/misc_american2.wav
      wait 500
      trigger naz1 move1
       wait 2000
	  alertentity alarm
	  wait 20000
	  facetargetangles o2
	  playanim scratching_chest both forever




      }


           enemysight player
	{

	}

 	death
	{


	}

	}

