player
{
  spawn
  {
  mu_start sound/music/m_mission
  giveweapon weapon_mp40
  setammo ammo_9mm 50
  selectweapon weapon_mp40
  trigger dzot start
  }
  playerstart
  {

  }
  trigger bomb
  {
	mu_start sound/pro8/bomba.wav
  }
  trigger film0
  {
	  startcam p8x0
  }

  trigger film1
  {
	  startcam p8x1
  }
  trigger film2
  {
	  startcam p8x2
  }
  trigger film4
  {
	  startcam p8x4
  }
  trigger film4a
  {
	  startcam p8x4a
  }

  trigger film5
  {
	  startcam p8x5
	  wait 1000

	  trigger luk1 start
  }
  trigger film10
  {
	  startcam p8x10
  }
  trigger film11
  {
	  startcam p8x11
  }
  trigger film15
  {
	  startcam p8x15
  }
  trigger film20
  {
	  startcam p8x20
  }
   trigger film21
  {
	  startcam p8x21
  }
   trigger film22
  {
	  startcam p8x22
  }
   trigger film23
  {
	  startcam p8x23
  }
   trigger film24
  {
	  startcam p8x24
  }
   trigger film25
  {
	  startcam p8x25
  }
  trigger film30
  {
	  mu_start sound/music/m_mission
	  startcam p8x30
  }
 trigger film26
  {
	  startcam p8x5

	  trigger luk1 fin

  }

   trigger endmap
  {
	  changelevel pro9 persistent
  }





 }




