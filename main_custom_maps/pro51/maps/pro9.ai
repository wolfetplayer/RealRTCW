player
{
  spawn
  {
  mu_start sound/music/m_drums

  }
  playerstart
  {

  }

  trigger aaa
{
mu_fade 0 1500
	mu_queue sound/music/m_assault
}

 trigger bbb
{
mu_fade 0 1500
	mu_queue sound/music/x_military
}

trigger ccc
{
mu_fade 0 1500
	mu_queue sound/music/x_action
}
  trigger open
  {
	  trigger ruk start
  }

  trigger niz
  {
	  trigger op1 cl
  }

  trigger action1
  {
	  alertentity of1
	  alertentity naz1
	  alertentity naz2
  }

  trigger action2
  {
	  trigger player aaa
	  alertentity naz3
	  alertentity naz4
	  alertentity naz5

	  savecheckpoint
  }

   trigger action3
  {
	  alertentity of2
	  alertentity naz6
	   alertentity naz7
  }

  trigger action4
  {

	  alertentity naz8
	  alertentity naz9
  }

  trigger action5
  {
	  alertentity naz10
	  alertentity naz11
	  alertentity of3

	  savecheckpoint
  }

   trigger action6
  {
	  alertentity naz12
	  alertentity naz13
	  alertentity naz14
  }

   trigger action7
  {
	  alertentity naz15
	  alertentity naz16

  }

  trigger action8
  {
	  alertentity g1
	  alertentity of4
	  alertentity naz17
	  alertentity naz18

	  savecheckpoint

  }

    trigger action9
  {
	  alertentity naz19
	  alertentity naz20

  }

    trigger action10
  {
	  alertentity naz21
	  alertentity naz22
	  alertentity naz23
	  alertentity naz24
  }

   trigger action11
  {
	  alertentity naz25
	  alertentity naz26
	  alertentity naz27

	  savecheckpoint

  }

   trigger action12
  {
	  alertentity naz28
	  alertentity naz29

  }

  trigger action13
  {
	  alertentity g2
	  alertentity naz30
	  alertentity naz31

  }

    trigger action14
  {
	  alertentity naz32
	  alertentity of5
	  alertentity of6
	  alertentity of7
	  trigger player fau
  }

    trigger  fau
  {
	  alertentity fau1
	  wait 2000
	  alertentity fau2

  }

    trigger action15
  {
	  alertentity naz33
	  alertentity naz34

	  savecheckpoint

  }
    trigger action16
  {
	  trigger player bbb
	  alertentity ven1

  }

    trigger action17
  {
	  alertentity ven2

  }

     trigger action18
  {

	  alertentity naz35
	  alertentity naz36
	  alertentity of8
	  alertentity of9

	  savecheckpoint
  }



trigger endmap
	{

		changelevel pro10 persistent
	}




 }


