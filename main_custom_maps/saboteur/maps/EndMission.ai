//
//AI Scripting
//Map: EndMission
//Last edited by: Dan
//

player
{
	spawn
	{
		cvar g_episode 1010
		objectivesneeded 1
		
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}
	playerstart
	{
		mu_fade 0 1000
		mu_queue sound/music/l_briefing_1

		// Weapons
		// Ammo
		// Items
//		trigger start go1
//		trigger counter2 loudspeaker1
		trigger player cinema1
	}
	trigger stand
	{	
		trigger cine1_nazi1 action1
		mu_fade 0 1000
		mu_queue sound/music/m_moving

	}
	trigger cinema1
	{	
		trigger player cam3
		trigger cine1_nazi1 go
	}
	trigger dead
	{
		stopcam
	}
	trigger fail
	{
		missionfailed
	}
	trigger win
	{
		trigger start go1
		alertentity fake_bj 
	}
	trigger return
	{
		trigger vazi1 start
	}
	trigger action1
	{
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
	}
	trigger action2
	{
		alertentity nazi9
		alertentity nazi10
		alertentity scientist2
		alertentity scientist3
	}
	trigger action3
	{
		alertentity nazi11
	}
	trigger action4
	{
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
	}
	trigger action5
	{
		alertentity nazi16
		alertentity nazi17
	}
	trigger action6
	{
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
	}
	trigger action7
	{
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
	}
	trigger action8
	{
		alertentity nazi24
		objectivemet 1
	}
	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}
	trigger cino
	{
		trigger player cam1
	}
	trigger endmap
	{
		changelevel
		wait 9000
		endgame
	}
	trigger cam1
	{
   		mu_fade 0 2000
		mu_queue sound/music/l_finale
		startcam cinematic8
		wait 17000
		trigger player cam2
	}
	trigger cam2
	{
		mu_fade 0 1000
		mu_stop
		startcam cinematic9
		wait 10000
		trigger player endmap
	}
	trigger cam3
	{
		startcam cinematic10
	}
}
fake_bj
{
	attributes
	{
		hearing_scale 0.0
	}
	spawn
	{
		noavoid on
		nosight 99999
		takeweapon all
		giveweapon weapon_venom
		setammo ammo_127mm 999
		selectweapon weapon_venom
//		giveweapon weapon_mp40
//		selectweapon weapon_mp40
		headlook off
		godmode on
		knockback off

		wait 100
		explicit_routing on
		trigger fake_bj go1
	}
	trigger go1
	{
		walktomarker c1spot1
		walktomarker c1spot2
		walktomarker c1spot3
		trigger player endmap
		walktomarker c1spot4
		walktomarker c1spot5
	}
	trigger reload
	{
		nosight 99999
		setclip weapon_fg42 0
		setammo ammo_792mm 200
		playanim reload both
	}
}
cine1_deathshead
{
	attributes
	{
		starting_health 50
		alertness 1200
		aim_accuracy 0.5
		attack_crouch 0.9
		attack_skill 0.9
		aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0	
	}

	spawn
	{
//		headlook off
		takeweapon all
		nosight 999999
		wait 100
	}

	trigger animloop1
	{
//		playanim device both
		trigger cine1_deathshead animloop1
	}

	trigger talk1
	{
		playsound deathshead_1		//This had better be important...
	}
	
	trigger talk2
	{
		playsound deathshead_2		//What? Will this fool follow me to the ends of the earth?
		trigger cine1_deathshead anim
	}

	trigger anim
	{
		playanim talking_1h both
	}

	trigger talk3
	{
		playsound deathshead_3	//Dispatch the remaining security force immediately...
	}

	trigger talk4
	{
		playsound deathshead_4	//Then I will deal with him...
	}

	trigger walkaway
	{
		wait 1000
		clearanim
		resetscript
		sight
//		headlook on
		statetype alert
		takeweapon all
		giveweapon weapon_sten
		setammo ammo_9mm 999
		selectweapon weapon_sten
	}
}

cine1_nazi1
{
	attributes
	{
		starting_health 25
		aim_accuracy 0.4
		attack_crouch 0.9
		attack_skill 0.9
		aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0	
	}

	spawn
	{
//		headlook off
		nosight 999999
		takeweapon all
		wait 1000
		explicit_routing on
	}
	trigger action1
	{
//		headlook on
		sight
		resetscript 
		statetype alert
		takeweapon all
		giveweapon weapon_mp44
		setammo ammo_44ammo 999
		selectweapon weapon_mp44
		setammo ammo_grenades 9
	}
	trigger go
	{
		walktomarker cine1_n1spot0a 
		walktomarker cine1_n1spot0b 
//		walktomarker cine1_n1spot0c 
		walktomarker cine1_n1spot0d 
	
		explicit_routing off
		trigger counter3 cine1_sync
	}

	trigger animloop
	{
		playanim officer_talking both
		trigger cine1_nazi1 animloop
	}

	trigger runaway
	{
		clearanim
		wait 1500
		playsound cine1_nazi1_jawohl
		clearanim
		walktomarker cine1_n1spot0d nostop
//		walktomarker cine1_n1spot0c nostop
		walktomarker cine1_n1spot0b nostop
		walktomarker cine1_n1spot0a nostop
	}

	trigger talk1
	{
		playsound cine1_nazi1_1 //Sir...
		trigger scientist1 animloop
	}

	trigger talk2
	{
		playsound cine1_nazi1_2	//Yes Sir, Zee American agent has infiltrated the X-Lab Facility.
	}

	trigger talk3
	{
		playsound cine1_nazi1_3  //What are your orders, Herr Oberfuhrer?
	}

	trigger talk4
	{
		playsound cine1_nazi1_4  //And if zee American gets past the security force?
		trigger scientist0 anim
	}
}
scientist0
{
	attributes
	{
		starting_health 5
		aim_accuracy 0.2
		aim_skill 0.6
		alertness 1200
		fov 45
	}

	spawn
	{
		accum 0 bitreset 0	// Used so that the INSPECTS don't trigger while after enemy has been spotted.
		takeweapon all
		playsound rocket_sci0_hurry_up // print Come on you guys! Hurry it up...
		wait 2000 0
		playsound rocket_sci0_here_all_day // print I don't want to be here all day!
		playanim talking both
	}

	trigger anim
	{
		playanim talking both
	}

	bulletimpact
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectsoundstart
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectsoundend
	{
		clearanim
		deny
	}

	inspectbodystart
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectbodyend
	{
		clearanim
		playsound rocket_mech1_man_down	// playsound rocket_sci0_man_down // print Man down!!
		accum 0 bitset 0
	}

	trigger scaredloop
	{
		playanim frightened both
		trigger scientist0 scaredloop
	}

	enemysight
	{
		clearanim
		accum 0 bitset 0
		playsound rocket_sci0_dont_shoot // print No, please don't shoot me
		playanim don't_kill_me both player
		trigger scientist0 scaredloop 
	}

	death
	{
	}
}
