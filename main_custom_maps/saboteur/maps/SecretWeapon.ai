//
//AI Scripting
//Map: SecretWeapon
//Last edited by: Dan
//

player
{
	spawn
	{
		cvar g_episode 1008
		objectivesneeded 1
		
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}
	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/c_military

		// Weapons
		// Ammo
		// Items
	}
	trigger action1
	{
		mu_fade 0 1000
		mu_start sound/music/m_alarm
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	}
	trigger action2
	{
		alertentity nazi10
		alertentity nazi11
//		alertentity nazi12
	}
	trigger action3
	{
		mu_fade 0 1000
		mu_queue sound/music/m_situation

		alertentity nazi13
		alertentity nazi14
	}
	trigger action4
	{
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
	}
	trigger action5
	{
		mu_fade 0 1000
		mu_queue sound/music/m_mission

		alertentity nazi19
		alertentity nazi20
	}
	trigger action6
	{
		mu_fade 0 1000
		mu_queue sound/music/m_action

		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
	}
	trigger action7
	{

		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27
	}
	trigger action8
	{
		alertentity nazi27
		alertentity nazi28
		alertentity scientist2
		alertentity scientist3
	}
	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}

	trigger secret1
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel SecretWeapon2 persistent
	}
}
nazi1
{
	attributes
	{
		starting_health 25
		aim_accuracy 0.4
		aim_skill 0.6
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp44
		setammo ammo_44ammo 999
		selectweapon weapon_mp44
		setammo ammo_grenades 9
		playsound rocket_nazi29_ammo
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	statechange alert combat
	{
		accum 0 abort_if_not_bitset 0
		resetscript
	}

	death
	{
	}
}
