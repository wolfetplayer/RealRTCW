//
//AI Scripting
//Map: SecretWeapon2
//Last edited by: Dan
//

player
{
	spawn
	{
		
		accum 0 bitreset 0	// Used for action21/21b, support if the player jumps off the bridge.
		accum 0 bitreset 1	// Used for voice toggle.
		accum 0 bitset 2	// Used for elevator1's DOWN lever
		accum 0 bitreset 3	// Used for elevator1's UP lever
		accum 0 bitreset 4
		cvar g_episode 1009
		objectivesneeded 3
		
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}
	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/c_military

		// Weapons
		// Ammo
		// Items
	}
	trigger startrocket
	{
		mu_fade 0 1000
		mu_queue sound/music/m_action
	
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25

		alertentity nazi26
		alertentity nazi27
		alertentity nazi28
		trigger counter2 choose_loudspeaker1

	}
	trigger action1
	{
		mu_fade 0 1000
		mu_start sound/music/m_alarm
		alertentity nazi3
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6
		alertentity scientist2
		alertentity scientist3
	}
	trigger action2
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity scientist4
		alertentity scientist5
	}
	trigger action3
	{
		mu_fade 0 1000
		mu_queue sound/music/m_situation
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
	}
	trigger action4
	{
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
	}
	trigger action5
	{
		mu_fade 0 1000
		mu_queue sound/music/m_mission
		alertentity nazi19
		alertentity nazi20
		alertentity scientist6
	}
	trigger action6
	{
		mu_fade 0 1000
		mu_queue sound/music/m_action

	}
	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}
	trigger got_objective2
	{
		objectivemet 2
	}
	trigger got_objective3
	{
		objectivemet 3
	}
	trigger endmap
	{
		changelevel Endmission persistent
	}
}
scientist0
{
	attributes
	{
		starting_health 5
		aim_accuracy 0.2
		aim_skill 0.6
		fov 45
	}

	spawn
	{
		accum 0 bitreset 0	// Used so that the INSPECTS don't trigger while after enemy has been spotted.
		takeweapon all
		playsound rocket_sci0_hurry_up // print Come on you guys! Hurry it up...
		wait 2000 0
		playsound rocket_sci0_here_all_day // print I don't want to be here all day!
		playanim talking both
	}

	bulletimpact
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectsoundstart
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectsoundend
	{
		clearanim
		deny
	}

	inspectbodystart
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectbodyend
	{
		clearanim
		playsound rocket_mech1_man_down	// playsound rocket_sci0_man_down // print Man down!!
		accum 0 bitset 0
	}

	enemysight
	{
		accum 0 bitset 1
		clearanim
		resetscript
		accum 0 bitset 0
		playsound rocket_sci0_dont_shoot // print No, please don't shoot me
		playanim don't_kill_me both
	}

	death
	{
	}
}
scientist1
{
	attributes
	{
		starting_health 20
		aim_accuracy 0.2
		aim_skill 0.6
	}

	spawn
	{
		accum 0 bitreset 0	// Used so that the INSPECTS don't trigger while after enemy has been spotted.
		takeweapon all
		trigger scientist1 animloop
		wait forever 0 player
	}

	trigger animloop
	{
		playanim clipboard both
		trigger scientist1 animloop
	}

	bulletimpact
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectsoundstart
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectsoundend
	{
		clearanim
		deny
	}

	inspectbodystart
	{
		clearanim
		accum 0 abort_if_not_bitset 0
		deny
	}

	inspectbodyend
	{
		clearanim
		playsound rocket_sci1_man_down // print Man down!!
		accum 0 bitset 0
	}

	enemysight
	{
		clearanim
		accum 0 bitset 0
		playsound rocket_sci1_guards // print Uh!? WHO ARE YOU!?! GUARDS!!!
		giveweapon weapon_luger
		setammo ammo_9mm 100
		selectweapon weapon_luger
		resetscript
	}

	death
	{
	}
}

