//
//AI Scripting
//Map: UnderBase
//Last edited by: Dan
//

player
{
	spawn
	{
		cvar g_episode 1006
		objectivesneeded 2		
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}
	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout UnderBase
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_start sound/music/l_briefing_1

		trigger radar1 rotateloop

		// Weapons
		// Ammo
		// Items
	}
	trigger cam1
	{
		startcam cinematic1
	}
	trigger cam2
	{
		startcam cinematic2
	}
	trigger go
	{
		alertentity demo1
		alertentity demo2
		alertentity demo3
	}
	trigger delete
	{
		alertentity remove_demo1
		alertentity remove_demo2
		alertentity remove_demo3

	}
	trigger action1
	{
		mu_fade 0 3000
		mu_queue sound/music/m_action
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
	}
	trigger action2
	{
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
	}
	trigger action3
	{
		alertentity sniper
	}
	trigger action4
	{
		alertentity nazi14
		alertentity nazi15
	}
	trigger action5
	{
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22
	}
	trigger action6
	{
//		alertentity dazz
		
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
	}
	trigger action7
	{
		
		alertentity nazi26
		alertentity nazi27
		alertentity nazi28
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
		alertentity nazi32
	}
	trigger action8
	{
		alertentity nazi33
		alertentity nazi34
		alertentity nazi35
	}
	trigger action9
	{
		alertentity nazi36
		alertentity nazi37
		alertentity nazi38
	}
	trigger action10
	{
		alertentity nazi39
		alertentity nazi40
		alertentity nazi41
	}
	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}

	trigger got_objective2
	{
		objectivemet 2	// mission objective complete
	}
	trigger endmap
	{
		changelevel UnderBase2 persistent
	}
}

