//
//AI Scripting
//Map: SWF (Secret Weapons Facility)
//Last edited by: Dan
//

player
{
	spawn
	{
		accum 0 bitset 0
		cvar g_episode 1007
		objectivesneeded 2

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_moving

	}

	trigger action1
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	}

	trigger action2
	{
		alertentity nazi10
		alertentity nazi11
	}

	trigger action3
	{
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
	}

	trigger action4
	{
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
	}

	trigger action5
	{
		alertentity nazi21
		alertentity nazi22
	}
	trigger secret1
	{
		foundsecret
	}
	trigger elevgo
	{
		trigger vazi1 start
	}
	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}

	trigger got_objective2
	{
		objectivemet 2	// mission objective complete
	}
	trigger endmap
	{
		changelevel SecretWeapon persistent
	}
}
nazi1				
{
	attributes
	{
		starting_health 25
		aim_accuracy 0.4
		attack_crouch 0.9
		attack_skill 0.9
		aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		statetype alert
		takeweapon all
		giveweapon weapon_mp34
		setammo ammo_9mm 999
		setclip mp34 32
		selectweapon weapon_mp34
		setammo ammo_grenades 9
	}
	pain 20
	{
		attrib aggression 0.2
		attrib aim_accuracy 0.6
	}
