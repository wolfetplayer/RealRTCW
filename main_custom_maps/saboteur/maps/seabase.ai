//
//AI Scripting
//Map: Морская База
//Last edited by: RDigital
//

player
{
	spawn
	{
		cvar g_episode 1003
		objectivesneeded 1
		suggestweapon weapon_mp40

		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout seabase
		#endif
		cvar g_level_was_selected 0
		
		// Weapons
		// Ammo
//		setammo ammo_9mm 50
//		setammo ammo_grenades_american 5
//		setammo ammo_45cal 250
//		setammo ammo_30cal 250

		mu_fade 0 1000
		mu_queue sound/music/m_moving

		// Items
		giveinventory key_binocs
//		giveweapon weapon_knife
//		giveweapon weapon_thompson
//		selectweapon weapon_thompson
//		giveweapon weapon_colt 
//		giveweapon weapon_colt 
		setarmor 55

		trigger radar1 rotateloop
//		trigger radar2 rotateloop

	}
	trigger action1
	{
		mu_fade 0 1000
		mu_queue sound/music/m_moving
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9	
	}
	trigger action2
	{
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13  
	}
	trigger action3
	{
		mu_fade 0 1000
		mu_queue sound/music/m_grave
	}
	trigger action4
	{
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
	}
	trigger action5
	{
		alertentity nazi19
		alertentity nazi20
	}
	trigger action6
	{
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
	}
	trigger action7
	{
		mu_fade 0 1000
		mu_queue sound/music/m_mission

		alertentity nazi26
		alertentity nazi27
		alertentity nazi28
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
		alertentity nazi32
	}
	trigger action8
	{
		alertentity nazi33
		alertentity nazi34
		alertentity nazi35
		alertentity nazi36
		alertentity nazi37
		alertentity nazi38
	}
	trigger action9
	{
		objectivemet 1
	}
	trigger endmap
	{
		changelevel techicalbunker persistent 
	}
}
