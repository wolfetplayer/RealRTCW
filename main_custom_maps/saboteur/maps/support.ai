//
//AI Scripting
//Map: Бункер техническая часть 2
//Last edited by: Dan
//

player
{
	spawn
	{
		cvar g_episode 1005
		objectivesneeded 1
		
		abort_if_loadgame
		mu_start sound/music/l_briefing_1
	}
	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout support
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 1500
		mu_queue sound/music/c_military

		// Weapons
		// Ammo
		// Items
	}
	trigger action1
	{
		alertentity nazi4
		alertentity nazi5
	}
	trigger action2
	{
		alertentity nazi6
		alertentity nazi7
	}
	trigger action3
	{
		mu_fade 0 1500
		mu_queue sound/music/m_tension

		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
	}
	trigger action4
	{
		alertentity nazi12
	}
	trigger action5
	{
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
	}
	trigger action6
	{
		alertentity nazi17
		alertentity nazi18
	}
	trigger action7
	{
		mu_fade 0 1500
		mu_queue sound/music/m_mission

		alertentity nazi19
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
	}
	trigger action8
	{
		alertentity nazi27
		alertentity nazi28
	}
	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}

	trigger found_secret1
	{
		foundsecret
	}

	trigger endmap
	{
		changelevel UnderBase persistent
	}
}
nazi1				
{
	attributes
	{
		attack_crouch 0.9
		attack_skill 0.9
		aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp34
		setammo ammo_9mm 999
		setclip mp34 32
//		selectweapon weapon_mp34
		giveweapon weapon_grenadelauncher
		selectweapon weapon_grenadelauncher
		setammo ammo_grenades 999
	}
	pain 40
	{
		attrib aggression 1.0
		attrib camper 1.0
	}
	enemysight
	{	
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
