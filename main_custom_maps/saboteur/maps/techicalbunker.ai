nazi12				
{
	attributes
	{
		tactical 0.5
		camper 1.0
		aggression 0.9
		inner_detection_radius 300
		alertness 1000
		attack_skill 0.95	
		hearing_scale 6.0	
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		giveweaponfull weapon_mp44
		setammo ammo_grenades 9
		accum 1 set 0
		accum 2 set 1
		statetype alert
		trigger nazi12 marchloop
		accum 0 bitreset 0	// On/OFF
		accum 4 set 0	// Used to choose a random ambient animation.
		accum 5 set 0	// Used to determine what part of the marchloop 
	}
	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}
	trigger marchloop
	{
		walktomarker n12spot1
		walktomarker n12spot2
		walktomarker n12spot3
		walktomarker n12spot4
		walktomarker n12spot5
		trigger nazi12 marchloop
	}
	enemysight
	{
		resetscript
		attack player
                runtomarker n12spot6
	        wait player
	}
	inspectsoundstart
	{
		clearanim
	}
	statechange alert combat
	{
		accum 0 abort_if_not_bitset 0
		resetscript
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
//		alertentity force1
		alertentity force2
//		alertentity force3

	}
}
