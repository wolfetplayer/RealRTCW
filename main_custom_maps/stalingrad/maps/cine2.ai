player
{
	spawn
	{
		cvar g_episode 1
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_mission
		trigger player cam1



		// Weapons
		// Ammo
		// Items
	}
