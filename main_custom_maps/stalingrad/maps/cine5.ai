player
{
	spawn
	{
		mu_start sound/music/m_stealth
		cvar g_episode 1
		notarget on
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/cine5
		trigger radar1 rotateloop
		trigger player vision
		notarget on
	}
	trigger vision
	{
		wait 5000
		trigger nazi1 go1
		trigger nazi2 go1
		trigger nazi3 go1
		trigger nazi4 go1
	}
	trigger film1
	{
		startcam cam5
	}
	trigger film2
	{
		startcam cam6
	}
	trigger film3
	{
		startcam cam7
	}
	trigger endmap
	{
		changelevel
		wait 9000
		endgame
	}
}
