par4
{
	attributes
	{
		aim_accuracy 0.5
		starting_health 180
		attack_crouch 0.2
		fov 120
		aggression 0.8
		alertness 2048
	}

	spawn
	{
		accum 0 set 1 // 0=enemy spotted already
		accum 1 set 0 // 1= don't play looping anim
		accum 2 set 0 // one bullet impact
		setammo ammo_grenades 0
		notarget on
		statetype relaxed
		nosight 99999		

		wait 2000
		trigger par4 smoking2
	}

	trigger smoking2
	{
		wait 5000
		accum 1 abort_if_not_equal 0
		cigarette on
		playanim smoking both
		cigarette off
		wait 20000
		trigger par4 smoking2
	}
	trigger gethelp11
	{
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		resetscript
		wait 1000 player
		attack
	}

	enemysight
	{
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		trigger par4 alert11a
		wait 5
		
	}

	bulletimpact
	{
		deny
		accum 2 abort_if_not_equal 0
		accum 2 set 1
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		statetype alert
		accum 1 set 1
		wait 100 player
	}

	inspectsoundstart
	{
		accum 0 set 0
	}

	trigger alert11a
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 0
		wait 300
		resetscript
		attack
	}

	trigger n10down	
	{
		cigarette off
		accum 0 set 0
		accum 2 set 0
	}
	death
	{
		cigarette off
		accum 0 set 0
		resetscript
	}
}
