player
{
	spawn
	{
		trigger player vision	
		cvar g_episode 1
		mu_start sound/music/m_stealth
		notarget on
	}

	playerstart
	{
		trigger radar1 rotateloop
		trigger player vision
		notarget on
	}
	trigger vision
	{
		wait 1000
		trigger officer talk1
	}
	trigger film1
	{
		startcam cam9
	}
	trigger film2
	{
		startcam cam10
	}
	trigger endmap
	{
		changelevel demo4 persistent
	}
}
officer			
{
	attributes
	{
		starting_health 60
		aim_accuracy 0.6
		attack_crouch 0.9
		attack_skill 0.9
		aim_skill 0.9
		aggression 0.5
		tactical 1.0
		pain_threshhold_scale 1.0		
	}
	spawn
	{
		accum 0 bitreset 0
		takeweapon all
		notarget on
		statetype relaxed
		nosight 99999		
	}
	trigger go1 
	{
		wait 2500
		walktomarker of1spot1
		trigger nazi1 go1
		walktomarker of1spot2
		walktomarker of1spot3
		walktomarker of1spot4
		walktomarker of1spot5
		walktomarker of1spot6
		walktomarker of1spot7
	}
	trigger talk1
	{
		playsound  sound/stalingrad/cine8nemoficer.wav
		trigger nazi1 talk1
	}
	trigger talk2
	{
		wait 4400
		trigger officer go1
	}
	trigger talk3
	{
		wait 2900
//		playanim talking_1h both
		playsound officer5
		trigger nazi1 talk2
	}
	trigger talk4
	{
		wait 2200
		playsound officer6
		trigger officer go1
	}
	trigger go2
	{
	}
	trigger anim
	{
		wait 1900
		playanim talking_1h both
	}
	trigger stop
	{
		resetscript
		trigger player end
	}
	pain 30
	{
	}
	enemysight
	{	
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
