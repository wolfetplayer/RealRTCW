player
{
	spawn
	{
		trigger player vision
        cvar g_episode 1		
		mu_start sound/music/m_stealth
		notarget on
	}

	playerstart
	{
		trigger air1 go1
		trigger player vision
		notarget on
	}
	trigger vision
	{
		wait 1000
		trigger par1 talk1
	}
	trigger vision2
	{
		wait 1000
		trigger officer talk1
	}
	trigger film1
	{
		startcam cam20
	}
	trigger film2
	{
		startcam cam21
	}
	trigger film3
	{
		startcam cam22
	}
	trigger film4
	{
		startcam cam23
	}
	trigger tactic
	{
		trigger par2 go1
		trigger par3 go1
		trigger par1 go1
	}
	trigger action33
	{
//		trigger nazi1 go1
		trigger nazi2 go1
//		trigger nazi3 go1
//		trigger nazi4 go1
//		trigger nazi5 go1
		trigger nazi6 go1
	}
	trigger endmap
	{
		changelevel demo6 persistent
	}
}
par1			
{
	attributes
	{
		starting_health 60
		aim_accuracy 0.6
		attack_crouch 0.9
		attack_skill 0.9
		aim_skill 0.9
		aggression 0.5
		tactical 1.0
		pain_threshhold_scale 1.0		
	}
	spawn
	{
		accum 0 bitreset 0
		takeweapon all
		notarget on
		statetype relaxed
		nosight 99999		
	}
	trigger go1 
	{
		takeweapon all
		giveweapon weapon_ppsh
		setammo ammo_ttammo 999
		selectweapon weapon_ppsh
	}
	trigger talk1
	{
		playsound sound/stalingrad/cine9sovoficer.wav
		trigger par2 talk1
	}
	trigger talk2
	{
		wait 2000
		playsound talk4
		trigger player tactic
	}
	pain 30
	{
	}
	enemysight
	{	
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
