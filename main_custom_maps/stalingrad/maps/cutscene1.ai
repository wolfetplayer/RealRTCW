player
{
	spawn
	{	
		abort_if_loadgame
		cvar g_episode 1
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/vstuplenie
		setarmor 20
		giveinventory key_binocs

		// Weapons
		// Items
		trigger radar1 rotateloop
	}
	trigger film1
	{
		startcam cam12
	}
	trigger film2
	{
		startcam cam13
	}
	trigger film3
	{
		startcam cam14
	}
	trigger action1
	{
		trigger air1 go1
	}
	trigger action2
	{
		alertentity bomba1
		trigger bomba1 go1
	}
	trigger action3
	{
		alertentity bomba2
		trigger bomba2 go1
	}
	trigger action4
	{
	}
	trigger action5
	{
	}
	trigger action6
	{
	}
	trigger action7
	{
	}
	trigger endmap
	{
		changelevel demo1 persistent
	}
}
