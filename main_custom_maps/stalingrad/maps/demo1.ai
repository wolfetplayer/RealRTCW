player
{
	spawn
	{	
		abort_if_loadgame
		cvar g_episode 1
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad1
		setarmor 75
		giveinventory key_binocs

		// Weapons
		giveweapon weapon_knife
		giveweapon weapon_knife
		giveweapon weapon_tt33
		giveweapon weapon_tt33
		giveweapon weapon_ppsh
		giveweapon weapon_mosin

		setammo ammo_mosina full
		setammo ammo_ttammo full
		setammo ammo_grenades 5

		setclip weapon_tt33 full
		setclip weapon_dualtt33 full
		setclip weapon_ppsh full
		setclip weapon_mosin full

		selectweapon weapon_ppsh

	}
	trigger secret1
	{
		foundsecret		
	}
	trigger action1
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11

		savecheckpoint
	}
	trigger action2
	{
		alertentity nazi12
		alertentity nazi13
