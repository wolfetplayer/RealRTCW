//
//AI Scripting
//Map: demo10
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{	
		objectivesneeded 2
		abort_if_loadgame
		mu_start sound/music/m_drums
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad2

		#if g_level_was_selected >= 1
		applyloadout endgame
		#endif
		cvar g_level_was_selected 0

		// Weapons
		sethealth 100
		setarmor 100
		// Items

	}
	trigger action1
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
	}
	trigger action2
	{
		savecheckpoint
		alertentity d1
		alertentity d2
		alertentity d3
		alertentity d4
	}
	trigger action3
	{
		alertentity l1
		alertentity l2
		alertentity l3
		alertentity l4
		alertentity l5
	}
	trigger action4
	{
		alertentity m1
		alertentity m2
		alertentity m3
	}
	trigger action5
	{
		savecheckpoint
		alertentity v1
		alertentity v2
		alertentity v3
		alertentity v4
	}
	trigger escape
	{
		trigger nazi7 action5
		trigger nazi8 action5
		trigger dead1 action5
		trigger dead2 action5
		alertentity v5
		alertentity v6
		trigger par1 go3
		trigger par2 go3
		trigger par3 go3
		trigger par4 go3
		trigger par5 go3
		trigger par6 go3
		trigger par7 go3
		trigger par8 go3
		trigger rus1 go3
		trigger rus2 go3
		trigger rus3 go3
		trigger rus4 go3
		trigger rus5 go3
		trigger rus6 go3
		trigger rus7 go3
		trigger rus8 go3
		objectivemet 1
	}
	trigger step1
	{
		trigger par1 go2
		trigger par2 go2
		trigger par3 go2
		trigger par4 go2
		trigger par5 go2
		trigger par6 go2
		trigger par7 go2
		trigger par8 go2
		trigger rus1 go2
		trigger rus2 go2
		trigger rus3 go2
		trigger rus4 go2
		trigger rus5 go2
		trigger rus6 go2
		trigger rus7 go2
		trigger rus8 go2
	}
	trigger victory
	{
		alertentity v7
		alertentity v8
		alertentity v9
		alertentity v10
	}
	trigger win
	{
		objectivemet 2
		wait 95000
		trigger player endmap
	}
	trigger endmap
	{
		achievement_stalingrad
		changelevel cine5 persistent
	}
}
