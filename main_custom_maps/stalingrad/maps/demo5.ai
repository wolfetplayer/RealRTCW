//AI Scripting
//Map: demo5
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 1
		objectivesneeded 1
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad5

		#if g_level_was_selected >= 1
		applyloadout mid_game
		#endif
		cvar g_level_was_selected 0

		// Weapons
		sethealth 100
		// Ammo

		// Items
		trigger panzer go1
	}
	trigger tank1
	{
		trigger panzerturret go1
	}
	trigger tank2
	{
		trigger panzerturret go2
		alertentity nazi3
		alertentity nazi4
	}
	trigger tank3
	{
		trigger panzerturret go3
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8

		savecheckpoint
	}
	trigger tank4
	{
		trigger panzerturret go4
	}
	trigger tank6
	{
		trigger panzerturret go6
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
	}
	trigger endtank
	{
		trigger panzerturret go7

		savecheckpoint
	}
	trigger action2
	{
		alertentity nazi12
		alertentity nazi13
	}
	trigger action3
	{
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger endmap
	{
		changelevel cine9 persistent
	}
}
