player
{
	spawn
	{
		cvar g_episode 1
		objectivesneeded 2
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad6

		#if g_level_was_selected >= 1
		applyloadout mid_game
		#endif
		cvar g_level_was_selected 0

		// Weapons
		sethealth 100
		// Ammo

		// Items
	}
	trigger tank
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad1
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
