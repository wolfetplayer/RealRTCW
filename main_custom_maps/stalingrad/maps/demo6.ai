		trigger par1 go2
		trigger par2 go2
		trigger par3 go2
	}
	trigger action1
	{
		alertentity nazi6
		alertentity nazi7
	}
	trigger action2
	{
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10

		savecheckpoint
	}
	trigger action3
	{
		alertentity nazi11
		alertentity nazi12
		trigger par1 go1
		trigger par2 go1
		trigger par3 go1
	}
	trigger action4
	{
		trigger air1 go1
		alertentity nazi31
		alertentity nazi32
		alertentity nazi33
		alertentity nazi34
		alertentity nazi35

		savecheckpoint
	}
	trigger action5
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad4
		alertentity nazi36
		alertentity nazi37
		alertentity nazi38
		alertentity nazi39
		objectivemet 2
	}
	trigger escape
	{
		trigger par7 go1
		objectivemet 1
