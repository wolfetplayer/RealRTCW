air1
{
	spawn
	{
	}

	trigger go1
	{
		playsound sound\world\flyby.wav 
		gotomarker f1 1000
		faceangles 0 180 0 gototime
		playsound sound\world\flyby.wav looping forewer
		gotomarker f2 1000
		faceangles 0 180 0 gototime
		gotomarker f3 1000
		faceangles 0 180 0 gototime
		playsound sound\world\boomin.wav
		alertentity boom11
		gotomarker f4 1000
		faceangles 0 180 0 gototime
		playsound sound\world\boomin.wav
		alertentity boom12
		gotomarker f5 1000
		faceangles 0 180 0 gototime
		playsound sound\world\boomin.wav
		alertentity boom13
		gotomarker f6 1000
		faceangles 0 180 0 gototime
		gotomarker f7 1000
		faceangles 0 180 0 gototime
	}
}