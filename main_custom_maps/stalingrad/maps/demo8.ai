player
{
	spawn
	{
		cvar g_episode 1
		objectivesneeded 1
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad6

		#if g_level_was_selected >= 1
		applyloadout mid_game
		#endif
		cvar g_level_was_selected 0

		// Weapons
		sethealth 100
		setarmor 50
		// Ammo
		setammo ammo_ttammo full
		// Items
		trigger panzer go1
		trigger nazi1 go1
		trigger nazi2 go1
		trigger nazi3 go1
		trigger nazi4 go1
		trigger nazi5 go1
		trigger nazi6 go1
		trigger nazi7 go1
		trigger nazi8 go1
		trigger nazi9 go1
		trigger nazi10 go1
		trigger nazi11 go1
		trigger nazi12 go1
		
	}
	trigger action1
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad8
		alertentity boom1
		alertentity boom2
		trigger nazi1 go2
		trigger nazi2 go2
		trigger nazi3 go2
		trigger nazi4 go2
