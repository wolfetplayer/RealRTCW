		trigger par5 go2
		trigger par6 go2
		trigger par7 go2
		trigger par8 go2
		alertentity s1
		alertentity s2
		alertentity s3
		alertentity s4
		alertentity s5
		alertentity s6
		alertentity s7
		alertentity r1
		alertentity r2
		alertentity r3
		alertentity r4
		alertentity r5
		alertentity r6
		alertentity gren1
		alertentity gren2
	}
	trigger end
	{
		accum 0 bitset 1
		missionfailed
	}
	trigger win
	{
		objectivemet 1
		wait 90000
		trigger player endmap
	}
	trigger action3
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	}
	trigger action4
	{
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		
		savecheckpoint
