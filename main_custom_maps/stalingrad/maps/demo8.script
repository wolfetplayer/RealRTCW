	}

	trigger forwardshort
	{
		wait 1000
		playanim 0 5 50
		playsound sound/vehicles/tankidle.wav looping
	}

	trigger reverse
	{
		playsound sound/vehicles/tankmove2.wav looping
		wait 5
		playanim 66 130 looping forever
	}

	trigger reversestop
	{
		wait 1000
		playanim 66 130 500
		playsound sound/vehicles/tankidle.wav looping
	}

}
air1
{
	spawn
	{
	}

	trigger go1
	{
		playsound sound\world\flyby.wav 
		gotomarker r1 1000
		faceangles 0 90 0 gototime
		playsound sound\world\flyby.wav looping forewer
		gotomarker r2 1000
		faceangles 0 90 0 gototime
		gotomarker r3 1000
		faceangles 0 100 0 gototime
		playsound sound\world\boomin.wav
		alertentity boom3
		gotomarker r4 1000
		faceangles 0 100 0 gototime
		playsound sound\world\boomin.wav
		alertentity boom4
		gotomarker r5 1000
		faceangles 0 110 0 gototime
		alertentity smoke
		gotomarker r6 1000
		faceangles 0 110 0 gototime
		playsound sound\world\boomin.wav
		alertentity boom5
		gotomarker r7 1000
		faceangles 0 90 0 gototime
	}
}
