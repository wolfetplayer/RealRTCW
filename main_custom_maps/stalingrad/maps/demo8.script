panzerturret
{
	spawn
	{	
		gotomarker a1 25
		faceangles 0 0 0 gototime
	}
	trigger go1
	{
		gotomarker a1 25
		faceangles 0 0 0 gototime
		gotomarker a2 25
		faceangles 0 0 0 gototime
		gotomarker a3 25
		faceangles 0 0 0 gototime
		gotomarker a4 25
		faceangles 0 0 0 gototime
		gotomarker a5 25
		faceangles 0 0 0 gototime
	}
}
panzer
{
	spawn
	{
		gotomarker a1 25
		faceangles 0 0 0 gototime
	}
	trigger go1
	{
		trigger panzerturret go1
		trigger panzergun go1
		trigger panzertrackl go1
		trigger panzertrackr go1
		trigger panzertrackl forward
		trigger panzertrackr forward
		gotomarker a1 25
		faceangles 0 0 0 gototime
		gotomarker a2 25
		faceangles 0 0 0 gototime
		gotomarker a3 25
		faceangles 0 0 0 gototime
		gotomarker a4 25
		faceangles 0 0 0 gototime
		gotomarker a5 25
		faceangles 0 0 0 gototime
		trigger player action1
		alertentity smoke
		trigger panzertrackl forwardstop
		trigger panzertrackr forwardstop
	}
}
panzergun
{
	spawn
	{
	}
	trigger go1
	{
		attachtotag panzerturret tag_gun
	}
}
panzertrackl
{
	spawn
	{
	}
	trigger go1
	{
		attachtotag panzer tag_raild
	}

	trigger forward
	{
		playsound sound/vehicles/tankmove2.wav looping
		wait 5
		playanim 0 65 looping forever
	}

	trigger forwardstop
	{
		wait 1000
		playanim 0 65 500
		playsound sound/vehicles/tankidle.wav looping
	}

	trigger forwardshort
	{
		wait 1000
		playanim 0 5 50
		playsound sound/vehicles/tankidle.wav looping
	}

	trigger reverse
	{
		playsound sound/vehicles/tankmove2.wav looping
		wait 5
		playanim 66 130 looping forever
	}

	trigger reversestop
	{
		wait 1000
		playanim 66 130 500
		playsound sound/vehicles/tankidle.wav looping
	}

}

