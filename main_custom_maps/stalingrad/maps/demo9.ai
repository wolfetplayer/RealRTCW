//AI Scripting
//Map: demo9
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 1
		objectivesneeded 3
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/stalingrad3

		#if g_level_was_selected >= 1
		applyloadout mid_game
		#endif
		cvar g_level_was_selected 0

		// Weapons
		giveweapon weapon_dynamite
		// Ammo
		setammo ammo_dynamite 3
		setammo ammo_ttammo 200
		sethealth 100
		setarmor 100
		// Items
		trigger panzer go1
		trigger panzer1 go1
	}
	trigger end
	{
		accum 0 bitset 1
		missionfailed
	}
	trigger action1
	{
               	alertentity k1
		alertentity k2
		alertentity k3
		alertentity k4
                alertentity k5
		alertentity k6
		alertentity k7
		alertentity k8
		alertentity k9
		alertentity k10
	}
	trigger tank1
	{
		trigger panzer1 go2
	}
	trigger tank2
	{
		trigger panzer1 go3
	}
        trigger tank5
	{
		trigger panzer go3
	}
	trigger action4
	{
		savecheckpoint
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
	}
	trigger action5
	{
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
	}
	trigger action6
	{
		alertentity nazi17
		alertentity nazi18
	}
	trigger action7
	{
		alertentity nazi19
		alertentity nazi20
	}
	trigger action8
	{
		savecheckpoint
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
	}
	trigger action9
	{
		alertentity nazi25
		alertentity nazi26
