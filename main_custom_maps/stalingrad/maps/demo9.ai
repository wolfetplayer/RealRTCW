	trigger action14
	{
		savecheckpoint
		alertentity nazi41
		alertentity nazi42
	}
	trigger action15
	{
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger got_objective2
	{
		objectivemet 2
	}
	trigger endmap
	{
		changelevel demo55a persistent
	}
}
