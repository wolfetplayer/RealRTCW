// Time Gate campaign loadouts

loadout start
{
		giveweapon weapon_knife
		selectweapon weapon_knife
}

loadout tombs_veteran
{
		giveweapon weapon_knife
		giveweapon weapon_mp40
		giveweapon weapon_luger
		giveweapon weapon_mauserrifle

		setammo ammo_9mm full
		setammo ammo_792mm full

		setclip weapon_mp40 full
		setclip weapon_luger full
		setclip weapon_mauserrifle full

		setarmor 50

		selectweapon weapon_mp40
}

loadout mid_game
{
		giveweapon weapon_knife
		giveweapon weapon_luger
		giveweapon weapon_silencer

		setammo ammo_9mm 24

		setclip weapon_luger full
		setclip weapon_silencer full

		setarmor 50

		selectweapon weapon_luger
}

