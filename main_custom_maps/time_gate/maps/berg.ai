player
{
  spawn
  {
   mu_queue sound/music/m_tension
   trigger vagon_up beginup
  } 
  playerstart
  {
  
  }
trigger action100
{
alertentity naz102
alertentity naz103
alertentity naz104
alertentity naz105

trigger vagon_dn begindn
}

trigger action101
{
