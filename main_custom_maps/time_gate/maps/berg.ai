//vishka========================
	
naz100
{
	attributes
	{
		idle_crouch 0.0
		attack_crouch 0.0
		alertness 1600
		fov 360


	}

	spawn
	{
		takeweapon all
		giveweapon weapon_mp44
        setammo ammo_44ammo 999
		selectweapon weapon_mp44
        gotocast player
		sight
		
	}
            trigger n100mov
            {
            walktomarker n101
            }
	
           enemysight player
	{
                        playsound sound/player/infantryss/attack/attack2.wav
		resetscript		// resume normal combat now
	}

 	death
	{
            trigger naz101 mov
         
		
	}

	}

naz101
{
	attributes
	{
		
		idle_crouch 0.0
		attack_crouch 0.0
		alertness 1600
		

	}

	spawn
	{
		giveweapon weapon_luger
        setammo ammo_9mm 999
                      	}
            
 trigger mov
{
godmode on
facetargetangles n101
playsound sound/player/infantryss/orders/kook.wav
wait 2500
playsound sound/player/infantryss/orders/angreif.wav
wait 2500
alertentity trans
alertentity trans10
playsound sound/player/infantryss/death/flame_scream1.wav
wait 2500
catchfire
alertentity d1
godmode off



}

	
           enemysight player
	{
			}

 	death
	{
		
		
	}

	}



