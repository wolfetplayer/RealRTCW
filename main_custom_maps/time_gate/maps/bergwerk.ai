player
{
  spawn
  {


    }
  playerstart
  {

        mu_fade 0 1000
		mu_queue sound/music/m_stealth

		#if g_level_was_selected >= 1
		applyloadout mines_assault
		#endif
		cvar g_level_was_selected 0

		// misc
		setarmor 50
		selectweapon weapon_mp44


  }
trigger action1
{

trigger lift begin
}

trigger kranstart
{
trigger kran go
}

trigger liftup
{
trigger lift2 move
}

trigger action10
{
alertentity naz2
alertentity naz3
alertentity naz4
alertentity naz5

savecheckpoint
}

