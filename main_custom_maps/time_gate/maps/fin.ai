  trigger tit start
  wait 30000
  startcam fin12
  wait 30000
  startcam fin12
  wait 30000
  startcam fin12
  wait 30000
		changelevel
		wait 9000
		endgame

  }





trigger endmap
  {
	 changelevel gamefinished 250
  }


