//
//AI Scripting
//Map: rock

//Last edited by: WolfETPlayer
//



player
{
  spawn
  {
  giveweapon weapon_mp40
  setammo ammo_9mm 50
  selectweapon weapon_mp40
  trigger kino start
  }
  playerstart
  {
  mu_queue sound/laba/mistik.wav
  }
  trigger change_themusic
  {
   mu_stop 100
  }
  trigger film1
  {
	startcam lab1
	trigger naz1 mov1
  }
  trigger film2
  {
	startcam lab2
  }
  trigger film3
  {
	startcam lab3
	trigger naz1 mov2
	wait 16000
	stopcam
	trigger player endmap
  }
  trigger endmap
  {
	  changelevel labor1a persistent
  }


 trigger relax
 {
	 wait 10000
	 trigger naz2 up
	 trigger naz4 up
	 trigger naz5 up
	 trigger naz7 up
	 wait 1000
	 trigger naz6 up
	 trigger naz3 up
	 trigger naz12 up
	 trigger naz13 up
	 wait 1000

	 trigger naz14 up
	 trigger naz17 up
	 trigger naz8 up
	 trigger naz9 up
	 wait 1000

	 trigger naz15 up
	 trigger naz16 up
	 trigger naz11 up
	 trigger naz10 up


}
 }

 //babû=======================================

 naz1
{
  	attributes
  	{
  	alertness 0
  	hearing_scale 0
	aggression 0
	inner_detection_radius 0
	tactical 0.6
  	}

  	trigger mov1
  	{
	  	wait 25000
	  	runtomarker move1 nostop
	  	facetargetangles move1
	  	trigger player relax
        walktomarker move2 nostop
	  	facetargetangles move2
	  	wait 1000
	  	trigger player change_themusic
	  	facetargetangles move3

	  	walktomarker move3
	  	trigger player film3
 }
		 trigger mov2
	{
		headlook off
	  	playanim talking torso
	  	playsound sound/laba/bab1.wav
    }

  	spawn
  	{
	takeweapon all
 	}
	death
  	{
  	resetscript
  	}
	bulletimpact
  	{
  	deny
  	}
  	enemysight
  	{
	deny
 	}
	inspectsoundstart
  	{
	deny
 	}
}


