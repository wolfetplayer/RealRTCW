

gate1l
{
	spawn
	{
	}
	trigger alarm
	{
	playsound sound/world/klaxon.wav looping
    }


	trigger open
	{
		wait 50
		stopsound
		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker g1l1 50
		faceangles 0 0 0 gototime
		gotomarker g1l2 50
		faceangles 0 0 0 gototime
		stopsound
        playsound  sound/movers/doors/door3_endo.wav


	}
}

