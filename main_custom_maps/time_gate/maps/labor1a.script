vent
{
	spawn
	{
	}


	trigger start
	{
		wait 1000
		playsound sound/scenaric/village2/g2_ya_ya.wav
		playsound sound/scenaric/village2/g1lc_haha.wav
		wait 1000
		playsound sound/scenaric/rocket/bridge_creak1.wav looping
		gotomarker v1 100
		faceangles 180 0 0 800
            faceangles 360 0 0 800


		stopsound
            playsound  sound/movers/doors/door3_endo.wav
            wait 500
            playsound sound/scenaric/rocket/bridge_creak3.wav looping
            trigger ventdoor open
            gotomarker v4 10
		faceangles 0 45 0 gototime
            gotomarker v2 10
            faceangles 0 90 0 gototime
            gotomarker v3 10
            faceangles 0 135 0 gototime

            stopsound


	}
}

ventdoor
{
	spawn
	{
	}


	trigger open
	{
		gotomarker v4 10
		faceangles 0 45 0 gototime
		gotomarker v2 10
		faceangles 0 90 0 gototime
		gotomarker v3 10
            faceangles 0 135 0 gototime





	}
}


