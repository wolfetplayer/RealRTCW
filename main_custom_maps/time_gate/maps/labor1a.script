gate4l
{
	spawn
	{
	}


	trigger open
	{
		wait 50
		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker g4l1 50
		faceangles 0 0 0 gototime
		gotomarker g4l2 50
		faceangles 0 0 0 gototime
		stopsound
        playsound  sound/movers/doors/door3_endo.wav


	}


	trigger close
	{
		wait 50
		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker g4l2 50
		faceangles 0 0 0 gototime
		gotomarker g4l3 50
		faceangles 0 0 0 gototime
		stopsound
        playsound  sound/world/electrocute.wav
        trigger gate4l closes



	}
	trigger closes
	{

		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker g4l2 50
		faceangles 0 0 0 gototime
		gotomarker g4l3 70
		faceangles 0 0 0 gototime
		stopsound
		playsound  sound/movers/doors/door3_endo.wav
		trigger gate4l closes





	}
}

