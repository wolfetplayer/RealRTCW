trigger movik
{
            startcam lx2cam1
            trigger of1 kadr1
            wait 5000
            startcam lx2cam2
            trigger post kadr1
            wait 10500
            startcam lx2cam3
            trigger of1 kadr2
            wait 8000
            startcam lx2cam4
            trigger of1 kadr3
            wait 7000

            alertentity lopdoor
            alertentity naz52
            trigger player m1start
            startcam lx2cam5
            wait 5000
            stopcam




}





}


