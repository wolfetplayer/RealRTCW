naz3
{
	attributes
	{
		alertness 500
		hearing_scale 0.5
		fov 360
	}

	spawn
	{
		accum 1 set 0	// Used to see what combat talk to use.
		takeweapon all
		giveweapon weapon_mp34
		setammo ammo_9mm 999
		setclip mp34 24
		selectweapon weapon_mp34
		trigger naz3 start
        statetype alert
	}

	trigger start
	{
	gotomarker n3
    }
	avoiddanger grenade
	{
		playsound blank

		resetscript
	}

	inspectfriendlycombatstart
	{
		playsound blank

	}

	bulletimpact
	{
		playsound blank

	}

	inspectsoundstart
	{
		playsound blank

	}

	inspectbodystart
	{
		playsound blank

	}
	enemysight player
	{
		explicit_routing off
		playsound blank
		attrib alertness 1024

	}

	death
	{

	}
}

