of1
{
	attributes
	{
        alertness 0
        inner_detection_radius 0


	}

	spawn
	{


        takeweapon all
        giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger

	}

trigger kadr1
   {
	trigger player stopm1
	walktomarker of1spot1
	playanim looking_over_table torso
    wait 5000
    clearanim
   }
trigger kadr2a
   {
	facetargetangles of1spot2

   }
trigger kadr2
   {
	 wait 100
     playanim giving_orders torso
     playsound sound/lab/p2.wav

   }

 trigger kadr3
   {
	trigger post kadr2
	gotomarker of1spot3
	facetargetangles of1spot3

    attrib inner_detection_radius 128
	attrib alertness 1600
    statetype alert
    fireattarget bum 800
    fireattarget bum 800


   }





	death
	{

	}


}


post
{
	attributes
	{
		idle_crouch 0.0
		attack_crouch 0.0
		alertness 0
        inner_detection_radius 0
		fov 180
	}

	spawn
	{
	    takeweapon all
		giveweapon weapon_mp44
        setammo ammo_44ammo 999
		selectweapon weapon_mp44
	}

      trigger kadr1
      {
      gotomarker postspot1
      trigger of1 kadr2a
      playanim nazi_salute both
      wait 100
      playsound sound/lab/p1.wav


      }

       trigger kadr2
      {
	  playsound sound/lab/p3.wav
      gotomarker postspot2
      facetargetangles postspot2




      }


           enemysight player
	{
		attrib inner_detection_radius 128
		attrib alertness 1600
		resetscript		// resume normal combat now
	}

 	death
	{


	}

	}