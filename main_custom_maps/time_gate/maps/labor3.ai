trigger exp3
{
	alertentity exp2
    wait 200
	alertentity exp3
	wait 200
	alertentity exp4

    wait 300
	alertentity exp5
	wait 200
	alertentity exp6

	  wait 300
	alertentity exp5
	wait 2000
	alertentity exp6

