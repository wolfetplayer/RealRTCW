




handel
{
	spawn
	{
	}


	trigger start
	{


		playsound sound/world/electrocute.wav
		faceangles -180 0 0 500
		trigger mgate1 start

    }

    trigger dawn
    {

		playsound sound/world/electrocute.wav
		faceangles  0 0 0 500

    }
}


mgate1
{
	spawn
	{
	}


	trigger start
	{

		wait 100


		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker mg1 20
		faceangles 0 0 0 gototime
		stopsound
        playsound  sound/movers/doors/door3_endo.wav
        wait 3000
        playsound sound/movers/doors/door3_loopo.wav looping
        gotomarker mg2 50
		faceangles 0 0 0 gototime
		stopsound
        playsound  sound/movers/doors/door3_endo.wav
        trigger handel dawn


	}
}

	mgate2
{
	spawn
	{
	}


	trigger start
	{

		wait 100


		playsound sound/movers/doors/door3_loopo.wav looping
		gotomarker mg1a 20
		faceangles 0 0 0 gototime
		stopsound
        playsound  sound/movers/doors/door3_endo.wav



	}









}


