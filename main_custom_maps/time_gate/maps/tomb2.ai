//
//AI Scripting
//Map: tomb2

//Last edited by: Priv
//



player
{
  spawn
  {
   applyloadout start
   cvar g_level_was_selected 0

  }
  playerstart
  {
  mu_start sound/music/x_atmos
  }



  trigger action1
	{
	alertentity zom1
	}
trigger action2
	{
	alertentity zom4
      alertentity zom5
	}
 trigger action3
      {
      alertentity zom6
      }
 trigger action4
      {
      alertentity zom7
      alertentity zom8
      alertentity zom9

	  savecheckpoint
      }
 trigger action5
      {
      alertentity zom10
            
      alertentity zom11
      }
 trigger action6
      {
      alertentity zom12
      
      alertentity zom13
	  savecheckpoint
      }
  trigger action7
      {
      alertentity zom14
      alertentity zom15
      }
  trigger action8
     {
      alertentity zom16
      alertentity zom17
      alertentity zom18

	  savecheckpoint
      }
  trigger endmap
	{
	changelevel tomb3 persistent
	}


}
	

zom1
{
	attributes
	{
		aggression 1.0
		fov 360
	}
	
	spawn
	{
	//	trigger  action1
		alertentity z1			// break the cover
		nosight 10000
		playanim revive both
		gotocast player
		sight
	}

	enemysight player
	{
		resetscript		// resume normal combat now
	}

	death
	{
		alertentity zom2
            alertentity zom3
		
	}
}

