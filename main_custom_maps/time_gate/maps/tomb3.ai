player
{
  spawn
  {
   
  
  } 
  playerstart
  {
  #if g_level_was_selected >= 1
  applyloadout tombs_veteran
  #endif
  cvar g_level_was_selected 0
  }



  trigger action1
	{
	alertentity wzom1
      mu_start sound/music/m_action
	}
   trigger action2
      {
      alertentity zom1
      alertentity zom2
      alertentity zom3
      alertentity zom6
       }
  trigger action3
       {
      alertentity wzom2
      alertentity wzom3
	  savecheckpoint
       }
  trigger action4
       {
      alertentity zom7
      alertentity zom8
       }
   trigger action5
       {
      alertentity zom9
        }
   trigger action6
       {
      alertentity wzom6
      alertentity zom10
      alertentity zom11
	  savecheckpoint
       }
   trigger action7
       {
      alertentity zom12
      alertentity zom13
      alertentity zom14
       }
    trigger action8
       {
       alertentity wzom7
       alertentity wzom8
	   savecheckpoint
        }
    trigger action10
       {
       alertentity zom15
       alertentity zom16
       }
trigger endmap
	{
	changelevel tomb4 persistent
	}



}

wzom1
{
	attributes
	{

	}

	spawn
	{
		noaidamage on
	}

	trigger reset
	{
		noaidamage off
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
