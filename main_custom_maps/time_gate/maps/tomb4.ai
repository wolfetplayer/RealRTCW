player
{
  spawn
  {
   
  
  } 
  playerstart
  {
  
  }
  
  trigger action1
  {
  alertentity zom1
  alertentity zom2
   }

 trigger action2
  {
  alertentity zom3
  alertentity zom4
  alertentity zom5

  savecheckpoint
   }

 trigger action3
  {
  alertentity zom7
  alertentity wzom4
  alertentity wzom5
  alertentity zom6
   }

 trigger action4
  {
  
  
  alertentity zom8
  savecheckpoint
   }
 trigger action5
  {
  mu_start sound/music/m_drums
  alertentity fzom1
  
   }

  trigger action6
  {
  alertentity fzom2
  
   }
  trigger action7
  {
  alertentity boss
  alertentity zom10
  alertentity zom9
  savecheckpoint
   }
  trigger endmap
  {
  changelevel vil01 persistent
  
   }




}


zom1
{
	attributes
	{
		aggression 1.0
		fov 360
	}
	
	spawn
	{
	
			
		nosight 10000
		playanim revive both
		attack player
		sight
	}

	enemysight player
	{
		resetscript		// resume normal combat now
	}

	death
	{
	alertentity zcry1
      alertentity wzom1
      alertentity wzom2
      alertentity wzom3
		
	}
}

