boss	
{
	attributes
	{
		pain_threshold_scale 50
		aggression 1.0
		fov 360
	}

	spawn
	{
		accum 0 set 0 // 1 = helga has broken gate
		accum 1 set 0 // 1 = fired fakedeath
		accum 2 set 0 // 1 = gate blown
		statetype alert
		knockback off
		godmode on
		nosight 999999
		wait 5000
	
		godmode off
	
		playanim attack3 both
		
		attrib pain_threshold_scale 10
		sight
		accum 0 set 1
		gotocast player
	}

	enemysight
	{
		resetscript
	}

	blocked player
	{
		deny
		pushaway player
	}

	
	

	death
	{
			
      }
}

