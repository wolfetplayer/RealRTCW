fzom1
{
	attributes
	{
		fov 240
		hearing_scale 1.0
		alertness 4000
	}

	spawn
	{
            
		accum 0 bitreset 0
		noaidamage on
		nosight 99999
		godmode on
		takeweapon monsterattack2
		knockback off
		//alertentity flame1_bust
		giveweapon monsterattack1
		playanim off_hole both
		sight
		godmode off
            

		//explicit_routing on
		//runtomarker f1spot1
		//explicit_routing off
		//alertentity hurt01
		accum 0 bitset 0
		resetscript
		attack player
		
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	death
	{
            
		alertentity zcry3
		accum 0 abort_if_bitset 0
            
            
		
	}

	enemysight
	{
	}

}

