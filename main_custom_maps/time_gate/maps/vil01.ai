bj
{
  	
  	spawn
  	{
	takeweapon all
      noavoid
      godmode on
      nosight 99999
      trigger bj comein
 	}

	trigger comein
  	{
      playanim plane_2 both
      //giveweapon weapon_mp40
          
      runtomarker bj1
      gotomarker bj2
           
      facetargetangles bj2
      wait 2000
      facetargetangles bj3
      wait 2000
      facetargetangles bj2
      setammo ammo_9mm 200
      playanim reload both
      wait 5000
      gotomarker bj3
       
	
   	}
       
      
	


}


