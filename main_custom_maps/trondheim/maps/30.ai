player
{
	spawn
	{
		cvar g_episode 30
		objectivesneeded 2		
		abort_if_loadgame
		mu_start sound/music/m_moving
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		
	}
	trigger action1
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1
		mu_fade 0 500
		mu_queue sound/music/m_moving
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	}
	trigger action2
	{
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		
		savecheckpoint
	}
	trigger action3
	{
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
	}
	trigger action4
	{
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
	}
	trigger action5
	{
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27
		alertentity nazi28

		savecheckpoint
	}
	trigger action6
	{
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
		alertentity nazi32
		alertentity nazi33
	}
	trigger action7
	{
		alertentity nazi34
		alertentity nazi35
		alertentity nazi36

		savecheckpoint
	}
	trigger action8
	{
		alertentity d1
		alertentity d2
	}
	trigger endmap
	{
		changelevel 30a persistent
	}
}

