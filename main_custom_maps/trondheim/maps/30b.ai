player
{
	spawn
	{
		cvar g_episode 32
		objectivesneeded 1		
		abort_if_loadgame
		mu_start sound/music/m_grave
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_grave


	}
	trigger action1
	{
		alertentity nazi5
	}
	trigger action2
	{
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	        alertentity nazi10

			savecheckpoint
	}
	trigger action3
	{
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
	}
	trigger action4
	{
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		alertentity nazi21

		savecheckpoint
	}
	trigger action5
	{
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27

		savecheckpoint
	}
	trigger endmap
	{
		changelevel 30c persistent
	}
}
