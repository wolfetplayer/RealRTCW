//
//AI Scripting
//Map: Trondheim UK -  ?
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 33
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_tension
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 30c
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_tension

		// Weapons
		// Ammo
		// Items
	}
	trigger action1
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
	}
	trigger action2
	{
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
	        alertentity nazi15
			savecheckpoint
	}
	trigger action3
	{
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
	}
	trigger endmap
	{
		changelevel 30d persistent
	}
}
