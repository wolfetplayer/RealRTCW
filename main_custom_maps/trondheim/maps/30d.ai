
//AI Scripting
//Map: Trondheim UK
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 34
		objectivesneeded 3		
		abort_if_loadgame
		mu_start sound/music/m_tension
	}

	playerstart
	{
		trigger player cam1

	}
	// --- Start Cameras---
	trigger cam1
	{
		startcam 30d_1
	}
	trigger cam2
	{
		startcam 30d_2
	}

	trigger cam3
	{
		startcam 30d_3
	}

	trigger cam4
	{
		startcam 30d_4
	}

	trigger cam5
	{
		startcam 30d_5
	}

	trigger cam6
	{
		startcam 30d_6
	}

	trigger cam7
	{
		startcam 30d_7
	}

	trigger cam8
	{
		startcam 30d_8
	}

	trigger camerainterrupt
	{
	}
	// ---End Camera Section---


	trigger action1
	{
		mu_fade 0 3000
		mu_queue sound/music/m_alarm
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	}
	trigger action2
	{
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
	        alertentity nazi14

			savecheckpoint
	}
	trigger action3
	{
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
	}
	trigger action4
	{
		alertentity nazi20
		alertentity nazi21
	}
	trigger action5
	{
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25

		savecheckpoint
	}
	trigger action6
	{
		alertentity nazi26
		alertentity nazi27
		alertentity nazi28
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
	}
	trigger action7
	{
		alertentity nazi32
		alertentity nazi33
		alertentity nazi34
		alertentity nazi35
		alertentity nazi36
		alertentity nazi37
		alertentity nazi38
		alertentity nazi39
		alertentity nazi40
		alertentity nazi41
		alertentity nazi42
		alertentity nazi43
		alertentity nazi44
		alertentity nazi45
		alertentity nazi46

		savecheckpoint
	}
	trigger secret1
	{
		foundsecret		
	}
	trigger endmap
	{
		changelevel 30f persistent
	}
}
nazi1
{
	attributes
	{
		//aim_accuracy 0.5
		//starting_health 35
		attack_crouch 0.2
		fov 120
		aggression 0.8
		alertness 2048
	}

	spawn
	{
		accum 0 set 1 // 0=enemy spotted already
		accum 1 set 0 // 1= don't play looping anim
		accum 2 set 0 // one bullet impact

		wait 20000
		trigger nazi1 smoking2
	}

	trigger smoking2
	{
		accum 1 abort_if_not_equal 0
		cigarette on
		playanim smoking both
		cigarette off
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		trigger nazi1 smoking2
	}
	trigger gethelp11
	{
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		resetscript
		wait 1000 player
		attack
	}

	enemysight
	{
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		trigger nazi1 alert11a
		wait 5
		
	}

	bulletimpact
	{
		deny
		accum 2 abort_if_not_equal 0
		accum 2 set 1
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		statetype alert
		accum 1 set 1
		wait 100 player
	}

	inspectsoundstart
	{
		accum 0 set 0
	}

	trigger alert11a
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 0
		wait 300
		resetscript
		attack
	}

	trigger n10down	
	{
		cigarette off
		accum 0 set 0
		accum 2 set 0
	}
	death
	{
		cigarette off
		accum 0 set 0
		resetscript
	}
}
nazi2					
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		tactical 0.5
		camper 1.0
		aggression 0.9
		inner_detection_radius 300
		alertness 1000
		//attack_skill 0.95	
		hearing_scale 6.0	
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		accum 1 set 0
		accum 2 set 1
		statetype alert
		trigger nazi2 marchloop
		accum 0 bitreset 0	// On/OFF
		accum 4 set 0	// Used to choose a random ambient animation.
		accum 5 set 0	// Used to determine what part of the marchloop 
	}

	trigger marchloop
	{
		walktomarker n2spot1
		facetargetangles n2spot1
		walktomarker n2spot2
		facetargetangles n2spot2
		walktomarker n2spot3
		facetargetangles n2spot3
		walktomarker n2spot4
		facetargetangles n2spot4
		wait 10000
		trigger nazi2 marchloop
	}
	enemysight
	{
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		resetscript
		wait 1000 player
		attack
	}

	inspectsoundstart
	{
		clearanim
	}
	statechange alert combat
	{
		accum 0 abort_if_not_bitset 0
		resetscript
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
