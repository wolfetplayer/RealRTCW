//AI Scripting
//Map: Trondheim UK - Final
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 35
		objectivesneeded 0	
		abort_if_loadgame
		mu_start sound/music/m_assault
	}

	playerstart
	{

		// Weapons
		// Ammo
		// Items
	}
	trigger action1
	{
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
	}
	trigger action2
	{
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
	        alertentity nazi25
		alertentity nazi26
		alertentity nazi27

		savecheckpoint
	}
	trigger action3
	{
		alertentity nazi28
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
		alertentity nazi33
	}
	trigger action4
	{
		alertentity nazi34
		alertentity nazi35
		alertentity nazi36
		alertentity nazi37

		savecheckpoint
	}
	trigger endmap
	{
		achievement_sf
		changelevel
		wait 9000
		endgame
	}
}
nazi1
{
	attributes
	{
		aim_accuracy 0.5
		starting_health 35
		attack_crouch 0.2
		fov 120
		aggression 0.8
		alertness 2048
	}

	spawn
	{
		accum 0 set 1 // 0=enemy spotted already
		accum 1 set 0 // 1= don't play looping anim
		accum 2 set 0 // one bullet impact
		setammo ammo_grenades 0

		wait 20000
		trigger nazi1 smoking2
	}

	trigger smoking2
	{
		accum 1 abort_if_not_equal 0
		cigarette on
		playanim smoking both
		cigarette off
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		trigger nazi1 smoking2
	}
	trigger gethelp11
	{
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		resetscript
		wait 1000 player
		attack
	}

	enemysight
	{
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		trigger nazi1 alert11a
		wait 5
		
	}

	bulletimpact
	{
		deny
		accum 2 abort_if_not_equal 0
		accum 2 set 1
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		statetype alert
		accum 1 set 1
		wait 100 player
	}

	inspectsoundstart
	{
		accum 0 set 0
	}

	trigger alert11a
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 0
		wait 300
		resetscript
		attack
	}

	trigger n10down	
	{
		cigarette off
		accum 0 set 0
		accum 2 set 0
	}
	death
	{
		cigarette off
		accum 0 set 0
		resetscript
	}
}
nazi2					
{
	attributes
	{
		tactical 0.5
		camper 1.0
		aggression 0.9
		inner_detection_radius 300
		alertness 1000
		hearing_scale 6.0	
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		accum 1 set 0
		accum 2 set 1
		statetype alert
		trigger nazi2 marchloop
		accum 0 bitreset 0	// On/OFF
		accum 4 set 0	// Used to choose a random ambient animation.
		accum 5 set 0	// Used to determine what part of the marchloop 
	}
	
	trigger marchloop
	{
		walktomarker n2spot1
		facetargetangles n2spot1
		walktomarker n2spot2
		facetargetangles n2spot2
		wait 10000
		trigger nazi2 marchloop
	}
	enemysight
	{
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		resetscript
		wait 1000 player
		attack
	}

	inspectsoundstart
	{
		clearanim
	}
	statechange alert combat
	{
		accum 0 abort_if_not_bitset 0
		resetscript
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
nazi3
{
	attributes
	{
		attack_crouch 0.0
		alertness 2200
	}

	spawn
	{
		accum 0 set 0 // 1 = sighted player
		accum 1 set 0 // random generator
		takeweapon weapon_mp40
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle

		wait 100
		trigger nazi3 look14a
	}
	trigger look14a
	{
		accum 1 abort_if_not_equal 0
		zoom on
		attrib alertness 2600
		playanim binocular both
		wait 200
		playanim binocular both
		wait 200
		playanim binocular both
		wait 200
		playanim binocular both
		attrib alertness 2200
		zoom off
		wait 2000
		attrib alertness 1800
		trigger nazi3 look14a
	}
	statechange relaxed combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi3 alert
	}

	statechange query combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi3 alert
	}

	statechange alert combat
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi3 alert
	}

	inspectfriendlycombatstart
	{
		deny
	}

	inspectbodystart
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi3 alert
	}

	bulletimpact
	{
		deny
		accum 0 abort_if_not_equal 0
		statetype alert
		clearanim
		zoom off
		resetscript
		wait 5 player
	}

	inspectsoundstart
	{
		accum 0 set 1
		trigger nazi3 alert
	}

	trigger alert
	{
		clearanim
		zoom off
		resetscript
		attrib alertness 4000
		wait 200 0
		noattack 1000
		wait 1000 0
		attack
		wait forever 0
	}	

	trigger alarm
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		clearanim
		zoom off
		resetscript
		attrib alertness 4000
		wait 5 player
		wait forever 0
	}
	enemysight
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		trigger nazi3 active1
	}
	trigger active1
	{
		statetype alert
		accum 1 set 1
		resetscript
		wait 1000 player
		attack
	}
	death
	{
	}
}
