//
//AI Scripting
//Map: Trondheim UK - Beach
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 29
		objectivesneeded 1		
		abort_if_loadgame
		
		mu_start sound/music/l_briefing_2
	}

	playerstart
	{
		mu_fade 0 1500
		mu_queue sound/music/m_action

		applyloadout 30s
		cvar g_level_was_selected 0

		trigger player cam1
	}
	// --- Start Cameras---
	trigger cam1
	{
		startcam 30s_1
	}
	trigger cam2
	{
		startcam 30s_2
	}
	trigger action1
	{
		trigger officerSmit action1
		trigger SoldierJohn action1
		trigger SoldierAlex action1
		trigger SoldierDan action1
		trigger SoldierTorn action1
		trigger OfficerJack action1
		trigger SoldierWins action1
		trigger SoldierLion action1
		trigger SoldierGarold action1
		trigger OfficerEric action1
		trigger SoldierSergei action1
		trigger SoldierTifon action1
		trigger OfficerKovan action1
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	}
	trigger action2
	{
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20

		savecheckpoint
		
	}
	trigger action3
	{
		alertentity nazi21
		alertentity nazi22

		savecheckpoint
	}
	
	trigger objective1
	{
		objectivemet 1 
		print - Mission Objective Complete

		savecheckpoint
	}
	trigger endmap
	{
		changelevel 30 persistent
	}
}
