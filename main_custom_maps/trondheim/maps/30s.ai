OfficerSmit
{
	attributes
	{
		aim_accuracy 0.8
		starting_health 150
		fov 360
		tactical 1.0
		camper 0.5
		alertness 55000
		aggression 1.0
		Attack_skill 1.0
	}
	spawn
	{
		accum 0 bitset 0
		accum 0 bitset 1
		takeweapon all
		giveweapon weapon_colt
		setammo ammo_45cal 999
		selectweapon weapon_colt
		statetype alert	
		trigger OfficerSmit go1
	}

	trigger revive
	{
		playanim revive both
		statetype alert
		sight
		trigger spawner spawnOfficerSmit
		accum 0 abort_if_not_bitset 1
		sethealth 35
		resetscript
		clearanim
		runtomarker par1spot3
		facetargetangles par1spot3
		resetscript
	}

	trigger go1			
	{
		runtomarker par1spot1
		facetargetangles par1spot1
		wait 50000
		runtomarker par1spot2
		facetargetangles par1spot2
		trigger talk
	}
	trigger talk
	{
		accum 0 abort_if_not_equal 1
		playsound take4
	}
	trigger talk2
	{
		accum 0 abort_if_not_equal 1
		playsound take2
	}

	trigger action1			
	{
		runtomarker par1spot3
		facetargetangles par1spot3
		trigger talk2
	}
	trigger action2			
	{
		runtomarker par1spot3
		facetargetangles par1spot3
	}
	enemysight
	{
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}

	trigger rem_clear
	{
		accum 0 bitreset 0
	}

	death
	{
		accum 0 bitreset 1
		print is dead
		wait 1000
		restorescript	
	}
}
