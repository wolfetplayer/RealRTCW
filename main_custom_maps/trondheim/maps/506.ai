player
{
	spawn
	{	
		abort_if_loadgame
		mu_start sound/music/c_military
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/c_military
		trigger player cam1

		// Weapons
		// Items
	}
	// --- Start Cameras---
	trigger cam1
	{
		startcam black_03
	}
	trigger steel1
	{
		trigger nazi7 go1
		trigger nazi8 go1
		trigger nazi9 go1
		trigger nazi10 go1
		trigger nazi5 go1
	}
	trigger steel2
	{
		trigger door1 go2
	}
	trigger steel3
	{
		trigger t2body go1
	}
	trigger endmap
	{
		changelevel 50e_1 persistent
	}
}
nazi1			
{
	attributes
	{
		starting_health 190
		aim_accuracy 0.5
		attack_crouch 0.9
		attack_skill 0.9
		aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}
	spawn
	{
