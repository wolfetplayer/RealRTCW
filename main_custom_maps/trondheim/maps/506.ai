nazi4					
{
	attributes
	{
		starting_health 40
		aim_accuracy 0.5
		tactical 0.5
		camper 1.0
		aggression 0.9
		inner_detection_radius 300
		alertness 1000
		attack_skill 0.95	
		hearing_scale 6.0	
	}

	spawn
	{
		accum 0 bitreset 0
		statetype relaxed
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		accum 1 set 0
		accum 2 set 1
		statetype relaxed
		trigger nazi4 marchloop
		accum 0 bitreset 0	// On/OFF
		accum 4 set 0	// Used to choose a random ambient animation.
		accum 5 set 0	// Used to determine what part of the marchloop 
	}
	pain 10
	{
		attrib aggression 1.0
		attrib camper 1.0
	}
	trigger marchloop
	{
		walktomarker n4spot1
		facetargetangles n4spot1
		walktomarker n4spot2
		facetargetangles n4spot2
		walktomarker n4spot3
		facetargetangles n4spot3
		walktomarker n4spot4
		facetargetangles n4spot4
		walktomarker n4spot3
		facetargetangles n4spot3
		walktomarker n4spot2
		facetargetangles n4spot2
		walktomarker n4spot1
		facetargetangles n4spot1
		trigger nazi4 marchloop
	}
	enemysight
	{
	}

	inspectsoundstart
	{
		clearanim
	}
	statechange alert combat
	{
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
nazi5
{
	attributes
	{
		starting_health 40
		aim_accuracy 0.6
		aggression 1.0
		fov 300
		alertness 55000
		attack_crouch 0.9
		tactical 1.0
	}
	spawn
	{
		accum 0 set 0 // 1 = sighted player
		accum 1 set 0
		statetype relaxed
		setammo ammo_grenades 0
		takeweapon weapon_mp40
		trigger nazi5 working1
	}
	trigger working1
	{
		accum 0 abort_if_not_equal 0
		accum 1 abort_if_not_equal 0
		playsound MiscHum1
		playanim device both		
		trigger nazi5 working1
	}
	trigger go1
	{
		clearanim
		playsound Blank
		walktomarker n5spot1
		walktomarker n5spot2
		trigger door1 go2
		walktomarker n5spot3
		facetargetangles n5spot3
		trigger nazi5 go2
	}
	trigger go2
	{
		wait 5000
		walktomarker n5spot2
		facetargetangles n5spot2
	}
	bulletimpact
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		statetype alert
		clearanim
		playsound Blank
		wait 5 player
	}

	inspectsoundstart
	{
		deny
		accum 1 set 1
		statetype alert
		clearanim
		playsound Blank
		wait 5 player
	}

	inspectfriendlycombatstart
	{
		deny
	}

	death
	{
		accum 1 set 1
	}
}
