player
{
	spawn
	{
		cvar g_episode 50
		objectivesneeded 1		
		abort_if_loadgame
		mu_start sound/music/m_action
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_action

		applyloadout 50a
		cvar g_level_was_selected 0
	}
	trigger action1
	{
		alertentity nazi8
		alertentity nazi9
		alertentity nazi4
		alertentity nazi5
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity d1
		alertentity d2
		alertentity d3
		alertentity d4

	}
	trigger action2
	{
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity d5
		alertentity d6
		alertentity d7

		savecheckpoint

	}
	trigger action3
	{
		alertentity agent
	}
	trigger ufo
	{
		trigger nazi8 action1
		trigger nazi9 action1

		savecheckpoint
	}
	trigger action4
	{
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27
		alertentity d8
		alertentity d9

		savecheckpoint

	}
	trigger endmap
	{
		changelevel 50b persistent
	}
}

