//
//AI Scripting
//Map: Trondheim RU - level2
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 51
		objectivesneeded 1	
		abort_if_loadgame
		mu_start sound/music/m_grave
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 50b
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_grave

	}
	trigger action1
	{
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6
	}
	trigger action2
	{
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
	    alertentity nazi11
		alertentity nazi12

		savecheckpoint
	}
	trigger action3
	{
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16

		savecheckpoint
	}
	trigger endmap
	{
		changelevel 50b_1 persistent
	}
}
nazi1				
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		trigger nazi1 marchloop
	}
	trigger marchloop
	{
		walktomarker n1spot1
		facetargetangles n1spot1
		walktomarker n1spot2
		facetargetangles n1spot2
		walktomarker n1spot3
		facetargetangles n1spot3
		wait 10000
		trigger nazi1 marchloop
	}

	enemysight
	{	
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		resetscript
		wait 1000 player
		attack	
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
