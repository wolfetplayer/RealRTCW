//
//AI Scripting
//Map: Trondheim RU - level3
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 51_1
		objectivesneeded 0
		abort_if_loadgame
		mu_start sound/music/m_grave
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 50b_1
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_grave

		// Weapons
		// Ammo
		// Items
	}
	trigger action1
	{
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
	}
	trigger action2
	{
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
	        alertentity nazi12
		alertentity nazi13

		savecheckpoint
	}
	trigger action3
	{
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17

		savecheckpoint
	}
	trigger endmap
	{
		changelevel 50c persistent
	}
}
nazi1				
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
	}
	
	enemysight
	{	
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
