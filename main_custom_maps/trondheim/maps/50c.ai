player
{
	spawn
	{
		cvar g_episode 53
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_stealth

		// Weapons

		// Ammo

		// Items
		selectweapon weapon_mp40	
	}
	trigger action1
	{
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
	}
	trigger action2
	{
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12

		savecheckpoint	
	}
	trigger action3
	{
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16

		savecheckpoint
	}
	trigger action4
	{
		
	}
	trigger action5
	{
		savecheckpoint
	}
	trigger action6
	{
		
	}
	trigger action7
	{
		
	}
	trigger action8
	{
		savecheckpoint
	}
	trigger endmap
	{
		changelevel 50d persistent
	}
	trigger button1				// this activates button
	{
		trigger button1 buttons
	}

	trigger button2				// this activates button
	{
		trigger button2 buttons
	}

}

nazi1				
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
	}

	enemysight
	{		
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
