player
{
	spawn
	{
		cvar g_episode 54
		objectivesneeded 2		
		abort_if_loadgame
		mu_start sound/music/m_action
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 50d
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_action

		// Weapons
		// Ammo
		// Items
	}
	trigger action1
	{
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8

	}
	trigger action1_one
	{
		alertentity remove_nazi1
		alertentity remove_nazi2
		alertentity nazi1
		alertentity nazi2

		savecheckpoint
	}
	trigger action2
	{
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16

	}
	trigger action3
	{
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22

		savecheckpoint
	}
	trigger action3_one
	{
		alertentity remove_nazi10
		alertentity remove_nazi11
		alertentity remove_nazi13
		alertentity remove_nazi14
		alertentity remove_nazi16
		alertentity nazi10
		alertentity nazi11
		alertentity nazi13
		alertentity nazi14
		alertentity nazi16
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27

	}
	trigger action4
	{
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27

		savecheckpoint
	}
	trigger action5
	{
		alertentity nazi28
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
	}
	trigger action6
	{
		alertentity nazi32
		alertentity nazi33
		alertentity nazi34
		alertentity nazi35
	}
	trigger action7
	{
		alertentity nazi36
		alertentity nazi37
	}
	trigger action8
	{
		alertentity nazi38
		alertentity nazi39
		alertentity nazi40
		alertentity nazi41
		alertentity nazi42
		alertentity nazi43
		alertentity nazi44

		savecheckpoint
	}
	trigger got_objective1
	{
		objectivemet 1	// mission objective complete
	}
	trigger endmap
	{
		changelevel 50e persistent
	}
}
nazi1
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		aggression 1.0
		fov 300
		tactical 1.0
	}

	inspectsoundstart
	{
		deny
	}

	spawn
	{
		takeweapon mp40
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}
	enemysight
	{
	}
	death
	{
	}

}
nazi2				
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		giveweapon weapon_grenadelauncher
		selectweapon weapon_grenadelauncher
		setammo ammo_grenades 999
		trigger nazi2 grenade
	}
	trigger grenade
	{
		wait 40000
		selectweapon weapon_grenadelauncher
		fireattarget player 3000
		selectweapon weapon_mp40
		trigger nazi2 grenade //  restart loop
	}

	enemysight
	{	
		playsound shot2
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
