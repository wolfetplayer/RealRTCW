//
//
//AI Scripting
//Map: Trondheim RU - level6
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 56
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/c_military
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 50e
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		// Weapons

		// Ammo

		// Items
	}
	trigger fight
	{
		trigger tiger go1
	}
	trigger tiger3
	{
		trigger tiger go2
	}
	trigger open
	{
		trigger door1 go2
		trigger door2 go2
		alertentity nazi18
		alertentity nazi19
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22
		mu_fade 0 3000
		mu_queue sound/music/m_mission

		savecheckpoint
	}
	trigger action1
	{
		alertentity nazi12
		alertentity nazi13
	}
	trigger action2
	{
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
	}
	trigger action3
	{
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27
		alertentity nazi28

		savecheckpoint
	}
	trigger action4
	{
		alertentity nazi33
		alertentity nazi34
		alertentity nazi35
		alertentity nazi36
		alertentity nazi37
		alertentity nazi38
		alertentity nazi39
	}
	trigger stand
	{
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		trigger door1 go1
		trigger door2 go1
		alertentity ops
		alertentity nazi29
		alertentity nazi30
		alertentity nazi31
		alertentity nazi32

		savecheckpoint
	}
	trigger hit2
	{
		trigger tiger go3
	}
	trigger hit4
	{
		trigger tiger go5
	}
	trigger alfa1
	{
		trigger tiger go4
	}
	trigger end
	{
		accum 0 bitset 1
		missionfailed
	}
	trigger endmap
	{
		changelevel 50e_1 persistent
	}
}
nazi1				
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		giveweapon weapon_grenadelauncher
		selectweapon weapon_grenadelauncher
		setammo ammo_grenades 999
		trigger nazi1 grenade
	}
	trigger grenade
	{
		wait 20000
		selectweapon weapon_grenadelauncher
		fireattarget player 3000
		selectweapon weapon_mp40
		trigger nazi1 grenade //  restart loop
	}
	
	enemysight
	{	
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
