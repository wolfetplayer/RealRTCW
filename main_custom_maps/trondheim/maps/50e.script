tiger
{
	spawn
	{
	}
	trigger go1
	{
		wait 2000
		playsound sound\world\veh_tank_on1.wav 
		wait 5
		playsound sound\world\veh_track_move.wav looping forewer
		gotomarker h1 70
		faceangles 0  0 0 gototime
		gotomarker h2 80
		faceangles 0  0 0 gototime
		gotomarker h3 90
		faceangles 0  0 0 gototime
		gotomarker h4 80
		faceangles 0  0 0 gototime
		gotomarker h5 70
		faceangles 0  0 0 gototime
		gotomarker h6 70
		playsound sound\world\TankFire.wav
		playsound sound\world\TankFire1.wav
		alertentity shot1
		faceangles 1  0 -1 gototime
		gotomarker h7 60
		faceangles 0  0 0 gototime
		gotomarker h8 60
		faceangles 1  0 -1 gototime
		playsound sound\world\TankFire.wav
		playsound sound\world\TankFire1.wav
		alertentity shot2
		gotomarker h9 60
		faceangles 0 0 0 gototime
		gotomarker h10 60
		faceangles 0 0 0 gototime
		alertentity tiger2
		playsound sound\world\veh_tank_off1.wav

	}
	trigger go2
	{
		wait 500
