		alertentity alfa2
		alertentity hit3
		playsound sound\world\veh_tank_off1.wav

	}
	trigger go3
	{
		wait 500
		playsound sound\world\veh_tank_on1.wav 
		wait 5
		gotomarker h13 2
		faceangles 0  350 0 gototime
		wait 3000
