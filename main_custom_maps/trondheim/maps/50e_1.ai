player
{
	spawn
	{
		cvar g_episode 507
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_grave
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 50e_1
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_grave

		// Weapons

		// Ammo

		// Items
	}
	trigger talk1
	{
		trigger nazi1 go1
		trigger nazi2 go1
	}
	trigger action1
	{
		mu_fade 0 3000
		mu_queue sound/music/m_alarm
		alertentity nazi3
		alertentity nazi4
		alertentity nazi5
		trigger nazi3 go1
		trigger nazi4 go1
	}
	trigger action2
	{
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
	        alertentity nazi10
		alertentity nazi11
		trigger nazi6 go1
		trigger nazi7 go1
		trigger nazi8 go1
		trigger nazi9 go1
		trigger nazi10 go1
		trigger nazi11 go1

		savecheckpoint
	}
	trigger action3
	{
	//      alertentity nazi12
		alertentity nazi13
		alertentity nazi14
	}
	trigger action4
	{
		mu_fade 0 3000
		mu_queue sound/music/m_action
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19

		savecheckpoint
	}
	trigger action5
	{
		alertentity nazi20
		alertentity nazi21
		alertentity nazi22
		alertentity nazi23
		alertentity nazi24
		alertentity nazi25
	}
	trigger action6
	{
		alertentity nazi26
	}
	trigger endmap
	{
		changelevel 50f persistent
	}
}
