nazi9
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.4
		aggression 1.0
		fov 300
		alertness 55000
		attack_crouch 0.9
		tactical 1.0
	}
	spawn
	{
		accum 0 set 0 // 1 = sighted player
		accum 1 set 0
		setammo ammo_grenades 0
		takeweapon weapon_mp40
		trigger nazi9 working1
	}
	trigger working1
	{
		accum 0 abort_if_not_equal 0
		accum 1 abort_if_not_equal 0
		playsound MiscHum1
		playanim device both		
		trigger nazi9 working1
	}
	statechange relaxed query
	{
		accum 0 set 1
		clearanim
		playsound Blank
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

	statechange relaxed alert
	{
		accum 0 set 1
		clearanim
		playsound Blank
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

	statechange relaxed combat
	{
		accum 0 set 1
		clearanim
		playsound Blank
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
	}

	statechange alert combat
	{
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		resetscript
	}

	bulletimpact
	{
		deny
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		statetype alert
		clearanim
		playsound Blank
		wait 5 player
	}

	inspectsoundstart
	{
		deny
		accum 1 set 1
		statetype alert
		clearanim
		playsound Blank
		wait 5 player
	}

	inspectfriendlycombatstart
	{
		deny
	}

	death
	{
		accum 1 set 1
	}
}
