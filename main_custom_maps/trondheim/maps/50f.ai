//
//AI Scripting
//Map: Trondheim RU - level8final
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 57
		objectivesneeded 3	
		abort_if_loadgame
		mu_start sound/music/m_drums
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 50f
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_drums

		// Weapons

		// Ammo

		// Items
	}
	trigger action1
	{
		trigger nazi4 go1
	}
	trigger action2
	{
		alertentity nazi10
		alertentity nazi11
		alertentity nazi12
		//alertentity nazi13
		//alertentity nazi14
		//alertentity nazi15
		//alertentity nazi16

		savecheckpoint
	}
	trigger action3
	{
		mu_fade 0 3000
		mu_queue sound/music/m_stealth
		alertentity nazi17
		alertentity nazi18
		alertentity nazi19
		//alertentity nazi20
		//alertentity nazi21
		//alertentity nazi22
		//alertentity nazi23
	}
	trigger action4
	{
		mu_fade 0 3000
		mu_queue sound/music/m_tension
		alertentity nazi24
		alertentity nazi25
		alertentity nazi26
		alertentity nazi27
		//alertentity nazi28
		//alertentity nazi29
		//alertentity nazi30

		savecheckpoint
	}
	trigger action5
	{
		alertentity nazi31
		alertentity nazi32
		alertentity nazi33
		//alertentity nazi34
		//alertentity nazi35
		//alertentity nazi36
	}
	trigger allright
	{
		trigger nazi2 go1
		trigger nazi3 go1
	}
	trigger got_objective1
	{
		objectivemet 1
		savecheckpoint
	}
	trigger got_objective2
	{
		objectivemet 2	
		savecheckpoint
	}
	trigger got_objective3
	{
		objectivemet 3	// mission objective complete
		savecheckpoint
	}
	trigger endmap
	{
	      achievement_ra
		changelevel
		wait 9000
		endgame
	}
}
nazi1			
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9
		aggression 0.5
		tactical 2.0
		pain_threshhold_scale 2.0		
	}
	spawn
	{
		wait 100000
		accum 0 bitreset 0
		statetype relaxed
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
	}

	enemysight
	{	
		resetscript
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
