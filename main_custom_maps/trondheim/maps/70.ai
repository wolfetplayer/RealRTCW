//
//AI Scripting
//Map: Trondheim DE - level1
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 70
		objectivesneeded 1		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_mission

		// Weapons
		giveweapon weapon_knife
		// Ammo
		setammo ammo_9mm 100

		// Items
		giveinventory key_binocs

		trigger radar1 rotateloop
		trigger radar2 rotateloop
		alertentity nazi3
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10
		alertentity par2
		alertentity par3
		alertentity par4
		alertentity par5
		alertentity par6
		alertentity par7
		alertentity par8
		alertentity par9
		alertentity par10
		alertentity par11
		alertentity par12
		alertentity par13
		alertentity par19
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		trigger nazi7 go2
		alertentity par14
		alertentity par20
		alertentity par21

		savecheckpoint
	}
	trigger action2
	{
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity par50
		alertentity par51
		alertentity par53
		alertentity par54
		alertentity par55
		alertentity par56
		alertentity par57
		alertentity par58
		alertentity par59

		savecheckpoint

	}
	trigger action3
	{
	}
	trigger action4
	{
	}
	trigger got_objective1
	{
		objectivemet 1

		savecheckpoint
	}
	trigger endmap
	{
//		resetscript
		startcam cam6
		alertentity bj
		trigger counter1 cine2
	}

	trigger endmap2
	{
		changelevel 70m persistent 4000
	}
}
bj
{
	attributes
	{
		hearing_scale 0.0
	}

	spawn
	{
		noavoid on
		nosight 99999
		takeweapon all
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		headlook off
		godmode on
		knockback off

		wait 100
		explicit_routing on
		trigger bj talk
	}
	trigger talk
	{
		walktomarker p1spot1
		walktomarker p1spot2
		playsound nazi1
		trigger nazi16 go1
	}
	trigger talk2
	{
		wait 2500
		playsound ok1
		trigger bj go1
	}
	trigger go1
	{
		wait 1700
		walktomarker p1spot1
		trigger endmap2
		changelevel 70m persistent 1000
		walktomarker p1spot3
		walktomarker p1spot4
	}

}
nazi1
{
	attributes
	{
		//aim_accuracy 0.5
		//starting_health 40
		attack_crouch 0.2
		fov 120
		aggression 0.8
		alertness 2048
	}

	spawn
	{
		nosight 99999
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		wait 2000
		trigger nazi1 smoking2
		playsound whistle1
	}

	trigger smoking2
	{
		walktomarker n1spot1
		walktomarker n1spot2
		nosight 99999
		accum 1 abort_if_not_equal 0
		cigarette on
		playanim smoking both
		cigarette off
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		playanim crotch_grab_2h both
		wait 3000
		playsound Cough2
		playanim coughing_2h both
		wait 2000
		trigger nazi1 smoking2
	}
	trigger gethelp11
	{
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		resetscript
		wait 1000 player
		attack
	}

	enemysight
	{
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		accum 1 set 1
		trigger nazi1 alert11a
		wait 5
		
	}

	bulletimpact
	{
		deny
		accum 2 abort_if_not_equal 0
		accum 2 set 1
		accum 0 set 0
		cigarette off
		playsound Blank
		clearanim
		explicit_routing off
		statetype alert
		accum 1 set 1
		wait 100 player
	}

	inspectsoundstart
	{
		accum 0 set 0
	}

	trigger alert11a
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 0
		wait 300
		resetscript
		attack
	}

	trigger n10down	
	{
		cigarette off
		accum 0 set 0
		accum 2 set 0
	}
	death
	{
		alertentity remove_nazi1
		cigarette off
		accum 0 set 0
		resetscript
	}
}
