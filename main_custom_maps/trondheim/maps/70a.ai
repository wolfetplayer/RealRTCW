//AI Scripting
//Map: Trondheim DE - level3
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 79
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 70a
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_stealth

		// Weapons
		// Ammo

		// Items
		giveinventory key_binocs

 		trigger panzer go1
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_stealth

		savecheckpoint
	}
	trigger got_objective1
	{
	}
	trigger action2
	{
		mu_fade 0 3000
		mu_queue sound/music/m_grave

		savecheckpoint

	}
	trigger endmap
	{
		changelevel 70c persistent 4000
	}
	trigger endmap2
	{
	}
}
par1
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.4
		tactical 2.0
		aggression 0.5
		camper 1.0
		inner_detection_radius 200
		alertness 55000
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9		
	}

	spawn
	{
		takeweapon all
		giveweapon weapon_thompson
		setammo ammo_45cal 999
		selectweapon weapon_thompson
		noavoid
		wait forever 0
		knockback off
	}
	pain 50
	{
	}
	enemysight
	{
		clearanim
		resetscript
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	statechange query alert	
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
		trigger par3 good
		trigger par5 good
	}
}
