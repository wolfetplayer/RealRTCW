panzer
{
	spawn
	{
		gotomarker h1 90
		faceangles 0 270 0 gototime
	}
	trigger go1
	{
		trigger panzerturret go1
		trigger panzergun go1
		trigger panzertrackl go1
		trigger panzertrackr go1
		trigger panzertrackl forward
		trigger panzertrackr forward
		gotomarker h1 90
		faceangles 0 270 0 gototime
		gotomarker h2 90
		faceangles 0 270 0 gototime
		gotomarker h3 90
		faceangles 0 270 0 gototime
		trigger panzer go2
	}
	trigger go2
	{
		
		trigger panzerturret go2
		gotomarker h4 90
		faceangles 0 320 0 1500
		gotomarker h5 90
		faceangles 0 0 0 1500
		gotomarker h6 90
		faceangles 0 0 0 gototime
		gotomarker h7 90
		faceangles 0 0 0 gototime
		trigger panzer go3
	}
	trigger go3
	{
		
		trigger panzerturret go3
		gotomarker h8 90
		faceangles 0 0 0 gototime
		trigger panzer go4
	}
	trigger go4
	{
		trigger panzerturret go4
		gotomarker h9 90
		faceangles 0 320 0 1500
		gotomarker h10 90
		faceangles 0 0 0 1500
		gotomarker h11 90
		faceangles 0 0 0 gototime
		gotomarker h12 90
		faceangles 0 320 0 1500
		trigger panzer go5
	}
	trigger go5
	{
		trigger panzerturret go5
		gotomarker h13 90
		faceangles 0 0 0 1500
		gotomarker h14 90
		faceangles 0 320 0 1500
		alertentity par15
		alertentity par16
		alertentity par17
		gotomarker h15 90
		faceangles 0 270 0 1500
		gotomarker h16 90
		faceangles 0 270 0 gototime
		gotomarker h17 90
		faceangles 0 310 0 1500
		gotomarker h18 90
		faceangles 0 270 0 1500
		gotomarker h19 90
		faceangles 0 270 0 gototime
