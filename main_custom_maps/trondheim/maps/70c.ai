//
//AI Scripting
//Map: Trondheim DE - level4
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 70579
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 70c
		#endif
		cvar g_level_was_selected 0
		
		mu_fade 0 3000
		mu_queue sound/music/m_moving

		// Weapons
		// Ammo

		// Items
		giveinventory key_binocs
	}
	trigger action1
	{	
		alertentity par7
		alertentity par8
		alertentity par9
		alertentity par10
		alertentity nazi3
		alertentity nazi4
		alertentity nazi5
	}
	trigger action2
	{
		alertentity par11
		alertentity par12
		alertentity par13

		savecheckpoint
	}
	trigger action3
	{
		mu_fade 0 3000
		mu_queue sound/music/m_grave
		alertentity par14
		alertentity par15
	}
	trigger action4
	{
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		alertentity par16
		alertentity par17
		alertentity par18
		alertentity par19
		alertentity par20

		savecheckpoint
	}
	trigger action5
	{
		mu_fade 0 3000
		mu_queue sound/music/m_grave
		alertentity par21
		alertentity par22
		alertentity par23
	}
	trigger endmap
	{
		changelevel 70p persistent 4000
	}
}
nazi1				
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		attack_crouch 0.9
		//attack_skill 1.0
		//aim_skill 1.0
		aggression 0.4
		tactical 2.0
		pain_threshhold_scale 2.0		
	}

	spawn
	{
		accum 0 bitreset 0
		statetype alert
		takeweapon all
		giveweapon weapon_mp40
		setammo ammo_9mm 999	
		selectweapon weapon_mp40
		setammo ammo_grenades 9
		giveweapon weapon_grenadelauncher
		selectweapon weapon_grenadelauncher
		trigger nazi1 grenade
	}
	trigger grenade
	{
		selectweapon weapon_grenadelauncher
		fireattarget par5 2000
		selectweapon weapon_mp40
		wait 20000
		trigger nazi1 grenade //  restart loop
	}

	enemysight
	{		
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
