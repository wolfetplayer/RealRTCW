player
{
	spawn
	{
		cvar g_episode 74
		objectivesneeded 1		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_situation

		// Weapons
		// Ammo
		setammo ammo_9mm 50

		// Items
		giveinventory key_binocs
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_situation
	}
	trigger action2
	{
	}
	trigger action3
	{
	}
	trigger action4
	{
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger endmap
	{
	}
	trigger endmap2
	{
		changelevel 70d persistent 4000
	}
}
