//
//AI Scripting
//Map: Trondheim DE - level7
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 790
		objectivesneeded 2		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_mission
		alertentity nazi1
		alertentity nazi2
		alertentity nazi3
		alertentity nazi4
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		alertentity rus1
		alertentity rus2
		alertentity rus3
		alertentity rus4
		alertentity par5
	}
	trigger action2
	{
		mu_fade 0 3000
		mu_queue sound/music/m_grave
		alertentity par6
		alertentity par7

		savecheckpoint
	}
	trigger action3
	{
		alertentity par8
		alertentity par9

	}
	trigger action4
	{
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity par10
		alertentity par11
		alertentity par12
		alertentity par13
		alertentity par14
		alertentity nazi5
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8

		savecheckpoint

	}
	trigger action5
	{
		mu_fade 0 3000
		mu_queue sound/music/m_grave
		alertentity par15
		alertentity par16
		alertentity par17
		alertentity par18
		alertentity par19
	}
	trigger action6
	{
		alertentity rus5
		alertentity rus6
		alertentity rus7
	}
	trigger action7
	{
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity rus8
		alertentity rus9
		alertentity rus10
		alertentity rus11
		alertentity rus12
		alertentity nazi9
		alertentity nazi11
		alertentity nazi12
		alertentity nazi10

		savecheckpoint

	}
	trigger action8
	{
		alertentity par20
		alertentity par21
		alertentity par22
	}
	trigger action9
	{
		alertentity par23
		alertentity par24
		alertentity par25
		alertentity par26
		alertentity par27

		savecheckpoint

	}
	trigger joy
	{
		alertentity d1
	}
	trigger save1
	{	
		objectivemet 1
		savegame
		trigger nazi6 go1

	}
	trigger save2
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		objectivemet 2
		savegame
	}

	trigger endmap
	{
		changelevel 70j_1 persistent
	}
	trigger got_objective1
	{
		objectivemet 1

		savecheckpoint
	}
	trigger got_objective2
	{
		objectivemet 2

		savecheckpoint
	}
}
