//
//AI Scripting
//Map: Trondheim DE - level8
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 80
		objectivesneeded 1		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 70j_1
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		alertentity nazi1
		alertentity nazi2
		alertentity nazi3
		alertentity nazi4

		// Weapons
		// Ammo
		// Items
		giveinventory key_binocs
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity par1
		alertentity par2
		alertentity par3
		alertentity par4
		alertentity par5
		alertentity par6
		alertentity par7
		alertentity rus6
		alertentity rus7
		alertentity rus8
		alertentity rus9
		alertentity par10
	}
	trigger action2
	{
		alertentity par8
		alertentity par9
		alertentity par10
		alertentity par11
		alertentity par12
		alertentity par13
		alertentity nazi4
		alertentity nazi5
		alertentity nazi6

		savecheckpoint
	}
	trigger action3
	{
		objectivemet 1
		alertentity rus11
		alertentity rus12
		alertentity rus13

	}
	trigger action4
	{
		mu_fade 0 3000
		mu_queue sound/music/m_assault
		alertentity rus14
		alertentity rus15

		savecheckpoint
	}
	trigger action5
	{
		alertentity par14
		alertentity par15
		alertentity par16
		alertentity par17
		alertentity par18
		alertentity par19
		alertentity nazi7
		alertentity nazi8
		alertentity nazi9
		alertentity nazi10

	}
	trigger action6
	{
		alertentity par20
		alertentity par21
		alertentity par22
	}
	trigger action7
	{
		alertentity par23
		alertentity par24
		alertentity par25
		alertentity par26

		savecheckpoint
	}
	trigger action8
	{
		alertentity par28
		alertentity par29
		alertentity par30
		alertentity nazi11
		alertentity nazi12
		alertentity nazi13

	}
	trigger save1
	{	
		objectivemet 1
		savegame
	}
	trigger save2
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		objectivemet 2
		savegame
	}
	trigger radar1
	{
		missionfailed
	}
	trigger endmap
	{
		changelevel 70j_2 persistent
	}
	trigger got_objective1
	{
		objectivemet 1

		savecheckpoint
	}
	trigger got_objective2
	{
		objectivemet 2

		savecheckpoint
	}
}
