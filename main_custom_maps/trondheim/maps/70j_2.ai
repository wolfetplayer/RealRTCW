//
//AI Scripting
//Map: Trondheim DE - level9 final
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 70878
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 70j_2
		#endif
		cvar g_level_was_selected 0
		
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		
		trigger radar1 rotateloop
		trigger radar2 rotateloop
		trigger radar3 rotateloop
		trigger button go1
	}
	trigger fail
	{
		missionfailed
	}
	trigger action1
	{	
		alertentity par6
		alertentity par7
		alertentity par8
		alertentity par9
		alertentity nazi6
		alertentity nazi7
		alertentity nazi8
	}
	trigger action2
	{
		mu_fade 0 3000
		mu_queue sound/music/m_grave
		alertentity par10
		alertentity par11
		alertentity par12

		savecheckpoint
	}
	trigger action3
	{
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity par13
		alertentity par14
		alertentity par15
		alertentity par16
		alertentity nazi9
		alertentity nazi10
		alertentity nazi11
	}
	trigger action4
	{
		alertentity nazi12
		alertentity nazi13
		alertentity nazi14
		alertentity nazi15
		alertentity nazi16
		alertentity nazi17
		alertentity nazi18
		alertentity par17
		alertentity par18
		alertentity par19
		alertentity par20
		alertentity par21
		alertentity par22

		savecheckpoint
	}
	trigger action5
	{
		alertentity par23
		alertentity par24
		alertentity par25
		alertentity par26
		alertentity par27
		alertentity nazi20
//		alertentity nazi21
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger cine
	{
		alertentity cine1
		alertentity cine2
		alertentity cine3
		startcam editor2
		mu_fade 0 3000
		mu_queue sound/music/m_mission
	}
	trigger win
	{
		trigger button win
	}
	trigger endmap
	{
		achievement_ic
		changelevel cine3 10
	}
}
cine1
{
	attributes
	{
		hearing_scale 0.0
	}

	spawn
	{
		noavoid on
		nosight 99999
		takeweapon all
		giveweapon weapon_thompson
		selectweapon weapon_thompson
		headlook off
		godmode on
		notarget on
		knockback off

		wait 100
		explicit_routing on
		trigger cine1 talk
	}
	trigger talk
	{
		wait 1000
		playsound talk1
		trigger cine1 talk2
	}

	trigger talk2
	{
		wait 5000
		playsound talk2
		trigger cine2 talk
	}
	trigger go1
	{
		wait 500
		walktomarker cine1spot1
		trigger player endmap
		trigger cine2 go1
		walktomarker cine1spot2
		walktomarker cine1spot3
	}

}
cine2
{
	attributes
	{
		hearing_scale 0.0
	}

	spawn
