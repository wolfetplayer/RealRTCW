//AI Scripting
//Map: Trondheim DE - level2
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 78
		objectivesneeded 0		
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		#if g_level_was_selected >= 1
		applyloadout 70m
		#endif
		cvar g_level_was_selected 0
		mu_fade 0 3000
		mu_queue sound/music/m_stealth

		// Items
		giveinventory key_binocs
		setarmor 100

		trigger t2body go1
		trigger player lockincar
		trigger panzerturret go1
 		trigger panzer go1
		trigger panzergun go1
		trigger panzertrackl go1
		trigger panzertrackr go1
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		trigger panzerturret go2
 		trigger panzer go2
		trigger panzergun go2
		trigger panzertrackl go2
		trigger panzertrackr go2
	}
	trigger step1
	{
		trigger nazi1 go2
		trigger nazi2 go2
		trigger nazi3 go2
		trigger nazi4 go2
		trigger nazi5 go2
		trigger nazi6 go2
		trigger nazi7 go2
	}
	trigger step2
	{
		trigger panzer go4
		trigger nazi1 go3
		trigger nazi2 go3
		trigger nazi3 go3
		trigger nazi4 go3
		trigger nazi5 go3
		trigger nazi6 go3
		trigger nazi7 go3
	}
	trigger step3
	{
		trigger panzer go5
		trigger nazi1 go4
		trigger nazi2 go4
		trigger nazi3 go4
		trigger nazi4 go4
		trigger nazi5 go4
		trigger nazi6 go4
		trigger nazi7 go4
	}
	trigger lockincar
	{
		lockplayer on
	}

	trigger unlockincar
	{
		lockplayer off
		selectweapon weapon_mp40	
		trigger nazi1 go1
		trigger nazi2 go1
		trigger nazi3 go1
		trigger nazi4 go1
		trigger nazi5 go1
		trigger nazi6 go1
		trigger nazi7 go1
		alertentity par1
		alertentity par2
		alertentity par3
		alertentity par4
		alertentity par5
		alertentity par6
		alertentity par7
		alertentity par8
		alertentity par9
		alertentity par10
		alertentity par11
		alertentity par12
		alertentity par13

		savecheckpoint
	}
	trigger got_objective1
	{
		objectivemet 1
	}
	trigger endmap
	{
		changelevel 70a persistent 4000
	}
	trigger endmap2
	{
	}
}
nazi1			
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.7
		tactical 0.9
		camper 1.0
		aggression 0.9
		inner_detection_radius 300
		alertness 55000
		//attack_skill 1.0		
	}

	spawn
	{
		accum 0 bitreset 0
		explicit_routing on
		noavoid on
		statetype relaxed
		takeweapon all
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
	}
	pain 50
	{
		followcast par11
	}
	trigger go1
	{
        followcast player
		playsound axis2
		clearanim
		explicit_routing off
		noavoid off
		resetscript
		attack
		runtomarker n1spot1
		trigger nazi1 go2
	}
	trigger go2
	{
		followcast player
		runtomarker n1spot2
	}
	trigger go3
	{
                followcast player
		runtomarker n1spot3
	}
	trigger go4
	{
		runtomarker n1spot4
	}
	enemysight
	{
		clearanim
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	death
	{
	}
}
