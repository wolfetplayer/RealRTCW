		faceangles 0 30 0 gototime
		gotomarker c9 50
		faceangles 0 10 0 gototime
	}
	trigger go2
	{
		wait 100
		gotomarker ñ8 30
		faceangles 0 0 0 gototime
		playsound axis6
		gotomarker r1 50
		faceangles 0 20 0 1500
		playsound axis5
