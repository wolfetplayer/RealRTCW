t2body
{
	spawn
	{
		gotomarker c1 30
		faceangles 0 0 0 gototime
		playsound sound/world/shift_01.wav looping
	}
	trigger go1
	{
		playsound sound/world/shift_01.wav looping
		trigger t2bwheels go1
		trigger t2lwheel go1
		trigger t2rwheel go1
		playsound sound/world/idle_01.wav looping
		gotomarker c1 70
		faceangles 0 0 0 gototime
		gotomarker c2 70
		faceangles 0 0 0 gototime
		gotomarker c3 70
		faceangles 0 0 0 gototime
		gotomarker c4 70
		faceangles 0 0 0 gototime
		gotomarker c5 70
		faceangles 0 0 0 gototime
		gotomarker c6 70
		faceangles 0 0 0 gototime
		gotomarker c7 70
		faceangles 0 0 0 gototime
		gotomarker c8 70
		faceangles 0 0 0 gototime
		gotomarker c9 70
		faceangles 0 0 0 gototime
		gotomarker c10 70
		faceangles 0 0 0 gototime
		trigger player unlockincar
         	alertentity rocket
		trigger player action1
		gotomarker c10 30
		faceangles 0 0 0 gototime
		alertentity grenade
		trigger t2bwheels stop
		trigger t2lwheel stop
		trigger t2rwheel stop
	}
}
