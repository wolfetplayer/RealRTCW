panzerturret
{
	spawn
	{
		
	}

	trigger go1
	{
		gotomarker c1 50
		faceangles 0 0 0 gototime
		gotomarker c2 50
		faceangles 0 0 0 gototime
		gotomarker c3 50
		faceangles 0 10 0 gototime
