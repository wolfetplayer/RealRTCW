panzer
{
	spawn
	{
	}
	trigger go1
	{
		
		trigger panzerturret go1
		gotomarker c1 50
		faceangles 1 0 0 gototime
		gotomarker c2 50
		faceangles 0 0 0 gototime
		gotomarker c3 50
		faceangles 0 0 0 gototime
		gotomarker c4 50
		faceangles 0 0 0 gototime
		gotomarker c5 50
		faceangles 0 0 0 gototime
		gotomarker c6 50
		faceangles 0 0 0 gototime
		gotomarker c7 50
		faceangles 0 0 0 gototime
		gotomarker c8 50
		faceangles -1 0 0 gototime
		gotomarker c9 50
		faceangles 0 0 0 gototime
		trigger panzertrackl forwardstop
		trigger panzertrackr forwardstop
	}
	trigger go2
	{
		
		wait 100
		trigger panzerturret go2
		trigger panzertrackl reverse
		trigger panzertrackr reverse
		gotomarker c8 30
		faceangles 0 0 0 gototime
		trigger panzertrackl forward
		trigger panzertrackr forward
		gotomarker r1 50
		faceangles 0 345 0 1500
		gotomarker r2 50
		faceangles 0 0 0 1500
		gotomarker r3 50
		faceangles 0 0 0 gototime
		gotomarker r4 50
		faceangles 0 0 0 gototime
		trigger panzer go3
	}
	trigger go3
	{
		wait 500
		trigger panzerturret go3
		gotomarker r5 50 
		faceangles 0 45 0 1500
		gotomarker r6 50 
		faceangles 0 0 0 1500
		trigger panzertrackl forwardstop
		trigger panzertrackr forwardstop
	}
	trigger go4
	{
		trigger panzertrackl forward
		trigger panzertrackr forward
		trigger panzerturret go4
		gotomarker r7 50 
		faceangles 0 0 0 gototime
		gotomarker r8 50 
		faceangles 0 0 0 gototime
		gotomarker r9 50 
		faceangles 0 315 0 1500
		trigger panzertrackl forwardstop
		trigger panzertrackr forwardstop
	}
	trigger go5
	{
		trigger panzertrackl forward
		trigger panzertrackr forward
		trigger panzerturret go5
		gotomarker r10 50 
		faceangles 0 45 0 1500
		gotomarker r11 70 
		faceangles 0 0 0 1500
		gotomarker r12 70 
		faceangles 0 0 0 gototime
		gotomarker r13 50 
		faceangles 0 0 0 gototime
		trigger panzertrackl forwardstop
		trigger panzertrackr forwardstop
	}
}
