//
//AI Scripting
//Map: Trondheim DE - level5
//Last edited by: WolfETPlayer
//

player
{
	spawn
	{
		cvar g_episode 7088
		objectivesneeded 1	
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_mission

		// Weapons
		// Ammo
		// Items
		giveinventory key_binocs
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity par5
		alertentity par6
		alertentity par7
		alertentity par8
		alertentity par9
		alertentity par10
		alertentity par11
		alertentity par12
		alertentity par13
		alertentity par14
		trigger par13 go1
		trigger par14 go1
	}
	trigger action2
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity par13
		alertentity par14
		trigger par13 go1
		trigger par14 go1
		alertentity par21
		alertentity par22
		alertentity par23
		alertentity par24
		alertentity par25
		alertentity par26

		savecheckpoint
	}
	trigger action3
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_mission
		objectivemet 1
		savegame
		alertentity par15
		alertentity par16
		alertentity par17
		alertentity par18
		alertentity par19
		alertentity par20
	}
	trigger action4
	{	
		alertentity par27
		alertentity par28
		alertentity par29

		savecheckpoint
	}
	trigger action5
	{	
		alertentity par30
		alertentity par31
		alertentity par32
		alertentity par33
	}
	trigger change
	{
		changelevel 70p_1 persistent
	}
	trigger fail
	{
		missionfailed
	}
	trigger got_objective1
	{
		objectivemet 1
	}

}
par1
{
	attributes
	{
		//starting_health 35
		//aim_accuracy 0.5
		tactical 2.0
		aggression 0.5
		camper 1.0
		inner_detection_radius 200
		alertness 5000
		attack_crouch 0.9
		//attack_skill 0.9
		//aim_skill 0.9		
	}

	spawn
	{
		takeweapon all
		giveweapon weapon_m1garand
		setammo ammo_barammo 999
		selectweapon weapon_m1garand
		knockback off
		wait forever
	}
	pain 50
	{
	}
	enemysight
	{
		clearanim
		resetscript
	}

	inspectsoundstart
	{
		clearanim
	}

	inspectsoundend
	{
	}

	inspectbodystart
	{
		clearanim
	}

	inspectbodyend
	{
	}

	statechange query alert	
	{
		resetscript
	}

	statechange relaxed alert
	{
		resetscript
	}	

	death
	{
	}
}
