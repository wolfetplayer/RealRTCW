player
{
	spawn
	{
		cvar g_episode 7089
		objectivesneeded 2	
		abort_if_loadgame
		mu_start sound/music/m_stealth
	}

	playerstart
	{
		mu_fade 0 3000
		mu_queue sound/music/m_mission

		// Weapons
		// Ammo
		// Items
	}
	trigger action1
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_grave
	}
	trigger action2
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_moving
		alertentity par4
		alertentity par5
		alertentity par6
		alertentity par24

		savecheckpoint
	}
	trigger action3
	{	
		alertentity par12
		alertentity par13
		alertentity par14
		alertentity par15
		alertentity par16
		alertentity par17
	}
	trigger action4
	{	
		mu_fade 0 3000
		mu_queue sound/music/m_situation
		alertentity par18
		alertentity par19
		alertentity par20

		savecheckpoint
	}
	trigger action5
	{	
		alertentity par21
		alertentity par22
		alertentity par23
	}
	trigger got_objective1
	{
		objectivemet 1

		savecheckpoint
	}
	trigger got_objective2
	{
		objectivemet 2

		savecheckpoint
	}
	trigger endmap
	{
		changelevel 70j persistent 4000
	}


}
