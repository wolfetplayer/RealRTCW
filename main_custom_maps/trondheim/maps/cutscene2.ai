player
{
	spawn
	{	
		abort_if_loadgame
		mu_start sound/music/m_drums
	}

	playerstart
	{
		mu_fade 0 3000
	//	mu_queue sound/music/m_drums
		mu_queue sound/intro
		trigger player cam1

		// Weapons
		// Items
	}
	// --- Start Cameras---
	trigger cam1
	{
		startcam black_05
	}
	trigger endmap
	{
		wait 15000
		changelevel 50a persistent
	}
}
par1
{
	attributes
	{
		aim_accuracy 0.5
		starting_health 200
		fov 360
		tactical 1.0
		camper 0.5
		alertness 55000
		aggression 1.0
		Attack_skill 1.0
	}
	spawn
	{
		accum 0 bitset 0
		accum 0 bitset 1
		takeweapon weapon_sniperscope
		takeweapon weapon_mauserrifle
		giveweapon weapon_ppsh
		setammo ammo_ttammo 999
		selectweapon weapon_ppsh
		statetype relaxed
		trigger par1 go1
	}
	trigger go1
	{
		walktomarker par1spot1 nostop
		walktomarker par1spot2 nostop
		walktomarker par1spot3 nostop
		walktomarker par1spot4 nostop
	}
	enemysight
	{
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectfriendlycombatstart
	{
		deny
	}
